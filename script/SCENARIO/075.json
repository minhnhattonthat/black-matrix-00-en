[
 {
  "id": "SCENARIO/075/00130",
  "speaker": 0,
  "jp": [
   "うわぁ・・・",
   "人がたくさんいる！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/00170",
  "speaker": 16,
  "jp": [
   "ここはヴェローナの街だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/001ae",
  "speaker": 0,
  "jp": [
   "大きな街だね",
   "なんだか、目が回りそうだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/001f4",
  "speaker": 16,
  "jp": [
   "長旅の疲れもあるだろう",
   "少し休憩をとろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/00246",
  "speaker": 0,
  "jp": [
   "ボクなら大丈夫だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/00274",
  "speaker": 16,
  "jp": [
   "無理をすることはない",
   "空を飛ぶことは想像以上に",
   "体力を消耗する"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/002d6",
  "speaker": 16,
  "jp": [
   "今日はもう休みなさい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/00312",
  "speaker": 0,
  "jp": [
   "うん・・・でも"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/0033c",
  "speaker": 16,
  "jp": [
   "飛ぶことを覚えたばかりで",
   "あの距離を飛ぶのは",
   "大変だったろう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/003a6",
  "speaker": 0,
  "jp": [
   "うん、",
   "最初はちょっと辛かったけれど",
   "今はもうへっちゃらだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/00400",
  "speaker": 16,
  "jp": [
   "そうか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/0042e",
  "speaker": 0,
  "jp": [
   "でもね、",
   "途中から、だんだん変な感覚に",
   "のみ込まれそうになって怖かった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/004a2",
  "speaker": 16,
  "jp": [
   "変な感覚？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/004c8",
  "speaker": 0,
  "jp": [
   "もっと速く、",
   "もっと高くって誰かがささやいて",
   "いるような感じだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/0052e",
  "speaker": 0,
  "jp": [
   "ねぇ、ヨハネ",
   "この翼はいったい誰のものなん",
   "だろう・・・？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/00588",
  "speaker": 16,
  "jp": [
   "すまないが、",
   "私はその質問には答えられない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/005de",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/0060c",
  "speaker": 16,
  "jp": [
   "それはそうと",
   "この街に来た理由なのだが"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/00648",
  "speaker": 16,
  "jp": [
   "この街には、",
   "プロデヴォン教団に反目する",
   "地下組織が存在するらしい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/006b6",
  "speaker": 0,
  "jp": [
   "地下組織？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/006dc",
  "speaker": 16,
  "jp": [
   "その組織の名は",
   "＜サイファーパンク＞"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/00714",
  "speaker": 16,
  "jp": [
   "うまく＜サイファーパンク＞に",
   "接触出来れば、教団の情報を",
   "得られるかもしれない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/00778",
  "speaker": 16,
  "jp": [
   "マティアの手がかりが",
   "少しでも得られるといいのだが"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/007c0",
  "speaker": 16,
  "jp": [
   "まずは＜サイファーパンク＞に",
   "接触する方法を見つけなくては",
   "ならないな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/00832",
  "speaker": 1,
  "jp": [
   "ボクも一緒に行くよ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/00872",
  "speaker": 16,
  "jp": [
   "しかし・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/008a6",
  "speaker": 0,
  "jp": [
   "じっとなんか",
   "していられないんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/008f2",
  "speaker": 16,
  "jp": [
   "そうか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/0091a",
  "speaker": 16,
  "jp": [
   "カインは街の中心部で",
   "出来るだけ多くの人に話しかけて",
   "みてくれ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/00970",
  "speaker": 16,
  "jp": [
   "私は他を当たってみる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/00998",
  "speaker": 16,
  "jp": [
   "あまり無茶をしないように"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/009c4",
  "speaker": 16,
  "jp": [
   "私もいつでもすぐ",
   "お前の元に駆けつけられるとは",
   "限らないからな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/075/00a2e",
  "speaker": 0,
  "jp": [
   "うん、気をつけるよ"
  ],
  "en": ""
 },
