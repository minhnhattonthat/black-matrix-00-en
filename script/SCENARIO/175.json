 {
  "id": "SCENARIO/175/02cc6",
  "jp": "　退却してヨハネを助けに行く",
  "en": "Retreat and go help Johannes"
 },
 {
  "id": "SCENARIO/175/02cec",
  "jp": "　ヨハネを信じて戦う",
  "en": "Trust Johannes and fight"
 },
 {
  "id": "SCENARIO/175/02d28",
  "speaker": 16,
  "jp": [
   "うん・・・退却して",
   "ヨハネを助けに行こう！！"
  ],
  "en": "Yeah... Let's retreat and go help Johannes!!"
 },
 {
  "id": "SCENARIO/175/02d7e",
  "speaker": 1,
  "jp": [
   "状況を見てから言え！！",
   "敵に囲まれたこの状態で",
   "俺たちに何ができる！？"
  ],
  "en": "Look at the situation before you talk!! Surrounded like this, what can we do!?"
 },
 {
  "id": "SCENARIO/175/02de4",
  "speaker": 0,
  "jp": [
   "半端な気持ちで来たんじゃない",
   "なら、仲間１人のことぐらいで",
   "ガタガタ騒ぐな！"
  ],
  "en": "You didn't come here half-hearted. Then don't make a fuss over one comrade!"
 },
 {
  "id": "SCENARIO/175/02e78",
  "speaker": 16,
  "jp": [
   "ええ、仲間の心配をする余裕など",
   "貴方たちにはありません"
  ],
  "en": "Yes. You have no room to spare for worrying about comrades."
 },
 {
  "id": "SCENARIO/175/02eec",
  "speaker": 0,
  "jp": [
   "僕たちは必ず戻ってくる",
   "ヨハネと共にね"
  ],
  "en": "We will come back, without fail. With Johannes."
 },
 {
  "id": "SCENARIO/175/02f3e",
  "speaker": 16,
  "jp": [
   "仲間の死体を探しに",
   "向かうのですか？"
  ],
  "en": "Off to search for your comrade's corpse, then?"
 },
 {
  "id": "SCENARIO/175/02f8e",
  "speaker": 0,
  "jp": [
   "ヨハネは死んでなんかいない！！"
  ],
  "en": "Johannes isn't dead!!"
 },
 {
  "id": "SCENARIO/175/02fd0",
  "speaker": 16,
  "jp": [
   "ヨハネを信じよう",
   "ヨハネは・・・きっと",
   "大丈夫だよ"
  ],
  "en": "Let's trust Johannes. Johannes will... be all right, I know it."
 },
 {
  "id": "SCENARIO/175/03040",
  "speaker": 1,
  "jp": [
   "バカヤロウ！！",
   "大丈夫なわけないだろ！！",
   "ヨハネさんを見捨てるのか！？"
  ],
  "en": "You idiot!! Of course he won't be all right!! You're abandoning Johannes-san!?"
 },
 {
  "id": "SCENARIO/175/030b2",
  "speaker": 16,
  "jp": [
   "ボクだってヨハネが心配だよ！！",
   "でも、ヨハネの意志なんだ！！",
   "だから・・・！！！"
  ],
  "en": "I'm worried about Johannes too!! But it's what Johannes wants!! So...!!"
 },
 {
  "id": "SCENARIO/175/03126",
  "speaker": 16,
  "jp": [
   "力ずくでも通させてもらうよ",
   "ボク達はヨハネのためにも",
   "生き延びなきゃいけないんだ！"
  ],
  "en": "We'll force our way through if we must. We have to survive, for Johannes's sake too!"
 },
 {
  "id": "SCENARIO/175/031c0",
  "speaker": 16,
  "jp": [
   "仲間の屍を乗り越えてでも",
   "進む覚悟なのですね"
  ],
  "en": "So you are resolved to advance, even over your comrade's corpse."
 },
 {
  "id": "SCENARIO/175/03228",
  "speaker": 0,
  "jp": [
   "ヨハネは死んでなんかいないよ"
  ],
  "en": "Johannes isn't dead."
 },
 {
  "id": "SCENARIO/175/03276",
  "speaker": 16,
  "jp": [
   "嘆くことはありません",
   "貴方たちは等しく同じ運命を",
   "たどるのですから"
  ],
  "en": "There is no need to grieve. You will all share the very same fate."
 },
 {
  "id": "SCENARIO/175/032d8",
  "speaker": 0,
  "jp": [
   "ボク達は誰も死なない・・・",
   "誰も死なせたりなんかしない！"
  ],
  "en": "None of us will die... I won't let anyone die!"
 },
 {
  "id": "SCENARIO/175/0332c",
  "speaker": 16,
  "jp": [
   "我、愚かなる夢追い人を死に誘い",
   "儚き者達に永遠の安らぎを与える",
   "ことをここに誓う"
  ],
  "en": "Here I vow: to lead foolish dreamers unto death, and grant the fleeting eternal rest."
 },
 {
  "id": "SCENARIO/175/033a2",
  "speaker": 16,
  "jp": [
   "全ての嘆きも悲しみも",
   "ここで終わりにしましょう"
  ],
  "en": "Let all lament and all sorrow end here."
 },
 {
  "id": "SCENARIO/175/06f4c",
  "jp": "青年",
  "en": "Young man"
 },
 {
  "id": "SCENARIO/175/06f5a",
  "speaker": 16,
  "jp": [
   "ボンジュール"
  ],
  "en": "Bonjour"
 },
 {
  "id": "SCENARIO/175/06f72",
  "jp": "カイン",
  "en": "Cain"
 },
 {
  "id": "SCENARIO/175/06f82",
  "speaker": 16,
  "jp": [
   "？？？"
  ],
  "en": "???"
 }
]