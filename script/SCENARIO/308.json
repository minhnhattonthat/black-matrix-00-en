[
 {
  "id": "SCENARIO/308/00108",
  "speaker": 16,
  "jp": [
   "カインも見たのか、あれ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/00146",
  "speaker": 0,
  "jp": [
   "見たとゆーか",
   "なんとゆーか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/0018a",
  "speaker": 0,
  "jp": [
   "ボクが行った頃には",
   "もうエンブリオンは倒され",
   "ちゃっていたから・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/001fa",
  "speaker": 16,
  "jp": [
   "おばちゃん、現役時代は",
   "＜真紅のトゲ＞と恐れられた",
   "凄腕のナイフ使いでさ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/0026e",
  "speaker": 16,
  "jp": [
   "ナイフの他にも色々",
   "暗器を隠し持ってるらしいけど",
   "あの強さは味方ながら怖いぜ～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/0031c",
  "speaker": 16,
  "jp": [
   "カインも地獄を見たくなかったら",
   "おばちゃんだけは、怒らせちゃ",
   "ダメだぜ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/003be",
  "speaker": 0,
  "jp": [
   "う、うん・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/00494",
  "speaker": 16,
  "jp": [
   "だ・れ・が、",
   "おばちゃんだってぇ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/00530",
  "speaker": 1,
  "jp": [
   "うわぁぁぁぁぁっ？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/0056e",
  "speaker": 16,
  "jp": [
   "あんまり軽口叩いていると",
   "あんたも早死にするよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/005ca",
  "speaker": 0,
  "jp": [
   "あはははは・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/005fa",
  "speaker": 0,
  "jp": [
   "そんなことより",
   "カルディアさんのケガの方は",
   "大丈夫だったのかよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/00666",
  "speaker": 16,
  "jp": [
   "大丈夫とは言い切れないけど",
   "今、ステイエンに代わってきて",
   "もらったところだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/006d6",
  "speaker": 16,
  "jp": [
   "積もる話もあるだろうからねぇ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/0071a",
  "speaker": 0,
  "jp": [
   "まぁ、そうだろうなぁ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/00818",
  "speaker": 0,
  "jp": [
   "でも、ひどい傷だったけど",
   "いったい教団で何があったん",
   "だろう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/0087e",
  "speaker": 5,
  "jp": [
   "おそらく、彼女のいた施設も",
   "エンブリオンに襲われたのだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/00970",
  "speaker": 16,
  "jp": [
   "ヴァルトスさん？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/009aa",
  "speaker": 0,
  "jp": [
   "今、各地の教団施設が",
   "大挙して押し寄せたエンブリオン",
   "の群れに襲われている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/00a22",
  "speaker": 16,
  "jp": [
   "っ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/00a52",
  "speaker": 0,
  "jp": [
   "何が起きているのか",
   "我々には計りかねる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/00a9a",
  "speaker": 0,
  "jp": [
   "だが、何か大きなことが",
   "起ころうとしているのは事実だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/00af2",
  "speaker": 0,
  "jp": [
   "・・・こういう時に",
   "堂々とサイファーパンクに戻れぬ",
   "我が身が恨めしいな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/00b66",
  "speaker": 16,
  "jp": [
   "ヴァルトスさん"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/00b9e",
  "speaker": 0,
  "jp": [
   "やむを得ない事態だったとはいえ",
   "全て自分がまいた種だ・・",
   "今更悔やんでも仕方あるまい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/00c24",
  "speaker": 0,
  "jp": [
   "ダリア",
   "皆に警戒だけは怠らぬように",
   "伝えてくれ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/00c90",
  "speaker": 16,
  "jp": [
   "はい、了解しました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/00cd2",
  "speaker": 3,
  "jp": [
   "このような事態の時に",
   "教団関係者をサイファーパンクの",
   "中にかくまってしまったが"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/308/00d46",
  "speaker": 3,
  "jp": [
   "何か、悪いことが",
   "起こらなければ良いのだが・・・"
  ],
  "en": ""
 },
