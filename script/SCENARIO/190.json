  "en": ""
 },
 {
  "id": "SCENARIO/190/010fa",
  "speaker": 16,
  "jp": [
   "い・・いやだっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/190/01120",
  "speaker": 16,
  "jp": [
   "ステイエンを死なせたくない！",
   "絶対に助けるんだっ！"
