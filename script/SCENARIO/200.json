[
 {
  "id": "SCENARIO/200/000a8",
  "speaker": null,
  "jp": [
   "＜渇き＞とは、",
   "黒羽根の一族にのみ現れる",
   "特有の病だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/200/00122",
  "speaker": null,
  "jp": [
   "怒り、哀しみ、恐れ、殺意、",
   "それら様々な負の感情が",
   "体の奥底からあふれ出し"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/200/0019e",
  "speaker": null,
  "jp": [
   "やがて気も狂わんばかりに",
   "精神を喰らい尽くす"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/200/0020c",
  "speaker": null,
  "jp": [
   "自制の効かぬ体は",
   "破壊衝動に乗っ取られ、",
   "血を見たいと渇望する・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/200/00282",
  "speaker": null,
  "jp": [
   "しかし、正常さを失っても",
   "意識は残ったままなのだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/200/002e2",
  "speaker": null,
  "jp": [
   "心の奥底で、",
   "どれだけ拒否しようとも、",
   "身体が思う通りにならない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/200/00352",
  "speaker": null,
  "jp": [
   "どんな屈強な戦士であっても",
   "これに抗うすべは無い・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/200/003c8",
  "speaker": null,
  "jp": [
   "それが",
   "どれほど肉体に苦痛を与え",
   "どれほど心をさいなむのか・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/200/00524",
  "speaker": 16,
  "jp": [
   "ゴホゴホッ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/200/0055a",
  "speaker": 19,
  "jp": [
   "畜生・・・また発作が"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/200/005e8",
  "speaker": 16,
  "jp": [
   "ルカ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/200/0065a",
  "speaker": 0,
  "jp": [
   "ザイオン"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/200/0067c",
  "speaker": 16,
  "jp": [
