  "en": ""
 },
 {
  "id": "SCENARIO/300/00718",
  "speaker": 0,
  "jp": [
   "・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/300/00740",
  "speaker": 17,
  "jp": [
   "では、不浄なる者よ",
   "我が剣のサビとなれ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/300/00788",
  "speaker": 6,
  "jp": [
   "そうはさせるかよっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/300/0089a",
  "speaker": 17,
  "jp": [
   "エクサル？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/300/008de",
  "speaker": 0,
  "jp": [
   "そんな、幽霊でも見たような顔",
