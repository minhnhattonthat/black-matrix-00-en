  "en": ""
 },
 {
  "id": "SCENARIO/300/00dda",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/300/00e2c",
  "speaker": 16,
  "jp": [
   "サイファーパンク・・・",
