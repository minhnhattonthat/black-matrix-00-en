   "＜手合わせ＞"
  ],
  "en": "",
  "spill": false
 },
 {
  "id": "SCENARIO/026/00174",
  "speaker": 0,
  "jp": [
   "へー・・・",
   "こんな場所があったなんて"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/001d4",
  "speaker": 16,
  "jp": [
   "軽く運動するには",
   "ちょうどいい場所だろ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/0023a",
  "speaker": 0,
  "jp": [
   "そうね、あたしも少し",
   "肩慣らしがしたいんだけど",
   "どっちか付き合ってくれない？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/0029c",
  "speaker": 0,
  "jp": [
   "カインでもエクサルでも",
   "どちらでもいいわよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/002fc",
  "speaker": 19,
  "jp": [
   "それじゃあ"
  ],
  "en": "",
  "spill": false
 },
 {
  "id": "SCENARIO/026/0030e",
  "jp": "　ボクが相手になるよ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0032c",
  "jp": "　エクサルを推薦する",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00378",
  "speaker": 16,
  "jp": [
   "それじゃあ",
   "ボクが相手になるよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/003c2",
  "speaker": 0,
  "jp": [
   "ええ、お願いするわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/004c4",
  "speaker": 17,
  "jp": [
   "うわぁっ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/0051a",
  "speaker": 0,
  "jp": [
   "勝負あったわね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00588",
  "speaker": 16,
  "jp": [
   "おお～",
   "さすが元僧兵、強いな",
   "あのカインに勝っちまった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/005ea",
  "speaker": 0,
  "jp": [
   "カインはダメね",
   "本番じゃないと実力が出せない",
   "タイプだわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00660",
  "speaker": 16,
  "jp": [
   "うぅ～・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00696",
  "speaker": 0,
  "jp": [
   "でも、あたしもまだまだ",
   "相手に本気を出させることが",
   "出来ないうちは半人前だわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00720",
  "speaker": 16,
  "jp": [
   "へぇ～、格好いいなぁ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00756",
  "speaker": 16,
  "jp": [
   "相手の実力を引き出せないうちは",
   "半人前だなんて、なかなか言える",
   "セリフじゃないぜ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/007d6",
  "speaker": 0,
  "jp": [
   "師匠からの受け売りよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/0081e",
  "speaker": 16,
  "jp": [
   "ボクよりエクサルの方がいいよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00862",
  "speaker": 0,
  "jp": [
   "それじゃあ、カインおすすめの",
   "エクサルにお願いしようかしら？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/008dc",
  "speaker": 16,
  "jp": [
   "別にいいけれど",
   "手加減なんて器用なマネは",
   "出来ないぜ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/0093e",
  "speaker": 0,
  "jp": [
   "あら心外ね",
   "手加減なんて必要ないわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00982",
  "speaker": 0,
  "jp": [
   "それに、手加減が出来ない人との",
   "手合わせだったら、慣れている",
   "から大丈夫"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/009f6",
  "speaker": 16,
  "jp": [
   "じゃ、遠慮無くいくぜ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00a36",
  "speaker": 0,
  "jp": [
   "ええ、こっちも本気でいくわよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00b44",
  "speaker": 17,
  "jp": [
   "うわっ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00b9a",
  "speaker": 0,
  "jp": [
   "勝負あったわね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00c08",
  "speaker": 16,
  "jp": [
   "うわぁ・・・",
   "強いんだね、ステイエン"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00c56",
  "speaker": 0,
  "jp": [
   "あたしなんか",
   "たいしたことないわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00cb4",
  "speaker": 16,
  "jp": [
   "おいおい",
   "そんな風に言われちまったら",
   "負けた俺の立場がないって"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00d1e",
  "speaker": 0,
  "jp": [
   "何言ってるのよ",
   "本気で戦ってなんかいなかった",
   "くせに"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00d7e",
  "speaker": 16,
  "jp": [
   "一応、本気は出したつもりだぜ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00dbe",
  "speaker": 16,
  "jp": [
   "ま、こんな穏やかな中で",
   "死力を尽くせって言われても",
   "無理だけどな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00e2a",
  "speaker": 0,
  "jp": [
   "それもそうね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00e56",
  "speaker": 0,
  "jp": [
   "でも、悔しいわ",
   "腕を上げれば上げるほど",
   "あの人を遠く感じる・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00ed4",
  "speaker": 16,
  "jp": [
   "あの人？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00f06",
  "speaker": 0,
  "jp": [
   "あたしに剣を教えてくれた人",
   "あたしの師匠よ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00f96",
  "speaker": 16,
  "jp": [
   "師匠って、もしかして・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/00fda",
  "speaker": 0,
  "jp": [
   "そうよ、アンタたちも",
   "戦ったことがある、あの人のこと"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01032",
  "speaker": 0,
  "jp": [
   "クレイス様・・・",
   "今頃どうしているのかしら"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01098",
  "speaker": 16,
  "jp": [
   "・・・あのさ、お前もしかして",
   "アイツのこと好きだったとか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/010fe",
  "speaker": 1,
  "jp": [
   "ご、誤解しないでよ！！！",
   "今でも尊敬してるだけ",
   "そういうのじゃないわよ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01176",
  "speaker": 16,
  "jp": [
   "・・・わ、わかったから",
   "そんなに怒るなよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/011ca",
  "speaker": 0,
  "jp": [
   "第一、恋心を抱くには",
   "部下として苦労を味わい過ぎたわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/0123c",
  "speaker": 16,
  "jp": [
   "苦労を味わいすぎた？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/0126c",
  "speaker": 0,
  "jp": [
   "あたしに言わせれば",
   "クレイス様はむしろ、手のかかる",
   "＜兄＞のような存在だったわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/012e6",
  "speaker": 16,
  "jp": [
   "手のかかる、お兄さん？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01318",
  "speaker": 0,
  "jp": [
   "自分に無頓着すぎる人だから",
   "放っておくと大変なのよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01360",
  "speaker": 0,
  "jp": [
   "まず、必要最低限の休息以外の",
   "時間はすべて剣の腕をみがく",
   "ために費やしているし"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/013c4",
  "speaker": 0,
  "jp": [
   "食事だって、栄養に問題なければ",
   "何でもイイとか言って、乾燥した",
   "携帯食とかを食べるのよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01434",
  "speaker": 0,
  "jp": [
   "あんな味気のないものを",
   "主食に出来るのは、",
   "クレイス様だけだと思うわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/014a6",
  "speaker": 16,
  "jp": [
   "うーん、ボクはみんなと",
   "テーブルを囲んでする食事が",
   "一番いいと思うけど"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/0151a",
  "speaker": 0,
  "jp": [
   "あたしもそう思うわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01556",
  "speaker": 3,
  "jp": [
   "クレイス様・・・",
   "たぶん今も、携帯食をかじって",
   "いるんでしょうね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/015ac",
  "speaker": 3,
  "jp": [
   "あたしの代わりに誰かがしっかり",
   "面倒みてくれているといいけれど",
   "大丈夫かしら・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/0163c",
  "speaker": 16,
  "jp": [
   "他人の心配も良いけれど",
   "自分のことも心配しろよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/0168e",
  "speaker": 16,
  "jp": [
   "俺に言わせりゃ、自分の身を",
   "顧みないっていう意味では",
   "アンタも一緒だぜ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01702",
  "speaker": 0,
  "jp": [
   "そうね、あたしも気をつけるけど",
   "一番危ないのはカインじゃない",
   "かしら？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01776",
  "speaker": 16,
  "jp": [
   "あ～確かに一番危なっかしいのは",
   "コイツだよな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/017ce",
  "speaker": 0,
  "jp": [
   "悪魔をかばって死にかけたことが",
   "あるなんて、世界中でもきっと",
   "カイン一人だけよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/0185c",
  "speaker": 16,
  "jp": [
   "うー・・・",
   "そんなこと言われても"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/018a6",
  "speaker": 0,
  "jp": [
   "お互い、無茶はほどほどにね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/018ea",
  "speaker": 16,
  "jp": [
   "うん、ステイエンもだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/0192a",
  "speaker": 0,
  "jp": [
   "ええ、わかってるわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/0196c",
  "speaker": 3,
  "jp": [
   "クレイス様も・・・",
   "どうか無茶はしないで下さいね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01af0",
  "speaker": 0,
  "jp": [
   "入れ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01b30",
  "speaker": 16,
  "jp": [
   "失礼します"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01b62",
  "speaker": 0,
  "jp": [
   "リプサリスか・・・",
   "何の用だ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01baa",
  "speaker": 16,
  "jp": [
   "ええ、お見舞いに参りました",
   "傷の方はいかがですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01c06",
  "speaker": 0,
  "jp": [
   "見舞いに来てもらうほどの",
   "傷ではない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01c56",
  "speaker": 16,
  "jp": [
   "そうですか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01c86",
  "speaker": 16,
  "jp": [
   "ところで、お食事の方は",
   "もう済まされましたか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01cde",
  "speaker": 0,
  "jp": [
   "いや、まだだが、",
   "それがどうかしたのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01d32",
  "speaker": 16,
  "jp": [
   "ええ、御一緒にお食事でも",
   "どうかと思いまして"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01d8a",
  "speaker": 0,
  "jp": [
   "食事なら一人でもとれるだろう",
   "何故、わざわざ一緒に取る",
   "必要がある？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01dfa",
  "speaker": 16,
  "jp": [
   "それはもちろん",
   "貴方の食事が、食事とは呼べない",
   "ものだからですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01e50",
  "speaker": 16,
  "jp": [
   "ステイエンがいなくなって、",
   "また携帯食だけ食べる生活に",
   "戻ってるそうじゃないですか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01ec0",
  "speaker": 0,
  "jp": [
   "栄養面では問題ない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01efa",
  "speaker": 16,
  "jp": [
   "人としては大問題です",
   "まったく、そんなんだから",
   "ステイエンに見限られるんですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01f76",
  "speaker": 0,
  "jp": [
   "別にステイエンには",
   "見限られたわけではなく・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/01fd2",
  "speaker": 16,
  "jp": [
   "さぁ、ベイル様も",
   "お誘いしてありますから",
   "急ぎましょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/02020",
  "speaker": 16,
  "jp": [
   "久々に三人での食事も",
   "悪くないとは思いませんか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/0207a",
  "speaker": 0,
  "jp": [
   "ベイルもいるのか？",
   "あの年中多忙な男が",
   "よく誘いに応じたものだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/020e6",
  "speaker": 16,
  "jp": [
   "ベイル様の場合、放っておくと",
   "食事そのものを怠る方ですからね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/02138",
  "speaker": 16,
  "jp": [
   "お二人には是非とも",
   "時間を割いて楽しむ食事の良さを",
   "覚えていただきたいものですわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/021b6",
  "speaker": 0,
  "jp": [
   "胃に入れば全て同じだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/021f6",
  "speaker": 16,
  "jp": [
   "そんなことを言ったら",
   "料理長が泣きますわよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/02242",
  "speaker": 16,
  "jp": [
   "それに、こんな時だからこそ",
   "信頼おける方々との語らいの",
   "時間は大切なものですわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/022be",
  "speaker": 0,
  "jp": [
   "こんな時・・・",
   "まさか例の計画のことか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/02312",
  "speaker": 16,
  "jp": [
   "食事の場に相応しくない",
   "お話になるかもしれませんが",
   "よろしいでしょうか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/02386",
  "speaker": 0,
  "jp": [
   "・・・わかった、行こう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/05ef0",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/026/05efe",
  "speaker": 0,
  "jp": [
   "ボンジュール"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/026/05f16",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/026/05f26",
