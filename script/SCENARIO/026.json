[
 {
  "id": "SCENARIO/026/000d2",
  "jp": "ボーナスシナリオ　６",
  "en": ""
 },
 {
  "id": "SCENARIO/026/000ea",
  "jp": "＜手合わせ＞",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00174",
  "jp": "へー・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00182",
  "jp": "こんな場所があったなんて",
  "en": ""
 },
 {
  "id": "SCENARIO/026/001d4",
  "jp": "軽く運動するには",
  "en": ""
 },
 {
  "id": "SCENARIO/026/001e8",
  "jp": "ちょうどいい場所だろ？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0023a",
  "jp": "そうね、あたしも少し",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00252",
  "jp": "肩慣らしがしたいんだけど",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0026e",
  "jp": "どっちか付き合ってくれない？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0029c",
  "jp": "カインでもエクサルでも",
  "en": ""
 },
 {
  "id": "SCENARIO/026/002b6",
  "jp": "どちらでもいいわよ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/002fc",
  "jp": "それじゃあ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0030e",
  "jp": "　ボクが相手になるよ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0032c",
  "jp": "　エクサルを推薦する",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00378",
  "jp": "それじゃあ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00386",
  "jp": "ボクが相手になるよ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/003c2",
  "jp": "ええ、お願いするわ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/004c4",
  "jp": "うわぁっ！！！",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0051a",
  "jp": "勝負あったわね",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00588",
  "jp": "おお～",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00592",
  "jp": "さすが元僧兵、強いな",
  "en": ""
 },
 {
  "id": "SCENARIO/026/005aa",
  "jp": "あのカインに勝っちまった",
  "en": ""
 },
 {
  "id": "SCENARIO/026/005ea",
  "jp": "カインはダメね",
  "en": ""
 },
 {
  "id": "SCENARIO/026/005fc",
  "jp": "本番じゃないと実力が出せない",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0061c",
  "jp": "タイプだわ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00660",
  "jp": "うぅ～・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00696",
  "jp": "でも、あたしもまだまだ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/006b0",
  "jp": "相手に本気を出させることが",
  "en": ""
 },
 {
  "id": "SCENARIO/026/006ce",
  "jp": "出来ないうちは半人前だわ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00720",
  "jp": "へぇ～、格好いいなぁ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00756",
  "jp": "相手の実力を引き出せないうちは",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00778",
  "jp": "半人前だなんて、なかなか言える",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0079a",
  "jp": "セリフじゃないぜ？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/007d6",
  "jp": "師匠からの受け売りよ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0081e",
  "jp": "ボクよりエクサルの方がいいよ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00862",
  "jp": "それじゃあ、カインおすすめの",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00882",
  "jp": "エクサルにお願いしようかしら？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/008dc",
  "jp": "別にいいけれど",
  "en": ""
 },
 {
  "id": "SCENARIO/026/008ee",
  "jp": "手加減なんて器用なマネは",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0090a",
  "jp": "出来ないぜ？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0093e",
  "jp": "あら心外ね",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0094c",
  "jp": "手加減なんて必要ないわ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00982",
  "jp": "それに、手加減が出来ない人との",
  "en": ""
 },
 {
  "id": "SCENARIO/026/009a4",
  "jp": "手合わせだったら、慣れている",
  "en": ""
 },
 {
  "id": "SCENARIO/026/009c4",
  "jp": "から大丈夫",
  "en": ""
 },
 {
  "id": "SCENARIO/026/009f6",
  "jp": "じゃ、遠慮無くいくぜ！",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00a36",
  "jp": "ええ、こっちも本気でいくわよ！",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00b44",
  "jp": "うわっ！！！",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00b9a",
  "jp": "勝負あったわね",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00c08",
  "jp": "うわぁ・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00c18",
  "jp": "強いんだね、ステイエン",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00c56",
  "jp": "あたしなんか",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00c66",
  "jp": "たいしたことないわ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00cb4",
  "jp": "おいおい",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00cc0",
  "jp": "そんな風に言われちまったら",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00cde",
  "jp": "負けた俺の立場がないって",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00d1e",
  "jp": "何言ってるのよ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00d30",
  "jp": "本気で戦ってなんかいなかった",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00d50",
  "jp": "くせに",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00d7e",
  "jp": "一応、本気は出したつもりだぜ？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00dbe",
  "jp": "ま、こんな穏やかな中で",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00dd8",
  "jp": "死力を尽くせって言われても",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00df6",
  "jp": "無理だけどな",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00e2a",
  "jp": "それもそうね",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00e56",
  "jp": "でも、悔しいわ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00e68",
  "jp": "腕を上げれば上げるほど",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00e82",
  "jp": "あの人を遠く感じる・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00ed4",
  "jp": "あの人？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00f06",
  "jp": "あたしに剣を教えてくれた人",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00f24",
  "jp": "あたしの師匠よ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00f96",
  "jp": "師匠って、もしかして・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00fda",
  "jp": "そうよ、アンタたちも",
  "en": ""
 },
 {
  "id": "SCENARIO/026/00ff2",
  "jp": "戦ったことがある、あの人のこと",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01032",
  "jp": "クレイス様・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01046",
  "jp": "今頃どうしているのかしら",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01098",
  "jp": "・・・あのさ、お前もしかして",
  "en": ""
 },
 {
  "id": "SCENARIO/026/010b8",
  "jp": "アイツのこと好きだったとか？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/010fe",
  "jp": "ご、誤解しないでよ！！！",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0111a",
  "jp": "今でも尊敬してるだけ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01132",
  "jp": "そういうのじゃないわよ！！",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01176",
  "jp": "・・・わ、わかったから",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01190",
  "jp": "そんなに怒るなよ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/011ca",
  "jp": "第一、恋心を抱くには",
  "en": ""
 },
 {
  "id": "SCENARIO/026/011e2",
  "jp": "部下として苦労を味わい過ぎたわ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0123c",
  "jp": "苦労を味わいすぎた？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0126c",
  "jp": "あたしに言わせれば",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01282",
  "jp": "クレイス様はむしろ、手のかかる",
  "en": ""
 },
 {
  "id": "SCENARIO/026/012a4",
  "jp": "＜兄＞のような存在だったわ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/012e6",
  "jp": "手のかかる、お兄さん？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01318",
  "jp": "自分に無頓着すぎる人だから",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01336",
  "jp": "放っておくと大変なのよ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01360",
  "jp": "まず、必要最低限の休息以外の",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01380",
  "jp": "時間はすべて剣の腕をみがく",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0139e",
  "jp": "ために費やしているし",
  "en": ""
 },
 {
  "id": "SCENARIO/026/013c4",
  "jp": "食事だって、栄養に問題なければ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/013e6",
  "jp": "何でもイイとか言って、乾燥した",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01408",
  "jp": "携帯食とかを食べるのよ？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01434",
  "jp": "あんな味気のないものを",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0144e",
  "jp": "主食に出来るのは、",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01464",
  "jp": "クレイス様だけだと思うわ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/014a6",
  "jp": "うーん、ボクはみんなと",
  "en": ""
 },
 {
  "id": "SCENARIO/026/014c0",
  "jp": "テーブルを囲んでする食事が",
  "en": ""
 },
 {
  "id": "SCENARIO/026/014de",
  "jp": "一番いいと思うけど",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0151a",
  "jp": "あたしもそう思うわ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01556",
  "jp": "クレイス様・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0156a",
  "jp": "たぶん今も、携帯食をかじって",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0158a",
  "jp": "いるんでしょうね",
  "en": ""
 },
 {
  "id": "SCENARIO/026/015ac",
  "jp": "あたしの代わりに誰かがしっかり",
  "en": ""
 },
 {
  "id": "SCENARIO/026/015ce",
  "jp": "面倒みてくれているといいけれど",
  "en": ""
 },
 {
  "id": "SCENARIO/026/015f0",
  "jp": "大丈夫かしら・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0163c",
  "jp": "他人の心配も良いけれど",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01656",
  "jp": "自分のことも心配しろよ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0168e",
  "jp": "俺に言わせりゃ、自分の身を",
  "en": ""
 },
 {
  "id": "SCENARIO/026/016ac",
  "jp": "顧みないっていう意味では",
  "en": ""
 },
 {
  "id": "SCENARIO/026/016c8",
  "jp": "アンタも一緒だぜ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01702",
  "jp": "そうね、あたしも気をつけるけど",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01724",
  "jp": "一番危ないのはカインじゃない",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01744",
  "jp": "かしら？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01776",
  "jp": "あ～確かに一番危なっかしいのは",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01798",
  "jp": "コイツだよな",
  "en": ""
 },
 {
  "id": "SCENARIO/026/017ce",
  "jp": "悪魔をかばって死にかけたことが",
  "en": ""
 },
 {
  "id": "SCENARIO/026/017f0",
  "jp": "あるなんて、世界中でもきっと",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01810",
  "jp": "カイン一人だけよ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0185c",
  "jp": "うー・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0186a",
  "jp": "そんなこと言われても",
  "en": ""
 },
 {
  "id": "SCENARIO/026/018a6",
  "jp": "お互い、無茶はほどほどにね",
  "en": ""
 },
 {
  "id": "SCENARIO/026/018ea",
  "jp": "うん、ステイエンもだよ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0192a",
  "jp": "ええ、わかってるわ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0196c",
  "jp": "クレイス様も・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01982",
  "jp": "どうか無茶はしないで下さいね",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01af0",
  "jp": "入れ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01b30",
  "jp": "失礼します",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01b62",
  "jp": "リプサリスか・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01b78",
  "jp": "何の用だ？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01baa",
  "jp": "ええ、お見舞いに参りました",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01bc8",
  "jp": "傷の方はいかがですか？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01c06",
  "jp": "見舞いに来てもらうほどの",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01c22",
  "jp": "傷ではない",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01c56",
  "jp": "そうですか・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01c86",
  "jp": "ところで、お食事の方は",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01ca0",
  "jp": "もう済まされましたか？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01cde",
  "jp": "いや、まだだが、",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01cf2",
  "jp": "それがどうかしたのか？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01d32",
  "jp": "ええ、御一緒にお食事でも",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01d4e",
  "jp": "どうかと思いまして",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01d8a",
  "jp": "食事なら一人でもとれるだろう",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01daa",
  "jp": "何故、わざわざ一緒に取る",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01dc6",
  "jp": "必要がある？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01dfa",
  "jp": "それはもちろん",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01e0c",
  "jp": "貴方の食事が、食事とは呼べない",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01e2e",
  "jp": "ものだからですよ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01e50",
  "jp": "ステイエンがいなくなって、",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01e6e",
  "jp": "また携帯食だけ食べる生活に",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01e8c",
  "jp": "戻ってるそうじゃないですか",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01ec0",
  "jp": "栄養面では問題ない",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01efa",
  "jp": "人としては大問題です",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01f12",
  "jp": "まったく、そんなんだから",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01f2e",
  "jp": "ステイエンに見限られるんですよ",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01f76",
  "jp": "別にステイエンには",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01f8c",
  "jp": "見限られたわけではなく・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01fd2",
  "jp": "さぁ、ベイル様も",
  "en": ""
 },
 {
  "id": "SCENARIO/026/01fe6",
  "jp": "お誘いしてありますから",
  "en": ""
 },
 {
  "id": "SCENARIO/026/02000",
  "jp": "急ぎましょう",
  "en": ""
 },
 {
  "id": "SCENARIO/026/02020",
  "jp": "久々に三人での食事も",
  "en": ""
 },
 {
  "id": "SCENARIO/026/02038",
  "jp": "悪くないとは思いませんか？",
  "en": ""
 },
 {
  "id": "SCENARIO/026/0207a",
  "jp": "ベイルもいるのか？",
  "en": ""
