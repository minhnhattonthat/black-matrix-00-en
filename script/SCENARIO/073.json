[
 {
  "id": "SCENARIO/073/00040",
  "jp": "ここまでをセーブしますか？",
  "en": ""
 },
 {
  "id": "SCENARIO/073/002f0",
  "jp": "・・・以上で",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00300",
  "jp": "キボートス島への遠征の",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0031a",
  "jp": "報告を終了します",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00352",
  "jp": "ごくろう",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0035e",
  "jp": "お前はもう下がりなさい",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0039e",
  "jp": "はい",
  "en": ""
 },
 {
  "id": "SCENARIO/073/003a6",
  "jp": "それでは失礼します",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00418",
  "jp": "さしたる問題はなさそうだね",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00478",
  "jp": "無論だ",
  "en": ""
 },
 {
  "id": "SCENARIO/073/004dc",
  "jp": "問題はないだと？",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00516",
  "jp": "そうだ",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00546",
  "jp": "ベイル・ペレンデール！",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00578",
  "jp": "貴様がついていながら、",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00592",
  "jp": "我が配下グリシナが傷を負って",
  "en": ""
 },
 {
  "id": "SCENARIO/073/005b2",
  "jp": "戻って来るとは何事だ！！",
  "en": ""
 },
 {
  "id": "SCENARIO/073/005f2",
  "jp": "不必要な戦闘を行い、",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0060a",
  "jp": "勝手に傷を負ったのは",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00622",
  "jp": "奴の責任だ",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00656",
  "jp": "貴様ぁ、",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00662",
  "jp": "よくもグリシナを・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/073/006c0",
  "jp": "見苦しいぞ、レッド・ムフロン",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00708",
  "jp": "何っ！？",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0072c",
  "jp": "ベイルを責める前に",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00742",
  "jp": "我が身さえ守れぬ不甲斐ない",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00760",
  "jp": "己の部下を責めたらどうだ？",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0078c",
  "jp": "補佐官とは名ばかりで",
  "en": ""
 },
 {
  "id": "SCENARIO/073/007a4",
  "jp": "足手まといになる部下など",
  "en": ""
 },
 {
  "id": "SCENARIO/073/007c0",
  "jp": "邪魔なだけだ",
  "en": ""
 },
 {
  "id": "SCENARIO/073/007ee",
  "jp": "部下は私情で選ぶより",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00806",
  "jp": "能力を重視すべきではないのか？",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0084e",
  "jp": "・・・くっ、言わせておけば！",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00892",
  "jp": "私情で部下を選んでいるのは",
  "en": ""
 },
 {
  "id": "SCENARIO/073/008b0",
  "jp": "ルビエル、貴様の方だろう！？",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00906",
  "jp": "・・・リプサリスのことを",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00922",
  "jp": "言っているのか？",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00952",
  "jp": "言っておくが、私のリプサリスを",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00974",
  "jp": "お前のグリシナなどと同じように",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00996",
  "jp": "扱われては困る",
  "en": ""
 },
 {
  "id": "SCENARIO/073/009b8",
  "jp": "私が育て、",
  "en": ""
 },
 {
  "id": "SCENARIO/073/009c6",
  "jp": "鍛えぬいた傑作だ",
  "en": ""
 },
 {
  "id": "SCENARIO/073/009da",
  "jp": "その実力はお前も知っておろう？",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00a22",
  "jp": "・・・・くっ",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00a74",
  "jp": "ダメですよ、ルビエル",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00a8c",
  "jp": "そんなに苛めたら可哀想じゃ",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00aaa",
  "jp": "ないですか",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00ad6",
  "jp": "誰だって自分の大切なモノが",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00af4",
  "jp": "傷つけられたら、誰かに当たり",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00b14",
  "jp": "散らしたくなるものですよ",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00b56",
  "jp": "・・・フン",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00b64",
  "jp": "感情に動かされるなど、高潔なる",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00b86",
  "jp": "天使のあるべき姿ではない",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00bc6",
  "jp": "僕から見れば貴方も十分",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00be0",
  "jp": "感情的な方に見えますけれどね",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00c26",
  "jp": "ほう、面白いことを言う",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00c7a",
  "jp": "私を侮辱するつもりか？",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00c94",
  "jp": "テリオス",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00cd6",
  "jp": "まさか！",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00ce2",
  "jp": "僕に貴方を敵にまわす勇気なんて",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00d04",
  "jp": "ありませんよ",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00d3a",
  "jp": "・・・・フン、どうだか",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00d7a",
  "jp": "そうトゲを出さないで下さい",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00db6",
  "jp": "そもそも僕らは、",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00dca",
  "jp": "つまらない言い争いをするために",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00dec",
  "jp": "集まったわけじゃない",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00e14",
  "jp": "例の計画のために",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00e28",
  "jp": "集まったのですから・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00e6a",
  "jp": "わかっている",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00e9e",
  "jp": "しかし、",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00eaa",
  "jp": "悪魔アラギの討伐のみならず、",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00eca",
  "jp": "新たな＜インセスト＞を発見とは",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00f0a",
  "jp": "一度没落したとはいえ",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00f22",
  "jp": "ペレンデール家の血は想像以上に",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00f44",
  "jp": "優秀だったようですね",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00f94",
  "jp": "血は関係ない",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00fa4",
  "jp": "与えられた責務を全うした",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00fc0",
  "jp": "までのことだ",
  "en": ""
 },
 {
  "id": "SCENARIO/073/00fe8",
  "jp": "フフフ、＜規格外＞のキミを",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01006",
  "jp": "十審将に推薦した僕の判断は",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01024",
  "jp": "間違ってなかったようだ",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01080",
  "jp": "一度や二度の成功で何が計れる？",
  "en": ""
 },
 {
  "id": "SCENARIO/073/010b0",
  "jp": "所詮こやつは＜規格外＞",
  "en": ""
 },
 {
  "id": "SCENARIO/073/010ca",
  "jp": "買いかぶると痛い目にあうぞ",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01100",
  "jp": "ホワイトフェイス",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01114",
  "jp": "貴方は相変わらず＜規格外＞が",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01134",
  "jp": "嫌いのようですね",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0117e",
  "jp": "・・・・フン",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0118e",
  "jp": "私は天使として当たり前の感覚で",
  "en": ""
 },
 {
  "id": "SCENARIO/073/011b0",
  "jp": "物を語っているつもりだ",
  "en": ""
 },
 {
  "id": "SCENARIO/073/011ee",
  "jp": "確かに・・・天使としては",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0120a",
  "jp": "正確な感覚でしょうね",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0123e",
  "jp": "ところで、例の計画の要たる",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0125c",
  "jp": "貴方の実験の方はうまくいって",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0127c",
  "jp": "いるのですか？",
  "en": ""
 },
 {
  "id": "SCENARIO/073/012b2",
  "jp": "無理を言われては困る",
  "en": ""
 },
 {
  "id": "SCENARIO/073/012ca",
  "jp": "肝心の核となる＜インセスト＞が",
  "en": ""
 },
 {
  "id": "SCENARIO/073/012ec",
  "jp": "見つからぬのだからな",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0133e",
  "jp": "＜グレイヘン＞の再来・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0135c",
  "jp": "ですか",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0139c",
  "jp": "早く見つけてもらわねば困る",
  "en": ""
 },
 {
  "id": "SCENARIO/073/013ba",
  "jp": "天使の異形化も、いつまで",
  "en": ""
 },
 {
  "id": "SCENARIO/073/013d6",
  "jp": "覆い隠し続けられるものか・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01410",
  "jp": "数を増やしつつある＜規格外＞",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01430",
  "jp": "そして、＜先祖返り＞・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0145c",
  "jp": "望まれぬ異形の天使の子らは",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0147a",
  "jp": "今や粛正しきれないほど",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01494",
  "jp": "増えつつある",
  "en": ""
 },
 {
  "id": "SCENARIO/073/014e8",
  "jp": "誰も望んで異形に生まれる",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01504",
  "jp": "わけではない",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0153a",
  "jp": "それでも",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01546",
  "jp": "僕ら天使は、生まれながら",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01562",
  "jp": "＜完璧＞でなくてはならない",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01590",
  "jp": "キミのように多くの翼を持つ者",
  "en": ""
 },
 {
  "id": "SCENARIO/073/015c0",
  "jp": "リプサリスのように",
  "en": ""
 },
 {
  "id": "SCENARIO/073/015d6",
  "jp": "生まれつき感覚に欠陥を持つ者",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01604",
  "jp": "何一つ欠けてはいけない・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01624",
  "jp": "それが、天使に求められている",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01644",
  "jp": "理想像だ",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01684",
  "jp": "我が＜プロデヴォン教団＞は、",
  "en": ""
 },
 {
  "id": "SCENARIO/073/016a4",
  "jp": "世界をあるべき姿に正すために",
  "en": ""
 },
 {
  "id": "SCENARIO/073/016c4",
  "jp": "存在する",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0173e",
  "jp": "清浄なる世界のために",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01756",
  "jp": "我ら＜天使十審将＞が存在する",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0178c",
  "jp": "全てはプロデヴォン教団のため",
  "en": ""
 },
 {
  "id": "SCENARIO/073/017ac",
  "jp": "そして、我ら天使の栄光のために",
  "en": ""
 },
 {
  "id": "SCENARIO/073/017f2",
  "jp": "ええ、今は全ての因子が揃うまで",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01814",
  "jp": "我々は我々のすべきことを",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01830",
  "jp": "しましょう・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/073/0185c",
  "jp": "全ての天使たちに福音を",
  "en": ""
 },
 {
  "id": "SCENARIO/073/01944",
  "jp": "白き翼の子らに永遠を・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/073/054b8",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/073/054c6",
  "jp": "ボンジュール",
  "en": ""
 },
 {
  "id": "SCENARIO/073/054de",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/073/054ee",
  "jp": "？？？",
  "en": ""
 }
]