[
 {
  "id": "SCENARIO/073/00040",
  "jp": "ここまでをセーブしますか？",
  "en": ""
 },
 {
  "id": "SCENARIO/073/002f0",
  "speaker": 0,
  "jp": [
   "・・・以上で",
   "キボートス島への遠征の",
   "報告を終了します"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00352",
  "speaker": 16,
  "jp": [
   "ごくろう",
   "お前はもう下がりなさい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/0039e",
  "speaker": 0,
  "jp": [
   "はい",
   "それでは失礼します"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00418",
  "speaker": 0,
  "jp": [
   "さしたる問題はなさそうだね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00478",
  "speaker": 16,
  "jp": [
   "無論だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/004dc",
  "speaker": 0,
  "jp": [
   "問題はないだと？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00516",
  "speaker": 16,
  "jp": [
   "そうだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00546",
  "speaker": 0,
  "jp": [
   "ベイル・ペレンデール！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00578",
  "speaker": 1,
  "jp": [
   "貴様がついていながら、",
   "我が配下グリシナが傷を負って",
   "戻って来るとは何事だ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/005f2",
  "speaker": 16,
  "jp": [
   "不必要な戦闘を行い、",
   "勝手に傷を負ったのは",
   "奴の責任だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00656",
  "speaker": 1,
  "jp": [
   "貴様ぁ、",
   "よくもグリシナを・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/006c0",
  "speaker": 16,
  "jp": [
   "見苦しいぞ、レッド・ムフロン"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00708",
  "speaker": 0,
  "jp": [
   "何っ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/0072c",
  "speaker": 16,
  "jp": [
   "ベイルを責める前に",
   "我が身さえ守れぬ不甲斐ない",
   "己の部下を責めたらどうだ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/0078c",
  "speaker": 16,
  "jp": [
   "補佐官とは名ばかりで",
   "足手まといになる部下など",
   "邪魔なだけだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/007ee",
  "speaker": 16,
  "jp": [
   "部下は私情で選ぶより",
   "能力を重視すべきではないのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/0084e",
  "speaker": 0,
  "jp": [
   "・・・くっ、言わせておけば！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00892",
  "speaker": 1,
  "jp": [
   "私情で部下を選んでいるのは",
   "ルビエル、貴様の方だろう！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00906",
  "speaker": 16,
  "jp": [
   "・・・リプサリスのことを",
   "言っているのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00952",
  "speaker": 16,
  "jp": [
   "言っておくが、私のリプサリスを",
   "お前のグリシナなどと同じように",
   "扱われては困る"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/009b8",
  "speaker": 16,
  "jp": [
   "私が育て、",
   "鍛えぬいた傑作だ",
   "その実力はお前も知っておろう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00a22",
  "speaker": 0,
  "jp": [
   "・・・・くっ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00a74",
  "speaker": 0,
  "jp": [
   "ダメですよ、ルビエル",
   "そんなに苛めたら可哀想じゃ",
   "ないですか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00ad6",
  "speaker": 0,
  "jp": [
   "誰だって自分の大切なモノが",
   "傷つけられたら、誰かに当たり",
   "散らしたくなるものですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00b56",
  "speaker": 16,
  "jp": [
   "・・・フン",
   "感情に動かされるなど、高潔なる",
   "天使のあるべき姿ではない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00bc6",
  "speaker": 0,
  "jp": [
   "僕から見れば貴方も十分",
   "感情的な方に見えますけれどね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00c26",
  "speaker": 16,
  "jp": [
   "ほう、面白いことを言う"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00c7a",
  "speaker": 16,
  "jp": [
   "私を侮辱するつもりか？",
   "テリオス"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00cd6",
  "speaker": 0,
  "jp": [
   "まさか！",
   "僕に貴方を敵にまわす勇気なんて",
   "ありませんよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00d3a",
  "speaker": 16,
  "jp": [
   "・・・・フン、どうだか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00d7a",
  "speaker": 0,
  "jp": [
   "そうトゲを出さないで下さい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00db6",
  "speaker": 0,
  "jp": [
   "そもそも僕らは、",
   "つまらない言い争いをするために",
   "集まったわけじゃない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00e14",
  "speaker": 0,
  "jp": [
   "例の計画のために",
   "集まったのですから・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00e6a",
  "speaker": 16,
  "jp": [
   "わかっている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00e9e",
  "speaker": 0,
  "jp": [
   "しかし、",
   "悪魔アラギの討伐のみならず、",
   "新たな＜インセスト＞を発見とは"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00f0a",
  "speaker": 0,
  "jp": [
   "一度没落したとはいえ",
   "ペレンデール家の血は想像以上に",
   "優秀だったようですね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00f94",
  "speaker": 16,
  "jp": [
   "血は関係ない",
   "与えられた責務を全うした",
   "までのことだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/00fe8",
  "speaker": 0,
  "jp": [
   "フフフ、＜規格外＞のキミを",
   "十審将に推薦した僕の判断は",
   "間違ってなかったようだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/01080",
  "speaker": 16,
  "jp": [
   "一度や二度の成功で何が計れる？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/010b0",
  "speaker": 16,
  "jp": [
   "所詮こやつは＜規格外＞",
   "買いかぶると痛い目にあうぞ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/01100",
  "speaker": 0,
  "jp": [
   "ホワイトフェイス",
   "貴方は相変わらず＜規格外＞が",
   "嫌いのようですね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/0117e",
  "speaker": 16,
  "jp": [
   "・・・・フン",
   "私は天使として当たり前の感覚で",
   "物を語っているつもりだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/011ee",
  "speaker": 0,
  "jp": [
   "確かに・・・天使としては",
   "正確な感覚でしょうね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/0123e",
  "speaker": 0,
  "jp": [
   "ところで、例の計画の要たる",
   "貴方の実験の方はうまくいって",
   "いるのですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/012b2",
  "speaker": 16,
  "jp": [
   "無理を言われては困る",
   "肝心の核となる＜インセスト＞が",
   "見つからぬのだからな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/0133e",
  "speaker": 0,
  "jp": [
   "＜グレイヘン＞の再来・・・",
   "ですか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/0139c",
  "speaker": 16,
  "jp": [
   "早く見つけてもらわねば困る",
   "天使の異形化も、いつまで",
   "覆い隠し続けられるものか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/01410",
  "speaker": 0,
  "jp": [
   "数を増やしつつある＜規格外＞",
   "そして、＜先祖返り＞・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/0145c",
  "speaker": 0,
  "jp": [
   "望まれぬ異形の天使の子らは",
   "今や粛正しきれないほど",
   "増えつつある"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/014e8",
  "speaker": 16,
  "jp": [
   "誰も望んで異形に生まれる",
   "わけではない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/0153a",
  "speaker": 0,
  "jp": [
   "それでも",
   "僕ら天使は、生まれながら",
   "＜完璧＞でなくてはならない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/01590",
  "speaker": 0,
  "jp": [
   "キミのように多くの翼を持つ者"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/015c0",
  "speaker": 0,
  "jp": [
   "リプサリスのように",
   "生まれつき感覚に欠陥を持つ者"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/01604",
  "speaker": 0,
  "jp": [
   "何一つ欠けてはいけない・・・",
   "それが、天使に求められている",
   "理想像だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/01684",
  "speaker": 5,
  "jp": [
   "我が＜プロデヴォン教団＞は、",
   "世界をあるべき姿に正すために",
   "存在する"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/0173e",
  "speaker": 0,
  "jp": [
   "清浄なる世界のために",
   "我ら＜天使十審将＞が存在する"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/0178c",
  "speaker": 5,
  "jp": [
   "全てはプロデヴォン教団のため",
   "そして、我ら天使の栄光のために"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/017f2",
  "speaker": 0,
  "jp": [
   "ええ、今は全ての因子が揃うまで",
   "我々は我々のすべきことを",
   "しましょう・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/0185c",
  "speaker": 5,
  "jp": [
   "全ての天使たちに福音を"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/01944",
  "speaker": 5,
  "jp": [
   "白き翼の子らに永遠を・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/054b8",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/073/054c6",
  "speaker": 5,
  "jp": [
   "ボンジュール"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/073/054de",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/073/054ee",
  "speaker": 5,
  "jp": [
   "？？？"
  ],
  "en": ""
 }
]