  ],
  "en": "Ho ho ho ho..."
 },
 {
  "id": "SCENARIO/305/01370",
  "jp": "カップル・女",
  "en": "Couple (Woman)"
 },
 {
  "id": "SCENARIO/305/01386",
  "speaker": null,
  "jp": [
