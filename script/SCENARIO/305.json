 {
  "id": "SCENARIO/305/013a4",
  "speaker": null,
  "jp": [
   "どっちなのかしら・・・？"
  ],
  "en": "Which is it, I wonder...?"
 },
 {
  "id": "SCENARIO/305/01404",
  "jp": "神父",
