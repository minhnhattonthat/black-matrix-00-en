 {
  "id": "SCENARIO/305/0149c",
  "speaker": null,
  "jp": [
   "貴方も聞きますか？"
  ],
  "en": "Will you listen too?",
  "spill": false
 },
 {
  "id": "SCENARIO/305/014b6",
  "jp": "　はい",
  "en": "Yes"
 },
 {
  "id": "SCENARIO/305/014c4",
  "jp": "　いいえ",
  "en": "No"
 },
 {
  "id": "SCENARIO/305/014d8",
  "speaker": null,
  "jp": [
