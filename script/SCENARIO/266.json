[
 {
  "id": "SCENARIO/266/0012c",
  "speaker": 0,
  "jp": [
   "ねぇねぇカイン",
   "カインは地面の下にこんな場所が",
   "あったって想像してた？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0019e",
  "speaker": 16,
  "jp": [
   "え？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/001ca",
  "speaker": 0,
  "jp": [
   "リリスは色んなことを",
   "想像するのが好きだけど、",
   "本物の世界はもっとすごいんだね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00246",
  "speaker": 16,
  "jp": [
   "そうだね",
   "ボクもビックリしたよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0028e",
  "speaker": 0,
  "jp": [
   "でしょー"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/002b6",
  "speaker": 0,
  "jp": [
   "でもね、リリス怖いの",
   "ここは本物の世界だよね？",
   "夢なんかじゃないよね？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00314",
  "speaker": 0,
  "jp": [
   "すごいことがいっぱいありすぎて",
   "時々リリスは夢を見てるだけなの",
   "かなって怖くなるの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0038a",
  "speaker": 0,
  "jp": [
   "目が覚めたら、ここじゃなくて",
   "まだ牢屋の中だったら嫌だって",
   "思うの・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00416",
  "speaker": 0,
  "jp": [
   "ここは、夢なんかじゃないよね？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00478",
  "speaker": 16,
  "jp": [
   "ええ、大丈夫ですよリリス",
   "ここは現実、見るもの触れるもの",
   "すべて本物ですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/004ee",
  "speaker": 0,
  "jp": [
   "えへへ、良かった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0051e",
  "speaker": 0,
  "jp": [
   "リリス、外の世界はあんまり",
   "知らなかったから、",
   "すごくビックリしてるの！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/005ac",
  "speaker": 16,
  "jp": [
   "うん、ボクも",
   "外の世界は広くて初めてみるもの",
   "ばかりで、すごく新鮮なんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0061a",
  "speaker": 16,
  "jp": [
   "・・・そうだね",
   "今ならヨハネの放浪癖も",
   "少しだけその気持ちがわかるよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/006c2",
  "speaker": 0,
  "jp": [
   "ほう、私の気持ちがわかるとは？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0070a",
  "speaker": 16,
  "jp": [
   "あのね、今までヨハネの放浪癖が",
   "ぜんぜん理解出来なかったんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0076a",
  "speaker": 16,
  "jp": [
   "だって目的もないのに、",
   "フラフラとどこかへ出かける",
   "なんて変だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/007d6",
  "speaker": 0,
  "jp": [
   "そんな風に思われていたのか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00828",
  "speaker": 16,
  "jp": [
   "うん、でも今は違うよ",
   "世界にはボクの知らないことが",
   "たくさんあるのを知ったから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0089a",
  "speaker": 16,
  "jp": [
   "あんなことがなければ・・・",
   "マティアがさらわれ、それを追い",
   "かけて島を飛びださなければ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00908",
  "speaker": 16,
  "jp": [
   "こんな地下に黒羽根が住む世界が",
   "あることだって一生知らなかった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00964",
  "speaker": 0,
  "jp": [
   "そうだな・・・",
   "人も知識も運命も自ら踏み出して",
   "こそ多くの出会う機会を得る"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/009c4",
  "speaker": 0,
  "jp": [
   "求める者には＜引力＞が働くのだ",
   "それは思うだけではなく行動を",
   "ともなってこそ動き出す力"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00a30",
  "speaker": 0,
  "jp": [
   "その力のうねりこそ＜運命＞さえ",
   "もくつがえす、大きな流れなの",
   "かもしれない・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00aae",
  "speaker": 16,
  "jp": [
   "ヨハネはまた難しいことを言う"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00aea",
  "speaker": 16,
  "jp": [
   "・・・でも、今なら少しだけ",
   "わかるような気がするよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00b46",
  "speaker": 0,
  "jp": [
   "そうか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00bc4",
  "speaker": 0,
  "jp": [
   "でも教団もこんな場所に",
   "悪魔達が隠れ住んでるなんて",
   "本当に知らないんでしょうね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00c28",
  "speaker": 0,
  "jp": [
   "知っていたら今頃",
   "殲滅部隊が送り込まれて",
   "大きな争いになってるはずだもの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00c90",
  "speaker": 16,
  "jp": [
   "ここは悪魔にとって最後の場所",
   "どんな根性の腐った悪魔でも",
   "それぐらいは心得ているわよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00cfc",
  "speaker": 16,
  "jp": [
   "秘密を明かせば悪魔族そのものが",
   "滅ぼされかねないわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00d74",
  "speaker": 0,
  "jp": [
   "おいおい、それって",
   "ここの存在を知った俺達は二度と",
   "地上に戻れないとか言うなよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00de0",
  "speaker": 16,
  "jp": [
   "大丈夫よ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00e0a",
  "speaker": 16,
  "jp": [
   "バラしたら、悪魔族全てを敵に",
   "回して、ありとあらゆる報復を",
   "その身に受けて死ぬだけだから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00e8e",
  "speaker": 0,
  "jp": [
   "うわぁ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00ec2",
  "speaker": 16,
  "jp": [
   "でも、どんなにうまく隠れても",
   "天使と悪魔の間にある根本的な",
   "問題は残ったままだわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00f36",
  "speaker": 16,
  "jp": [
   "遠くない未来で再び起こる",
   "天使と悪魔の衝突は、",
   "多分、避けられない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00fc0",
  "speaker": 0,
  "jp": [
   "・・・そんな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/00ff6",
  "speaker": 16,
  "jp": [
   "天使の衰退は目に見えているわ",
   "天使は自分たちを完成形と考え",
   "規格外を認めない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01088",
  "speaker": 0,
  "jp": [
   "ああ、そしてその結果",
   "天使の出生率が低下していった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01100",
  "speaker": 16,
  "jp": [
   "天使は、子供が生まれなく",
   "なっているの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01144",
  "speaker": 0,
  "jp": [
   "羽根のない者達と違い",
   "天使や悪魔は結合を必要としない",
   "むしろそれを＜禁忌＞としている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/011be",
  "speaker": 0,
  "jp": [
   "女に生まれた翼ある者達は",
   "一定の年齢に至れば自らの力で",
   "自らの分身を宿すことが出来る"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01258",
  "speaker": 16,
  "jp": [
   "悪魔も天使ほどではないけれど",
   "出生率が低下してるわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/012ae",
  "speaker": 16,
  "jp": [
   "それより悪魔を悩ませているのは",
   "＜渇き＞という不治の病ね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01304",
  "speaker": 0,
  "jp": [
   "共に斜陽の時代を迎えつつある",
   "天使と悪魔・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0135e",
  "speaker": 16,
  "jp": [
   "どちらにしろ再び戦争が始まれば",
   "天使か悪魔のどちらかは確実に",
   "滅びるでしょうね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/013ec",
  "speaker": 0,
  "jp": [
   "悪魔も天使も",
   "こうやって一緒に話したり",
   "笑い合うことも出来るはずなのに"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01448",
  "speaker": 0,
  "jp": [
   "どうして戦いを繰り返し続ける",
   "のでしょうか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01496",
  "speaker": 0,
  "jp": [
   "もっと、お互いを分かり合えても",
   "いいはずです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01500",
  "speaker": 16,
  "jp": [
   "それは、",
   "口で言うほど簡単な事じゃない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0153c",
  "speaker": 16,
  "jp": [
   "俺達がこうしてつるんでいるのも",
   "利害が一致する間だけの関係だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0159a",
  "speaker": 16,
  "jp": [
   "敵が消えれば、お互い元通りだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/015f8",
  "speaker": 0,
  "jp": [
   "そうとは言い切れまい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0162e",
  "speaker": 0,
  "jp": [
   "手を取り合う切っ掛けは何にせよ",
   "そこで結ばれた＜絆＞は価値ある",
   "ものではないのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/016c8",
  "speaker": 16,
  "jp": [
   "絆？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/016e8",
  "speaker": 0,
  "jp": [
   "そう、理屈では断ち切れぬ＜縁＞",
   "人はそれを＜絆＞と呼ぶ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01734",
  "speaker": 0,
  "jp": [
   "人は、自分が思うほど",
   "非情にはなれないものだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0177c",
  "speaker": 3,
  "jp": [
   "そう、非情になりきれない",
   "そこに弱さがある・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/017f0",
  "speaker": 16,
  "jp": [
   "・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01840",
  "speaker": 16,
  "jp": [
   "＜絆＞かぁ・・・",
   "ヨハネさんって説教くさいけど",
   "時々いいこと言うよな～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/018b2",
  "speaker": 0,
  "jp": [
   "どれも私の言葉ではない",
   "私は書物の中で見かけた言葉を",
   "引用しているにすぎない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01954",
  "speaker": 16,
  "jp": [
   "そうなのかな？",
   "ボクはやっぱりヨハネの言葉なん",
   "だと思うよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/019ac",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/019e6",
  "speaker": 16,
  "jp": [
   "ヨハネはたくさんの本を読んで",
   "たくさんの言葉を知っているから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01a38",
  "speaker": 16,
  "jp": [
   "ヨハネは本で覚えた言葉の中から",
   "自分の気持ちに一番近いものを",
   "引き出してるんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01aa0",
  "speaker": 16,
  "jp": [
   "自分の気持ちをそのまま言葉に",
   "するのが苦手だから、本で覚えた",
   "言葉を借りてるんじゃないかな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01b18",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01b52",
  "speaker": 16,
  "jp": [
   "だから、うまく言えないけど",
   "「自分は冷たい人間だ」みたいに",
   "言わなくてもいいと思うよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01bca",
  "speaker": 16,
  "jp": [
   "ヨハネが自分自身をどう思って",
   "いても、ボクはヨハネがとても",
   "暖かい人だって知ってるから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01c4e",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・ぷっ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01c86",
  "speaker": 0,
  "jp": [
   "くっくっくっくっくっ・・・",
   "あはははははは"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01cf4",
  "speaker": 19,
  "jp": [
   "ヨ、ヨハネさんが！！",
   "声を立てて笑ってる！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01d64",
  "speaker": 16,
  "jp": [
   "ボ、ボク、ヨハネが笑うような",
   "変なこと言ってないよ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01db8",
  "speaker": 0,
  "jp": [
   "くっくっくっくっくっ・・・",
   "あははははははははっ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01e12",
  "speaker": 17,
  "jp": [
   "ヨハネってば！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01e4a",
  "speaker": 0,
  "jp": [
   "・・・いや、すまない",
   "笑うつもりではなかったのだが"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01ea6",
  "speaker": 16,
  "jp": [
   "そうだよ！！",
   "ボクは真面目な気持ちで言った",
   "のに、笑うなんてひどいよ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01f28",
  "speaker": 0,
  "jp": [
   "・・・ああ、すまない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01f50",
  "speaker": 0,
  "jp": [
   "心をくすぐられるというのは",
   "こういうことを言うのだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01fc8",
  "speaker": 16,
  "jp": [
   "おー、いたいた！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/01fec",
  "speaker": 16,
  "jp": [
   "ウンダ様が目を覚ましたんだ",
   "ペインリングの話を聞かせて",
   "くれるってよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/02050",
  "speaker": 0,
  "jp": [
   "それはありがたい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0208a",
  "speaker": 16,
  "jp": [
   "・・・あれ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/020d8",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/02112",
  "speaker": 16,
  "jp": [
   "何でカインの奴",
   "むくれた顔なんかしてるんだ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0216a",
  "speaker": 0,
  "jp": [
   "むくれてなんかいないよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/021aa",
  "speaker": 16,
  "jp": [
   "まいっか",
   "ウンダ様が待っているから",
   "早く来いよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0220e",
  "speaker": 0,
  "jp": [
   "うん、わかった",
   "みんな先に行ってて"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/0226c",
  "speaker": 16,
  "jp": [
   "先にって・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/02294",
  "speaker": 0,
  "jp": [
   "ボクはちょっと",
   "ヨハネと話をしてから行くよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/022ea",
  "speaker": 16,
  "jp": [
   "・・・ふーん、そっか",
   "あんまり遅くなるなよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/02342",
  "speaker": 0,
  "jp": [
   "うん！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/02398",
  "speaker": 16,
  "jp": [
   "・・・ふぅ",
   "いつも一緒にいるはずだったが"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/266/023d4",
  "speaker": 16,
  "jp": [
   "最近では、二人っきりになるのも",
