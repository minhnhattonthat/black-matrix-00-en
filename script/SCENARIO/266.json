[
 {
  "id": "SCENARIO/266/0012c",
  "jp": "ねぇねぇカイン",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0013e",
  "jp": "カインは地面の下にこんな場所が",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00160",
  "jp": "あったって想像してた？",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0019e",
  "jp": "え？",
  "en": ""
 },
 {
  "id": "SCENARIO/266/001ca",
  "jp": "リリスは色んなことを",
  "en": ""
 },
 {
  "id": "SCENARIO/266/001e2",
  "jp": "想像するのが好きだけど、",
  "en": ""
 },
 {
  "id": "SCENARIO/266/001fe",
  "jp": "本物の世界はもっとすごいんだね",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00246",
  "jp": "そうだね",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00252",
  "jp": "ボクもビックリしたよ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0028e",
  "jp": "でしょー",
  "en": ""
 },
 {
  "id": "SCENARIO/266/002b6",
  "jp": "でもね、リリス怖いの",
  "en": ""
 },
 {
  "id": "SCENARIO/266/002ce",
  "jp": "ここは本物の世界だよね？",
  "en": ""
 },
 {
  "id": "SCENARIO/266/002ea",
  "jp": "夢なんかじゃないよね？",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00314",
  "jp": "すごいことがいっぱいありすぎて",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00336",
  "jp": "時々リリスは夢を見てるだけなの",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00358",
  "jp": "かなって怖くなるの",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0038a",
  "jp": "目が覚めたら、ここじゃなくて",
  "en": ""
 },
 {
  "id": "SCENARIO/266/003aa",
  "jp": "まだ牢屋の中だったら嫌だって",
  "en": ""
 },
 {
  "id": "SCENARIO/266/003ca",
  "jp": "思うの・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00416",
  "jp": "ここは、夢なんかじゃないよね？",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00478",
  "jp": "ええ、大丈夫ですよリリス",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00494",
  "jp": "ここは現実、見るもの触れるもの",
  "en": ""
 },
 {
  "id": "SCENARIO/266/004b6",
  "jp": "すべて本物ですよ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/004ee",
  "jp": "えへへ、良かった",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0051e",
  "jp": "リリス、外の世界はあんまり",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0053c",
  "jp": "知らなかったから、",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00552",
  "jp": "すごくビックリしてるの！",
  "en": ""
 },
 {
  "id": "SCENARIO/266/005ac",
  "jp": "うん、ボクも",
  "en": ""
 },
 {
  "id": "SCENARIO/266/005bc",
  "jp": "外の世界は広くて初めてみるもの",
  "en": ""
 },
 {
  "id": "SCENARIO/266/005de",
  "jp": "ばかりで、すごく新鮮なんだ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0061a",
  "jp": "・・・そうだね",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0062c",
  "jp": "今ならヨハネの放浪癖も",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00646",
  "jp": "少しだけその気持ちがわかるよ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/006c2",
  "jp": "ほう、私の気持ちがわかるとは？",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0070a",
  "jp": "あのね、今までヨハネの放浪癖が",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0072c",
  "jp": "ぜんぜん理解出来なかったんだ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0076a",
  "jp": "だって目的もないのに、",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00784",
  "jp": "フラフラとどこかへ出かける",
  "en": ""
 },
 {
  "id": "SCENARIO/266/007a2",
  "jp": "なんて変だよ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/007d6",
  "jp": "そんな風に思われていたのか",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00828",
  "jp": "うん、でも今は違うよ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00840",
  "jp": "世界にはボクの知らないことが",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00860",
  "jp": "たくさんあるのを知ったから",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0089a",
  "jp": "あんなことがなければ・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/266/008b8",
  "jp": "マティアがさらわれ、それを追い",
  "en": ""
 },
 {
  "id": "SCENARIO/266/008da",
  "jp": "かけて島を飛びださなければ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00908",
  "jp": "こんな地下に黒羽根が住む世界が",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0092a",
  "jp": "あることだって一生知らなかった",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00964",
  "jp": "そうだな・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00976",
  "jp": "人も知識も運命も自ら踏み出して",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00998",
  "jp": "こそ多くの出会う機会を得る",
  "en": ""
 },
 {
  "id": "SCENARIO/266/009c4",
  "jp": "求める者には＜引力＞が働くのだ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/009e6",
  "jp": "それは思うだけではなく行動を",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00a06",
  "jp": "ともなってこそ動き出す力",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00a30",
  "jp": "その力のうねりこそ＜運命＞さえ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00a52",
  "jp": "もくつがえす、大きな流れなの",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00a72",
  "jp": "かもしれない・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00aae",
  "jp": "ヨハネはまた難しいことを言う",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00aea",
  "jp": "・・・でも、今なら少しだけ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00b08",
  "jp": "わかるような気がするよ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00b46",
  "jp": "そうか",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00bc4",
  "jp": "でも教団もこんな場所に",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00bde",
  "jp": "悪魔達が隠れ住んでるなんて",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00bfc",
  "jp": "本当に知らないんでしょうね",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00c28",
  "jp": "知っていたら今頃",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00c3c",
  "jp": "殲滅部隊が送り込まれて",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00c56",
  "jp": "大きな争いになってるはずだもの",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00c90",
  "jp": "ここは悪魔にとって最後の場所",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00cb0",
  "jp": "どんな根性の腐った悪魔でも",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00cce",
  "jp": "それぐらいは心得ているわよ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00cfc",
  "jp": "秘密を明かせば悪魔族そのものが",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00d1e",
  "jp": "滅ぼされかねないわ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00d74",
  "jp": "おいおい、それって",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00d8a",
  "jp": "ここの存在を知った俺達は二度と",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00dac",
  "jp": "地上に戻れないとか言うなよ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00de0",
  "jp": "大丈夫よ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00e0a",
  "jp": "バラしたら、悪魔族全てを敵に",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00e2a",
  "jp": "回して、ありとあらゆる報復を",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00e4a",
  "jp": "その身に受けて死ぬだけだから",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00e8e",
  "jp": "うわぁ・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00ec2",
  "jp": "でも、どんなにうまく隠れても",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00ee2",
  "jp": "天使と悪魔の間にある根本的な",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00f02",
  "jp": "問題は残ったままだわ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00f36",
  "jp": "遠くない未来で再び起こる",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00f52",
  "jp": "天使と悪魔の衝突は、",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00f6a",
  "jp": "多分、避けられない",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00fc0",
  "jp": "・・・そんな",
  "en": ""
 },
 {
  "id": "SCENARIO/266/00ff6",
  "jp": "天使の衰退は目に見えているわ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01016",
  "jp": "天使は自分たちを完成形と考え",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01036",
  "jp": "規格外を認めない",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01088",
  "jp": "ああ、そしてその結果",
  "en": ""
 },
 {
  "id": "SCENARIO/266/010a0",
  "jp": "天使の出生率が低下していった",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01100",
  "jp": "天使は、子供が生まれなく",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0111c",
  "jp": "なっているの？",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01144",
  "jp": "羽根のない者達と違い",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0115c",
  "jp": "天使や悪魔は結合を必要としない",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0117e",
  "jp": "むしろそれを＜禁忌＞としている",
  "en": ""
 },
 {
  "id": "SCENARIO/266/011be",
  "jp": "女に生まれた翼ある者達は",
  "en": ""
 },
 {
  "id": "SCENARIO/266/011da",
  "jp": "一定の年齢に至れば自らの力で",
  "en": ""
 },
 {
  "id": "SCENARIO/266/011fa",
  "jp": "自らの分身を宿すことが出来る",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01258",
  "jp": "悪魔も天使ほどではないけれど",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01278",
  "jp": "出生率が低下してるわ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/012ae",
  "jp": "それより悪魔を悩ませているのは",
  "en": ""
 },
 {
  "id": "SCENARIO/266/012d0",
  "jp": "＜渇き＞という不治の病ね",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01304",
  "jp": "共に斜陽の時代を迎えつつある",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01324",
  "jp": "天使と悪魔・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0135e",
  "jp": "どちらにしろ再び戦争が始まれば",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01380",
  "jp": "天使か悪魔のどちらかは確実に",
  "en": ""
 },
 {
  "id": "SCENARIO/266/013a0",
  "jp": "滅びるでしょうね",
  "en": ""
 },
 {
  "id": "SCENARIO/266/013ec",
  "jp": "悪魔も天使も",
  "en": ""
 },
 {
  "id": "SCENARIO/266/013fc",
  "jp": "こうやって一緒に話したり",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01418",
  "jp": "笑い合うことも出来るはずなのに",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01448",
  "jp": "どうして戦いを繰り返し続ける",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01468",
  "jp": "のでしょうか？",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01496",
  "jp": "もっと、お互いを分かり合えても",
  "en": ""
 },
 {
  "id": "SCENARIO/266/014b8",
  "jp": "いいはずです",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01500",
  "jp": "それは、",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0150c",
  "jp": "口で言うほど簡単な事じゃない",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0153c",
  "jp": "俺達がこうしてつるんでいるのも",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0155e",
  "jp": "利害が一致する間だけの関係だ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0159a",
  "jp": "敵が消えれば、お互い元通りだ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/015f8",
  "jp": "そうとは言い切れまい",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0162e",
  "jp": "手を取り合う切っ掛けは何にせよ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01650",
  "jp": "そこで結ばれた＜絆＞は価値ある",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01672",
  "jp": "ものではないのか？",
  "en": ""
 },
 {
  "id": "SCENARIO/266/016c8",
  "jp": "絆？",
  "en": ""
 },
 {
  "id": "SCENARIO/266/016e8",
  "jp": "そう、理屈では断ち切れぬ＜縁＞",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0170a",
  "jp": "人はそれを＜絆＞と呼ぶ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01734",
  "jp": "人は、自分が思うほど",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0174c",
  "jp": "非情にはなれないものだ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/0177c",
  "jp": "そう、非情になりきれない",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01798",
  "jp": "そこに弱さがある・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/266/017f0",
  "jp": "・・・・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01840",
  "jp": "＜絆＞かぁ・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01854",
  "jp": "ヨハネさんって説教くさいけど",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01874",
  "jp": "時々いいこと言うよな～",
  "en": ""
 },
 {
  "id": "SCENARIO/266/018b2",
  "jp": "どれも私の言葉ではない",
  "en": ""
 },
 {
  "id": "SCENARIO/266/018cc",
  "jp": "私は書物の中で見かけた言葉を",
  "en": ""
 },
 {
  "id": "SCENARIO/266/018ec",
  "jp": "引用しているにすぎない",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01954",
  "jp": "そうなのかな？",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01966",
  "jp": "ボクはやっぱりヨハネの言葉なん",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01988",
  "jp": "だと思うよ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/019ac",
  "jp": "・・・・・・・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/266/019e6",
  "jp": "ヨハネはたくさんの本を読んで",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01a06",
  "jp": "たくさんの言葉を知っているから",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01a38",
  "jp": "ヨハネは本で覚えた言葉の中から",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01a5a",
  "jp": "自分の気持ちに一番近いものを",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01a7a",
  "jp": "引き出してるんだよ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01aa0",
  "jp": "自分の気持ちをそのまま言葉に",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01ac0",
  "jp": "するのが苦手だから、本で覚えた",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01ae2",
  "jp": "言葉を借りてるんじゃないかな",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01b18",
  "jp": "・・・・・・・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01b52",
  "jp": "だから、うまく言えないけど",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01b70",
  "jp": "「自分は冷たい人間だ」みたいに",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01b92",
  "jp": "言わなくてもいいと思うよ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01bca",
  "jp": "ヨハネが自分自身をどう思って",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01bea",
  "jp": "いても、ボクはヨハネがとても",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01c0a",
  "jp": "暖かい人だって知ってるから",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01c4e",
  "jp": "・・・・・・・・・ぷっ",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01c86",
  "jp": "くっくっくっくっくっ・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/266/01ca4",
  "jp": "あはははははは",
