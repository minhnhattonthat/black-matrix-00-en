[
 {
  "id": "SCENARIO/327/0018c",
  "speaker": 0,
  "jp": [
   "写本と言えど",
   "これは貴重な資料だ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/001c8",
  "speaker": 0,
  "jp": [
   "それを私に渡して・・",
   "いったい、テリオスは",
   "何を企んでいる？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00232",
  "speaker": 16,
  "jp": [
   "テリオス様の真意を知るのは",
   "テリオス様のみだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/0029e",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/002ec",
  "speaker": 16,
  "jp": [
   "ベイル様",
   "貴方はホワイトフェイスに",
   "命を狙われています"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00338",
  "speaker": 16,
  "jp": [
   "正確にはベイル様の持つ",
   "ペレンデール家に伝わる",
   "ペインリングですが・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/003ae",
  "speaker": 0,
  "jp": [
   "狙われているのは",
   "私だけではないだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/003e8",
  "speaker": 0,
  "jp": [
   "我々の持つ",
   "価値あるペインリングの全てが",
   "ホワイトフェイスに狙われている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00448",
  "speaker": 0,
  "jp": [
   "求めるモノが一つの場所に",
   "集まっている以上"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00496",
  "speaker": 0,
  "jp": [
   "ヤツは必ず",
   "私の前に姿を現す・・・",
   "その時こそ、ヤツをこの手でッ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00508",
  "speaker": 16,
  "jp": [
   "ええ、ですから",
   "我々もあなた方に同行させて",
   "頂きますわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/0056a",
  "speaker": 1,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/005aa",
  "speaker": 16,
  "jp": [
   "ホワイトフェイスに",
   "残された価値あるペインリングを",
   "渡すわけにはいきません"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/0060c",
  "speaker": 16,
  "jp": [
   "ですから、我々は",
   "命をかけてもあなた方を",
   "お守りします"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00680",
  "speaker": 0,
  "jp": [
   "で、でもボク達は",
   "教団の敵のはずじゃ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/006e8",
  "speaker": 16,
  "jp": [
   "お前達を守り通すことが",
   "プロデヴォン教団や教団にすがる",
   "多くの人々を守るというのなら"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00762",
  "speaker": 16,
  "jp": [
   "この剣を",
   "お前達を守る盾に代えるまでだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/007b2",
  "speaker": 0,
  "jp": [
   "・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/007ec",
  "speaker": 16,
  "jp": [
   "それに、お前達の所以外に",
   "ヤツが現れそうな場所など",
   "心当たりがない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00844",
  "speaker": 16,
  "jp": [
   "ホワイトフェイスを討つために",
   "もっとも効率の良い方法を選んだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/008be",
  "speaker": 16,
  "jp": [
   "ただ、それだけのことだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00910",
  "speaker": 0,
  "jp": [
   "それだけって・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/0095c",
  "speaker": 16,
  "jp": [
   "教団のためにも",
   "計画のために犠牲になった",
   "インセスト達のためにも・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/009b8",
  "speaker": 16,
  "jp": [
   "我々は最悪の事態を",
   "迎えるわけにはいかないのです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00a24",
  "speaker": 0,
  "jp": [
   "うん、わかったよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00a60",
  "speaker": 16,
  "jp": [
   "！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00a82",
  "speaker": 16,
  "jp": [
   "本当に、いいのですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00ac2",
  "speaker": 0,
  "jp": [
   "うん",
   "ボク達に断る理由なんてないから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00b12",
  "speaker": 16,
  "jp": [
   "ご理解ありがとうございます"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00b4e",
  "speaker": 16,
  "jp": [
   "しばらくの間ですが",
   "よろしくお願いしますわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00bb4",
  "speaker": 16,
  "jp": [
   "じゃ、俺は",
   "ルカ達呼びに行ってくるから",
   "その間に準備万端にしておけよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00c26",
  "speaker": 0,
  "jp": [
   "うん！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00c68",
  "speaker": 16,
  "jp": [
   "出かけるなら",
   "キロタとリリスの二人を連れて",
   "外に出ろ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00cca",
  "speaker": 0,
  "jp": [
   "え？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00d2e",
  "speaker": 16,
  "jp": [
   "キボートス島は遠いのでしたら",
   "忘れ物があってはいけませんもの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00daa",
  "speaker": 16,
  "jp": [
   "リリス、キロタくん",
   "カインさんのお買い物のお手伝い",
   "お願いできますか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00e30",
  "speaker": 0,
  "jp": [
   "うん！",
   "リリス頑張る！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00e84",
  "speaker": 0,
  "jp": [
   "まかせておいて下さい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00ec4",
  "speaker": 16,
  "jp": [
   "それじゃあ、お願いしますね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00f18",
  "speaker": 3,
  "jp": [
   "買い物ぐらい一人でも",
   "ちゃんと出来るのに・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00f84",
  "speaker": 16,
  "jp": [
   "カイン、行こう！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/00fbe",
  "speaker": 0,
  "jp": [
   "そうだね、行こうか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/01038",
  "speaker": 0,
  "jp": [
   "あああ！",
   "待って下さいよ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/010a4",
  "speaker": 16,
  "jp": [
   "あんな風に露骨にさけては",
   "かえって怪しまれるだけですわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/01118",
  "speaker": 0,
  "jp": [
   "ああ、すまない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/01142",
  "speaker": 16,
  "jp": [
   "何か、カインさん達には",
   "聞かせたくないお話ですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/01190",
  "speaker": 0,
  "jp": [
   "ああ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/011b6",
  "speaker": 0,
  "jp": [
   "私は、ヨハネという人物を",
   "よく知っているわけではないが",
   "どうも、不信感を拭えない・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/0122e",
  "speaker": 16,
  "jp": [
   "仮面で素顔を隠しているような",
   "方でしたから、知らない方には",
   "そうとられても仕方ないですわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/012b2",
  "speaker": 0,
  "jp": [
   "そうではない",
   "私が気にかかるのは",
   "マティアに関することだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/0132a",
  "speaker": 16,
  "jp": [
   "マティアさんのこと・・ですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/01372",
  "speaker": 0,
  "jp": [
   "私は、何故アラギが",
   "キボートス島に向かったのか",
   "ずっと不思議に思っていた"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/013f8",
  "speaker": 16,
  "jp": [
   "そんなの決まってるじゃない",
   "インセストのマティアをさらう",
   "ためにキボートスに向かったのよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/0147e",
  "speaker": 0,
  "jp": [
   "では聞くが、何故アラギは外との",
   "交流が無いような孤島に居る",
   "インセストの存在を知っていた？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/01506",
  "speaker": 16,
  "jp": [
   "それは・・・",
   "それはきっと、誰かから",
   "噂とかで聞いたのよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/01560",
  "speaker": 0,
  "jp": [
   "ほとんど外界との交流のない",
   "小さな島だぞ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/015ae",
  "speaker": 0,
  "jp": [
   "唯一、頻繁に外との行き来を",
   "繰り返していたのは、ただ一人",
   "天使ヨハネだけだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/01638",
  "speaker": 16,
  "jp": [
   "・・おいおい、待てよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/01668",
  "speaker": 17,
  "jp": [
   "ヨハネさんはずっと",
   "カインと一緒にマティアを",
   "助けようとしていたんだぞ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/016d0",
  "speaker": 16,
  "jp": [
   "そのヨハネさんが、どうして",
   "アラギにマティアがさらわれる",
   "ように仕向けるんだよ？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/01740",
  "speaker": 0,
  "jp": [
   "私は彼を信じたいと思うほど",
   "彼のことを知っているわけでは",
   "ない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/01794",
  "speaker": 0,
  "jp": [
   "だからこそ、私の目には",
   "ヨハネを信じていたいと願う",
   "カインの姿が、危うく見える・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/017fc",
  "speaker": 0,
  "jp": [
   "真実を知った結果",
   "ヨハネに裏切られてしまった時",
   "カインは立ち直れるのかと・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/01876",
  "speaker": 16,
  "jp": [
   "それは・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/018aa",
  "speaker": 0,
  "jp": [
   "純粋な者ほど",
   "裏切りを受けた時の反応は",
   "過剰になる・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/018fc",
  "speaker": 0,
  "jp": [
   "ヨハネが裏切り者ではないことを",
   "切に願わずにはいられないな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/0548c",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/327/0549a",
  "speaker": 0,
  "jp": [
   "ボンジュール"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/327/054b2",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/327/054c2",
  "speaker": 0,
  "jp": [
   "？？？"
  ],
  "en": ""
 }
