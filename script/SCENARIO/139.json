  "en": ""
 },
 {
  "id": "SCENARIO/139/00780",
  "speaker": 0,
  "jp": [
   "うーん・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/139/007d0",
  "speaker": 0,
  "jp": [
   "・・あの、",
