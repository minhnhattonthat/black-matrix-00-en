[
 {
  "id": "SCENARIO/139/00118",
  "speaker": 16,
  "jp": [
   "おや、おかえり坊やたち",
   "黒羽根の二人は先に来ているよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/139/0019a",
  "speaker": 0,
  "jp": [
   "おや？珍しいな",
   "いつもなら勝手構わず二人で",
   "出かけてるハズなのに"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/139/00218",
  "speaker": 16,
  "jp": [
   "闇雲に動いているわけじゃない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/139/00264",
  "speaker": 16,
  "jp": [
   "・・・それに、今の俺たちでは",
   "アラギには勝てない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/139/00376",
  "speaker": 0,
  "jp": [
   "アラギの持つ＜ペインリング＞か"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/139/003d0",
  "speaker": 16,
  "jp": [
   "うーん、確かに強敵だな・・",
   "ヤツに対抗するには、",
   "俺たちも力を手に入れないと"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/139/0043c",
  "speaker": 0,
  "jp": [
   "だが、アラギの＜ペインリング＞",
   "に対抗する代物となると",
   "そう簡単には手に入るまい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/139/004e2",
  "speaker": 16,
  "jp": [
   "そうだよなぁ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/139/00530",
  "speaker": 0,
  "jp": [
   "そうだ、クレイスが持っていた",
   "ペインリングはどうかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/139/005a6",
  "speaker": 16,
  "jp": [
   "一時的に相手の魔力を封じる",
   "あのリングのことか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/139/005f4",
  "speaker": 0,
  "jp": [
   "うん、攻撃力はなくても",
   "相手の力を抑え込める能力が",
   "あれば、効果はあると思う"
