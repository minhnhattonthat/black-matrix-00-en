  "en": ""
 },
 {
  "id": "SCENARIO/126/01c64",
  "speaker": 17,
  "jp": [
   "黙れアラギ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/01cac",
  "speaker": 16,
  "jp": [
   "挑発にのるなよザイオン！",
   "ここは、いったん退くぞ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/01d18",
  "speaker": 16,
  "jp": [
   "・・・俺に指図するな！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/01d48",
  "speaker": 21,
  "jp": [
   "おいおい、状況考えろよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/01d7c",
  "speaker": 16,
  "jp": [
   "逃げたいなら",
   "お前一人で勝手に逃げろ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/01dbc",
  "speaker": 21,
  "jp": [
   "パスカの大群を呼ばれたら",
   "いくらお前だってヤバイだろ！？"
