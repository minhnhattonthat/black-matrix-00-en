  "en": ""
 },
 {
  "id": "SCENARIO/126/01e10",
  "speaker": 17,
  "jp": [
   "知るか！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/01e54",
  "speaker": 16,
  "jp": [
   "・・・たく、熱くなりやがって",
   "悪いけど、ここはお前も一緒に",
   "逃げてもらうって決めたからな！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/01efa",
  "speaker": 17,
  "jp": [
   "！！"
