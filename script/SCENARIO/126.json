[
 {
  "id": "SCENARIO/126/0010e",
  "speaker": 16,
  "jp": [
   "アラギ、どこにいる？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00168",
  "speaker": 0,
  "jp": [
   "あっ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0019a",
  "speaker": 16,
  "jp": [
   "お前は・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/001c0",
  "speaker": 19,
  "jp": [
   "前に教団施設から",
   "さらってきたインセストか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00216",
  "speaker": 0,
  "jp": [
   "あの・・・",
   "ありがとうございます"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00262",
  "speaker": 0,
  "jp": [
   "わたしはレアと申します",
   "助けていただき、",
   "本当に感謝しています"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/002de",
  "speaker": 16,
  "jp": [
   "オレはお前を",
   "助けてやった覚えなどない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0032e",
  "speaker": 0,
  "jp": [
   "いいえ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00350",
  "speaker": 0,
  "jp": [
   "貴方は、教団の実験動物でしか",
   "なかったわたしを、外の世界に",
   "連れ出してくれました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/003ce",
  "speaker": 16,
  "jp": [
   "助け出してやったわけじゃない",
   "力を得るために必要だから",
   "さらってきただけだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00430",
  "speaker": 16,
  "jp": [
   "お前らインセストは",
   "オレが生きるための糧でしかない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0048e",
  "speaker": 0,
  "jp": [
   "ええ・・それでも、もう一度",
   "外の世界に触れたいという",
   "わたしの願いは叶えられました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0050e",
  "speaker": 16,
  "jp": [
   "・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0053e",
  "speaker": 16,
  "jp": [
   "おい、お前",
   "アラギを見ていないか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0058a",
  "speaker": 0,
  "jp": [
   "あ、いえ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/005c2",
  "speaker": 19,
  "jp": [
   "パスカの気配もない・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/005ec",
  "speaker": 19,
  "jp": [
   "例の元仲間のところにでも",
   "行ったのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0063e",
  "speaker": 16,
  "jp": [
   "まぁいい",
   "オレには関係ないことだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0068a",
  "speaker": 0,
  "jp": [
   "あの、アベル様・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/006c6",
  "speaker": 16,
  "jp": [
   "力を採り尽くしてしまえば",
   "お前にも用はない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00704",
  "speaker": 16,
  "jp": [
   "それまでは、",
   "自由に外の世界へ",
   "触れることは出来ないままだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00754",
  "speaker": 16,
  "jp": [
   "・・・恨むなら",
   "自分がインセストに生まれて",
   "しまったのを恨むんだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00906",
  "speaker": 0,
  "jp": [
   "・・・・・・はぁ、はぁ、はぁ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0096e",
  "speaker": 1,
  "jp": [
   "げほっ、ごほごほっ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/009aa",
  "speaker": 3,
  "jp": [
   "くっ・・・・・・",
   "ちくしょう！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/009ee",
  "speaker": 3,
  "jp": [
   "・・・発作が前よりひどい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00a52",
  "speaker": 0,
  "jp": [
   "げほげほっ、ごほっ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00aa0",
  "speaker": 17,
  "jp": [
   "ルカ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00ae0",
  "speaker": 1,
  "jp": [
   "！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00b1c",
  "speaker": 16,
  "jp": [
   "勝手に、動き回るな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00b56",
  "speaker": 0,
  "jp": [
   "アタシがどこに行こうと",
   "勝手だろう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00b98",
  "speaker": 16,
  "jp": [
   "どこに行くつもりだ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00bd6",
  "speaker": 1,
  "jp": [
   "うるさいんだよ！",
   "アタシに構うな！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00c52",
  "speaker": 19,
  "jp": [
   "・・・・・・ルカ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00c7c",
  "speaker": 5,
  "jp": [
   "くっくっくっ・・・",
   "ルカは相変わらずだなぁ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00cf8",
  "speaker": 17,
  "jp": [
   "アラギ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00d32",
  "speaker": 0,
  "jp": [
   "あの症状だと",
   "だいぶ進行しているようだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00d86",
  "speaker": 17,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00db2",
  "speaker": 0,
  "jp": [
   "ほっとけば、死ぬぜ？",
   "羽根なしどもを狩ってやったら",
   "どうなんだ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00e08",
  "speaker": 0,
  "jp": [
   "一、二匹切り裂いて血をすすれば",
   "少しは楽になるんだぜ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00e6a",
  "speaker": 16,
  "jp": [
   "ルカの意志だ",
   "あいつは気休めの癒しなどに",
   "すがりつきはしない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00ec4",
  "speaker": 0,
  "jp": [
   "ルカの意志か・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00ee8",
  "speaker": 0,
  "jp": [
   "その意志に背くとしても、",
   "ルカがあの病から助かるとしたら",
   "お前はどうする？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00f5e",
  "speaker": 16,
  "jp": [
   "・・・どういう意味だ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00f9e",
  "speaker": 0,
  "jp": [
   "くっくっくっ・・・",
   "目の色が変わったぜ、ザイオン？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/00fec",
  "speaker": 16,
  "jp": [
   "お前は何を知っている？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0102a",
  "speaker": 0,
  "jp": [
   "＜適合者＞だ・・・",
   "本人と適合する＜インセスト＞の",
   "血と髄でルカは助かる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/01090",
  "speaker": 16,
  "jp": [
   "・・・バカな、",
   "そんな話誰が信じるか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/010de",
  "speaker": 0,
  "jp": [
   "見つけて来たんだぜ",
   "ルカの＜適合者＞"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0112e",
  "speaker": 16,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0115a",
  "speaker": 0,
  "jp": [
   "生白いガキだったな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/01180",
  "speaker": 0,
  "jp": [
   "エンブリオンから",
   "横取りしてやるつもりが",
   "またあの六翼だ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/011ea",
  "speaker": 16,
  "jp": [
   "エンブリオン？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/01214",
  "speaker": 0,
  "jp": [
   "てめーらも見たんだろ？",
   "教会を襲ってた白い化け物だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/01272",
  "speaker": 16,
  "jp": [
   "まさか、リリスとかいうガキを",
   "さらっていった奴らのことか？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/012cc",
  "speaker": 0,
  "jp": [
   "へぇ・・・あのガキ",
   "リリスっていうのか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0131e",
  "speaker": 16,
  "jp": [
   "・・・それを俺に教えて",
   "お前は何を企んでいるんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0137a",
  "speaker": 0,
  "jp": [
   "くっくっくっ・・・",
   "聞きたいのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0147a",
  "speaker": 16,
  "jp": [
   "あれ？",
   "あそこにいるのは・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/014b4",
  "speaker": 17,
  "jp": [
   "おーい、ザイオン！",
   "そんなところで何してるんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/015e0",
  "speaker": 0,
  "jp": [
   "いいか・・・",
   "・・・・・・・・・だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0163c",
  "speaker": 17,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0168e",
  "speaker": 0,
  "jp": [
   "くっくっくっ・・・",
   "後はお前の好きにしな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/016d4",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・くっ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/017c6",
  "speaker": 16,
  "jp": [
   "・・・まさか",
   "一緒にいるのはアラギ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0190c",
  "speaker": 17,
  "jp": [
   "ふざけるな！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/0199c",
  "speaker": 0,
  "jp": [
   "おおっと",
   "怒るなよザイオン"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/019f4",
  "speaker": 17,
  "jp": [
   "大丈夫か、ザイオン！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/01a44",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/01a7e",
  "speaker": 0,
  "jp": [
   "くっくっくっ・・・",
   "お仲間の登場か"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/01abc",
  "speaker": 17,
  "jp": [
   "アラギ、お前は絶対に殺す！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/126/01af4",
  "speaker": 0,
  "jp": [
   "俺にはパスカがいるんだぜ？",
   "お前とその羽根なしの二人で",
   "何が出来るっていうんだよ"
