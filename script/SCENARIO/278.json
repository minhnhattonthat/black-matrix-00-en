  "en": ""
 },
 {
  "id": "SCENARIO/278/01b2e",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01b54",
  "speaker": 16,
  "jp": [
   "何故、こんなものを俺に渡す？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01b8c",
  "speaker": 0,
  "jp": [
   "この私が死ぬようなことがあれば",
   "渡すことが出来なくなってしまう",
   "からだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01be8",
  "speaker": 0,
  "jp": [
   "だから、今ここで渡しておく"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01c2a",
  "speaker": 17,
  "jp": [
   "説明になっていない！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01c58",
  "speaker": 16,
  "jp": [
   "お前はいったい・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01c88",
  "speaker": 0,
  "jp": [
   "私がお前を選んだのは",
   "その疑り深さを信じているからだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01ce6",
  "speaker": 16,
  "jp": [
   "・・・どういう意味だ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01d3c",
  "speaker": 0,
  "jp": [
   "見え見えの芝居にだまされるな",
   "ヤツはまだ生きている・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01d9e",
  "speaker": 16,
  "jp": [
   "！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01de0",
  "speaker": 21,
  "jp": [
   "ザイオン、そこにおるのかい？",
   "ルカが呼んでおるよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01e3c",
  "speaker": 16,
  "jp": [
   "あ、あぁ・・・",
   "今、行く"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01ecc",
  "speaker": 16,
  "jp": [
   "ふふふっ",
   "強引なのは相変わらずのよう",
   "じゃのう・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01f2e",
  "speaker": 0,
  "jp": [
   "昔の貴方ほどではない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01f6a",
  "speaker": 16,
  "jp": [
   "ダーナには会えたようじゃね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01fae",
  "speaker": 0,
  "jp": [
   "あぁ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01fe2",
  "speaker": 16,
  "jp": [
   "カイン・・・",
   "あの子の翼はやはり・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/02024",
  "speaker": 0,
  "jp": [
   "あぁ、そうだ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/0205e",
  "speaker": 16,
  "jp": [
   "翼は踊る・・・",
   "すべては巡り巡る・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/02098",
  "speaker": 16,
  "jp": [
   "全てのインセストに連なる者",
   "最初のインセスト",
   "グレイヘン・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/020ec",
  "speaker": 16,
  "jp": [
   "同じ悲劇が繰り返されないことを",
   "わたしは祈るよ・・"
  ],
  "en": ""
 },
