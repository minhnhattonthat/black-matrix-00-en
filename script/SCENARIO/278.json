  "en": ""
 },
 {
  "id": "SCENARIO/278/01a6e",
  "speaker": 17,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01a8c",
  "speaker": 16,
  "jp": [
   "何故・・・",
   "お前がこんなものを持っている？"
