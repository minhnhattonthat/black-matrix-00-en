[
 {
  "id": "SCENARIO/278/000d0",
  "speaker": 16,
  "jp": [
   "カイン・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/000f8",
  "speaker": 0,
  "jp": [
   "ルカが倒れたって聞いたけど",
   "大丈夫なの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00164",
  "speaker": 16,
  "jp": [
   "今は落ち着いてるけれどね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/001a6",
  "speaker": 0,
  "jp": [
   "そう・・・よかった",
   "でも心配だね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/001f2",
  "speaker": 16,
  "jp": [
   "カイン、あたし思うんだけど、",
   "たぶんルカは、戦い過ぎたんじゃ",
   "ないかしら"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00270",
  "speaker": 0,
  "jp": [
   "戦い過ぎた？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00298",
  "speaker": 16,
  "jp": [
   "あたしね、教団に居た頃に",
   "聞いたことがあるの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/002d8",
  "speaker": 16,
  "jp": [
   "戦いにあけくれる悪魔ほど",
   "それは早くに訪れるって"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00324",
  "speaker": 0,
  "jp": [
   "それ・・・って"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/0037c",
  "speaker": 16,
  "jp": [
   "わたしたちは見てしまいました",
   "ルカさんが、急に苦しみ暴れ出す",
   "姿を・・・あれは、"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00414",
  "speaker": 0,
  "jp": [
   "＜渇き＞じゃよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00464",
  "speaker": 16,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/0049c",
  "speaker": 0,
  "jp": [
   "戦うこと、それは血の匂いとは",
   "離れられない関係じゃ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/004f6",
  "speaker": 0,
  "jp": [
   "血の匂いは＜渇き＞を加速させる",
   "・・・ルカの症状は",
   "ここまで病んでしまったか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/0056e",
  "speaker": 16,
  "jp": [
   "ルカが渇きに狂った悪魔だって",
   "言うの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/005e6",
  "speaker": 0,
  "jp": [
   "ザイオン",
   "これは何度目の発作になる？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00628",
  "speaker": 16,
  "jp": [
   "地上で一度、渇きの発作にかられ",
   "自我を失い欠けたことがある",
   "だが、倒れたのはこれが初めてだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/006a0",
  "speaker": 0,
  "jp": [
   "そうかい、今ならまだ",
   "間に合うかもしれないねぇ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00714",
  "speaker": 16,
  "jp": [
   "間に合うって、ルカの渇きを",
   "癒すことができるのか！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00764",
  "speaker": 0,
  "jp": [
   "渇きを癒す方法はないに等しい",
   "出来るのは戦いから身を遠ざける",
   "ことぐらいじゃ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/007d6",
  "speaker": 0,
  "jp": [
   "それで症状の進行を",
   "遅らせることが出来る"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/0084c",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/008a0",
  "speaker": 0,
  "jp": [
   "アタシはごめんだよ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/008f4",
  "speaker": 16,
  "jp": [
   "ルカ・・・",
   "意識を取り戻したのか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/0093e",
  "speaker": 0,
  "jp": [
   "たとえ渇きが加速してしまっても",
   "アタシはアタシのしたいように",
   "させてもらうよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/009c8",
  "speaker": 16,
  "jp": [
   "死に急いで何になるんですか！？",
   "ルカさんがいなくなったら",
   "皆さん悲しむんですよ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00a4a",
  "speaker": 0,
  "jp": [
   "誰が悲しもうと関係ないよ",
   "アタシの命はアタシのものだ",
   "好きにさせてもらう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00abe",
  "speaker": 16,
  "jp": [
   "そうかもしれません",
   "でも、ご自分の命をもっと大切に",
   "して下さい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00b2a",
  "speaker": 0,
  "jp": [
   "長く生きることだけが正しいと",
   "でも言いたげだけど、命は生きた",
   "長さが全てじゃないよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00b94",
  "speaker": 0,
  "jp": [
   "限られた命だったらなおさら",
   "アタシはいつ死んでもいいように",
   "本音で生きなきゃいけない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00c0e",
  "speaker": 0,
  "jp": [
   "でないと、死んでも",
   "死にきれなくなるからね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00c7c",
  "speaker": 16,
  "jp": [
   "ルカ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00cae",
  "speaker": 0,
  "jp": [
   "なんだい泣きそうな顔して",
   "アンタまでアタシに戦うなとか",
   "言うわけ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00d08",
  "speaker": 19,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": "",
  "spill": false
 },
 {
  "id": "SCENARIO/278/00d22",
  "jp": "　戦い続けるのを反対する",
  "en": ""
 },
 {
  "id": "SCENARIO/278/00d44",
  "jp": "　戦い続けるのを反対しない",
  "en": ""
 },
 {
  "id": "SCENARIO/278/00d8a",
  "speaker": 16,
  "jp": [
   "ボクはこのままルカが",
   "戦い続けるの反対だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00dc8",
  "speaker": 16,
  "jp": [
   "たとえルカの気持ちは",
   "かわらなくても、ボクはルカが",
   "死んでしまうのは嫌だから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00e3a",
  "speaker": 16,
  "jp": [
   "ルカの気持ちを殺すことになって",
   "も、ボクはルカが死ぬところを",
   "見たくない・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00ec0",
  "speaker": 16,
  "jp": [
   "ボクはこのままルカが戦い続ける",
   "ことに反対しないよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00f08",
  "speaker": 16,
  "jp": [
   "ルカはパスカのペインリングに",
   "自分でケリをつけたがっているの",
   "知っているから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/00f7a",
  "speaker": 16,
  "jp": [
   "ルカが死ぬのは嫌だよ・・・",
   "でも、ルカを無理矢理引き止めて",
   "ルカの気持ちを殺すのも嫌なんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01002",
  "speaker": 0,
  "jp": [
   "・・・そう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01020",
  "speaker": 0,
  "jp": [
   "休みたいから、もう一人にさせて",
   "気分が悪いのよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01094",
  "speaker": 16,
  "jp": [
   "でも、誰かついて差し上げるべき",
   "ですわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01100",
  "speaker": 0,
  "jp": [
   "この子のことならわしとザイオン",
   "に任せてくれればええ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01178",
  "speaker": 16,
  "jp": [
   "ルカをよろしくお願いします"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/011b2",
  "speaker": 16,
  "jp": [
   "それから・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/011ea",
  "speaker": 0,
  "jp": [
   "わかっておるよ",
   "あの子は帰るべき場所へ帰ったの",
   "じゃろう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01244",
  "speaker": 16,
  "jp": [
   "・・はい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01276",
  "speaker": 0,
  "jp": [
   "何が幸せなのかは",
   "本人が決める事じゃ・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/012b4",
  "speaker": 0,
  "jp": [
   "本人がそれでいいのなら",
   "それでいいのじゃよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/0130a",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01360",
  "speaker": 16,
  "jp": [
   "・・・あら？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/013a8",
  "speaker": 0,
  "jp": [
   "どうしたの、シリア"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/013e2",
  "speaker": 16,
  "jp": [
   "いえ、リリスの姿が見えなく",
   "なって、さっきまですぐ側に",
   "いたはずなんですが・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01480",
  "speaker": 0,
  "jp": [
   "村の中にいる限りは安全だが",
   "外に飛び出されるとやっかいだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/014e2",
  "speaker": 16,
  "jp": [
   "そうですね",
   "どこにいるのかだけでも",
   "確認しておかないといけませんね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/0156c",
  "speaker": 0,
  "jp": [
   "僕も一緒に捜しに行きます"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/015ae",
  "speaker": 16,
  "jp": [
   "ええ、そうしてくださると",
   "助かりますわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01618",
  "speaker": 0,
  "jp": [
   "二人で捜すより、手の空いてる",
   "者達みんなで捜す方が早いだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01698",
  "speaker": 16,
  "jp": [
   "そうだね",
   "ルカも動けないんだし・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01700",
  "speaker": 0,
  "jp": [
   "わるかったわね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01736",
  "speaker": 16,
  "jp": [
   "大丈夫",
   "きっとすぐに良くなるよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01768",
  "speaker": 16,
  "jp": [
   "だから今は無理しないで",
   "しっかり休んでね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/017ba",
  "speaker": 0,
  "jp": [
   "・・・フン",
   "言われなくても休むわよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/01888",
  "speaker": 16,
  "jp": [
   "子供の足だ・・",
   "そう遠くには行ってないだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/018f0",
  "speaker": 0,
  "jp": [
   "ザイオン",
   "少し、話がある・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/0193a",
  "speaker": 16,
  "jp": [
   "俺にか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/0195c",
  "speaker": 0,
  "jp": [
   "そうだ・・・",
   "お前にコレを渡しておきたい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/019be",
  "speaker": 16,
  "jp": [
   "これは・・・",
   "何のペインリングだ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/278/019fc",
  "speaker": 0,
  "jp": [
   "パスカのペインリングがもたらす",
   "不死の効果を無効化する",
