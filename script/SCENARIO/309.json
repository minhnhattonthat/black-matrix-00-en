 {
  "id": "SCENARIO/309/0052a",
  "speaker": 1,
  "jp": [
   "そんなのわからなくていいわよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/309/00564",
  "speaker": 0,
  "jp": [
   "家族を捨ててまで",
