  ],
  "en": ""
 },
 {
  "id": "SCENARIO/309/00306",
  "speaker": 0,
  "jp": [
   "ここにはキロタもいるのに",
   "姉さんは、あたし達を",
   "置いていくつもりなの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/309/0037a",
  "speaker": 16,
  "jp": [
   "・・・ごめんなさい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/309/003cc",
  "speaker": 0,
  "jp": [
   "謝るくらいなら",
