  "en": ""
 },
 {
  "id": "SCENARIO/349/003a0",
  "jp": "構成員・若者",
  "en": ""
 },
 {
  "id": "SCENARIO/349/003b6",
  "speaker": null,
  "jp": [
   "何かを吹っ切ってきたようだな",
   "まぁいい・・・頑張ってこい",
   "俺に言えるのはそれだけだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/0044c",
  "jp": "ダリア",
  "en": ""
 },
 {
  "id": "SCENARIO/349/0045c",
  "speaker": null,
  "jp": [
   "ふふふ、忘れ物でもしたのかい？",
   "カインは相変わらずだねぇ・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/004c0",
  "jp": "ウェイター",
  "en": ""
 },
 {
  "id": "SCENARIO/349/004d4",
  "speaker": null,
  "jp": [
   "いらっしゃいませ～～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/004f4",
  "speaker": null,
  "jp": [
   "ありゃ？",
   "忘れ物でもしましたか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00554",
  "jp": "剣士の恋人",
  "en": ""
 },
 {
  "id": "SCENARIO/349/00568",
  "speaker": null,
  "jp": [
   "私は村に帰ります",
   "毎日、彼のお墓に花を届けて",
   "毎日、彼のために祈り続けます"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/005c0",
  "speaker": null,
  "jp": [
   "せめて亡骸くらい見つけて",
   "あげたかったけど、"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/005f8",
  "speaker": null,
  "jp": [
   "サンバルテルミが",
   "あの状態では・・・",
   "それも叶わぬ願いです・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/0067c",
  "jp": "中年",
  "en": ""
 },
 {
  "id": "SCENARIO/349/0068a",
  "speaker": null,
  "jp": [
   "ウィ～ック",
   "飲みたきゃのめー！",
   "人間自分に正直が一番だー！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/0071c",
  "jp": "次郎",
  "en": ""
 },
 {
  "id": "SCENARIO/349/0072a",
  "speaker": null,
  "jp": [
   "あなたの人生を反省して下さい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00764",
  "jp": "サル",
  "en": ""
 },
 {
  "id": "SCENARIO/349/00772",
  "speaker": null,
  "jp": [
   "キッキーーーーー！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/007cc",
  "jp": "老人",
  "en": ""
 },
 {
  "id": "SCENARIO/349/007da",
  "speaker": null,
  "jp": [
   "今日と変わらぬ明日がある・・・",
   "幸せとはそういうことじゃ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00854",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/349/00862",
  "speaker": null,
  "jp": [
   "兄貴に相談したら",
   "こき使われるのが嫌なら",
   "経営側の苦労を味わえだってさ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/008b8",
  "speaker": null,
  "jp": [
   "ま、なんとかなりそうだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00918",
  "jp": "老婆の息子",
  "en": ""
 },
 {
  "id": "SCENARIO/349/0092c",
  "speaker": null,
  "jp": [
   "母はよく、ここにいたそうです",
   "今からその母の、墓参りですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00974",
  "speaker": null,
  "jp": [
   "こんなことになるのなら、",
   "お互い意地をはらず、素直に",
   "仲直りすれば良かった・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00a08",
  "jp": "カップル・男",
  "en": ""
 },
 {
  "id": "SCENARIO/349/00a1e",
  "speaker": null,
  "jp": [
   "可愛いだろう～",
   "僕そっくりの女の子なんだ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00a54",
  "speaker": null,
  "jp": [
   "あぁ、僕は今最高に幸せだよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00ab0",
  "jp": "カップル・女",
  "en": ""
 },
 {
  "id": "SCENARIO/349/00ac6",
  "speaker": null,
  "jp": [
   "確信がもてなくて、",
   "ちょっと心配だったんだけど、",
   "この顔は間違いなく彼の子ね！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00b24",
  "speaker": null,
  "jp": [
   "はぁ～、心配して損しちゃった！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00b80",
  "jp": "神父",
  "en": ""
 },
 {
  "id": "SCENARIO/349/00b8e",
  "speaker": null,
  "jp": [
   "＜書＞を読まない子供のために",
   "私が語って聞かせてあげましょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00bd8",
  "speaker": null,
  "jp": [
   "今日は、＜天使のカクセイ＞に",
   "ついて話をしましょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00c18",
  "speaker": null,
  "jp": [
   "貴方も聞きますか？"
  ],
  "en": "",
  "spill": false
 },
 {
  "id": "SCENARIO/349/00c32",
  "jp": "　はい",
  "en": ""
 },
 {
  "id": "SCENARIO/349/00c40",
  "jp": "　いいえ",
  "en": ""
 },
 {
  "id": "SCENARIO/349/00c54",
  "speaker": null,
  "jp": [
   "＜天使のカクセイ＞とは、",
   "後天的に規格外に",
   "なってしまう現象です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00ca4",
  "speaker": null,
  "jp": [
   "大声では言えませんが、",
   "一部の力ある二枚翼の天使に",
   "見られる現象らしいです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00cfc",
  "speaker": null,
  "jp": [
   "二枚だった翼が四枚や六枚に",
   "なってしまうことを言うそう",
   "ですが・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00d50",
  "speaker": null,
  "jp": [
   "規格外はマズイですからね・・・",
   "そんなことになったら、",
   "その天使はおしまいですよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00db0",
  "speaker": null,
  "jp": [
   "ここだけの話、",
   "＜天使のカクセイ＞を抑えるため",
   "成長を止めてる天使もいるとか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00e0c",
  "speaker": null,
  "jp": [
   "あくまでここだけの話ですよ！",
   "よそでしゃべっちゃダメです",
   "からねッ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00e6a",
  "speaker": null,
  "jp": [
   "あなたも毎日＜書＞を読んで、",
   "立派な大人になるんですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00ee0",
  "jp": "男の子",
  "en": ""
 },
 {
  "id": "SCENARIO/349/00ef0",
  "speaker": null,
  "jp": [
   "最近、つまんないんだよなー"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00f14",
  "speaker": null,
  "jp": [
   "なんかさ～、",
   "悪の組織が立ち上がるとか、",
   "スゴイこと起きないかな～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00f98",
  "jp": "女の子",
  "en": ""
 },
 {
  "id": "SCENARIO/349/00fa8",
  "speaker": null,
  "jp": [
   "ママが言っていたわ",
   "少し退屈なくらいの方が",
   "ちょうどいいんだって"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/00ff8",
  "speaker": null,
  "jp": [
   "大人ってつまらないって",
   "思ったけど、いい歳して",
   "日々に刺激を求められても困るわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/01088",
  "jp": "ピエロ",
  "en": ""
 },
 {
  "id": "SCENARIO/349/01098",
  "speaker": null,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/010b4",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/349/010c4",
  "speaker": null,
  "jp": [
   "・・・あの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/010d8",
  "jp": "ピエロ",
  "en": ""
 },
 {
  "id": "SCENARIO/349/010e8",
  "speaker": null,
  "jp": [
   "は、話しかけないでくれ・・・",
   "今ちょっと持病の腰痛が・・・",
   "ウッ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/01170",
  "jp": "兵士",
  "en": ""
 },
 {
  "id": "SCENARIO/349/0117e",
  "speaker": null,
  "jp": [
