 {
  "id": "SCENARIO/349/014f8",
  "speaker": null,
  "jp": [
   "うん、カインの一番は",
   "マティアだって知ってるよ～",
   "・・・でもね、"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/01548",
  "speaker": null,
  "jp": [
   "カインさえよければ",
   "本当にネキンター・カネル団の",
   "一員になってほしいな～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/015a0",
  "speaker": null,
  "jp": [
   "そしたら、僕もプランちゃんも",
   "大喜びなのに・・・"
  ],
  "en": ""
 },
