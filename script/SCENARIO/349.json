  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/01248",
  "speaker": null,
  "jp": [
   "そういうわけで",
   "これをキミにあげるよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/01278",
  "speaker": null,
  "jp": [
   "もう、僕に武器は必要ない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/012be",
  "jp": "兵士",
  "en": ""
 },
 {
  "id": "SCENARIO/349/012cc",
  "speaker": null,
  "jp": [
   "僕に必要なのは"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/012e4",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/349/012f4",
  "speaker": null,
  "jp": [
   "・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/0130c",
  "jp": "兵士",
  "en": ""
 },
 {
  "id": "SCENARIO/349/01320",
  "speaker": null,
  "jp": [
   "プランちゃ～ん！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/01370",
  "jp": "プラン",
  "en": ""
 },
 {
  "id": "SCENARIO/349/01380",
  "speaker": null,
  "jp": [
   "ここでの公演も今日までなの",
   "ふふふ、今日で",
   "カインともお別れよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/013d0",
  "speaker": null,
  "jp": [
   "サヨナラは言わないわ！",
   "あなたの居場所は",
   "ちゃーんと空けておくんだから！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/01428",
  "speaker": null,
  "jp": [
   "だから、忘れないでね！",
   "絶対に、あたし達のこと",
   "忘れないでいてね！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/349/01478",
  "speaker": null,
  "jp": [
   "大好きよ、カイン・・・",
   "いつだって、待ってるから！",
   "また、遊びに来てね"
