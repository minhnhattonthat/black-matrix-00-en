[
 {
  "id": "SCENARIO/047/00138",
  "speaker": 17,
  "jp": [
   "あッ、あんた達っ？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00188",
  "speaker": 0,
  "jp": [
   "ダリアさん・・",
   "ただいま"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/001dc",
  "speaker": 0,
  "jp": [
   "帰ってきたぜ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00212",
  "speaker": 17,
  "jp": [
   "帰ってきたぜ、じゃないよ！",
   "どれだけ心配かければ",
   "気が済むんだい！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00282",
  "speaker": 16,
  "jp": [
   "てっきりもう・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/002be",
  "speaker": 0,
  "jp": [
   "俺だって心配だったんだぞ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/002ec",
  "speaker": 0,
  "jp": [
   "教団がサイファーパンクを",
   "本気で潰そうと動き出したって",
   "聞いたから・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00362",
  "speaker": 16,
  "jp": [
   "ああ、それならもう大丈夫だよ",
   "もうサイファーパンクに戦う",
   "意味はなくなったからね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/003de",
  "speaker": 0,
  "jp": [
   "え？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/0040a",
  "speaker": 16,
  "jp": [
   "サイファーパンクは、",
   "もう・・しまいだよ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00462",
  "speaker": 1,
  "jp": [
   "えええぇぇっ！！？",
   "ど、どういう意味だよ？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/004ba",
  "speaker": 0,
  "jp": [
   "まさか、ヴァルトス様の身に",
   "何かあったんじゃ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00516",
  "speaker": 16,
  "jp": [
   "・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/0054a",
  "speaker": 0,
  "jp": [
   "ダリアさん！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00582",
  "speaker": 16,
  "jp": [
   "サンバルテルミ崩壊後",
   "街に嫌な噂が流れたんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/005ec",
  "speaker": 0,
  "jp": [
   "嫌な噂？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/0061e",
  "speaker": 16,
  "jp": [
   "天使打倒をもくろむ",
   "ずる賢い悪魔の噂さ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00666",
  "speaker": 16,
  "jp": [
   "天使の目を欺き",
   "翼なきか弱き者達を利用する",
   "方法を思いついた悪魔の話さ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/006c4",
  "speaker": 16,
  "jp": [
   "その悪魔は甘い弁舌で人々を",
   "酔わせて、とうとう自分だけの",
   "小さな一軍を築き上げてしまった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/0074a",
  "speaker": 0,
  "jp": [
   "それって、まさか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/0078a",
  "speaker": 16,
  "jp": [
   "その組織の名前は",
   "サイファーパンク"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/007c0",
  "speaker": 16,
  "jp": [
   "悪魔の語る夢物語に魅せられて",
   "教団を天使を討とうした、愚かな",
   "翼なき者達の集まりさ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00858",
  "speaker": 0,
  "jp": [
   "そんな噂話、",
   "嘘に決まってるだろう！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/008aa",
  "speaker": 16,
  "jp": [
   "教団が街に突きつけた要求は",
   "悪魔ヴァルトスの居場所に",
   "関する情報提供と"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00908",
  "speaker": 16,
  "jp": [
   "サイファーパンクがこれまでに",
   "教団施設からさらっていった",
   "子供達の引き渡し"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00976",
  "speaker": 16,
  "jp": [
   "教団の意にそぐわない場合は",
   "サイファーパンクに関わるもの",
   "全てを焼き払うと言ってきたわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/009fa",
  "speaker": 0,
  "jp": [
   "関わるものすべて・・・",
   "まさかっ？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00a4a",
  "speaker": 16,
  "jp": [
   "そう、街ごと全てを焼き払う",
   "＜大粛正＞さ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00b7a",
  "speaker": 16,
  "jp": [
   "そんな・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00bcc",
  "speaker": 0,
  "jp": [
   "お前の故郷キボートスも",
   "一歩間違えば＜大粛正＞を受けて",
   "いたはずだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00c58",
  "speaker": 17,
  "jp": [
   "キボートス島が？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00cb0",
  "speaker": 0,
  "jp": [
   "島に＜世界樹＞があったことに",
   "感謝するのね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00cfe",
  "speaker": 0,
  "jp": [
   "天使は＜世界樹＞を神聖視して",
   "いるから、それが生える島に",
   "火を放つことはないわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00d64",
  "speaker": 0,
  "jp": [
   "本当なら、アラギをいぶり出す",
   "ために焼き払われてもおかしく",
   "なかったわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00dd6",
  "speaker": 16,
  "jp": [
   "そんな・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00ecc",
  "speaker": 0,
  "jp": [
   "おばちゃん",
   "ヴァルトス様は今どこにいる？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00f16",
  "speaker": 0,
  "jp": [
   "まさか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00f4a",
  "speaker": 16,
  "jp": [
   "ここにはいないわ",
   "もう出て行ってしまったから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00fa2",
  "speaker": 1,
  "jp": [
   "！！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/00fd2",
  "speaker": 16,
  "jp": [
   "天使打倒の企てが露見して",
   "逃げ出したんじゃないかって",
   "話だけどね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/0103e",
  "speaker": 1,
  "jp": [
   "違う！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01058",
  "speaker": 1,
  "jp": [
   "ヴァルトス様は",
   "そんなんじゃない！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01146",
  "speaker": 1,
  "jp": [
   "ちょっとエクサル！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/011b4",
  "speaker": 16,
  "jp": [
   "こんな話、一番信じたくないのは",
   "あの子だろうね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01206",
  "speaker": 16,
  "jp": [
   "あの子は誰より",
   "ヴァルトス様を信じている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/0126a",
  "speaker": 0,
  "jp": [
   "・・・信じていても",
   "嘘をつかれることはあるわよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/012c2",
  "speaker": 16,
  "jp": [
   "信じていたいのさ",
   "あの子にとってヴァルトス様は",
   "特別なんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/0133c",
  "speaker": 0,
  "jp": [
   "命の恩人だから？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01376",
  "speaker": 16,
  "jp": [
   "そうだね",
   "でも、それ以上の存在だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/013ba",
  "speaker": 16,
  "jp": [
   "あの子の住んでいた村はね",
   "＜大粛正＞を受けて、天使に",
   "燃やされてしまったんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01436",
  "speaker": 0,
  "jp": [
   "え・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01466",
  "speaker": 16,
  "jp": [
   "あの子は、ヴァルトス様が",
   "炎の中から見つけ出した",
   "唯一の生存者"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/014bc",
  "speaker": 16,
  "jp": [
   "あの子の家族を殺したのは",
   "黒い翼"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/014f0",
  "speaker": 16,
  "jp": [
   "助けを求めるあの子を斬りつけ",
   "村に火を放っていったのは",
   "白い翼"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/0155a",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01596",
  "speaker": 16,
  "jp": [
   "あたしは今、ヴァルトス様は",
   "サイファーパンクを操っていた",
   "凶悪な悪魔だとしか言えない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/0160e",
  "speaker": 16,
  "jp": [
   "この酒場から",
   "そういう情報を流すのが",
   "あたしの役目さ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/0166e",
  "speaker": 0,
  "jp": [
   "じゃあ、ダリアさんは",
   "本当はどう思ってるの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/016c6",
  "speaker": 16,
  "jp": [
   "人に聞く前に、自分の胸に",
   "問いかけたらどうだい？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/0171a",
  "speaker": 3,
  "jp": [
   "・・・・・・"
  ],
  "en": "",
  "spill": false
 },
 {
  "id": "SCENARIO/047/0172e",
  "jp": "　よくわからない",
  "en": ""
 },
 {
  "id": "SCENARIO/047/01748",
  "jp": "　信じたい・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/047/01782",
  "speaker": 0,
  "jp": [
   "よくわからない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/017a4",
  "speaker": 0,
  "jp": [
   "信じられるほど",
   "深いつながりがあったわけじゃ",
   "ないから・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01806",
  "speaker": 0,
  "jp": [
   "でも、エクサルが信じてるなら",
   "ボクも信じたいと思う"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/0184c",
  "speaker": 0,
  "jp": [
   "もし、本当に",
   "みんなをだましていたのなら・・",
   "ボクはヴァルトスさんを許さない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/018c6",
  "speaker": 16,
  "jp": [
   "そうだねぇ、",
   "もしみんなをだましていたのなら",
   "あたしもやっぱり怒るだろうね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01948",
  "speaker": 0,
  "jp": [
   "ボクは信じたい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01976",
  "speaker": 0,
  "jp": [
   "前にヨハネが言ってた",
   "真に人の胸を打つのは",
   "人の胸の内からの言葉だって"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/019d4",
  "speaker": 0,
  "jp": [
   "ヴァルトスさんの言葉が",
   "みんなをだますための",
   "嘘だなんて思えなかった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01a3e",
  "speaker": 0,
  "jp": [
   "だから、信じたいんだと思う"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01a82",
  "speaker": 16,
  "jp": [
   "真実だと思えるだけに",
   "全てが嘘だって言われた時は",
   "きっと辛いだろうね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01af2",
  "speaker": 16,
  "jp": [
   "それに、悔しいって思うだろうね",
   "信じていた人に裏切られるのは",
   "たまらなくやるせないものさ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01b60",
  "speaker": 16,
  "jp": [
   "でも、信じていた人を",
   "信じていいのかわからなくなって",
   "迷ってる間が一番辛いのかもね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01be4",
  "speaker": 16,
  "jp": [
   "あたしはいいけれど",
   "エクサルは今頃、一人で",
   "頭を抱えて沈み込んでるはずだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01c44",
  "speaker": 16,
  "jp": [
   "思い詰めるあまり、",
   "突拍子もない行動に出そうなのが",
   "怖いところだけどねぇ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01ccc",
  "speaker": 0,
  "jp": [
   "だったら、",
   "おバカが暴走しないように",
   "捕まえておけばいいじゃない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01d3a",
  "speaker": 16,
  "jp": [
   "おやおや、話がわかるねぇ",
   "よろしく頼むよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01da0",
  "speaker": 0,
  "jp": [
   "・・・チッ",
   "世話が焼ける"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01de2",
  "speaker": 16,
  "jp": [
   "おや、そういえばヨハネさんの",
   "姿が見えないじゃないか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01e42",
  "speaker": 0,
  "jp": [
   "・・・あいつは"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01e7a",
  "speaker": 16,
  "jp": [
   "いけない保護者だねぇ～",
   "またカインを置いて、どこかに",
   "行っちゃってるのかい？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01f04",
  "speaker": 0,
  "jp": [
   "ヨハネはもう・・",
   "帰ってこないんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01f52",
  "speaker": 16,
  "jp": [
   "え？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01f7e",
  "speaker": 0,
  "jp": [
   "エクサル追いかけてくるね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/01fa8",
  "speaker": 0,
  "jp": [
   "ヴァルトスさんを捜すのなら",
   "バラバラに捜すよりも",
   "一緒に捜した方がきっと早いから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/02062",
  "speaker": 16,
  "jp": [
   "坊や・・・",
   "まさか、ヨハネさんは・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/020c4",
  "speaker": 0,
  "jp": [
   "ダリアさん、",
   "実はヨハネさんは・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/05c3c",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/047/05c4a",
  "speaker": 0,
  "jp": [
   "ボンジュール"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/047/05c62",
  "jp": "カイン",
  "en": ""
 },
 {
