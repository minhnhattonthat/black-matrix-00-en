[
 {
  "id": "SCENARIO/217/00040",
  "jp": "ここまでをセーブしますか？",
  "en": ""
 },
 {
  "id": "SCENARIO/217/001c4",
  "speaker": null,
  "jp": [
   "天地創世のときより、",
   "世界は混沌をはらんでいた"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/217/00222",
  "speaker": null,
  "jp": [
   "白き翼と黒き翼",
   "光と闇",
   "力を持つ者と持たざる者"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/217/00282",
  "speaker": null,
  "jp": [
   "ありとあらゆる相対因子が",
   "憎み合い、奪い合い、殺し合う",
   "計画された世界"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/217/002fa",
  "speaker": null,
  "jp": [
   "互いを削り合う緋色の日々が続き",
   "ひととき勝利を収めた者は"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/217/00362",
  "speaker": null,
  "jp": [
   "自らを天使と名付け",
   "彼（か）の者との約束通り、",
   "成熟の時を迎えた"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/217/003d2",
  "speaker": null,
  "jp": [
   "しかし、擦（す）りあい傷ついた",
   "羽根は地に墜ちて返らず",
   "世界樹とともに減じ始めた"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/217/00452",
  "speaker": null,
  "jp": [
   "そしてまた、",
   "約束の時来る"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/217/0049a",
  "speaker": null,
  "jp": [
   "儚（はかな）くもろい",
   "翼すら持たぬ者達よ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/217/004f2",
  "speaker": null,
  "jp": [
   "未来を託すにはあまりに未成熟"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/217/0053a",
  "speaker": null,
  "jp": [
   "しかし、",
   "能わずとも・・為さねばならぬ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/217/0058e",
  "speaker": null,
  "jp": [
   "幼き魂が触れるには",
   "美しさも醜さも",
   "痛いほどにあふれるこの世界"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/217/005fe",
  "speaker": null,
  "jp": [
   "仮臥（かりぶ）す者の",
   "目覚めの時は近い"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/217/00652",
  "speaker": null,
  "jp": [
   "それまでにカイン"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/217/0068e",
  "speaker": null,
  "jp": [
   "お前は・・・？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/217/04248",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/217/04256",
  "speaker": null,
  "jp": [
   "ボンジュール"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/217/0426e",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/217/0427e",
  "speaker": null,
  "jp": [
   "？？？"
  ],
  "en": ""
 }
]