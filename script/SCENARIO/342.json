  "jp": [
   "天使様ーッ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/0018c",
  "speaker": 17,
  "jp": [
   "あいつはっ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/001ba",
  "speaker": 17,
  "jp": [
   "ダメだ！",
   "そいつに本を渡しちゃいけない！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/002a8",
  "speaker": 16,
  "jp": [
   "天使様！",
   "僕、本持ってきました！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/002dc",
  "speaker": 16,
  "jp": [
   "これでカインを・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00366",
  "speaker": 0,
  "jp": [
   "この本は・・！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00396",
  "speaker": 0,
  "jp": [
   "ハハハハハ・・・",
   "フハハハハハハハッ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/003de",
  "speaker": 0,
  "jp": [
   "少年、礼を言わせてもらおう",
   "お前はよくやった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00438",
  "speaker": 16,
  "jp": [
   "それじゃあ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/0046e",
  "speaker": 0,
  "jp": [
   "クククククッ・・・・",
   "貴様は何をしたのか",
   "わかってないようだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/004da",
  "speaker": 16,
  "jp": [
   "え？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/004f8",
  "speaker": 0,
  "jp": [
   "復讐のために自分の手を汚す",
   "ことさえ出来ない臆病で卑怯な",
   "貴様の願い、叶えてやろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/0056e",
  "speaker": 0,
  "jp": [
   "ただしカインだけではない",
   "お前のせいで、全ての生き物が",
   "等しく死を迎える！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/0060e",
  "speaker": 16,
  "jp": [
   "・・て、天使様？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00638",
  "speaker": 0,
  "jp": [
   "お前は、自分の魂だけではなく",
   "全ての命をこの私に売って",
   "しまったのだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/0069c",
  "speaker": 16,
  "jp": [
   "ど、どういう意味なんですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/006cc",
  "speaker": 16,
  "jp": [
   "ぼ、僕が・・・",
   "何をしたっていうの？！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00710",
  "speaker": 0,
  "jp": [
   "面白い余興が出来た",
   "貴様は最後に殺してやる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00750",
  "speaker": 0,
  "jp": [
   "自分の愚かしさが招いた",
   "とりかえしのつかない事態を",
   "その目に焼き付けさせてやる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/007ca",
  "speaker": 16,
  "jp": [
   "ち、ちがぅ・・・",
   "ぼくはっ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00800",
  "speaker": 0,
  "jp": [
   "ククククッ・・・",
   "愚かなヒトの子の代表として",
   "そこで見ているがいい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/009a4",
  "speaker": 16,
  "jp": [
   "ここは僕が引き受ける",
   "だから、リリスちゃんは逃げて！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00ac6",
  "speaker": 17,
  "jp": [
   "キロタも一緒じゃなきゃ",
   "ダメだよ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00bca",
  "speaker": 16,
  "jp": [
   "大丈夫、僕を信じて",
   "キミは僕が守ってみせるから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00c16",
  "speaker": 21,
  "jp": [
   "待っててね、キロタ！",
   "リリス、みんなを呼んでくる！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00c74",
  "speaker": 0,
  "jp": [
   "実験動物の分際で",
   "私の邪魔をするとは",
   "よほど死にたいらしいな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00cd0",
  "speaker": 16,
  "jp": [
   "死ぬのはお前の方だ！",
   "すぐにみんなが駆けつける"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00d2a",
  "speaker": 0,
  "jp": [
   "それまで、自らが盾となるか・・",
   "だが惜しかったな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00d78",
  "speaker": 22,
  "jp": [
   "きゃぁぁぁぁぁぁっ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00dc8",
  "speaker": 17,
  "jp": [
   "リリスちゃん！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00e7a",
  "speaker": 17,
  "jp": [
   "ぐはっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00eae",
  "speaker": 0,
  "jp": [
   "残念だが、私も一人ではない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00edc",
  "speaker": 0,
  "jp": [
   "エンブリオンのことを",
   "忘れていたようだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00f3c",
  "speaker": 16,
  "jp": [
   "く、こんなとこで・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/00f7a",
  "speaker": 0,
  "jp": [
   "お前に用はない",
   "そこではいつくばっていろ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/0103a",
  "speaker": 17,
  "jp": [
   "ぐぁぁぁぁぁっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/01076",
  "speaker": 0,
  "jp": [
   "最後まで",
   "邪魔がよく入るものだ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/0115a",
  "speaker": 16,
  "jp": [
   "いや・・・来ないで！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/0118c",
  "speaker": 0,
  "jp": [
   "エンブリオンを使って",
   "回収しようとした時は",
   "ベイルに邪魔をされた"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/011e4",
  "speaker": 0,
  "jp": [
   "教団の手に落ちた貴様を",
   "回収しようとした時は、カインに",
   "さらわれた後だった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/01244",
  "speaker": 0,
  "jp": [
   "だが、そのおかげで",
   "他のどのインセストよりも",
   "死の恐怖にさらされつづけた"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/012d0",
  "speaker": 16,
  "jp": [
   "・・こ、来ないで！",
   "殺さないで！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/0131e",
  "speaker": 0,
  "jp": [
   "そうだ・・・もっと恐れを抱け",
   "恐怖しろ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/0135c",
  "speaker": 0,
  "jp": [
   "お前の心を糧に、お前の中で",
   "より強い負の力を宿す",
   "ペインリングが育っているはずだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/013da",
  "speaker": 16,
  "jp": [
   "し、知らない！",
   "リリス、そんなの知らない！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/01420",
  "speaker": 0,
  "jp": [
   "インセストとして捕らえられ",
   "お前は最初に何をされた？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/01480",
  "speaker": 17,
  "jp": [
   "！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/014a0",
  "speaker": 16,
  "jp": [
   "・・・い、いや",
   "痛いのは、怖いのは・・いや、",
   "思い出させないでっ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/01512",
  "speaker": 0,
  "jp": [
   "腹を切り裂かれ、何か",
   "冷たいモノを入れられた・・・",
   "そうだろう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/01568",
  "speaker": 0,
  "jp": [
   "それこそが",
   "私が求める私の最高傑作の",
   "ペインリングだ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/01636",
  "speaker": 17,
  "jp": [
   "！！！！！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/0171a",
  "speaker": 0,
  "jp": [
   "ククク・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/342/01746",
  "speaker": 0,
  "jp": [
   "あとは奴らが持つ",
   "ペインリングさえあれば・・・"
  ],
  "en": ""
 },
