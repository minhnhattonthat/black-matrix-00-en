[
 {
  "id": "SCENARIO/201/000e4",
  "speaker": 0,
  "jp": [
   "渇きがもたらす＜苦痛＞の",
   "真実を知るものは少ない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00150",
  "speaker": 16,
  "jp": [
   "・・・そんな話、信じられない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00196",
  "speaker": 0,
  "jp": [
   "信じられないのは",
   "サイファーパンクに対する不信か"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/001f8",
  "speaker": 0,
  "jp": [
   "それとも、私が",
   "黒羽根を持つ者だからだろうか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00252",
  "speaker": 16,
  "jp": [
   "たぶん、両方だと思います",
   "私は貴方達のことをよく知らない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/002a0",
  "speaker": 16,
  "jp": [
   "まして、サイファーパンクの",
   "リーダーが悪魔だったなんて",
   "初めて知ったところです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00304",
  "speaker": 16,
  "jp": [
   "知っていたら教団だって",
   "貴方達の存在を見逃しはしません"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00366",
  "speaker": 0,
  "jp": [
   "そうだろう",
   "だから私は公に行動を起こす",
   "ことが出来ない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/003d2",
  "speaker": 16,
  "jp": [
   "どうして黒羽根の貴方が",
   "サイファーパンクのリーダー",
   "なんですか！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00494",
  "speaker": 16,
  "jp": [
   "おいっ、ステイエン！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00512",
  "speaker": 0,
  "jp": [
   "何よ！",
   "誰だって不思議に思うわよ！！",
   "だって相手は黒羽根なのよ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00574",
  "speaker": 5,
  "jp": [
   "黒羽根は忌むべき存在・・・",
   "そう思うわけだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/0066e",
  "speaker": 16,
  "jp": [
   "ええ、そうです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/006a6",
  "speaker": 0,
  "jp": [
   "教団の価値観に基づいた",
   "模範的な回答だな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/006fa",
  "speaker": 0,
  "jp": [
   "だが、我々は教団のように",
   "悪魔を生まれつき邪悪な存在",
   "とは考えていない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00760",
  "speaker": 16,
  "jp": [
   "それじゃあ、",
   "教団や天使が悪だとでも？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/007a4",
  "speaker": 0,
  "jp": [
   "天使だから悪だとは思っていない",
   "それは個人の人格を否定した",
   "歪んだ思想だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00804",
  "speaker": 0,
  "jp": [
   "翼の有無や色形ではない",
   "罪を犯せば天使でも悪魔でも",
   "同等に裁きを受けるべきだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00868",
  "speaker": 0,
  "jp": [
   "サイファーパンクが目指すのは",
   "翼の有無や色形に囚われない",
   "人間すべてが対等でいられる世界"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/008f4",
  "speaker": 0,
  "jp": [
   "だからこそ黒羽根の私が",
   "サイファーパンクのリーダーでも",
   "決しておかしいことではないのだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00988",
  "speaker": 16,
  "jp": [
   "そうか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/009be",
  "speaker": 0,
  "jp": [
   "黒羽根の私がサイファーパンクの",
   "リーダーであることに",
   "違和感を感じたのがいい例だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00a24",
  "speaker": 0,
  "jp": [
   "人は自分が思う以上に",
   "翼の有無や色形に囚われて",
   "しまっている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00a78",
  "speaker": 0,
  "jp": [
   "自分自身が何者であるのか",
   "姿形に囚われるあまり",
   "本来の自分を見失ってしまう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00aee",
  "speaker": 16,
  "jp": [
   "自分自身が何者であるのか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00b28",
  "speaker": 0,
  "jp": [
   "人間が既存概念に囚われず",
   "誰もが自由である世界・・",
   "それが、私の望みだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00bc8",
  "speaker": 16,
  "jp": [
   "ヴァルトス様・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00c18",
  "speaker": 0,
  "jp": [
   "さて、私からみんなに提案が",
   "あるのだが"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00c54",
  "speaker": 0,
  "jp": [
   "キミたちを＜特例＞として",
   "正式にサイファーパンクへと",
   "迎え入れたいと思っている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00cce",
  "speaker": 17,
  "jp": [
   "えええええええっ！！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00d22",
  "speaker": 0,
  "jp": [
   "何か不服でもあるのかエクサル？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00d54",
  "speaker": 0,
  "jp": [
   "お前が一番に",
   "彼らを正式入団させて欲しいと",
   "嘆願していたはずだが？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00dc2",
  "speaker": 16,
  "jp": [
   "・・・い、いえその",
   "てっきり叱られるものとばかり",
   "思っていたので"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00e20",
  "speaker": 0,
  "jp": [
   "聞きたいというなら、今ここで",
   "お前の嫌いな説教を始めても",
   "私は一向にかまわないぞ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00e96",
  "speaker": 0,
  "jp": [
   "ずいぶんとまた周囲を困らせて",
   "きたようだからな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00eee",
  "speaker": 17,
  "jp": [
   "うわぁぁぁ！！",
   "説教は後でいいです！",
   "後で！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00f5c",
  "speaker": 0,
  "jp": [
   "・・・ぷっ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00f80",
  "speaker": 0,
  "jp": [
   "クスクス"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/00fc4",
  "speaker": 0,
  "jp": [
   "では耳の痛くなる話は後で",
   "しっかり聞いてもらうとしよう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/01026",
  "speaker": 16,
  "jp": [
   "・・・やっぱり叱られるのか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/0105c",
  "speaker": 0,
  "jp": [
   "キミ達に異存がないのなら",
   "正式にサイファーパンクに",
   "参加して欲しい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/010b4",
  "speaker": 0,
  "jp": [
   "無論、",
   "入団するかしないかはキミらの",
   "意思次第だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/01200",
  "speaker": 0,
  "jp": [
   "お姉ちゃんはどうするの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/01242",
  "speaker": 16,
  "jp": [
   "私は・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/01268",
  "speaker": 0,
  "jp": [
   "僕はここにいたいよ",
   "ここでカインさんたちの力に",
   "なりたい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/012b8",
  "speaker": 0,
  "jp": [
   "僕やリリスちゃんのように、",
   "教団に捕まっている",
   "インセスト達を解放したい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/0132e",
  "speaker": 0,
  "jp": [
   "世界樹に取り込まれて死んだ",
   "あの子のような犠牲者を",
   "これ以上増やしたくないんです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/0139c",
  "speaker": 16,
  "jp": [
   "私は・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/013bc",
  "speaker": 16,
  "jp": [
   "キロタを取り戻したら",
   "教団の手の届かないどこか遠くで",
   "静かに暮らそうと思ってた"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/0142e",
  "speaker": 16,
  "jp": [
   "でも、やっぱりどこかで",
   "「違う！」って心が叫んでる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/01474",
  "speaker": 16,
  "jp": [
   "あたしは自分が見てきたものから",
   "目を背けたくない・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/014ce",
  "speaker": 16,
  "jp": [
   "裏であんなひどいことをしている",
   "教団を、このまま野放しになんか",
   "出来ないわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/01558",
  "speaker": 19,
  "jp": [
   "ボクは・・・"
  ],
  "en": "",
  "spill": false
 },
 {
  "id": "SCENARIO/201/0156c",
  "jp": "　マティアを助けたい",
  "en": ""
 },
 {
  "id": "SCENARIO/201/01588",
  "jp": "　みんなを助けたい",
  "en": ""
 },
 {
  "id": "SCENARIO/201/015c6",
  "speaker": 16,
  "jp": [
   "ボクはマティアを助けたい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/015f0",
  "speaker": 16,
  "jp": [
   "マティア救うためにも",
   "ボクもサイファーパンクで",
   "みんなと共に戦います"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/0167e",
  "speaker": 16,
  "jp": [
   "ボクはみんなを助けたい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/016a8",
  "speaker": 16,
  "jp": [
   "ボクにとって一番大切なのは",
   "マティアを取り戻すこと",
   "その気持ちは今も変わらない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/0170c",
  "speaker": 16,
  "jp": [
   "でも",
   "みんなのために、ボクも",
   "サイファーパンクで戦いたいです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/01788",
  "speaker": 0,
  "jp": [
   "・・・そうか",
   "キミ達の意思は確認させて",
   "もらった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/017d0",
  "speaker": 0,
  "jp": [
   "キミ達には引き続き",
   "インセストと呼ばれる者達を",
   "救出、保護してもらいたい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/01830",
  "speaker": 0,
  "jp": [
   "もちろん、サイファーパンクを",
   "代表する者としてだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/0189c",
  "speaker": 17,
  "jp": [
   "！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/018ca",
  "speaker": 0,
  "jp": [
   "教会の非人道的実験を知った今",
   "それを見逃すわけにはいかない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/01918",
  "speaker": 0,
  "jp": [
   "これからもキミ達の活躍には",
   "期待させてもらおう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/201/01992",
  "speaker": 17,
  "jp": [
   "はい！"
  ],
  "en": ""
 },
