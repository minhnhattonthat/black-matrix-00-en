  "jp": [
   "キシュルルル・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00150",
  "speaker": 16,
  "jp": [
   "我は誓う",
   "我に仇なす者に死を",
   "我ら天使の敵に死を"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/001a0",
  "speaker": 1,
  "jp": [
   "ギシャァ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/001d6",
  "speaker": 17,
  "jp": [
   "不浄なる者よ、滅せよッ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/002ea",
  "speaker": 17,
  "jp": [
   "ギシャァァァァァァッ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00394",
  "speaker": 0,
  "jp": [
   "・・・フン",
   "人の背後にまわり込み",
   "私を討つつもりか、テリオス"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/0041c",
  "speaker": 16,
  "jp": [
   "いえいえ、",
   "貴方の勇ましい戦いぶりに",
   "見とれていただけですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00496",
  "speaker": 0,
  "jp": [
   "フン、今の教団は誰も信用できん",
   "からな・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/004e6",
  "speaker": 0,
  "jp": [
   "今度私の背後に立ってみろ",
   "そのよくまわる舌を",
   "我が魔槍で一突きにしてくれる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/0055e",
  "speaker": 16,
  "jp": [
   "肝に銘じておきますよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/0059a",
  "speaker": 0,
  "jp": [
   "他の施設もエンブリオンに",
   "襲われていたそうだな",
   "状況はどうなっている？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/0060e",
  "speaker": 16,
  "jp": [
   "ここほどの被害ではありませんが",
   "どこもかしこも、壊滅状態ですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00676",
  "speaker": 0,
  "jp": [
   "くっ・・・",
   "いったいなんだというのだ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/006c6",
  "speaker": 1,
  "jp": [
   "何故、天使が異形化する？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/006f4",
  "speaker": 1,
  "jp": [
   "何故、エンブリオンと化した",
   "天使達は教団施設を襲う？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00756",
  "speaker": 16,
  "jp": [
   "異形化したわけじゃない",
   "正確には、僕の予想通り・・・",
   "彼らは異形化させられたんですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/007d6",
  "speaker": 1,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00802",
  "speaker": 0,
  "jp": [
   "まさか・・・",
   "やはり、奴の仕業かっ？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00852",
  "speaker": 16,
  "jp": [
   "そう考えればすべてに納得がいく"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00892",
  "speaker": 16,
  "jp": [
   "我が友セイルズ・ペレンデールの",
   "異形化も・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/008e2",
  "speaker": 16,
  "jp": [
   "何故、エンブリオンが教団施設を",
   "襲うのかも・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00936",
  "speaker": 16,
  "jp": [
   "全ての黒幕はホワイトフェイスだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00976",
  "speaker": 16,
  "jp": [
   "野心の大きい男とは思っていたが",
   "まさか本気でことを起こすとは",
   "あまり信じたくなかったよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/009fa",
  "speaker": 1,
  "jp": [
   "くっ！！",
   "ホワイトフェイスめっ！！",
   "私利私欲に溺れたかっ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00a66",
  "speaker": 16,
  "jp": [
   "この施設を狙ったのは",
   "おそらくベイルのペインリングを",
   "狙ってのことだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00ada",
  "speaker": 0,
  "jp": [
   "万が一、ベイルが永久凍結から",
   "覚醒してしまった時に備えて",
   "数で圧倒しようと考えたワケか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00b5e",
  "speaker": 16,
  "jp": [
   "キミがここに居合わせたのは",
   "まったくもって不幸中の幸いだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00bac",
  "speaker": 16,
  "jp": [
   "ホワイトフェイスにとって",
   "ベイルのペインリングを手に入れ",
   "そびれたのは大きな痛手だろうね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00c32",
  "speaker": 0,
  "jp": [
   "貴様個人のペインリングは",
   "無事だったのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00c86",
  "speaker": 16,
  "jp": [
   "もちろんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00cba",
  "speaker": 0,
  "jp": [
   "上出来だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00cf0",
  "speaker": 0,
  "jp": [
   "しかし、納得がいかない",
   "核となるインセストがいない以上",
   "倒立樹の完成はありえないはずだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00d5c",
  "speaker": 0,
  "jp": [
   "それなのに、なぜ奴は・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00d9e",
  "speaker": 16,
  "jp": [
   "勝算もなく動く男でないこと",
   "だけは確かだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00df2",
  "speaker": 0,
  "jp": [
   "まずは体勢を立て直すことが先決",
   "さすがに私の疲労も限界に近い",
   "からな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00e62",
  "speaker": 16,
  "jp": [
   "おや、意外と賢明な判断を",
   "なされるのですね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00eae",
  "speaker": 16,
  "jp": [
   "貴方のことだから",
   "裏切り者の始末をつけようと",
   "すぐにでも飛び出すのかと・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00f26",
  "speaker": 0,
  "jp": [
   "私は天使を率いる者",
   "十審将法天使",
   "ルビエル・ビッグホーンだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/00f78",
  "speaker": 0,
  "jp": [
   "その名に与えられた",
   "使命と責務の重さぐらい",
   "理解しているつもりだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/010d6",
  "speaker": 1,
  "jp": [
   "ルビエル様！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/0112c",
  "speaker": 16,
  "jp": [
   "・・・何事だ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/01162",
  "speaker": 0,
  "jp": [
   "エンブリオンではない何者かが",
   "この施設内に入り込んだようです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/011ca",
  "speaker": 16,
  "jp": [
   "なんだと？",
   "まさか、ホワイトフェイスか？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/01230",
  "speaker": 0,
  "jp": [
   "この期に及んで",
   "ホワイトフェイス自らが",
   "姿を現すとは思えませんが・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/012a2",
  "speaker": 16,
  "jp": [
   "どちらにしろ",
   "ネズミには違いない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/012e6",
  "speaker": 16,
  "jp": [
   "行くぞ、リプサリス！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/01334",
  "speaker": 0,
  "jp": [
   "はい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/01414",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/01460",
  "speaker": 0,
  "jp": [
   "テリオス様、我々も・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/0149e",
  "speaker": 16,
  "jp": [
   "僕もさっきのエンブリオンとの",
   "戦いで、疲れているのに・・・",
   "仕方がないなぁ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/315/0150e",
