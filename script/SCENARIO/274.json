[
 {
  "id": "SCENARIO/274/00270",
  "jp": "ウンダ",
  "en": ""
 },
 {
  "id": "SCENARIO/274/00280",
  "speaker": null,
  "jp": [
   "あのインセストの少女なら",
   "ようやく意識を取り戻したよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/002e8",
  "jp": "自警団長",
  "en": ""
 },
 {
  "id": "SCENARIO/274/002fa",
  "speaker": null,
  "jp": [
   "慟哭の５５５日戦争・・・",
   "我々も戦場で戦い、",
   "戦って死にたかった・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00350",
  "speaker": null,
  "jp": [
   "だが、戦って死んだところで",
   "我々には何も残せなかっただろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00398",
  "speaker": null,
  "jp": [
   "お前達も戦士なら、忘れるな・・",
   "本当の戦いは生きる中にこそある"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00418",
  "jp": "族長補佐",
  "en": ""
 },
 {
  "id": "SCENARIO/274/0042a",
  "speaker": null,
  "jp": [
   "戦争の時、我々はまだ若く、",
   "身重の女達を守る役目を",
   "与えられた・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/0047c",
  "speaker": null,
  "jp": [
   "戦場に出られず、当時はひどく",
   "すさんだ気持ちでいたが、",
   "今ならわかる・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/004d4",
  "speaker": null,
  "jp": [
   "我々は、悪魔の未来のために",
   "残された命だったのだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00548",
  "jp": "悪魔・少女",
  "en": ""
 },
 {
  "id": "SCENARIO/274/0055c",
  "speaker": null,
  "jp": [
   "わたし達の先祖は、",
   "身重で戦いに出られなかった",
   "女戦士達だったらしいわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/005b0",
  "speaker": null,
  "jp": [
   "だから、わたし達の先祖は、",
   "戦いから逃げた腰抜け達なんか",
   "じゃないのよ・・・絶対に"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00644",
  "jp": "女主人",
  "en": ""
 },
 {
  "id": "SCENARIO/274/00654",
  "speaker": null,
  "jp": [
   "あら、いらっしゃい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00670",
  "speaker": null,
  "jp": [
   "ハメを外さない程度に、",
   "くつろいでいってちょうだい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/006ec",
  "jp": "ウェイトレス",
  "en": ""
 },
 {
  "id": "SCENARIO/274/00702",
  "speaker": null,
  "jp": [
   "いらっしゃいませー♪",
   "あら、坊や・・・",
   "やっぱり、ひとりなのね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00750",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/274/00760",
  "speaker": null,
  "jp": [
   "？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/0076c",
  "jp": "ウェイトレス",
  "en": ""
 },
 {
  "id": "SCENARIO/274/00782",
  "speaker": null,
  "jp": [
   "お連れさんの",
   "仮面を付けた人なんだけど"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/007b4",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/274/007c4",
  "speaker": null,
  "jp": [
   "ヨハネのこと？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/007dc",
  "jp": "ウェイトレス",
  "en": ""
 },
 {
  "id": "SCENARIO/274/007f2",
  "speaker": null,
  "jp": [
   "ええ、そのヨハネさんて人",
   "ひとりで地下通路に入っちゃった",
   "みたいよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00844",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/274/00854",
  "speaker": null,
  "jp": [
   "え、本当？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00868",
  "jp": "ウェイトレス",
  "en": ""
 },
 {
  "id": "SCENARIO/274/0087e",
  "speaker": null,
  "jp": [
   "うん、お姉さんみたもの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/008e0",
  "jp": "ウェイトレス",
  "en": ""
 },
 {
  "id": "SCENARIO/274/008f6",
  "speaker": null,
  "jp": [
   "うふふ、聞いたわよ",
   "あなた、こーんな可愛い顔して、",
   "なかなか腕が立つんですってね？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00958",
  "speaker": null,
  "jp": [
   "ますます気に入っちゃったわ♪"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00988",
  "jp": "ウェイトレス",
  "en": ""
 },
 {
  "id": "SCENARIO/274/0099e",
  "speaker": null,
  "jp": [
   "いらっしゃいませ～♪"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/009bc",
  "speaker": null,
  "jp": [
   "うふふ、可愛いお客様♪",
   "後で姉さんと一緒に遊ぶ？",
   "サービスしてあげるわよ～♪"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00a18",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/274/00a28",
  "speaker": null,
  "jp": [
   "遊ぶって・・・",
   "何して遊ぶの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00a54",
  "jp": "ウェイトレス",
  "en": ""
 },
 {
  "id": "SCENARIO/274/00a6a",
  "speaker": null,
  "jp": [
   "もちろん、イイコトよ♪"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00a8c",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/274/00a9c",
  "speaker": null,
  "jp": [
   "イイコト？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00adc",
  "jp": "ウェイトレス",
  "en": ""
 },
 {
  "id": "SCENARIO/274/00af2",
  "speaker": null,
  "jp": [
   "うーん、後でルカが怖いのよね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00b18",
  "speaker": null,
  "jp": [
   "これ、あげるから・・・",
   "今の話は、二人だけの秘密よ♪"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00bbc",
  "jp": "悪魔・剣士",
  "en": ""
 },
 {
  "id": "SCENARIO/274/00bd0",
  "speaker": null,
  "jp": [
   "実戦に慣れているとは、",
   "意外だったな・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00c08",
  "speaker": null,
  "jp": [
   "地上もまた、地下とかわらぬ",
   "命のやりとりがあるわけか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00c84",
  "jp": "悪魔・中年",
  "en": ""
 },
 {
  "id": "SCENARIO/274/00c98",
  "speaker": null,
  "jp": [
   "げぇ～っぷ、",
   "飲みたいだけ飲んで、",
   "食いたいだけ食って何が悪い？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00d1c",
  "jp": "片翼の天使",
  "en": ""
 },
 {
  "id": "SCENARIO/274/00d30",
  "speaker": null,
  "jp": [
   "グレイヘンは森の木々や小鳥達と",
   "心を通わせ、その歌声は神々の音",
   "とさえ言われる美しさだったとか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00d9c",
  "speaker": null,
  "jp": [
   "そのグレイヘンを死に追いやった",
   "道ならぬ恋とは？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00dd8",
  "speaker": null,
  "jp": [
   "歌いたいのに誰もその本当の詩を",
   "知らない、神々の妙なる調べ",
   "それが＜グレイヘンの哀歌＞"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00e70",
  "jp": "自警団員・男",
  "en": ""
 },
 {
  "id": "SCENARIO/274/00e86",
  "speaker": null,
  "jp": [
   "殺しを極力避ける・・・",
   "そんな甘いことを言えるのは、",
   "単純に我々が強いからだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00ee0",
  "speaker": null,
  "jp": [
   "他の部族の悪魔に比べ、",
   "数でこそ劣るが、個々の戦力は",
   "我々の方が確実に上だからな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00f74",
  "jp": "悪魔・男",
  "en": ""
 },
 {
  "id": "SCENARIO/274/00f86",
  "speaker": null,
  "jp": [
   "あ～、渇くぜ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/00fa4",
  "speaker": null,
  "jp": [
   "あ～違う、",
   "そっちの渇きじゃない・・・",
   "普通にノドが渇いたってだけだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/0102c",
  "jp": "悪魔・女",
  "en": ""
 },
 {
  "id": "SCENARIO/274/0103e",
  "speaker": null,
  "jp": [
   "ここはカルヒンの村よ",
   "他にもフィリオ、ゲルダっていう",
   "集落があるけれど・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/01098",
  "speaker": null,
  "jp": [
   "ゲルダの先祖は快楽に従順で、",
   "勝てない戦いはしたくないと、",
   "地下世界へ逃げ込んだ悪魔達よ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/01100",
  "speaker": null,
  "jp": [
   "今でも地上に出ては、",
   "翼なき者達を殺したり、",
   "略奪行為を楽しんでるみたい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/01158",
  "speaker": null,
  "jp": [
   "ウワサだと、ゲルダでは禁断の",
   "結合によって子供を残すから、",
   "渇きにおかされやすいそうよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/011f0",
  "jp": "自警団員・女",
  "en": ""
 },
 {
  "id": "SCENARIO/274/01206",
  "speaker": null,
  "jp": [
   "そうか、アラギは死んだのか・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/01230",
  "speaker": null,
  "jp": [
   "にわかに信じられないが、",
   "お前達が言うのなら、",
   "本当のことなのだろう・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/012bc",
  "jp": "悪魔・男の子",
  "en": ""
 },
 {
  "id": "SCENARIO/274/012d2",
  "speaker": null,
  "jp": [
   "地上のヤツらって、",
   "生ぬるい環境に甘え腐ったヤツら",
   "ばっかりだと思ってたぜ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/01330",
  "speaker": null,
  "jp": [
   "お前らなら、ヘタな悪魔より",
   "良い戦士になれそうだぜ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/013a4",
  "jp": "悪魔・女の子",
  "en": ""
 },
 {
  "id": "SCENARIO/274/013ba",
  "speaker": null,
  "jp": [
   "サーカスを見にきたはずなのに",
   "アイスばっかに夢中で何にも",
   "見てないみたいなの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/01414",
  "speaker": null,
  "jp": [
   "そんなアイスに夢中なふりを",
   "しなくても、私に照れていること",
   "ぐらいはお見通しなんだから♪"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/014b0",
  "jp": "ピエロ",
  "en": ""
 },
 {
  "id": "SCENARIO/274/014c0",
  "speaker": null,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/014dc",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/274/014ec",
  "speaker": null,
  "jp": [
   "・・・あの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/01500",
  "jp": "ピエロ",
  "en": ""
 },
 {
  "id": "SCENARIO/274/01510",
  "speaker": null,
  "jp": [
   "なんで地下世界にいるのかって？",
   "理由は簡単さ・・・",
   "そこにお客さんがいるからだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/015a4",
  "jp": "プラン",
  "en": ""
 },
 {
  "id": "SCENARIO/274/015b4",
  "speaker": null,
  "jp": [
   "今日も元気に",
   "いらっしゃいませ～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/015fc",
  "jp": "フライ",
  "en": ""
 },
 {
  "id": "SCENARIO/274/0160c",
  "speaker": null,
  "jp": [
   "いらっしゃいませ～",
   "今日も頑張るの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/01658",
  "speaker": null,
  "jp": [
   "レアの具合はどうなんだろう？",
   "ウンダ様に聞いてみよう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/051a4",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/274/051b2",
  "speaker": null,
  "jp": [
   "ボンジュール"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/274/051ca",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/274/051da",
