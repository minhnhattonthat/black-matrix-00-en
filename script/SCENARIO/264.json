[
 {
  "id": "SCENARIO/264/00120",
  "speaker": 0,
  "jp": [
   "ウンダ様は？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/00148",
  "speaker": 16,
  "jp": [
   "奥で休んでいるわ",
   "幸い傷もそんなに酷くなかった",
   "から、すぐによくなりそうよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/001be",
  "speaker": 0,
  "jp": [
   "・・・ルカ、大丈夫？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/001fa",
  "speaker": 16,
  "jp": [
   "大丈夫って何がよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/00228",
  "speaker": 0,
  "jp": [
   "疲れているみたいだから・・・",
   "ルカも少し休んだ方がいいよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/0028a",
  "speaker": 16,
  "jp": [
   "別に疲れてなんか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/002e4",
  "speaker": 0,
  "jp": [
   "自責の念にかられているのなら",
   "なおのこと自分の身体を大切に",
   "した方が良い"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/00352",
  "speaker": 0,
  "jp": [
   "ウンダ殿も自分の看病疲れで",
   "ルカに倒れられては目覚めが",
   "悪いだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/003c2",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/00418",
  "speaker": 0,
  "jp": [
   "そうだよ",
   "せっかく帰ってきたのに",
   "ルカもザイオンも働き過ぎだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/0049c",
  "speaker": 16,
  "jp": [
   "俺達は休むためにここへ",
   "戻ってきたわけじゃない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/004f6",
  "speaker": 0,
  "jp": [
   "でもさ、羽根休めもしないと",
   "肝心なところでぶっ倒れたら",
   "困るだろ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/00550",
  "speaker": 0,
  "jp": [
   "頼りにされてるんだから",
   "他の奴らが代われることなら",
   "他の奴らにまかせておけよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/005ca",
  "speaker": 16,
  "jp": [
   "休息は最低限で良い"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/00606",
  "speaker": 0,
  "jp": [
   "だったらせめてその最低限は",
   "きっちり休んでくれよ",
   "自己管理も戦士の勤めだろ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/0067e",
  "speaker": 16,
  "jp": [
   "それくらいわかっている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/006c6",
  "speaker": 0,
  "jp": [
   "ふう・・・やれやれ",
   "アンタ達も適当に休んでくれよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/00742",
  "speaker": 0,
  "jp": [
   "ペインリングに関する話は",
   "ウンダ様が目を覚ましたら",
   "聞かせてくれるだろうから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/264/007ba",
  "speaker": 16,
  "jp": [
   "うん、それじゃあ少し",
   "休んでおくよ"
  ],
  "en": ""
 },
