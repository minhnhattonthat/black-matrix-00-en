[
 {
  "id": "SCENARIO/142/0011c",
  "speaker": 16,
  "jp": [
   "アラギに逃げられたそうだね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00164",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/0019e",
  "speaker": 16,
  "jp": [
   "＜幽葬の地下通路＞か・・・",
   "噂には聞いていたけれど、",
   "本当にあるとはね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/0020a",
  "speaker": 16,
  "jp": [
   "悪魔達は神出鬼没だけれど",
   "地下通路を使っていたなんて",
   "まるで虫みたいだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00276",
  "speaker": 16,
  "jp": [
   "害虫は早めに退治しておきたい",
   "けれど、うまくいかないものだね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/002f0",
  "speaker": 0,
  "jp": [
   "申し訳ありません"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/0033c",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00376",
  "speaker": 16,
  "jp": [
   "僕はキミたちみたいな",
   "若い力に期待しているんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/003ce",
  "speaker": 0,
  "jp": [
   "期待されようとされまいと",
   "私には関係ない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/0041a",
  "speaker": 0,
  "jp": [
   "私は私の役目を果たすまでだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00450",
  "speaker": 16,
  "jp": [
   "ふふふ",
   "少しはこびを売ることを覚えても",
   "いいと思うんだけどね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/004b2",
  "speaker": 16,
  "jp": [
   "まぁ、いいさ",
   "お疲れ様、ベイル・ペレンデール",
   "引き止めて悪かったね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00522",
  "speaker": 0,
  "jp": [
   "・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00576",
  "speaker": 16,
  "jp": [
   "それにしても＜規格外＞の身で",
   "本当に十審将になるなんて・・",
   "ベイルも本当によく頑張るよね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/005ec",
  "speaker": 0,
  "jp": [
   "実力がありますから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00618",
  "speaker": 16,
  "jp": [
   "・・・確かに"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00638",
  "speaker": 16,
  "jp": [
   "在位している十審将の中で",
   "古のペインリングを完璧に",
   "使いこなせるのは彼ぐらいだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/006a4",
  "speaker": 0,
  "jp": [
   "テリオス様にも無理なのですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/006dc",
  "speaker": 16,
  "jp": [
   "全盛期ならともかく",
   "今では無理だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00722",
  "speaker": 16,
  "jp": [
   "見た目こそ子供のままだけど",
   "僕もずいぶんと老齢だからね",
   "加齢による力の衰えは免れないよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00798",
  "speaker": 0,
  "jp": [
   "・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/007ce",
  "speaker": 16,
  "jp": [
   "キミには引き続きアラギの討伐を",
   "よろしく頼むよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00818",
  "speaker": 0,
  "jp": [
   "はい、了解しました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00852",
  "speaker": 16,
  "jp": [
   "それと、めずらしく悩み事でも",
   "抱えているみたいだけど、",
   "どうしたの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/008d0",
  "speaker": 0,
  "jp": [
   "！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/0090c",
  "speaker": 16,
  "jp": [
   "フフフ、",
   "他の人間は誤魔化せても",
   "僕の目は誤魔化せないよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00972",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/009ae",
  "speaker": 16,
  "jp": [
   "迷いは剣を鈍くする・・・",
   "キミの口癖だったね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/009f0",
  "speaker": 16,
  "jp": [
   "キミが何に気をとられているのか",
   "知らないけれど、キミが正しいと",
   "思うことなら突き進めばいい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00a60",
  "speaker": 16,
  "jp": [
   "たとえキミが僕を裏切ることに",
   "なったとしても、それがキミの",
   "正義だというのだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00ade",
  "speaker": 0,
  "jp": [
   "確かに私は迷っています・・",
   "ですが、私はあの日の誓いを",
   "違えることはないです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00b40",
  "speaker": 0,
  "jp": [
   "私は貴方を守る盾",
   "貴方を守るためならば、世界を",
   "敵に回してでも戦い抜きます"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00bb6",
  "speaker": 16,
  "jp": [
   "キミが言うと少しも冗談に",
   "聞こえないのが怖いな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00bf8",
  "speaker": 16,
  "jp": [
   "まぁ、どうせキミのことだから",
   "曲がったことが嫌だったとか",
   "その程度のことだろう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00c6e",
  "speaker": 16,
  "jp": [
   "たとえば死体にならないと",
   "檻の外へ出られない、哀れな",
   "実験動物のこととか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00cd4",
  "speaker": 0,
  "jp": [
   "・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00cf8",
  "speaker": 16,
  "jp": [
   "もうそろそろ、",
   "真実を隠し通すのは限界だと",
   "思うよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00d4c",
  "speaker": 0,
  "jp": [
   "わかっています"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00d82",
  "speaker": 16,
  "jp": [
   "フフフ",
   "キミは優しい人だから苦労するね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00dd2",
  "speaker": 0,
  "jp": [
   "テリオス様ほどではありません"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00e08",
  "speaker": 16,
  "jp": [
   "あははははっ",
   "僕は腹黒い天使だからね",
   "僕の優しさは裏がある優しさだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00e64",
  "speaker": 16,
  "jp": [
   "でも、キミのそういう",
   "裏表のない優しさは",
   "好感を通りこして尊敬に値するよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/142/00ec4",
  "speaker": 16,
  "jp": [
   "まぁ、頑張ってきなさい"
  ],
  "en": ""
 },
