[
 {
  "id": "SCENARIO/306/00128",
  "speaker": 1,
  "jp": [
   "テリオス様、大変です！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/0016a",
  "speaker": 16,
  "jp": [
   "騒々しいなぁ・・・",
   "ノックぐらいしなきゃダメだよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/001c6",
  "speaker": 0,
  "jp": [
   "はっ！",
   "しかし、事態は急を要します"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00212",
  "speaker": 16,
  "jp": [
   "わかった、聞かせておくれ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00252",
  "speaker": 0,
  "jp": [
   "はっ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/0027a",
  "speaker": 0,
  "jp": [
   "まず、現在各地の教団施設が",
   "エンブリオンの群れに襲われて",
   "いる模様です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/002ee",
  "speaker": 16,
  "jp": [
   "それで、最も近い場所は？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/0033c",
  "speaker": 0,
  "jp": [
   "＜クレイドルの丘＞",
   "ベイルが幽閉されている施設です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00384",
  "speaker": 0,
  "jp": [
   "あそこには現在",
   "法天使ルビエル様とリプサリスが",
   "いるはずです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/003ee",
  "speaker": 16,
  "jp": [
   "なるほど",
   "彼女達がいるのなら",
   "僕達に出番はないね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00442",
  "speaker": 16,
  "jp": [
   "それで、他の",
   "火急の用件って何なのかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00496",
  "speaker": 0,
  "jp": [
   "ホワイトフェイス様の研究施設に",
   "何者かが火を放った模様です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/004fa",
  "speaker": 16,
  "jp": [
   "なにっ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/0052a",
  "speaker": 0,
  "jp": [
   "現在、僧兵達が消火にあたって",
   "いますが、炎の勢いが激しく",
   "全焼はまぬがれないでしょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/005aa",
  "speaker": 16,
  "jp": [
   "それで、ヤツは・・・",
   "ホワイトフェイスはどこに？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00606",
  "speaker": 0,
  "jp": [
   "わかりません",
   "もしかしたら、炎の中に",
   "取り残されたのではないかと・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00676",
  "speaker": 16,
  "jp": [
   "あの抜け目ない男が",
   "そんなところで死ぬものか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/006c6",
  "speaker": 16,
  "jp": [
   "クレイス",
   "エンブリオンに襲われた施設の",
   "一覧って用意できる？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/0072e",
  "speaker": 0,
  "jp": [
   "それならここに・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00776",
  "speaker": 16,
  "jp": [
   "・・・・・ふむ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/007aa",
  "speaker": 0,
  "jp": [
   "・・・何かわかりますか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/007ea",
  "speaker": 16,
  "jp": [
   "予想通りってとこかなぁ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/0082e",
  "speaker": 0,
  "jp": [
   "と、申されますと？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/0086a",
  "speaker": 16,
  "jp": [
   "どれも僕が天使長に頼まれて",
   "教団の秘蔵のペインリングを",
   "封じておいた施設ばかりさ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/008de",
  "speaker": 16,
  "jp": [
   "第三者、または教団内部の者が",
   "倒立樹を独占出来ないように",
   "天使長は管理者を分けたんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/0094c",
  "speaker": 16,
  "jp": [
   "僕しかペインリングの隠し場所を",
   "知らないように、倒立樹の場所は",
   "ホワイトフェイスしか知らない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/009ce",
  "speaker": 16,
  "jp": [
   "インセストとペインリングと",
   "倒立樹・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00a0c",
  "speaker": 16,
  "jp": [
   "この三つが揃えば",
   "世界を自分の思い通りに変革する",
   "ことだって不可能じゃないからね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00a8a",
  "speaker": 0,
  "jp": [
   "それでは、まさか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00aca",
  "speaker": 16,
  "jp": [
   "これは、ペインリングを封じた",
   "僕にしか導けない答えだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00b22",
  "speaker": 16,
  "jp": [
   "おそらく、あいつも",
   "僕が真っ先に気づくことぐらい",
   "わかっているはずだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00c24",
  "speaker": 17,
  "jp": [
   "キシャァァァァ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00c74",
  "speaker": 1,
  "jp": [
   "エンブリオン！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00ca6",
  "speaker": 1,
  "jp": [
   "テリオス様！",
   "下がってください！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00d10",
  "speaker": 0,
  "jp": [
   "・・・これで確信できたよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/306/00d4a",
  "speaker": 0,
  "jp": [
   "エンブリオンを裏で操る",
   "裏切り者は、間違いなくあの男だ"
  ],
  "en": ""
 },
