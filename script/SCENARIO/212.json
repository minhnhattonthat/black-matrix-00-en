[
 {
  "id": "SCENARIO/212/00112",
  "speaker": 16,
  "jp": [
   "アベル、どうしてここに？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00152",
  "speaker": 0,
  "jp": [
   "・・・調子はどうだよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00192",
  "speaker": 16,
  "jp": [
   "平気、だけど・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/001ce",
  "speaker": 0,
  "jp": [
   "ケッ、二度とその体に",
   "傷をつけるんじゃねぇぞ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00218",
  "speaker": 16,
  "jp": [
   "・・・・・う、うん"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00244",
  "speaker": 16,
  "jp": [
   "ねぇ、あの時",
   "どうしてボクを助けたりしたの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/0029a",
  "speaker": 0,
  "jp": [
   "言っただろう？",
   "お前はオレが殺すんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/002ea",
  "speaker": 16,
  "jp": [
   "殺すために・・・助けたの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00320",
  "speaker": 0,
  "jp": [
   "そうだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00340",
  "speaker": 16,
  "jp": [
   "どうして？",
   "ボクを殺すのなら、",
   "助けなくてもいいじゃない？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/003a6",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/003cc",
  "speaker": 0,
  "jp": [
   "そんなに知りたいなら",
   "あの男にでも聞いてみるんだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/0042a",
  "speaker": 16,
  "jp": [
   "あの男？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/0044c",
  "speaker": 0,
  "jp": [
   "そうだ・・元をただせばお前も",
   "アイツが作・・・",
   "ウッ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/005e6",
  "speaker": 16,
  "jp": [
   "・・・アベル？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/0061e",
  "speaker": 0,
  "jp": [
   "またか・・・やはり",
   "この・・器では、",
   "・・・グゥッ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/006c2",
  "speaker": 17,
  "jp": [
   "アベル様！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/006ec",
  "speaker": 0,
  "jp": [
   "・・・ちっ",
   "呼んでも、いないのに、",
   "勝手に、出てくるな！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00744",
  "speaker": 16,
  "jp": [
   "私の力を、お使い下さい",
   "このままでは・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/0078e",
  "speaker": 0,
  "jp": [
   "・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00910",
  "speaker": 0,
  "jp": [
   "・・・・・・うぅっ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/0093c",
  "speaker": 16,
  "jp": [
   "キミは・・いったい？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/009b4",
  "speaker": 0,
  "jp": [
   "私はアベル様に仕える",
   "従者の一人"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/009f0",
  "speaker": 0,
  "jp": [
   "そして＜インセスト＞と",
   "呼ばれる者、レアです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00a38",
  "speaker": 16,
  "jp": [
   "レア・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00a5c",
  "speaker": 5,
  "jp": [
   "よけいなことを",
   "ベラベラとしゃべるな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00b60",
  "speaker": 16,
  "jp": [
   "すみません"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00b84",
  "speaker": 0,
  "jp": [
   "・・・何の用だ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00bb0",
  "speaker": 16,
  "jp": [
   "アラギ様がお呼びです",
   "スグに来るようにと"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00c78",
  "speaker": 0,
  "jp": [
   "チッ・・ヤツめ",
   "一体何様のつも・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00d22",
  "speaker": 0,
  "jp": [
   "そうだ、カイン",
   "いいことを教えてやろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00d5c",
  "speaker": 0,
  "jp": [
   "お前の仲間に、",
   "女悪魔がいるだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00d9c",
  "speaker": 16,
  "jp": [
   "ルカの、こと？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00dc4",
  "speaker": 0,
  "jp": [
   "そいつとアラギは昔",
   "仲間だったんだぜ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00e16",
  "speaker": 17,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00e34",
  "speaker": 0,
  "jp": [
   "何かの理由で、",
   "今は対立関係にあるらしいが"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00e74",
  "speaker": 0,
  "jp": [
   "アラギのやつ、",
   "その女とヨリを戻そうと",
   "やっきになってやがる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00ede",
  "speaker": 16,
  "jp": [
   "でもルカは、",
   "アラギを倒すって・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00f2a",
  "speaker": 0,
  "jp": [
   "ククク・・・",
   "お前は仲間を信じているのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00f68",
  "speaker": 0,
  "jp": [
   "信じるのは勝手だが",
   "裏切られた時に傷つくぜ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/00fbe",
  "speaker": 16,
  "jp": [
   "ルカはボク達を",
   "裏切ったりしないよ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/01000",
  "speaker": 0,
  "jp": [
   "つくづく甘いヤツだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/01024",
  "speaker": 0,
  "jp": [
   "人の心なんて勝手なものだ",
   "自分の都合に合わせて",
   "ころころ手の平を返しやがる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/0108c",
  "speaker": 16,
  "jp": [
   "ボクの仲間は",
   "そんな人たちじゃない！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/010da",
  "speaker": 0,
  "jp": [
   "本当にそうかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/010fc",
  "speaker": 0,
  "jp": [
   "そう見せかけているだけで",
   "腹の中では何を考えているのか",
   "わかったもんじゃないぜ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/0116c",
  "speaker": 16,
  "jp": [
   "そんなことないっ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/011a6",
  "speaker": 0,
  "jp": [
   "・・・・・カイン",
   "お前に教えてやる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/011dc",
  "speaker": 0,
  "jp": [
   "お前が人を信じたがるのは",
   "人を疑うのが怖いからだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/01236",
  "speaker": 16,
  "jp": [
   "え・・・？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/0126a",
  "speaker": 0,
  "jp": [
   "疑わしいこと全てにフタをして",
   "信じこもうとしているだけだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/012b8",
  "speaker": 0,
  "jp": [
   "現実から目をそらし",
   "嫌な考えを心の底に押しやって",
   "逃げているだけだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/01326",
  "speaker": 16,
  "jp": [
   "・・・アベル"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/0135a",
  "speaker": 0,
  "jp": [
   "イライラする"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/01378",
  "speaker": 0,
  "jp": [
   "マティアそっくりで",
   "虫酸が走る！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/013c6",
  "speaker": 16,
  "jp": [
   "マティアに・・そっくり？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/013f8",
  "speaker": 0,
  "jp": [
   "認めろ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/01414",
  "speaker": 0,
  "jp": [
   "お前は臆病ものだ！",
   "１人では何も出来ない！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/01454",
  "speaker": 19,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": "",
  "spill": false
 },
 {
  "id": "SCENARIO/212/0146e",
  "jp": "　そうかもしれない",
  "en": ""
 },
 {
  "id": "SCENARIO/212/01488",
  "jp": "　違うよ",
  "en": ""
 },
 {
  "id": "SCENARIO/212/014ce",
  "speaker": 16,
  "jp": [
   "・・・そうかもしれない",
   "キミから見ればボクは弱くて",
   "臆病なのかもしれない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/0153a",
  "speaker": 16,
  "jp": [
   "でも、本当に臆病なのは",
   "誰も信じることが出来ない",
   "キミの方だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/015b2",
  "speaker": 16,
  "jp": [
   "・・・違うよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/015d0",
  "speaker": 16,
  "jp": [
   "ボクは臆病なんかじゃない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/015fc",
  "speaker": 16,
  "jp": [
   "本当に臆病なのは・・・",
   "誰も信じることが出来ない",
   "キミの方だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/01668",
  "speaker": 16,
  "jp": [
   "裏切られることを恐れ",
   "誰も信じないなんて、"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/016a8",
  "speaker": 16,
  "jp": [
   "そんなの自分が傷つくことから",
   "逃げてるだけじゃないか！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/0170a",
  "speaker": 0,
  "jp": [
   "・・・フン、",
   "一人じゃ生きられない",
   "弱者の理屈でオレを計るな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/01764",
  "speaker": 16,
  "jp": [
   "キミが何を言いたいのか",
   "ボクにはよくわからない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/017a8",
  "speaker": 16,
  "jp": [
   "でも、誰かを信じるのは",
   "勇気の要る、尊いことなんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/017f0",
  "speaker": 16,
  "jp": [
   "傷つくことに怯えていちゃ",
   "ダメなんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/0183e",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/0186c",
  "speaker": 16,
  "jp": [
   "ボクは人を信じることを",
   "やめたりなんかしない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/018b4",
  "speaker": 0,
  "jp": [
   "お前には、絶望が足りないんだ",
   "お前には、この世界の真実が",
   "何も見えていない！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/01920",
  "speaker": 16,
  "jp": [
   "キミの言う絶望って何？",
   "キミは何を見ているの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/0196c",
  "speaker": 0,
  "jp": [
   "お前には、まだアレが見え",
   "・・・グッ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/01a5c",
  "speaker": 5,
  "jp": [
   "アベル様！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/01a8e",
  "speaker": 0,
  "jp": [
   "・・・吐き気がする",
   "これ以上、お前の言葉には",
   "付き合いきれない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/01b98",
  "speaker": 16,
  "jp": [
   "いくぞ、レア"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/01bf8",
  "speaker": 0,
  "jp": [
   "はい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/01cf0",
  "speaker": 16,
  "jp": [
   "・・・アベル"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/212/01d18",
  "speaker": 19,
  "jp": [
   "ボクは",
   "何が見えていないというの・・？"
  ],
  "en": ""
 },
