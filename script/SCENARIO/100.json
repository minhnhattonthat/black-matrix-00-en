[
 {
  "id": "SCENARIO/100/000f8",
  "speaker": 0,
  "jp": [
   "うひゃー",
   "さっぱりした！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/0014c",
  "speaker": 16,
  "jp": [
   "風呂はいいけど",
   "ちゃんと頭をふきなさい",
   "風邪ひくわよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/001ae",
  "speaker": 0,
  "jp": [
   "ガキ扱いするなよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/001e8",
  "speaker": 16,
  "jp": [
   "お腹出して寝てる子なんか",
   "まだまだガキだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/0027e",
  "speaker": 16,
  "jp": [
   "おや、目が覚めたようだね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/002b0",
  "speaker": 3,
  "jp": [
   "・・・何か",
   "変な夢を見た気がする・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/002f4",
  "speaker": 16,
  "jp": [
   "もう起きても大丈夫なのかい？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/0033a",
  "speaker": 0,
  "jp": [
   "あ、はい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/0037e",
  "speaker": 16,
  "jp": [
   "無理はしないことだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/003b2",
  "speaker": 16,
  "jp": [
   "それと、アンタをここまで",
   "運んでくれたザイオンに",
   "ちゃんと礼を言っておくんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/0043c",
  "speaker": 1,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00536",
  "speaker": 0,
  "jp": [
   "・・・あ、あの",
   "ありがとう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/0057a",
  "speaker": 16,
  "jp": [
   "・・・・・・フン"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/005ec",
  "speaker": 16,
  "jp": [
   "気にしなくていいわよ",
   "ザイオンならいつもこんな感じ",
   "だから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00644",
  "speaker": 0,
  "jp": [
   "うん、それならいいけど"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/006b8",
  "speaker": 16,
  "jp": [
   "そんなことより",
   "しっかり食って、しっかり休んで",
   "ぶっ倒れないようにしろよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00726",
  "speaker": 16,
  "jp": [
   "お前って貧弱そうじゃん",
   "男だったらもっとたくましく",
   "ならないとな！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00796",
  "speaker": 0,
  "jp": [
   "うん"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/007b4",
  "speaker": 16,
  "jp": [
   "あ、おばちゃん！",
   "俺、ミルク！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/0081e",
  "speaker": 0,
  "jp": [
   "おば・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00858",
  "speaker": 0,
  "jp": [
   "・・・まったく、こっちは",
   "微妙な年頃の乙女だってのに",
   "デリカシーのない子だねぇ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/008d2",
  "speaker": 16,
  "jp": [
   "乙女？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00902",
  "speaker": 0,
  "jp": [
   "はいはい",
   "あんたには何言っても無駄だって",
   "ことぐらいわかってるよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00966",
  "speaker": 0,
  "jp": [
   "はい、ミルク",
   "ほら、坊やも"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/009bc",
  "speaker": 16,
  "jp": [
   "ありがとうございます"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00a28",
  "speaker": 0,
  "jp": [
   "うげぇ～",
   "やっぱり不味い・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00a80",
  "speaker": 16,
  "jp": [
   "イチゴジャムならあるけれど",
   "まぜてみる？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00ad2",
  "speaker": 0,
  "jp": [
   "なんでジャムなんて",
   "持ち歩いてるんだよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00b38",
  "speaker": 0,
  "jp": [
   "おやまぁ",
   "おいしそうなジャムじゃないか",
   "カインのお母さんの手作りかい？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00baa",
  "speaker": 16,
  "jp": [
   "お母さんなんていないよ",
   "マティアの見よう見まねで",
   "自分で作ってみたんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00c30",
  "speaker": 0,
  "jp": [
   "亡くなったのか？",
   "お前のおふくろ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00c7a",
  "speaker": 16,
  "jp": [
   "ううん",
   "そうじゃなくて、ボクは",
   "両親の顔を知らないから・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00ce2",
  "speaker": 0,
  "jp": [
   "ごめん・・・",
   "そういやお前、記憶が・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00d36",
  "speaker": 16,
  "jp": [
   "ううん、気にしてないよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00d9a",
  "speaker": 0,
  "jp": [
   "・・・そうかい、てっきり",
   "温室育ちの坊ちゃんかと思いきや",
   "あんたも苦労してきたみたいだね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00e1e",
  "speaker": 16,
  "jp": [
   "平気だよ",
   "ボクにはヨハネとマティアが",
   "家族みたいなものだから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00e98",
  "speaker": 0,
  "jp": [
   "家族みたいなものかぁ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00ec4",
  "speaker": 0,
  "jp": [
   "カインにとってのヨハネさんが",
   "俺にとってのヴァルトス様",
   "みたいなものかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00f3a",
  "speaker": 16,
  "jp": [
   "ヴァルトス様？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00f72",
  "speaker": 0,
  "jp": [
   "ヴァルトス様は",
   "サイファーパンクのリーダーで",
   "俺が一番に尊敬している人さ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/00fdc",
  "speaker": 16,
  "jp": [
   "へぇー、そうなんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/01016",
  "speaker": 0,
  "jp": [
   "ヴァルトス様は命の恩人なんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/0105a",
  "speaker": 16,
  "jp": [
   "命の恩人？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/0108e",
  "speaker": 0,
  "jp": [
   "瀕死だった俺を",
   "炎の中から助け出してくれたのが",
   "ヴァルトス様なんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/010f6",
  "speaker": 0,
  "jp": [
   "俺が脱いだらビックリするぜ",
   "いかにも奇跡の生還者って感じの",
   "すごい傷跡があるから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/01184",
  "speaker": 16,
  "jp": [
   "そんなもの",
   "見せびらかすんじゃないよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/011d6",
  "speaker": 0,
  "jp": [
   "わかってるよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/01220",
  "speaker": 0,
  "jp": [
   "奇跡の生還ね・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/01252",
  "speaker": 0,
  "jp": [
   "カインはどうなの？",
   "あんたもあの時、天使の一撃で",
   "死にかけていたはずでしょ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/012dc",
  "speaker": 16,
  "jp": [
   "うん、そうなんだけど・・・",
   "その時の傷がどこにもないんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/0133e",
  "speaker": 0,
  "jp": [
   "傷跡がない？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/01364",
  "speaker": 16,
  "jp": [
   "うん"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/013b0",
  "speaker": 0,
  "jp": [
   "うーん、翼を持つ者は",
   "傷の回復力もすごいって言うから",
   "完治しただけじゃないのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/0142e",
  "speaker": 16,
  "jp": [
   "そうなのかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/01498",
  "speaker": 16,
  "jp": [
   "ま、傷の一つや二つ",
   "気にするなって！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/01590",
  "speaker": 16,
  "jp": [
   "・・・・・・痛い"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/015d0",
  "speaker": 16,
  "jp": [
   "・・・そういえば",
   "サイファーパンクって",
   "どこにあるの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/01632",
  "speaker": 0,
  "jp": [
   "おいおい、",
   "何をいまさら・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/0166c",
  "speaker": 16,
  "jp": [
   "それらしい場所は",
   "どこにも見あたらないけど"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/016c2",
  "speaker": 0,
  "jp": [
   "・・・なんだ、カイン",
   "気付いてなかったのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/01712",
  "speaker": 0,
  "jp": [
   "ここもサイファーパンクの",
   "一部なんだぜ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/01762",
  "speaker": 17,
  "jp": [
   "えぇ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/017a4",
  "speaker": 0,
  "jp": [
   "ま、正確にはちょっと",
   "違うんだけどね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/017dc",
  "speaker": 0,
  "jp": [
   "ここは夜",
   "外から戻ってきた仲間たちが",
   "情報交換をする場所さ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/0182c",
  "speaker": 0,
  "jp": [
   "そこに『雑記帳』があるだろう？",
   "仲間が集めてきた情報は、",
   "そこに書かれているよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/01890",
  "speaker": 0,
  "jp": [
   "何か知りたいことがあるなら",
   "目を通しておくんだね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/018d4",
  "speaker": 0,
  "jp": [
   "つまらないウワサ話だってことも",
   "あるけれど、その中から真実を",
   "掴むのはアンタ次第さ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/01952",
  "speaker": 16,
  "jp": [
   "うん、ありがとう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/01986",
  "speaker": 0,
  "jp": [
   "サイファーパンクからの支給品",
   "こっちも忘れずに",
   "持って行くんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/019f4",
  "speaker": 16,
  "jp": [
   "ありがとう、ダリアさん"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/100/01a24",
  "speaker": 0,
  "jp": [
   "いえいえ、どういたしまして"
  ],
  "en": ""
 },
