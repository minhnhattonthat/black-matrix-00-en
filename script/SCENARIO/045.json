[
 {
  "id": "SCENARIO/045/00110",
  "speaker": 0,
  "jp": [
   "こんにちは"
  ],
  "en": "Hello."
 },
 {
  "id": "SCENARIO/045/00144",
  "speaker": 16,
  "jp": [
   "ええ、こんにちは",
   "またお会いしましたね"
  ],
  "en": "Yes, hello. We meet again."
 },
 {
  "id": "SCENARIO/045/00188",
  "speaker": 16,
  "jp": [
   "お花はいかがですか？"
  ],
  "en": "Would you like some flowers?"
 },
 {
  "id": "SCENARIO/045/001c6",
  "speaker": 3,
  "jp": [
   "花か・・・",
   "マティアも花が大好きだったな"
  ],
  "en": "Flowers... Matia loved flowers too."
 },
 {
  "id": "SCENARIO/045/0021a",
  "speaker": 0,
  "jp": [
   "それじゃあ、ひとつ・・・"
  ],
  "en": "Then I'll take one..."
 },
 {
  "id": "SCENARIO/045/0024e",
  "speaker": 16,
  "jp": [
   "ありがとうございます"
  ],
  "en": "Thank you very much."
 },
 {
  "id": "SCENARIO/045/00294",
  "speaker": 16,
  "jp": [
   "・・・お捜しの方は、",
   "見つかりましたか？"
  ],
  "en": "...Did you find the person you were looking for?"
 },
 {
  "id": "SCENARIO/045/002e6",
  "speaker": 0,
  "jp": [
   "え？"
  ],
  "en": "Huh?"
 },
 {
  "id": "SCENARIO/045/00306",
  "speaker": 16,
  "jp": [
   "いえ、貴方が迷子のような",
   "目をしていたので、",
   "少し気になっていたんです"
  ],
  "en": "It's just, you had the look of a lost child, and it's been on my mind a little."
 },
 {
  "id": "SCENARIO/045/0037a",
  "speaker": 0,
  "jp": [
   "・・・・・・・・"
  ],
  "en": "........"
 },
 {
  "id": "SCENARIO/045/003b4",
  "speaker": 16,
  "jp": [
   "あ、あの、すみません",
   "わたし、失礼なことを",
   "言ってしまって・・・"
  ],
  "en": "Oh, I-I'm sorry. That was a rude thing for me to say..."
 },
 {
  "id": "SCENARIO/045/00422",
  "speaker": 0,
  "jp": [
   "ううん、気にしないで"
  ],
  "en": "No, don't worry about it."
 },
 {
  "id": "SCENARIO/045/00448",
  "speaker": 0,
  "jp": [
   "それより、",
   "なんだか街の人達が少ないけど",
   "何かあったの？"
  ],
  "en": "More importantly, the streets seem kind of empty. Did something happen?"
 },
 {
  "id": "SCENARIO/045/004b0",
  "speaker": 16,
  "jp": [
   "街のみなさんなら",
   "教会へ＜グーテンベルグ＞を",
   "取りに行ってるはずですよ"
  ],
  "en": "Everyone from town should be at the church, collecting their Gutenberg."
 },
 {
  "id": "SCENARIO/045/00522",
  "speaker": 0,
  "jp": [
   "＜グーテンベルグ＞・・？",
   "なんだかおいしそうな名前だね"
  ],
  "en": "Gutenberg...? That sounds kind of tasty."
 },
 {
  "id": "SCENARIO/045/00584",
  "speaker": 16,
  "jp": [
   "おいしそう・・ですか？"
  ],
  "en": "Tasty... you say?"
 },
 {
  "id": "SCENARIO/045/005c2",
  "speaker": 0,
  "jp": [
   "あれ？",
   "お菓子の名前なんじゃ・・・"
  ],
  "en": "Huh? Isn't it the name of a sweet...?"
 },
 {
  "id": "SCENARIO/045/00610",
  "speaker": 16,
  "jp": [
   "いいえ、違いますよ"
  ],
  "en": "No, it isn't."
 },
 {
  "id": "SCENARIO/045/0064a",
  "speaker": 0,
  "jp": [
   "えぇっ！！"
  ],
  "en": "Whaat!!"
 },
 {
  "id": "SCENARIO/045/00680",
  "speaker": 16,
  "jp": [
   "ふふふ、",
   "あの子と同じことを言う人が",
   "他にもいるなんて"
  ],
  "en": "Hee hee. To think there's someone else who says the same thing as that child."
 },
 {
  "id": "SCENARIO/045/006e2",
  "speaker": 0,
  "jp": [
   "あの・・その・・"
  ],
  "en": "Um... well..."
 },
 {
  "id": "SCENARIO/045/00704",
  "speaker": 0,
  "jp": [
   "ボクの田舎だと",
   "教会でみんなにお菓子を配って",
   "いたものだから、てっきり・・・"
  ],
  "en": "Back home, the church would hand out sweets to everyone, so I just assumed..."
 },
 {
  "id": "SCENARIO/045/00780",
  "speaker": 16,
  "jp": [
   "そうですね、ここでも子供達には",
   "お菓子を配っているはずですよ"
  ],
  "en": "Well, they should be handing out sweets to the children here, too."
 },
 {
  "id": "SCENARIO/045/007d8",
  "speaker": 3,
  "jp": [
   "うー・・・思い出せない、",
   "教会でお菓子と一緒にもらった",
   "もの、なんていったかなぁ？"
  ],
  "en": "Ugh... I can't remember what it was we got at church along with the sweets..."
 },
 {
  "id": "SCENARIO/045/0084a",
  "speaker": 16,
  "jp": [
   "今ならまだ、お菓子も一緒に",
   "もらえるはずですわ"
  ],
  "en": "If you go now, you should still get sweets with it."
 },
 {
  "id": "SCENARIO/045/008a2",
  "speaker": 0,
  "jp": [
   "あ、うん・・・",
   "気が向いたらボクも行ってくるね"
  ],
  "en": "Ah, yeah... If I feel like it, I'll go too."
 },
 {
  "id": "SCENARIO/045/008ee",
  "speaker": 16,
  "jp": [
   "ええ、いってらっしゃい"
  ],
  "en": "Yes, take care."
 },
 {
  "id": "SCENARIO/045/0445c",
  "jp": "青年",
  "en": "Young man"
 },
 {
  "id": "SCENARIO/045/0446a",
