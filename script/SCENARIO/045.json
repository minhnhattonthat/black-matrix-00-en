  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/00188",
  "speaker": 16,
  "jp": [
   "お花はいかがですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/001c6",
  "speaker": 3,
  "jp": [
   "花か・・・",
   "マティアも花が大好きだったな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/0021a",
  "speaker": 0,
  "jp": [
   "それじゃあ、ひとつ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/0024e",
  "speaker": 16,
  "jp": [
   "ありがとうございます"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/00294",
  "speaker": 16,
  "jp": [
   "・・・お捜しの方は、",
   "見つかりましたか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/002e6",
  "speaker": 0,
  "jp": [
   "え？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/00306",
  "speaker": 16,
  "jp": [
   "いえ、貴方が迷子のような",
   "目をしていたので、",
   "少し気になっていたんです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/0037a",
  "speaker": 0,
  "jp": [
   "・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/003b4",
  "speaker": 16,
  "jp": [
   "あ、あの、すみません",
   "わたし、失礼なことを",
   "言ってしまって・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/00422",
  "speaker": 0,
  "jp": [
   "ううん、気にしないで"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/00448",
  "speaker": 0,
  "jp": [
   "それより、",
   "なんだか街の人達が少ないけど",
   "何かあったの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/004b0",
  "speaker": 16,
  "jp": [
   "街のみなさんなら",
   "教会へ＜グーテンベルグ＞を",
   "取りに行ってるはずですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/00522",
  "speaker": 0,
  "jp": [
   "＜グーテンベルグ＞・・？",
   "なんだかおいしそうな名前だね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/00584",
  "speaker": 16,
  "jp": [
   "おいしそう・・ですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/005c2",
  "speaker": 0,
  "jp": [
   "あれ？",
   "お菓子の名前なんじゃ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/00610",
  "speaker": 16,
  "jp": [
   "いいえ、違いますよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/0064a",
  "speaker": 0,
  "jp": [
   "えぇっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/00680",
  "speaker": 16,
  "jp": [
   "ふふふ、",
   "あの子と同じことを言う人が",
   "他にもいるなんて"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/006e2",
  "speaker": 0,
  "jp": [
   "あの・・その・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/00704",
  "speaker": 0,
  "jp": [
   "ボクの田舎だと",
   "教会でみんなにお菓子を配って",
   "いたものだから、てっきり・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/00780",
  "speaker": 16,
  "jp": [
   "そうですね、ここでも子供達には",
   "お菓子を配っているはずですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/007d8",
  "speaker": 3,
  "jp": [
   "うー・・・思い出せない、",
   "教会でお菓子と一緒にもらった",
   "もの、なんていったかなぁ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/0084a",
  "speaker": 16,
  "jp": [
   "今ならまだ、お菓子も一緒に",
   "もらえるはずですわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/008a2",
  "speaker": 0,
  "jp": [
   "あ、うん・・・",
   "気が向いたらボクも行ってくるね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/045/008ee",
