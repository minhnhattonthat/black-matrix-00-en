  "en": ""
 },
 {
  "id": "SCENARIO/147/0021a",
  "speaker": 0,
  "jp": [
   "ああ、その通りだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/147/00268",
  "speaker": 16,
  "jp": [
   "・・・じゃあ、ずっと",
