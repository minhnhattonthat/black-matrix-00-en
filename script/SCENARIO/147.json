 },
 {
  "id": "SCENARIO/147/006b4",
  "speaker": 16,
  "jp": [
   "クレイス様、その傷は？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/147/006e8",
  "speaker": 0,
  "jp": [
   "たいしたことはない",
   "ただのかすり傷だ"
