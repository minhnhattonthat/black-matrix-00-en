[
 {
  "id": "SCENARIO/084/00136",
  "speaker": 0,
  "jp": [
   "・・・ここまで来れば平気だな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/001ea",
  "speaker": 16,
  "jp": [
   "まったく、アンタたち",
   "危ないところだったぜ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00254",
  "speaker": 0,
  "jp": [
   "ごめんなさい・・・",
   "でも、ありがとうエクサル",
   "また助けられちゃったね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/002c6",
  "speaker": 16,
  "jp": [
   "いいってことよ",
   "気にするなって"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00306",
  "speaker": 16,
  "jp": [
   "それより",
   "僧兵に目をつけられたのは",
   "ちょっとやっかいだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00362",
  "speaker": 16,
  "jp": [
   "ここのところ悪魔による被害が",
   "深刻で、教団のやつらも",
   "厳戒態勢中なんだよな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/003cc",
  "speaker": 0,
  "jp": [
   "悪魔による被害？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/003f8",
  "speaker": 16,
  "jp": [
   "ああ、最近市街地やその周辺で",
   "頻繁に悪魔が目撃されていて",
   "何人も殺されているんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00460",
  "speaker": 16,
  "jp": [
   "しかもまた、その食欲の旺盛な",
   "ことといったらなくて、日に日に",
   "死体の数が増えていやがる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/004f4",
  "speaker": 0,
  "jp": [
   "食欲・・・と言うことは"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00532",
  "speaker": 16,
  "jp": [
   "ああ、その通り、",
   "犯人は＜渇き＞に狂った悪魔に",
   "違いない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/005a8",
  "speaker": 0,
  "jp": [
   "＜渇き＞？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/005ce",
  "speaker": 16,
  "jp": [
   "悪魔特有の病気だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/005f4",
  "speaker": 16,
  "jp": [
   "この病気になっちまうと",
   "理性がぶっとんで、人を襲って",
   "その血を飲むようになるんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00684",
  "speaker": 0,
  "jp": [
   "悪魔が忌み嫌われる",
   "理由の一つだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/006c4",
  "speaker": 16,
  "jp": [
   "それで今この街には・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/006f0",
  "speaker": 16,
  "jp": [
   "教団から派遣された",
   "悪魔討伐のスペシャリストが",
   "来ているって話だぜ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00754",
  "speaker": 0,
  "jp": [
   "教団の上層幹部か・・・",
   "渇きに狂った悪魔の討伐となると",
   "よほどの手練れだろうな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/007e2",
  "speaker": 0,
  "jp": [
   "もしかして",
   "あの六翼の天使！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/0082a",
  "speaker": 16,
  "jp": [
   "残念",
   "噂じゃ派遣されてきたのは",
   "天使じゃないって話だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/0089c",
  "speaker": 0,
  "jp": [
   "天使ではない・・・",
   "まさか、例の男のことか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00906",
  "speaker": 16,
  "jp": [
   "ああ、十審将お抱えの強剣士様が",
   "この街に来ているらしい・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00966",
  "speaker": 16,
  "jp": [
   "興味はあるけれど",
   "ま、お手合わせは勘弁だな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/009ca",
  "speaker": 5,
  "jp": [
   "へえ",
   "面白い話じゃないの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00a0e",
  "speaker": 16,
  "jp": [
   "誰だ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00a90",
  "speaker": 0,
  "jp": [
   "血の臭いが濃い街だとは",
   "思っていたけれど",
   "やっぱりこの街にいるみたいね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00b2a",
  "speaker": 0,
  "jp": [
   "・・・ああ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00b92",
  "speaker": 17,
  "jp": [
   "な、・・悪魔！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00bca",
  "speaker": 16,
  "jp": [
   "くそっ！！",
   "お前達が街を襲っている",
   "渇きに狂った悪魔か！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00c44",
  "speaker": 0,
  "jp": [
   "失礼ね",
   "誰が狂ってるだって？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00c9c",
  "speaker": 19,
  "jp": [
   "この人達・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00ce0",
  "speaker": 1,
  "jp": [
   "！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00d0e",
  "speaker": 0,
  "jp": [
   "お前・・・あの時の"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00d34",
  "speaker": 0,
  "jp": [
   "まさか、生きていたなんてね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00d88",
  "speaker": 16,
  "jp": [
   "・・・おい",
   "こいつら知り合いなのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00de8",
  "speaker": 16,
  "jp": [
   "・・・うん",
   "前にキボートス島で会ったんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00e4c",
  "speaker": 0,
  "jp": [
   "・・・お前",
   "助かるような",
   "傷ではなかったはずだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00e9e",
  "speaker": 0,
  "jp": [
   "それに、この気配・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00ef0",
  "speaker": 0,
  "jp": [
   "ええ",
   "ヒトの臭いの中に",
   "嫌な臭いが混じってるわね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00f46",
  "speaker": 0,
  "jp": [
   "お前、何者？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00f6c",
  "speaker": 16,
  "jp": [
   "ボクにも",
   "よくわからないんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/00fc4",
  "speaker": 0,
  "jp": [
   "自分で自分のことが",
   "わからない？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01006",
  "speaker": 0,
  "jp": [
   "俺たちを馬鹿にしているのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/0104a",
  "speaker": 16,
  "jp": [
   "・・・でも",
   "本当にわからないんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/010d0",
  "speaker": 1,
  "jp": [
   "見つけたわよ不審人物！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01120",
  "speaker": 17,
  "jp": [
   "げげっ！！",
   "お前はさっきの僧兵！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/0116e",
  "speaker": 0,
  "jp": [
   "このあたしステイエンに",
   "にらまれたのが運の尽きよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/011da",
  "speaker": 0,
  "jp": [
   "そこの不審者たち！",
   "大人しく職務質問に答えなさい！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01220",
  "speaker": 0,
  "jp": [
   "後ろにいる二人も",
   "一緒に教会まで来てもらうわよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/0128c",
  "speaker": 16,
  "jp": [
   "・・・なんだ",
   "この女は？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/012ce",
  "speaker": 0,
  "jp": [
   "黒羽根！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01320",
  "speaker": 16,
  "jp": [
   "見ればわかるでしょ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/0135e",
  "speaker": 0,
  "jp": [
   "・・・あ、あ、あ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01388",
  "speaker": 1,
  "jp": [
   "悪魔！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/0140e",
  "speaker": 1,
  "jp": [
   "キャーー！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01468",
  "speaker": 1,
  "jp": [
   "なんでこんなところに",
   "悪魔なんているのよ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/014ec",
  "speaker": 16,
  "jp": [
   "すさまじい悲鳴だな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01546",
  "speaker": 16,
  "jp": [
   "落ち着いてる場合じゃないって"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01598",
  "speaker": 1,
  "jp": [
   "・・・はっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/015ce",
  "speaker": 0,
  "jp": [
   "まさか、あんたたち悪魔の",
   "仲間なの！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01630",
  "speaker": 16,
  "jp": [
   "あの、まだ仲間じゃなくて"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01672",
  "speaker": 1,
  "jp": [
   "怪しい奴とは思ってたけど",
   "悪魔の仲間だなんて最低！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/016ca",
  "speaker": 1,
  "jp": [
   "同じヒトとして恥ずかしいわ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01720",
  "speaker": 16,
  "jp": [
   "なかなか",
   "ひどい言われようね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01778",
  "speaker": 16,
  "jp": [
   "あー、もう",
   "ここはとりあえず",
   "冷静に話し合おうよ、な？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/017da",
  "speaker": 1,
  "jp": [
   "あんたたち",
   "黒羽根の仲間でしょ！！",
   "異端者の言葉なんて聞かないわ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/0184a",
  "speaker": 16,
  "jp": [
   "・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01868",
  "speaker": 16,
  "jp": [
   "あのさ、翼の色って",
   "そんなに大切かい？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/018ba",
  "speaker": 0,
  "jp": [
   "異端者の言葉なんて聞かない！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/018fe",
  "speaker": 16,
  "jp": [
   "ああ、またも問答無用かよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01982",
  "speaker": 0,
  "jp": [
   "カイン、念のため",
   "いつでも逃げられるよう",
   "翼を出しておくんだ"
