  "en": ""
 },
 {
  "id": "SCENARIO/084/019dc",
  "speaker": 16,
  "jp": [
   "うん"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01aa2",
  "speaker": 1,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01ae0",
  "speaker": 0,
  "jp": [
   "人間の臭いに",
   "嫌な臭いが混じっているとは",
   "思ったけど・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01b30",
  "speaker": 0,
  "jp": [
   "まさか白羽根を",
   "手に入れていたとはね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01b90",
  "speaker": 0,
  "jp": [
   "・・・て、天使！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01bc2",
  "speaker": 0,
  "jp": [
   "う、ううん",
   "だまされたりはしないわよ！",
   "あいつも悪魔の仲間！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/084/01c2e",
  "speaker": 1,
  "jp": [
   "異端者たちよ！！",
   "今ここで悔い改めなさい！！！"
  ],
  "en": ""
 },
