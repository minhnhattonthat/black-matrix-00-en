[
 {
  "id": "SCENARIO/302/0015c",
  "speaker": 3,
  "jp": [
   "白き悪魔・・カインの生存確認",
   "至急、ホワイトフェイス様に",
   "報告を・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00310",
  "speaker": 0,
  "jp": [
   "帰りましょう",
   "ヴァルトス様",
   "みんなも待っているはずです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00364",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/0039e",
  "speaker": 0,
  "jp": [
   "ヴァルトス様！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/003d6",
  "speaker": 16,
  "jp": [
   "今、戻るわけにはいかない",
   "教団にサイファーパンクをつぶす",
   "口実を与えてしまうだけだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00456",
  "speaker": 0,
  "jp": [
   "だったら、いつになったら",
   "サイファーパンクに戻るつもり",
   "なんですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/004be",
  "speaker": 0,
  "jp": [
   "まさか、もう二度と戻って",
   "来ないつもりなんじゃ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00528",
  "speaker": 16,
  "jp": [
   "私が消えても",
   "私が灯した火は消えない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/0056e",
  "speaker": 16,
  "jp": [
   "私はそれで満足だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/005a8",
  "speaker": 6,
  "jp": [
   "お待ち下さい",
   "ヴァルトス様！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00620",
  "speaker": 16,
  "jp": [
   "お前達は・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00648",
  "speaker": 0,
  "jp": [
   "先ほどはスイマセンでした",
   "ですが・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/0069a",
  "speaker": 16,
  "jp": [
   "あぁ、言わずともわかっている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/006d0",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/006f4",
  "speaker": 0,
  "jp": [
   "・・・ヴァルトス様",
   "サイファーパンクは貴方を失う",
   "わけには参りません"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/0075e",
  "speaker": 0,
  "jp": [
   "サイファーパンクを離れるのなら",
   "必ず我々の元に戻ってくると",
   "誓って下さい！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/007c0",
  "speaker": 0,
  "jp": [
   "それで私達も、",
   "貴方が灯した理想の火を絶やさず",
   "戦い続けることが出来ます！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00836",
  "speaker": 16,
  "jp": [
   "わかった、誓おう",
   "私は必ずサイファーパンクに戻る"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/0088a",
  "speaker": 16,
  "jp": [
   "私が不在の間",
   "サイファーパンクを頼むぞ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/008cc",
  "speaker": 0,
  "jp": [
   "はっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/008e8",
  "speaker": 0,
  "jp": [
   "では、以後のヴァルトス様との",
   "連絡役はエクサルに任せます"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/009ec",
  "speaker": 0,
  "jp": [
   "えぇぇっ！！",
   "お、俺が？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00a42",
  "speaker": 16,
  "jp": [
   "以後エクサルは",
   "ヴァルトス様に付き従い",
   "その周辺警護を担当しろ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00aae",
  "speaker": 0,
  "jp": [
   "そ、そんな大役・・・",
   "それに、俺はカイン達と一緒に！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00b00",
  "speaker": 16,
  "jp": [
   "これは命令だ",
   "お前はヴァルトス様の側を",
   "離れるな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00b5e",
  "speaker": 0,
  "jp": [
   "・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00c44",
  "speaker": 0,
  "jp": [
   "ヴァルトス様"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00c64",
  "speaker": 0,
  "jp": [
   "我々は貴方がサイファーパンクに",
   "正式に戻られる日を心待ちに",
   "しております"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00cc4",
  "speaker": 0,
  "jp": [
   "それまで、どうかご自愛下さい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00d0a",
  "speaker": 16,
  "jp": [
   "ああ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00df4",
  "speaker": 16,
  "jp": [
   "それでは",
   "エクサル、頼んだぞ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00e3a",
  "speaker": 0,
  "jp": [
   "・・・わかったよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00eb0",
  "speaker": 16,
  "jp": [
   "エクサル",
   "私の身辺警護役は不服か？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00efe",
  "speaker": 0,
  "jp": [
   "いえ、そんなことはありません！",
   "むしろ、光栄なくらいです",
   "でも、俺・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00f72",
  "speaker": 16,
  "jp": [
   "私よりも",
   "彼らと共にいたいのだろう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00fc2",
  "speaker": 0,
  "jp": [
   "！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/00fee",
  "speaker": 16,
  "jp": [
   "わたしのことならかまうな",
   "護衛などなくても大丈夫だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/0104a",
  "speaker": 0,
  "jp": [
   "でも・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01114",
  "speaker": 0,
  "jp": [
   "エクサルいなくなるの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01170",
  "speaker": 16,
  "jp": [
   "リリス"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/0119e",
  "speaker": 0,
  "jp": [
   "リリス嫌だよ",
   "リリス、エクサルも一緒がいいの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/011f6",
  "speaker": 16,
  "jp": [
   "仕方ないさ",
   "俺もサイファーパンクの一員",
   "なんだから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01256",
  "speaker": 0,
  "jp": [
   "ねぇねぇ、ヴァルトスさんも",
   "リリス達と一緒にいるのは",
   "ダメなの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/012ac",
  "speaker": 0,
  "jp": [
   "そしたらエクサル",
   "一緒にいられるよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/012fa",
  "speaker": 16,
  "jp": [
   "おいおい無茶言うなよリリス",
   "ヴァルトス様まで付き合わせる",
   "わけにはいかないって！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01388",
  "speaker": 0,
  "jp": [
   "でも、ボク達はサイファーパンク",
   "の正式な任務としてインセストの",
   "救出をしているんだよね？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/0140e",
  "speaker": 16,
  "jp": [
   "おいおい、お前ら",
   "何が言いたいんだよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01470",
  "speaker": 0,
  "jp": [
   "ようは、あんたが",
   "ヴァルトスさんの側にいられれば",
   "いいってことでしょ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/014da",
  "speaker": 0,
  "jp": [
   "リリスの言う通り",
   "ヴァルトスさんに一緒にいて",
   "もらえれば丸く収まるじゃない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01552",
  "speaker": 16,
  "jp": [
   "ステイエンまで",
   "無茶苦茶なこと言うなよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/015b8",
  "speaker": 0,
  "jp": [
   "ですが、身辺警護と言っても",
   "明らかにエクサルさん一人では",
   "力不足です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01622",
  "speaker": 0,
  "jp": [
   "ヴァルトスさんの身の安全を",
   "考えるのなら、それくらいの",
   "屁理屈は許されるはずですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/016a2",
  "speaker": 16,
  "jp": [
   "だけど、死ぬかもしれないのに",
   "ヴァルトス様を連れ回すわけには",
   "いかない・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/0171a",
  "speaker": 0,
  "jp": [
   "命が狙われているのなら",
   "どこにいても同じじゃないですか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/0177a",
  "speaker": 16,
  "jp": [
   "でもっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/017c0",
  "speaker": 0,
  "jp": [
   "ふふふ、大丈夫よ",
   "たぶんこういう流れになることも",
   "計算の内に入っているはずだもの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/0183e",
  "speaker": 16,
  "jp": [
   "計算？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/0186e",
  "speaker": 0,
  "jp": [
   "サイファーパンクの連中、",
   "ヴァルトスをあたし達に",
   "押しつけて"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/018c0",
  "speaker": 0,
  "jp": [
   "その真意がどこにあるのかを",
   "計るつもりじゃないかしら？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01922",
  "speaker": 16,
  "jp": [
   "まさか、サイファーパンクが",
   "ヴァルトス様を試そうとしている",
   "とでも言うのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/0199a",
  "speaker": 0,
  "jp": [
   "本当に裏切り者だった時",
   "アタシ達なら始末できるだけの",
   "力があるもの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01a0a",
  "speaker": 16,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01a48",
  "speaker": 0,
  "jp": [
   "言葉ではなんとでも言えるからな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01a78",
  "speaker": 0,
  "jp": [
   "一度失った信用を回復するのは",
   "難しい・・・また裏切られるん",
   "じゃないかと疑われる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01af6",
  "speaker": 16,
  "jp": [
   "・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01b3c",
  "speaker": 16,
  "jp": [
   "言葉より、行動による明確な",
   "意思表示が求められている",
   "ということか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01bae",
  "speaker": 0,
  "jp": [
   "そういうことだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01be6",
  "speaker": 16,
  "jp": [
   "・・・わかった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01c1e",
  "speaker": 0,
  "jp": [
   "フン、決まりだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01c76",
  "speaker": 16,
  "jp": [
   "カイン",
   "私もキミ達と戦おう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01cb2",
  "speaker": 16,
  "jp": [
   "エクサルともども",
   "よろしく頼む"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/01cfa",
  "speaker": 0,
  "jp": [
   "はい、",
   "こちらこそよろしくです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/0586c",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/302/0587a",
  "speaker": 0,
  "jp": [
   "ボンジュール"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/302/05892",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/302/058a2",
