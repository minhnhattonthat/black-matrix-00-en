   "よくも、お姉ちゃんをっ！！"
  ],
  "en": "Uwaaaaah!!! How dare you hurt big sis!!"
 },
 {
  "id": "SCENARIO/312/00b6e",
  "speaker": 1,
  "jp": [
   "ギシャァァッ！！！"
  ],
  "en": "GSHAAAA!!"
 },
 {
  "id": "SCENARIO/312/00bfa",
  "speaker": 17,
  "jp": [
   "お姉ちゃん！！"
  ],
  "en": "Big sis!!"
 },
 {
  "id": "SCENARIO/312/00d20",
  "speaker": 0,
  "jp": [
   "キロタ・・・",
