  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00228",
  "speaker": 0,
  "jp": [
   "けっこう警備が厳重だな",
   "どうする？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00288",
  "speaker": 16,
  "jp": [
   "うーん・・・",
   "出来るだけ誰とも争わないで",
   "マティアに会えるのがいいけど"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/0030c",
  "speaker": 16,
  "jp": [
   "・・・おい、お前ら",
   "何の考えもないまま俺たちを",
   "ここまで引っ張ってきたのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00386",
  "speaker": 0,
  "jp": [
   "・・・そう言われても",
   "俺っていつも",
   "行き当たりばったりだし"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/0040e",
  "speaker": 16,
  "jp": [
   "それでよく",
   "今まで生きてこられたわね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/0046c",
  "speaker": 0,
  "jp": [
   "この前のパスカは",
   "さすがにヤバイと思ったけどな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/004be",
  "speaker": 0,
  "jp": [
   "ヴァルトス様に恩を返す前に",
   "勝手に死ぬわけにはいかないさ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00534",
  "speaker": 16,
  "jp": [
   "無駄話はいい",
   "それよりどうするんだ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00594",
  "speaker": 0,
  "jp": [
   "見たところ教会が",
   "パスカに襲われた様子もない",
   "ようだが・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/0061e",
  "speaker": 16,
  "jp": [
   "アラギが来てないなら",
   "用はないわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/0068c",
  "speaker": 0,
  "jp": [
   "来る前かも知れないだろ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/006c0",
  "speaker": 16,
  "jp": [
   "来るまで待てとでも言うつもり？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00706",
  "speaker": 0,
  "jp": [
   "そうじゃなくて",
   "あいつは＜インセスト＞を",
   "狙っているんだろう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/0075c",
  "speaker": 0,
  "jp": [
   "それで教会を襲うなら",
   "俺たちが先に教会から",
   "＜インセスト＞を強奪すれば"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/007e0",
  "speaker": 0,
  "jp": [
   "＜インセスト＞を求めるアラギは",
   "目的の物が我々の元にある以上",
   "我々の前に必ず姿をあらわす"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00878",
  "speaker": 0,
  "jp": [
   "ま、強奪というと物騒だけど",
   "つまりはインセストの保護だな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/008d2",
  "speaker": 0,
  "jp": [
   "マティアも助けて",
   "アラギもきっちり捕まえる",
   "いい感じの作戦だろう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00954",
  "speaker": 16,
  "jp": [
   "エクサルって意外と",
   "頭がいいんだね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/009b0",
  "speaker": 0,
  "jp": [
   "意外は余計だっての！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00a10",
  "speaker": 16,
  "jp": [
   "そういうこじつけで",
   "俺たちに人助けを手伝えと？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00a6a",
  "speaker": 0,
  "jp": [
   "ま・・悪くない話だと思うけど？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00ab2",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00b00",
  "speaker": 0,
  "jp": [
   "どうやら今回は、エクサルの方が",
   "一枚上手のようだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00b5e",
  "speaker": 16,
  "jp": [
   "・・・・・・ちっ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00c0a",
  "speaker": 16,
  "jp": [
   "・・・アタシが行く"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00c68",
  "speaker": 0,
  "jp": [
   "行くって、何を・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00ca6",
  "speaker": 16,
  "jp": [
   "アタシが僧兵達の注意をひく",
   "そのスキにアンタ達は",
   "中に忍び込むのさ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00d16",
  "speaker": 0,
  "jp": [
   "そんなのダメだよ！！",
   "わざわざそんな危ない方法を",
   "選ばなくても、他に何か・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00da0",
  "speaker": 17,
  "jp": [
   "うるさい！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00de4",
  "speaker": 16,
  "jp": [
   "イライラするんだ",
   "アンタ達と手を組んだからって",
   "いちいち指図は受けないよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00e7c",
  "speaker": 0,
  "jp": [
   "ルカ、あまり先走るな",
   "今のお前は血が見たいだけだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00ee4",
  "speaker": 17,
  "jp": [
   "うるさい！！！",
   "アンタ達が何を言おうと",
   "アタシは行くよ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00f54",
  "speaker": 1,
  "jp": [
   "ルカ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/00fcc",
  "speaker": 0,
  "jp": [
   "二人とも待って！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/01072",
  "speaker": 16,
  "jp": [
   "おっと、お前は飛びだすな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/010b2",
  "speaker": 0,
  "jp": [
   "で、でも二人が！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/010ee",
  "speaker": 16,
  "jp": [
   "いまの俺達とアイツらじゃ、",
   "綿密な計画立てろって方が無理だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/0113c",
  "speaker": 16,
  "jp": [
   "心配しなくたって",
   "アイツらは悪魔なんだ",
   "僧兵相手に簡単には死なないって"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/011a0",
  "speaker": 0,
  "jp": [
   "・・・でも"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/011d2",
  "speaker": 16,
  "jp": [
   "まったく、お人好しだよな、",
   "お前はマティアのことだけ心配",
   "してればいいんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/104/01242",
  "speaker": 16,
  "jp": [
   "ほら、今のうちだ！",
   "行くぞ！！"
  ],
  "en": ""
 },
