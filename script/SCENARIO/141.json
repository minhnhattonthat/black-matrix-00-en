  "en": ""
 },
 {
  "id": "SCENARIO/141/00340",
  "speaker": 0,
  "jp": [
   "自分では手を下せない代わりに",
   "誰かがこの記事に気付いて",
   "少女を助けに来て欲しいと"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/141/003d0",
  "speaker": 16,
  "jp": [
