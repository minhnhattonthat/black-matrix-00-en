[
 {
  "id": "SCENARIO/141/00104",
  "speaker": 0,
  "jp": [
   "なぁ雑記帳にあった",
   "あの書き込み、どう思う？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/141/0017e",
  "speaker": 16,
  "jp": [
   "『少女の命が危ない』っていう",
   "やつのことだよね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/141/001e8",
  "speaker": 0,
  "jp": [
   "少女とはやはり、インセストの",
   "ことなのでしょうか？"
