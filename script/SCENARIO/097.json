 {
  "id": "SCENARIO/097/0071c",
  "speaker": 16,
  "jp": [
   "ムカツクわね・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/097/00768",
  "speaker": 16,
  "jp": [
   "アラギにアベル・・・",
   "あの二人は、いったい・・・"
