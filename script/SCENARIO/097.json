  "en": ""
 },
 {
  "id": "SCENARIO/097/00976",
  "speaker": 0,
  "jp": [
   "っ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/097/009b8",
  "speaker": 16,
  "jp": [
