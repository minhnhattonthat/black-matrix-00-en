  "en": ""
 },
 {
  "id": "SCENARIO/097/005ce",
  "speaker": 16,
  "jp": [
   "手加減されたのよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/097/00606",
  "speaker": 0,
  "jp": [
   "嘘だろっ！？",
   "あれで、手加減されていたのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/097/00670",
  "speaker": 16,
  "jp": [
   "俺たちの追撃も",
   "あいつにとっては",
   "余興の一つでしかない"
