[
 {
  "id": "SCENARIO/122/0010a",
  "speaker": 0,
  "jp": [
   "・・・ふう、やれやれ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/0016a",
  "speaker": 16,
  "jp": [
   "おばちゃん",
   "シリアの様子は？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/001b2",
  "speaker": 0,
  "jp": [
   "なんとか落ち着いたみたいだよ",
   "今は寝ている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/001f8",
  "speaker": 16,
  "jp": [
   "ルカとザイオンの方は・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/0024c",
  "speaker": 0,
  "jp": [
   "見ての通り、手ぶらよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/0029e",
  "speaker": 16,
  "jp": [
   "・・・そうか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/0039e",
  "speaker": 16,
  "jp": [
   "シリアの翼は大丈夫なの？",
   "すごく痛そうだったけど・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/003fe",
  "speaker": 0,
  "jp": [
   "ヨハネさんが手際よく処置して",
   "くれたからね、安静にしてれば",
   "ちゃんと元通りになるよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00490",
  "speaker": 0,
  "jp": [
   "いや、一命を取り留めたのは",
   "彼女自身の生命力の強さだ",
   "四翼でなければ、今頃は・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/0050e",
  "speaker": 16,
  "jp": [
   "ルカもそんなこと言ってたけど",
   "翼の枚数が多いと何か違うの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00564",
  "speaker": 0,
  "jp": [
   "翼の数は、多ければ多いほど",
   "秘めたる潜在能力が強い",
   "回復力にも同じことが言える"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/005c8",
  "speaker": 0,
  "jp": [
   "しいたげられる身でありながら",
   "四翼、六翼の実力は、",
   "他の天使を凌駕する者が多い"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00654",
  "speaker": 0,
  "jp": [
   "でもさ、四翼や六翼は、",
   "天使社会じゃ認められないんだぜ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/006b6",
  "speaker": 16,
  "jp": [
   "・・・え、どうして？",
   "翼の枚数が多いほど",
   "すごい力を持っているんでしょ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/0075a",
  "speaker": 0,
  "jp": [
   "＜規格外＞だからだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/007a2",
  "speaker": 16,
  "jp": [
   "＜規格外＞？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/007d4",
  "speaker": 0,
  "jp": [
   "天使は自分たちを進化の終わり",
   "完全なる進化を遂げた種だと",
   "思っているからね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/0083c",
  "speaker": 0,
  "jp": [
   "本来天使は、",
   "二枚の白い翼と二つの性を持つ",
   "生き物だって話だけれどね・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/008a4",
  "speaker": 16,
  "jp": [
   "二つの性？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/008c8",
  "speaker": 0,
  "jp": [
   "男でもあり、",
   "女でもあるってことだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00900",
  "speaker": 0,
  "jp": [
   "天使は無性で生まれ、",
   "成長とともに、どちらかの性別に",
   "分かれるらしい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00964",
  "speaker": 16,
  "jp": [
   "それじゃあシリアは？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/009b4",
  "speaker": 0,
  "jp": [
   "ああ、いくら力を持っていようと",
   "通常と違う姿形で生まれた天使は",
   "＜規格外＞と呼ばれ、疎まれる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00a28",
  "speaker": 0,
  "jp": [
   "四翼、六翼・・・そして、",
   "灰色の羽根を持つこの私も",
   "＜規格外＞と呼ばれる存在だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00ab6",
  "speaker": 16,
  "jp": [
   "姿が違うだけなのに？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00b04",
  "speaker": 0,
  "jp": [
   "天使は二対の白き羽根を持つ者と",
   "決めてやがるんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00b50",
  "speaker": 16,
  "jp": [
   "・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00b94",
  "speaker": 0,
  "jp": [
   "それでも、四翼、六翼の",
   "優れた力を持つ天使達には、",
   "道がある"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00be8",
  "speaker": 0,
  "jp": [
   "だが、片翼の天使や",
   "障害を持って生まれた",
   "天使は・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00c34",
  "speaker": 0,
  "jp": [
   "どこかに欠陥があれば、",
   "それはもう、型から外れた",
   "＜規格外＞なんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00ca2",
  "speaker": 16,
  "jp": [
   "・・・そんなのって"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00cf0",
  "speaker": 0,
  "jp": [
   "そんなの間違ってる",
   "そう思うだろ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00d3e",
  "speaker": 16,
  "jp": [
   "うん、なんか変だよ",
   "みんな、色々違う部分があって",
   "当たり前じゃないか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00dae",
  "speaker": 0,
  "jp": [
   "そうだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00dd6",
  "speaker": 0,
  "jp": [
   "だから俺たちは",
   "そういう世界を",
   "変えようとしているんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00e4c",
  "speaker": 16,
  "jp": [
   "＜サイファーパンク＞の",
   "意志か"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00e88",
  "speaker": 0,
  "jp": [
   "教団の目指す世界は",
   "異質を許さない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00ec0",
  "speaker": 0,
  "jp": [
   "教団が目指すのは",
   "天使に仇なす全てを消し去った",
   "完璧に統制された世界だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00f44",
  "speaker": 16,
  "jp": [
   "・・・統制された・・世界"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/00f98",
  "speaker": 0,
  "jp": [
   "天使のばらまいた",
   "消毒薬まみれの白い世界",
   "そんなのアタシはごめんだわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/0101c",
  "speaker": 16,
  "jp": [
   "悪魔には生きづらそうだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/01056",
  "speaker": 16,
  "jp": [
   "元よりプロデヴォン教団には",
   "悪魔を生かしておくつもりは",
   "ないだろうが"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/010d8",
  "speaker": 0,
  "jp": [
   "天使の価値観から逸脱した全てを",
   "切り捨てた世界か・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/0114c",
  "speaker": 16,
  "jp": [
   "ボクにはよくわからないけど",
   "なんとなく、息苦しい世界に",
   "なっちゃうってことなのかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/011ce",
  "speaker": 0,
  "jp": [
   "たぶん、そうだろうな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/0124c",
  "speaker": 0,
  "jp": [
   "そろそろ本題に入るとしよう",
   "我々には考えなくてはならない",
   "課題が山積みだからな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/012c6",
  "speaker": 16,
  "jp": [
   "マティアとアラギ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/012e8",
  "speaker": 16,
  "jp": [
   "そして、",
   "シリアが助けようとしてた",
   "リリスって女の子だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/0133c",
  "speaker": 0,
  "jp": [
   "リリスをさらった謎の化け物たち",
   "も気になるな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/013a4",
  "speaker": 0,
  "jp": [
   "パスカとは別物みたいだけど",
   "意志が統率されている感じとか",
   "パスカによく似ていたわね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/01434",
  "speaker": 16,
  "jp": [
   "ああ、確かに"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/0147c",
  "speaker": 0,
  "jp": [
   "いつも通り地道に情報を",
   "稼ぐしかないか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/014ce",
  "speaker": 16,
  "jp": [
   "嫌なら正面から教会に",
   "殴り込むんだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/01530",
  "speaker": 16,
  "jp": [
   "ふふふ・・・",
   "死ぬ気があるのならね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/015b0",
  "speaker": 0,
  "jp": [
   "ダメだよ、ボクが死んだら",
   "マティアを悲しませるから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/016be",
  "speaker": 0,
  "jp": [
   "あーあ、また",
   "カインのマティアバカが始まった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/01716",
  "speaker": 16,
  "jp": [
   "・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/0175c",
  "speaker": 16,
  "jp": [
   "あんたのヴァルトス様バカより",
   "カインの方がマシだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/017ba",
  "speaker": 0,
  "jp": [
   "なんだよそれ！？",
   "尊敬してる人を想うことの",
   "どこが悪いんだよ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/01826",
  "speaker": 16,
  "jp": [
   "ま、人生において",
   "尊敬できる誰かに出会えるのは",
   "いいことだけどね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/0188a",
  "speaker": 16,
  "jp": [
   "尊敬している誰かの",
   "受け売りだけじゃなくて",
   "自分の言葉も持てなきゃ半人前さ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/01902",
  "speaker": 0,
  "jp": [
   "？？？",
   "なんだよそれ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/01962",
  "speaker": 16,
  "jp": [
   "とにかく",
   "気になることが多すぎる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/01998",
  "speaker": 16,
  "jp": [
   "情報を集め、一度どこかで",
   "整理をつけた方がいいだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/01a08",
  "speaker": 0,
  "jp": [
   "・・・そうだね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/01ac4",
  "speaker": 0,
  "jp": [
   "ここか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/01aee",
  "speaker": 0,
  "jp": [
   "・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/122/01b1a",
  "speaker": 0,
  "jp": [
   "間違いない",
   "声が聞こえたのは、ここだ"
  ],
  "en": ""
 },
