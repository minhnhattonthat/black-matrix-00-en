[
 {
  "id": "SCENARIO/182/00040",
  "jp": "ここまでをセーブしますか？",
  "en": ""
 },
 {
  "id": "SCENARIO/182/001da",
  "speaker": 16,
  "jp": [
   "ボクには、何も出来ない・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/00208",
  "speaker": 16,
  "jp": [
   "苦しむ女の子を救うことも、"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/00234",
  "speaker": 16,
  "jp": [
   "大勢の敵から、",
   "仲間を守ることも、"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/0026c",
  "speaker": 16,
  "jp": [
   "ボクはいつだって",
   "マティアのことばかり・・・",
   "自分のことでいっぱいで"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/002c8",
  "speaker": 16,
  "jp": [
   "自分勝手なことを言って",
   "何もかもなくすところだった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/00310",
  "speaker": 16,
  "jp": [
   "憧れていた",
   "特別な何かになりたい・・・",
   "特別な＜力＞が欲しいと・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/0039c",
  "speaker": 16,
  "jp": [
   "そのために翼がある"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/00406",
  "speaker": 16,
  "jp": [
   "そう思ってた・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/0042c",
  "speaker": 16,
  "jp": [
   "ボクは強くなった",
   "この翼があれば、",
   "みんなを救えるかもしれない！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/00484",
  "speaker": 16,
  "jp": [
   "・・・でも、違った"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/004a8",
  "speaker": 16,
  "jp": [
   "何でも出来るって、",
   "うぬぼれていただけだった・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/004f0",
  "speaker": 16,
  "jp": [
   "だから、無茶をして、",
   "みんなを危険な目に遭わせた"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/00534",
  "speaker": 16,
  "jp": [
   "だから、",
   "ヨハネを傷つけてしまった！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/00596",
  "speaker": 16,
  "jp": [
   "たとえ誰が死んでも、自分に",
   "責任があると思わなくていい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/0061e",
  "speaker": 16,
  "jp": [
   "違うよ・・・",
   "ヨハネが傷ついたのは",
   "ボクのせいだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/0068e",
  "speaker": 16,
  "jp": [
   "皆、誰に強制されるでもなく、",
   "自分の意志で動いている",
   "自分の命の責任は自分にある"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/00732",
  "speaker": 16,
  "jp": [
   "じゃあ、ヨハネはなんで",
   "ボクのそばに居てくれるの・・？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/0078a",
  "speaker": 16,
  "jp": [
   "答えてよ、ヨハネ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/007ba",
  "speaker": 16,
  "jp": [
   "ダメ・・・",
   "ヨハネまで行っちゃイヤだ！",
   "行かないで！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/00808",
  "speaker": 16,
  "jp": [
   "・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/00836",
  "speaker": 16,
  "jp": [
   "あんなにずっとそばにいたのに",
   "自分のわがままばかり言って",
   "ヨハネの気持ち、何も知らない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/008a4",
  "speaker": 16,
  "jp": [
   "ヨハネの願いは何？",
   "どうして、そばにいてくれるの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/008ec",
  "speaker": 16,
  "jp": [
   "ボクは、自分の気持ちばかりで、",
   "みんなの気持ちを踏みにじって",
   "いたのかもしれない・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/00958",
  "speaker": 16,
  "jp": [
   "ごめんなさい・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/0097c",
  "speaker": 16,
  "jp": [
   "謝らなきゃ・・・みんなに、"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/182/009a8",
  "speaker": 16,
  "jp": [
   "謝らなきゃ・・・・・・"
  ],
  "en": ""
 },
