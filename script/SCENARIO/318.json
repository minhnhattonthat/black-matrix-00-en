  "en": ""
 },
 {
  "id": "SCENARIO/318/015ac",
  "jp": "でも、何のために剣を取ったのか",
  "en": ""
 },
 {
  "id": "SCENARIO/318/015ce",
  "jp": "何を守りたかったのか・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/015ec",
  "jp": "それを忘れないで",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0161e",
