 },
 {
  "id": "SCENARIO/318/0136e",
  "jp": "貴方がカインのイメージと重ねた",
  "en": ""
 },
 {
  "id": "SCENARIO/318/01390",
  "jp": "だけで、コレは貴方の中の答え",
  "en": ""
 },
 {
  "id": "SCENARIO/318/013ce",
  "jp": "コレは貴方が諦めた理想だよ",
  "en": ""
 },
 {
  "id": "SCENARIO/318/013ec",
  "jp": "実現があまりにも困難だから、",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0140c",
  "jp": "捨て去ろうとした夢の欠片",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0144e",
  "jp": "本当は誰も殺したくなかった",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0146c",
  "jp": "全て、守りたかった・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/014a6",
  "jp": "父も・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/014b2",
