 },
 {
  "id": "SCENARIO/318/00fce",
  "jp": "貴方は剣を手にするの？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/01006",
  "jp": "殺したいから？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/01018",
  "jp": "それとも、守りたいから？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0105a",
  "jp": "守りたいからだ",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0106c",
  "jp": "守りたいと思ったからこそ、",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0108a",
  "jp": "私は剣を手に取ったのだ！！！",
  "en": ""
 },
 {
  "id": "SCENARIO/318/010ce",
  "jp": "シリアを守りたいのに",
  "en": ""
 },
 {
  "id": "SCENARIO/318/010e6",
  "jp": "シリアに剣を向けたのは何故？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0112a",
  "jp": "それは・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0115e",
  "jp": "大切なもの、守りたいものは",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0117c",
  "jp": "一つじゃなきゃいけないって",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0119a",
  "jp": "思ってない？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/011ce",
  "jp": "！",
  "en": ""
 },
 {
  "id": "SCENARIO/318/011fa",
  "jp": "欲張るのはいけないこと？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/01216",
  "jp": "ボクは全部守りたいんだ",
  "en": ""
 },
 {
  "id": "SCENARIO/318/01230",
  "jp": "ボクはもう、誰も失いたくない",
  "en": ""
 },
 {
  "id": "SCENARIO/318/01276",
  "jp": "それが、お前の答えなのか・・？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/012be",
  "jp": "ここは、貴方の心の中",
  "en": ""
 },
 {
  "id": "SCENARIO/318/012d6",
  "jp": "貴方の心が映し出した世界",
  "en": ""
 },
 {
  "id": "SCENARIO/318/012f2",
  "jp": "貴方だけしかいない世界",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0131c",
  "jp": "コレは、貴方が出した答えの一つ",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0134c",
  "jp": "カインという姿をしているだけで",
