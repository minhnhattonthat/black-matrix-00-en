[
 {
  "id": "SCENARIO/318/0014c",
  "speaker": null,
  "jp": [
   "父殺しめ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/001c4",
  "speaker": 1,
  "jp": [
   "違う、私はっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/002a6",
  "speaker": 16,
  "jp": [
   "お兄様が、",
   "お父様を殺したのですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/002f6",
  "speaker": 0,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00322",
  "speaker": 16,
  "jp": [
   "お父様は",
   "病気で亡くなられたって・・・",
   "わたしに嘘をついていたんですね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00396",
  "speaker": 0,
  "jp": [
   "違うんだ、シリア！",
   "あれはっ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00406",
  "speaker": 16,
  "jp": [
   "来ないで下さい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/0043e",
  "speaker": 0,
  "jp": [
   "！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/0049c",
  "speaker": 16,
  "jp": [
   "お兄様の嘘つき・・・",
   "お父様を、返してっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/004f2",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00602",
  "speaker": 16,
  "jp": [
   "どうして自分を偽るの？",
   "本当は優しい人なのに・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00656",
  "speaker": 16,
  "jp": [
   "本当は、貴方も弱い人なのに・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/0069e",
  "speaker": 0,
  "jp": [
   "私が弱い・・・",
   "ああ、確かにそうかもしれない",
   "私は決して、強くない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/0070e",
  "speaker": 16,
  "jp": [
   "貴方が自分を責める必要はないわ",
   "翼ある者も翼なき者も、誰もが",
   "弱い心を持っているのよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00786",
  "speaker": 16,
  "jp": [
   "怒り、高慢、虚栄、欺き、貪欲、",
   "妬み、渇望、不安、恐れ、",
   "ため込み、そして怠惰・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/007f0",
  "speaker": 16,
  "jp": [
   "人は、あらゆる負の感情に流され",
   "永遠に自分や誰かを傷つけ続ける",
   "愚かな生き物なのよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00866",
  "speaker": 16,
  "jp": [
   "誰も貴方に",
   "救いを求めてなんかいないのよ？",
   "貴方がいなくてもいいのよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/008d6",
  "speaker": 0,
  "jp": [
   "私は、必要とされない・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/0091a",
  "speaker": 16,
  "jp": [
   "そうよ、求められてもいないのに",
   "応えようとして、応えられなくて",
   "そこまでして戦う必要はないわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/0099a",
  "speaker": 16,
  "jp": [
   "貴方が苦しむ必要なんてないのよ",
   "全て、捨ててしまえばいいの",
   "全部いらない者達じゃない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00a12",
  "speaker": 16,
  "jp": [
   "あんな愚かで醜く弱い者達なんて",
   "この世界に必要なんてないわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00a80",
  "speaker": 0,
  "jp": [
   "・・・・・・・違う"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00aba",
  "speaker": 16,
  "jp": [
   "どうしたの、ベイル？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00af6",
  "speaker": 0,
  "jp": [
   "お前は、マティアなどではない！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00b36",
  "speaker": 0,
  "jp": [
   "あの少女は、いらない者など",
   "どこにもいないと言った！！",
   "誰にも、代わりなどいないと！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00c8e",
  "speaker": 16,
  "jp": [
   "愚かでも弱くても・・・",
   "生きてても良いの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00ce2",
  "speaker": 0,
  "jp": [
   "ああ、そうだ",
   "愚かさや弱さは誰もが持つもの",
   "私の中にも、それはある"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00d52",
  "speaker": 16,
  "jp": [
   "だったら、",
   "どうしてインセストを殺すの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00d9e",
  "speaker": 16,
  "jp": [
   "愚かな人も、か弱い人も",
   "生きていていいのに・・・",
   "インセストは殺してもいいの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00e1a",
  "speaker": 0,
  "jp": [
   "・・・・・それは"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00e52",
  "speaker": 16,
  "jp": [
   "何かのため・・・",
   "誰かのため・・・",
   "そうやってまた、殺すの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00ec0",
  "speaker": 16,
  "jp": [
   "どこまで殺し続ければ",
   "人は幸せになるの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00f0a",
  "speaker": 16,
  "jp": [
   "人を殺すのは、楽しい？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00f4a",
  "speaker": 0,
  "jp": [
   "斬るたびに、",
   "何かが麻痺してゆく・・・",
   "あんなものに、喜びなど感じない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/00fbe",
  "speaker": 16,
  "jp": [
   "じゃあ、何故",
   "貴方は剣を手にするの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/01006",
  "speaker": 16,
  "jp": [
   "殺したいから？",
   "それとも、守りたいから？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/0105a",
  "speaker": 0,
  "jp": [
   "守りたいからだ",
   "守りたいと思ったからこそ、",
   "私は剣を手に取ったのだ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/010ce",
  "speaker": 16,
  "jp": [
   "シリアを守りたいのに",
   "シリアに剣を向けたのは何故？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/0112a",
  "speaker": 0,
  "jp": [
   "それは・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/0115e",
  "speaker": 16,
  "jp": [
   "大切なもの、守りたいものは",
   "一つじゃなきゃいけないって",
   "思ってない？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/011ce",
  "speaker": 0,
  "jp": [
   "！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/011fa",
  "speaker": 16,
  "jp": [
   "欲張るのはいけないこと？",
   "ボクは全部守りたいんだ",
   "ボクはもう、誰も失いたくない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/01276",
  "speaker": 0,
  "jp": [
   "それが、お前の答えなのか・・？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/012be",
  "speaker": 16,
  "jp": [
   "ここは、貴方の心の中",
   "貴方の心が映し出した世界",
   "貴方だけしかいない世界"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/0131c",
  "speaker": 16,
  "jp": [
   "コレは、貴方が出した答えの一つ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/0134c",
  "speaker": 16,
  "jp": [
   "カインという姿をしているだけで",
   "貴方がカインのイメージと重ねた",
   "だけで、コレは貴方の中の答え"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/013ce",
  "speaker": 16,
  "jp": [
   "コレは貴方が諦めた理想だよ",
   "実現があまりにも困難だから、",
   "捨て去ろうとした夢の欠片"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/0144e",
  "speaker": 0,
  "jp": [
   "本当は誰も殺したくなかった",
   "全て、守りたかった・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/014a6",
  "speaker": 0,
  "jp": [
   "父も・・",
   "インセスト達も・・！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/014f2",
  "speaker": 16,
  "jp": [
   "それでも、まだ殺すの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/01532",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/0156e",
  "speaker": 16,
  "jp": [
   "貴方がどんな道を選ぼうと",
   "それは貴方の自由"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/015ac",
  "speaker": 16,
  "jp": [
   "でも、何のために剣を取ったのか",
   "何を守りたかったのか・・・",
   "それを忘れないで"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/0161e",
  "speaker": 16,
  "jp": [
   "さぁ・・起きよう、",
   "ベイル・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/051c0",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/318/051ce",
  "speaker": 16,
  "jp": [
   "ボンジュール"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/318/051e6",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/318/051f6",
  "speaker": 16,
  "jp": [
   "？？？"
  ],
  "en": ""
 }
