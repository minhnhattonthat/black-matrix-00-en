[
 {
  "id": "SCENARIO/318/0014c",
  "jp": "父殺しめ",
  "en": ""
 },
 {
  "id": "SCENARIO/318/001c4",
  "jp": "違う、私はっ！！",
  "en": ""
 },
 {
  "id": "SCENARIO/318/002a6",
  "jp": "お兄様が、",
  "en": ""
 },
 {
  "id": "SCENARIO/318/002b4",
  "jp": "お父様を殺したのですか？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/002f6",
  "jp": "！？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00322",
  "jp": "お父様は",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0032e",
  "jp": "病気で亡くなられたって・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0034e",
  "jp": "わたしに嘘をついていたんですね",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00396",
  "jp": "違うんだ、シリア！",
  "en": ""
 },
 {
  "id": "SCENARIO/318/003ac",
  "jp": "あれはっ！！！",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00406",
  "jp": "来ないで下さい",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0043e",
  "jp": "！",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0049c",
  "jp": "お兄様の嘘つき・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/004b4",
  "jp": "お父様を、返してっ！！",
  "en": ""
 },
 {
  "id": "SCENARIO/318/004f2",
  "jp": "・・・・・・・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00602",
  "jp": "どうして自分を偽るの？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0061c",
  "jp": "本当は優しい人なのに・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00656",
  "jp": "本当は、貴方も弱い人なのに・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0069e",
  "jp": "私が弱い・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/006b0",
  "jp": "ああ、確かにそうかもしれない",
  "en": ""
 },
 {
  "id": "SCENARIO/318/006d0",
  "jp": "私は決して、強くない",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0070e",
  "jp": "貴方が自分を責める必要はないわ",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00730",
  "jp": "翼ある者も翼なき者も、誰もが",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00750",
  "jp": "弱い心を持っているのよ",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00786",
  "jp": "怒り、高慢、虚栄、欺き、貪欲、",
  "en": ""
 },
 {
  "id": "SCENARIO/318/007a8",
  "jp": "妬み、渇望、不安、恐れ、",
  "en": ""
 },
 {
  "id": "SCENARIO/318/007c4",
  "jp": "ため込み、そして怠惰・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/007f0",
  "jp": "人は、あらゆる負の感情に流され",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00812",
  "jp": "永遠に自分や誰かを傷つけ続ける",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00834",
  "jp": "愚かな生き物なのよ",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00866",
  "jp": "誰も貴方に",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00874",
  "jp": "救いを求めてなんかいないのよ？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00896",
  "jp": "貴方がいなくてもいいのよ",
  "en": ""
 },
 {
  "id": "SCENARIO/318/008d6",
  "jp": "私は、必要とされない・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0091a",
  "jp": "そうよ、求められてもいないのに",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0093c",
  "jp": "応えようとして、応えられなくて",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0095e",
  "jp": "そこまでして戦う必要はないわ",
  "en": ""
 },
 {
  "id": "SCENARIO/318/0099a",
  "jp": "貴方が苦しむ必要なんてないのよ",
  "en": ""
 },
 {
  "id": "SCENARIO/318/009bc",
  "jp": "全て、捨ててしまえばいいの",
  "en": ""
 },
 {
  "id": "SCENARIO/318/009da",
  "jp": "全部いらない者達じゃない",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00a12",
  "jp": "あんな愚かで醜く弱い者達なんて",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00a34",
  "jp": "この世界に必要なんてないわ",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00a80",
  "jp": "・・・・・・・違う",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00aba",
  "jp": "どうしたの、ベイル？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00af6",
  "jp": "お前は、マティアなどではない！",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00b36",
  "jp": "あの少女は、いらない者など",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00b54",
  "jp": "どこにもいないと言った！！",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00b72",
  "jp": "誰にも、代わりなどいないと！！",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00c8e",
  "jp": "愚かでも弱くても・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00ca8",
  "jp": "生きてても良いの？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00ce2",
  "jp": "ああ、そうだ",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00cf2",
  "jp": "愚かさや弱さは誰もが持つもの",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00d12",
  "jp": "私の中にも、それはある",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00d52",
  "jp": "だったら、",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00d60",
  "jp": "どうしてインセストを殺すの？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00d9e",
  "jp": "愚かな人も、か弱い人も",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00db8",
  "jp": "生きていていいのに・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00dd4",
  "jp": "インセストは殺してもいいの？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00e1a",
  "jp": "・・・・・それは",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00e52",
  "jp": "何かのため・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00e66",
  "jp": "誰かのため・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00e7a",
  "jp": "そうやってまた、殺すの？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00ec0",
  "jp": "どこまで殺し続ければ",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00ed8",
  "jp": "人は幸せになるの？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00f0a",
  "jp": "人を殺すのは、楽しい？",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00f4a",
  "jp": "斬るたびに、",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00f5a",
  "jp": "何かが麻痺してゆく・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00f76",
  "jp": "あんなものに、喜びなど感じない",
  "en": ""
 },
 {
  "id": "SCENARIO/318/00fbe",
  "jp": "じゃあ、何故",
