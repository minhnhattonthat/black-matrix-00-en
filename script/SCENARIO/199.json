[
 {
  "id": "SCENARIO/199/00102",
  "speaker": 16,
  "jp": [
   "エクサル以下６名、",
   "入室許可願います！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00144",
  "speaker": 5,
  "jp": [
   "入室を許可する"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/0016c",
  "speaker": 17,
  "jp": [
   "し、失礼します！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00228",
  "speaker": 0,
  "jp": [
   "・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/0025a",
  "speaker": 19,
  "jp": [
   "うへぇ～ヴァルトス様",
   "黙ったままだよ",
   "やっぱり怒ってるのかな・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/002ea",
  "speaker": 19,
  "jp": [
   "黒羽根・・・",
   "この人がサイファーパンクの",
   "リーダー"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/0035c",
  "speaker": 16,
  "jp": [
   "あ、あの、",
   "先日は危ないところを助けて頂き",
   "ありがとうございました！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/003e6",
  "speaker": 0,
  "jp": [
   "その前に、",
   "自己紹介をさせてもらおうか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00436",
  "speaker": 16,
  "jp": [
   "あっ、そ、そうですね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00472",
  "speaker": 16,
  "jp": [
   "ボクはカインです",
   "それから・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/004ca",
  "speaker": 19,
  "jp": [
   "あれ・・なんだろう、",
   "この感じ・・この人、どこかで",
   "会ったことあるような・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00534",
  "speaker": 0,
  "jp": [
   "私はヴァルトス",
   "サイファーパンクを統べる者だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/0058a",
  "speaker": 16,
  "jp": [
   "あっ、えっと、",
   "それから・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/005c4",
  "speaker": 0,
  "jp": [
   "キミたちの事は全て聞いている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/0060a",
  "speaker": 16,
  "jp": [
   "えっ・・？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00630",
  "speaker": 0,
  "jp": [
   "キミたちが今まで関わってきた",
   "事件とそのてんまつも含めて",
   "全て知っていると言ったのだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/006b2",
  "speaker": 16,
  "jp": [
   "・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/006d8",
  "speaker": 0,
  "jp": [
   "ただ、付け加えて言うなら",
   "エクサルはもう少し、報告書の",
   "書き方を改善するべきだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00740",
  "speaker": 0,
  "jp": [
   "感情的な表現が多く、",
   "事件の要点が掴みづらかった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/007ac",
  "speaker": 16,
  "jp": [
   "・・・はい、スミマセン"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/007ea",
  "speaker": 19,
  "jp": [
   "トホホ、やっぱりお説教だよ・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00844",
  "speaker": 16,
  "jp": [
   "あのっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00876",
  "speaker": 0,
  "jp": [
   "・・・？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/008a6",
  "speaker": 16,
  "jp": [
   "私たちは、何の用件で",
   "呼ばれたんでしょうか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/008e8",
  "speaker": 16,
  "jp": [
   "私たち１人１人をつるし上げて",
   "断罪でもするおつもりですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00940",
  "speaker": 21,
  "jp": [
   "お、おい、",
   "失礼だぞ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00982",
  "speaker": 0,
  "jp": [
   "ステイエン"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/009a0",
  "speaker": 0,
  "jp": [
   "元、プロデヴォン教団の僧兵で",
   "屈強な剣の使い手"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00a04",
  "speaker": 0,
  "jp": [
   "そして、悪魔討伐隊を束ねる",
   "クレイス隊長の一番弟子"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00a62",
  "speaker": 17,
  "jp": [
   "・・・！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00a96",
  "speaker": 19,
  "jp": [
   "クレイス様のことまで・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00ac8",
  "speaker": 16,
  "jp": [
   "そう、",
   "私は・・・元教団の人間です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00b00",
  "speaker": 16,
  "jp": [
   "異端審問と称し、",
   "アナタ方サイファーパンクとも",
   "何度も戦ってきました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00b64",
  "speaker": 0,
  "jp": [
   "・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00bf6",
  "speaker": 16,
  "jp": [
   "教団の教義と反する考え方を持つ",
   "あなた方サイファーパンクに",
   "とって"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00c66",
  "speaker": 16,
  "jp": [
   "私が邪魔だというなら、",
   "ハッキリそう言って下さい！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00d20",
  "speaker": 16,
  "jp": [
   "お前・・そんなことを",
   "考えてたのか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00d64",
  "speaker": 5,
  "jp": [
   "報告書：",
   "ステイエンに関する所見"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00dda",
  "speaker": 0,
  "jp": [
   "・・・？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00dfc",
  "speaker": 5,
  "jp": [
   "気が強い上に腕力もあり",
   "並の男では太刀打ちできない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00e44",
  "speaker": 5,
  "jp": [
   "だが、メガネも似合うし",
   "黙ってりゃカワイイと思う"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00ebc",
  "speaker": 17,
  "jp": [
   "・・・！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00f34",
  "speaker": 0,
  "jp": [
   "な、ななっ・・！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/00fac",
  "speaker": 0,
  "jp": [
   "エクサルの報告書は",
   "間違っていないようだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/010b8",
  "speaker": 16,
  "jp": [
   "あっ、ちょ、ちょっと",
   "ヴァルトス様っ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/01128",
  "speaker": 17,
  "jp": [
   "エ～ク～サ～ル～っ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/01194",
  "speaker": 0,
  "jp": [
   "ハハハ、",
   "そう怒らないでやってくれ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/011cc",
  "speaker": 0,
  "jp": [
   "落ち着いて私の話を",
   "聞いてはくれないか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/01210",
  "speaker": 21,
  "jp": [
   "そ、そうだ！",
   "今は大事な話の途中だぞ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/0129a",
  "speaker": 16,
  "jp": [
   "ハッ！",
   "ヤダ・・あたしったら"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/012e2",
  "speaker": 0,
  "jp": [
   "そういえば、黒羽根の２人の",
   "姿が見えないようだが・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/01342",
  "speaker": 16,
  "jp": [
   "２人なら出て行きました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/0136c",
  "speaker": 16,
  "jp": [
   "私たちとはきっと",
   "ウマが合わないんです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/013b0",
  "speaker": 0,
  "jp": [
   "キミの場合、彼らと言うより、",
   "黒羽根そのものを",
   "嫌悪しているのではないかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/0142a",
  "speaker": 16,
  "jp": [
   "・・・！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/01472",
  "speaker": 16,
  "jp": [
   "・・えぇ、",
   "その通りです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/014a0",
  "speaker": 16,
  "jp": [
   "弟のことがなければ、",
   "きっと今でも私は教団に居て、"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/014e8",
  "speaker": 16,
  "jp": [
   "悪魔討伐をしていたと",
   "思います・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/01548",
  "speaker": 16,
  "jp": [
   "・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/0158c",
  "speaker": 16,
  "jp": [
   "でも悪魔討伐は、",
   "サイファーパンクもすると",
   "聞きました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/015d8",
  "speaker": 16,
  "jp": [
   "だからプロデヴォン教団は、",
   "あなた方を一方的に",
   "弾圧することもなかった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/0163c",
  "speaker": 0,
  "jp": [
   "我々は、黒羽根が",
   "俗に言う悪魔という存在だから",
   "討伐していたワケではない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/0169c",
  "speaker": 0,
  "jp": [
   "＜渇き＞に襲われた悪魔は",
   "それ以外に救う方法が",
   "無いからだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/016f4",
  "speaker": 16,
  "jp": [
   "だから、",
   "それが悪魔なんでしょう？",
   "同じことじゃないんですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/0176e",
  "speaker": 0,
  "jp": [
   "君は、",
   "渇きの苦しみを知っているのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/017bc",
  "speaker": 0,
  "jp": [
   "黒羽根の一族のみが持つ",
   "呪われた宿命の、",
   "その本当の姿を・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/05398",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/199/053a6",
  "speaker": 0,
  "jp": [
   "ボンジュール"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/199/053be",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/199/053ce",
  "speaker": 0,
  "jp": [
   "？？？"
  ],
  "en": ""
 }
