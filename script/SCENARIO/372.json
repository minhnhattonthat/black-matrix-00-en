   "このプロデヴォン教団には",
   "貴様の力が必要だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/02d1a",
  "speaker": 0,
  "jp": [
   "やれやれ、これでまた",
   "引退はしばらくお預けだね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/02e82",
  "speaker": 6,
  "jp": [
   "こらーっ！！！！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/02ef0",
  "speaker": 0,
  "jp": [
   "まったく・・・",
   "逃げ足だけは早いんだから・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/02f72",
  "speaker": 16,
  "jp": [
   "ふぁぁぁぁ・・・",
   "おはよう、マティア",
   "どうしたの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/02fe0",
  "speaker": 1,
  "jp": [
   "もう、聞いてよカイン！",
   "ゼロったらヒドイのよっ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/0303a",
  "speaker": 16,
  "jp": [
   "あははっ",
   "また、何かしでかしたの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03078",
  "speaker": 1,
  "jp": [
   "寝ているわたしの枕元に",
   "カエルを置いてったのよ！！",
   "信じられないっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/030f8",
  "speaker": 16,
  "jp": [
   "あははっ",
   "可愛いイタズラじゃないか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03154",
  "speaker": 1,
  "jp": [
   "可愛くなんかないわよっ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03196",
  "speaker": 16,
  "jp": [
   "でも、ほら・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/031c6",
  "speaker": 16,
  "jp": [
   "見た目はボクらと変わらないけど",
   "ゼロはまだ生まれたばかりの",
   "子供なんだよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03228",
  "speaker": 16,
  "jp": [
   "だから、それくらい・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03278",
  "speaker": 1,
  "jp": [
   "もう、カインがそうやって",
   "ゼロを甘やかしてるから",
   "いけないのよっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/032ea",
  "speaker": 16,
  "jp": [
   "甘やかしてなんか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/0333e",
  "speaker": 1,
  "jp": [
   "いいえ",
   "絶対に甘やかしてるわっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/0339c",
  "speaker": 16,
  "jp": [
   "マティアさん、落ち着いて・・",
   "ゼロには後でわたしからちゃんと",
   "叱っておきますから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/0341a",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/0344e",
  "speaker": 0,
  "jp": [
   "ゼロは",
   "カインとレアの言うことなら",
   "大人しく何でも聞くんだから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/034b2",
  "speaker": 0,
  "jp": [
   "わたしの言うことだって",
   "少しくらい聞いてくれても",
   "いいのに・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03518",
  "speaker": 16,
  "jp": [
   "素直になれないだけですよ",
   "きっと・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03566",
  "speaker": 0,
  "jp": [
   "いいわよ",
   "カインが甘やかし担当なら",
   "わたしがしっかり教育するわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/035c4",
  "speaker": 16,
  "jp": [
   "ふふふふっ",
   "マティアさんったら"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/0360e",
  "speaker": 0,
  "jp": [
   "あ、もうすぐ朝食の準備が",
   "出来るから・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03654",
  "speaker": 16,
  "jp": [
   "わかりました",
   "すぐにゼロを呼んできますね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/036a6",
  "speaker": 0,
  "jp": [
   "ええ、お願いするわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/037a4",
  "speaker": 5,
  "jp": [
   "ゼロ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/037fc",
  "speaker": 16,
  "jp": [
   "レア・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03844",
  "speaker": 0,
  "jp": [
   "聞きましたよ",
   "マティアさんの寝室に",
   "カエルを忍び込ませたって"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/038ae",
  "speaker": 16,
  "jp": [
   "アイツが悪いんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/038ea",
  "speaker": 16,
  "jp": [
   "バケツみたいにでかい",
   "カエルを見たって言ったら",
   "アイツ、信じなかったんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/0395e",
  "speaker": 16,
  "jp": [
   "だから、証拠に",
   "捕まえてきてやったのに・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/039b6",
  "speaker": 0,
  "jp": [
   "マティアさんのこと",
   "好きなんですね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03a02",
  "speaker": 17,
  "jp": [
   "なんでそうなるんだよっ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03a38",
  "speaker": 0,
  "jp": [
   "あら、違うんですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03a76",
  "speaker": 16,
  "jp": [
   "別に・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03a9c",
  "speaker": 16,
  "jp": [
   "カインとお前の次にだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03acc",
  "speaker": 0,
  "jp": [
   "わたしも",
   "二人のことがとても好きです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03b1a",
  "speaker": 16,
  "jp": [
   "オレのことは？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03b52",
  "speaker": 0,
  "jp": [
   "貴方はわたしにとって一番の人",
   "唯一の人でした・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03ba0",
  "speaker": 0,
  "jp": [
   "でも、今は違います"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03bda",
  "speaker": 17,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03bf8",
  "speaker": 0,
  "jp": [
   "たくさんの",
   "信じられるモノがある中で"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03c46",
  "speaker": 0,
  "jp": [
   "貴方は、唯一ではなく",
   "たくさんの大切なモノの中で",
   "一番大切な人です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03cb6",
  "speaker": 16,
  "jp": [
   "レア・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03cea",
  "speaker": 16,
  "jp": [
   "・・・でも、いいのかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03d1c",
  "speaker": 0,
  "jp": [
   "何が、ですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03d44",
  "speaker": 16,
  "jp": [
   "オレは、取り返しのつかない",
   "大変なことをしてきたのに・・",
   "いいのかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03da8",
  "speaker": 16,
  "jp": [
   "たくさん償わなきゃいけないのに",
   "オレ、こんなに幸せで・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03e0e",
  "speaker": 0,
  "jp": [
   "貴方が不幸になっても",
   "傷ついた人達が幸せになるわけ",
   "ではありません"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03e7e",
  "speaker": 16,
  "jp": [
   "・・・わかっている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03eac",
  "speaker": 0,
  "jp": [
   "我々は生かされたのです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03eea",
  "speaker": 0,
  "jp": [
   "生きて償いましょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03f26",
  "speaker": 16,
  "jp": [
   "ああ・・・",
   "そうだな、レア"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03f5c",
  "speaker": 16,
  "jp": [
   "オレはこの世界の人間になれた"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/03f94",
  "speaker": 16,
  "jp": [
   "生きて・・",
   "この世界に償いをしよう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/040d4",
  "speaker": 0,
  "jp": [
   "マティア・・・",
   "聞いて欲しいことがあるんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/0413c",
  "speaker": 16,
  "jp": [
   "なぁに？",
   "急に真面目な顔しちゃって・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/04180",
  "speaker": 0,
  "jp": [
   "ボクはこの本を封印しようと",
   "思ってる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/041ce",
  "speaker": 16,
  "jp": [
   "本って・・・",
   "それは"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/04200",
  "speaker": 0,
  "jp": [
   "＜ヨハネの書＞",
   "第一次倒立樹計画の",
   "あらゆる知識が詰め込まれた本"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/04258",
  "speaker": 0,
  "jp": [
   "そして、歴史では語られない",
   "天使メフィストの",
   "真実の姿をつづった本・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/042ce",
  "speaker": 16,
  "jp": [
   "過ぎたる知識は災いを呼ぶ・・",
   "そういうことね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/04326",
  "speaker": 0,
  "jp": [
   "うん、だからボクは、この本を",
   "燃やしてしまおうかと思ったんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/04386",
  "speaker": 0,
  "jp": [
   "でも、この本を必要とする人が",
   "現れるかもしれない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/043cc",
  "speaker": 0,
  "jp": [
   "だから",
   "ボクはこの本を封印するよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/04408",
  "speaker": 16,
  "jp": [
   "そうね・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/04424",
  "speaker": 16,
  "jp": [
   "真に求める者だけが解ける封印",
   "でも、力に負けない心を持つ者",
   "でなければ解けない封印・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/044a2",
  "speaker": 16,
  "jp": [
   "そういう条件付きの",
   "封印とか出来ないかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/044f6",
  "speaker": 0,
  "jp": [
   "うーん、難しそうだけど",
   "頑張ってみるよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/04546",
  "speaker": 16,
  "jp": [
   "でも、こんな知識",
   "必要とされない方がいいわ・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/0459e",
  "speaker": 0,
  "jp": [
   "うん、そうだね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/045ce",
  "speaker": 0,
  "jp": [
   "でも、誰かがこの本を開くまで",
   "本当のメフィストさんの姿も",
   "知られないままなのかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/04640",
  "speaker": 16,
  "jp": [
   "みんなが知らなくても",
   "わたし達が知っている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/0468e",
  "speaker": 16,
  "jp": [
   "きっと、それでいいのよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/046ce",
  "speaker": 0,
  "jp": [
   "うん、そうだね・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/0470a",
  "speaker": 16,
  "jp": [
   "ねぇ、カイン・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/04746",
  "speaker": 0,
  "jp": [
   "なぁに、マティア？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/04774",
  "speaker": 16,
  "jp": [
   "ずっと聞きたかったことがあるの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/047ba",
  "speaker": 0,
  "jp": [
   "聞きたかったこと？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/047f6",
  "speaker": 16,
  "jp": [
   "名前、このままでもいいの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/0482c",
  "speaker": 0,
  "jp": [
   "・・え？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/0485e",
  "speaker": 16,
  "jp": [
   "だって",
   "本当の貴方の名前は・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/048aa",
  "speaker": 0,
  "jp": [
   "うーん、みんなが混乱するから",
   "カインのままでいいよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/04906",
  "speaker": 16,
  "jp": [
   "でも・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/0493a",
  "speaker": 0,
  "jp": [
   "それじゃあ",
   "二人っきりの時は",
   "ボクを本当の名前で呼んで"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/0499e",
  "speaker": 16,
  "jp": [
   "ええ、わかったわ",
   "アベル"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/04bb4",
  "jp": "ここまでをセーブしますか？",
  "en": ""
 },
 {
  "id": "SCENARIO/372/04c00",
  "jp": "クリアデータがセーブされません",
  "en": ""
 },
 {
  "id": "SCENARIO/372/04c22",
  "jp": "よろしいですか？",
  "en": ""
 },
 {
  "id": "SCENARIO/372/08764",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/372/08772",
  "speaker": 16,
  "jp": [
   "ボンジュール"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/372/0878a",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/372/0879a",
  "speaker": 16,
  "jp": [
   "？？？"
  ],
  "en": ""
 }
