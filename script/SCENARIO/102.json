  "en": ""
 },
 {
  "id": "SCENARIO/102/008b0",
  "speaker": 0,
  "jp": [
   "どうせ、他にあてもないんだろ？",
   "だったら少しくらい付き合えよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/00928",
  "speaker": 0,
  "jp": [
   "正論だな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/00944",
  "speaker": 0,
  "jp": [
   "我々は地道に進むしかない",
   "焦りからは過失しか生まれぬ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/009b4",
  "speaker": 16,
  "jp": [
   "・・・・・・ちっ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/00a08",
  "speaker": 16,
  "jp": [
   "だったら・・・",
   "少しくらい血を見ても",
   "嫌だとか騒がないでいられる？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/00a88",
  "speaker": 0,
  "jp": [
   "え？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/00ab6",
  "speaker": 16,
  "jp": [
   "出来るの？",
   "出来ないの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/00afa",
