[
 {
  "id": "SCENARIO/102/00104",
  "speaker": 0,
  "jp": [
   "ラメル教会に子供達が集められて",
   "いるって・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/00172",
  "speaker": 0,
  "jp": [
   "もしかしたら、",
   "マティアもここにいるのかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/001dc",
  "speaker": 16,
  "jp": [
   "確証はないが、今の我々には",
   "他に手がかりが無いんだ",
   "行ってみるしかあるまい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/00276",
  "speaker": 16,
  "jp": [
   "・・・俺は行かないぞ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/002b2",
  "speaker": 0,
  "jp": [
   "ザイオン？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/002e6",
  "speaker": 16,
  "jp": [
   "俺たちの目的はアラギだ",
   "そこにアラギがいるとは思えない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/00338",
  "speaker": 0,
  "jp": [
   "ルカはどうするの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/00384",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/003dc",
  "speaker": 0,
  "jp": [
   "ルカ、どうしたの？",
   "元気がないみたいだけど"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/00464",
  "speaker": 16,
  "jp": [
   "うるさいっ！！",
   "アタシに構うなっ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/00514",
  "speaker": 0,
  "jp": [
   "うわっ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/00554",
  "speaker": 16,
  "jp": [
   "・・・あ、悪かったね",
   "少し考え事をしていたから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/005d2",
  "speaker": 0,
  "jp": [
   "大丈夫？",
   "少し顔色が悪いみたい・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/00622",
  "speaker": 16,
  "jp": [
   "少しイライラしているだけよ",
   "いちいち人の顔色うかがわないで"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/0069a",
  "speaker": 0,
  "jp": [
   "・・・・ご、ごめんなさい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/0077a",
  "speaker": 16,
  "jp": [
   "アタシ達は",
   "早くアラギを捕まえたいの",
   "無駄足を踏んでる余裕はないわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/007d4",
  "speaker": 16,
  "jp": [
   "行くならアンタ達だけで行きな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/102/0082c",
  "speaker": 0,
  "jp": [
   "いいのかな～そんなこと言って",
   "もし、＜インセスト＞を狙う",
   "アラギがいたらどーする？"
