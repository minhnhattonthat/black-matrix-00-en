[
 {
  "id": "SCENARIO/034/000fa",
  "speaker": 16,
  "jp": [
   "まさか、パスカの群れが",
   "用意されていたとはな・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/034/00168",
  "speaker": 0,
  "jp": [
   "だから、遺跡の奥に行くのは",
