  "en": ""
 },
 {
  "id": "SCENARIO/244/009d8",
  "speaker": 0,
  "jp": [
   "ベイル様・・・貴方を、",
   "迎え入れるワケにはいきません"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/00a36",
  "speaker": 16,
  "jp": [
   "なんだと？"
