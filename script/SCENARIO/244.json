[
 {
  "id": "SCENARIO/244/0010c",
  "speaker": 0,
  "jp": [
   "いかん・・世界樹の崩壊が",
   "どんどん加速している",
   "このままではマズイ・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/00170",
  "speaker": 3,
  "jp": [
   "サンバルテルミの世界樹は、",
   "その老齢ゆえに、いつ死んでも",
   "おかしくない状態だった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/001e0",
  "speaker": 3,
  "jp": [
   "しかし、",
   "ホワイトフェイス様の命で",
   "＜彼女＞を実験体として以来、"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/00240",
  "speaker": 3,
  "jp": [
   "崩壊の危機を乗り越え、",
   "安定していたハズだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/0029c",
  "speaker": 3,
  "jp": [
   "いったい、何が",
   "起こったというんだ？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/00352",
  "speaker": 1,
  "jp": [
   "ぐわあぁっっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/0039c",
  "speaker": 16,
  "jp": [
   "限界だ！！",
   "この地下施設はもうもたん！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/00412",
  "speaker": 16,
  "jp": [
   "実験体ごと、ここを放棄するぞ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/0044c",
  "speaker": 0,
  "jp": [
   "馬鹿な！＜倒立樹計画＞の",
   "要となるインセストを、",
   "失うわけにはいかん！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/004b4",
  "speaker": 16,
  "jp": [
   "しかし、あの娘が居ればこそ",
   "世界樹の崩壊も、",
   "いまの状態でとどまっている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/00514",
  "speaker": 16,
  "jp": [
   "どのみちホワイトフェイス様しか",
   "切り離すことも出来んのだ、",
   "ここに捨てていくしかない！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/005ac",
  "speaker": 16,
  "jp": [
   "貴様ら、",
   "それでも誇り高き天使なのか！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/005f0",
  "speaker": 1,
  "jp": [
   "？！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/0061e",
  "speaker": 16,
  "jp": [
   "少女１人の命も省みない者に、",
   "人民を導き、神の代弁者たる",
   "天使の資格はない！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/00688",
  "speaker": 0,
  "jp": [
   "べ・・ベイルさま、",
   "何故このような所に・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/006d0",
  "speaker": 16,
  "jp": [
   "インセスト達を保護し、",
   "ここを脱出する"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/244/0070c",
  "speaker": 16,
  "jp": [
   "彼らはどこだ！ここにはまだ",
   "大勢残されているハズだ"
