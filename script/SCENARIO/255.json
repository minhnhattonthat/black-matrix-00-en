[
 {
  "id": "SCENARIO/255/00114",
  "speaker": 16,
  "jp": [
   "ここはいったいどこなんだ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/00170",
  "speaker": 0,
  "jp": [
   "少なくとも人間が住んでるとは",
   "思えない場所ですね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/001ec",
  "speaker": 16,
  "jp": [
   "人が住むような場所に",
   "見えなくて悪かったわね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/0023a",
  "speaker": 16,
  "jp": [
   "ここはアタシ達の故郷",
   "慟哭の５５５日戦争に敗れた",
   "黒羽根達が隠れ住む地下世界よ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/002d0",
  "speaker": 0,
  "jp": [
   "地下世界？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/002f4",
  "speaker": 16,
  "jp": [
   "アンタ達が住む地上の世界、",
   "その地下に広がる",
   "巨大な地下空洞のことよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/00380",
  "speaker": 0,
  "jp": [
   "教団も手こずるはずだわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/003b6",
  "speaker": 0,
  "jp": [
   "探していた悪魔の拠点が",
   "こんな地下にあるなんて、誰も",
   "想像出来なかったでしょうね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/00432",
  "speaker": 16,
  "jp": [
   "知ったところで、迷宮のような",
   "幽葬の地下通路があるからね、",
   "ここにたどり着くのは難しいわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/004d0",
  "speaker": 0,
  "jp": [
   "まさに、自然の城塞ですね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/00512",
  "speaker": 16,
  "jp": [
   "城塞なんかじゃない",
   "ここは監獄よ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/00556",
  "speaker": 16,
  "jp": [
   "ここの生活は",
   "そんなに楽なものじゃない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/005c0",
  "speaker": 0,
  "jp": [
   "ここ一帯の地形には見覚えがある",
   "俺たちの村からそう遠くない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/00640",
  "speaker": 16,
  "jp": [
   "ルカやザイオン達の故郷？",
   "リリス行ってみた～い！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/006b4",
  "speaker": 0,
  "jp": [
   "フフ、何もない場所だけど",
   "ここでじっとしているよりは",
   "マシだろうね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/0073c",
  "speaker": 16,
  "jp": [
   "俺たちが・・行ってもいいのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/00782",
  "speaker": 0,
  "jp": [
   "何が言いたいの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/007ba",
  "speaker": 16,
  "jp": [
   "だって、俺たちの中には白羽根も",
   "いるし、それに・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/0081a",
  "speaker": 0,
  "jp": [
   "なぁに、大勢の悪魔に囲まれる",
   "のが怖いとでも言うの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/0087a",
  "speaker": 16,
  "jp": [
   "いや、別にそういうわけじゃ",
   "ないんだけどさ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/008ce",
  "speaker": 0,
  "jp": [
   "話すより見た方が早いわよ",
   "ぐずぐずしてると置いてくよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/00960",
  "speaker": 0,
  "jp": [
   "だ、大丈夫なのかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/00990",
  "speaker": 16,
  "jp": [
   "ちょっと怖いですけど",
   "とにかく行ってみましょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/255/044f8",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/255/04506",
