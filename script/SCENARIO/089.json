 {
  "id": "SCENARIO/089/010e0",
  "speaker": 16,
  "jp": [
   "ふむ・・一理あるな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/089/01104",
  "speaker": 16,
  "jp": [
   "個人では、いずれ近いうちに",
