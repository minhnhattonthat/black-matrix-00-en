  "en": ""
 },
 {
  "id": "SCENARIO/089/0060a",
  "speaker": 0,
  "jp": [
   "ううう・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/089/00628",
  "speaker": 0,
  "jp": [
   "もっと早くに言ってくれれば",
   "ボクだって翼を使ったのに"
