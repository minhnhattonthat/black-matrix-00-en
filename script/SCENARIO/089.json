 },
 {
  "id": "SCENARIO/089/00afc",
  "speaker": 16,
  "jp": [
   "自分の仕事は大丈夫なのかね？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/089/00b42",
  "speaker": 0,
  "jp": [
   "いっけねぇ！",
   "すっかり忘れてた！！"
