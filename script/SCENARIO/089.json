  "en": ""
 },
 {
  "id": "SCENARIO/089/00cec",
  "speaker": 16,
  "jp": [
   "・・・そうだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/089/00d34",
  "speaker": 0,
  "jp": [
   "なぁ、あんたたち",
   "＜サイファーパンク＞の",
