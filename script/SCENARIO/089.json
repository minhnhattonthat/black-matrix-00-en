  "en": ""
 },
 {
  "id": "SCENARIO/089/00f9c",
  "speaker": 16,
  "jp": [
   "何か含みを感じるが・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/089/00fde",
  "speaker": 0,
  "jp": [
   "そりゃ",
   "俺にだって下心はあるさ"
