  "en": ""
 },
 {
  "id": "SCENARIO/089/00678",
  "speaker": 16,
  "jp": [
   "言う暇もなかっただろう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/089/006cc",
  "speaker": 0,
  "jp": [
   "・・・あれ？",
   "黒羽根の二人は？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/089/00716",
  "speaker": 16,
  "jp": [
   "偶然居合わせただけの",
   "仲だからな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/089/0074c",
  "speaker": 16,
  "jp": [
   "彼らは彼らで",
   "うまく逃げただろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/089/00796",
  "speaker": 0,
  "jp": [
   "・・・それにしても",
   "今日は本当に死ぬかと思ったよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/089/00804",
  "speaker": 0,
  "jp": [
   "そうだね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/089/00836",
  "speaker": 16,
  "jp": [
   "街に来たばかりだというのに",
   "この調子では後が怖いな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/089/008a4",
  "speaker": 0,
  "jp": [
   "・・・はぁ、この騒ぎだし",
   "＜サイファーパンク＞には",
   "誤魔化しきれないだろうな～"
