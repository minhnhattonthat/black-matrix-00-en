  "en": ""
 },
 {
  "id": "SCENARIO/089/00db0",
  "speaker": 16,
  "jp": [
   "え？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/089/00dd0",
  "speaker": 0,
  "jp": [
   "さっきの戦いは",
   "さすがに相手が悪かったけど",
   "なかなか腕が立つみたいだし"
