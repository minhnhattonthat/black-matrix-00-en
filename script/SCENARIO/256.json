[
 {
  "id": "SCENARIO/256/0012c",
  "speaker": 0,
  "jp": [
   "ここがルカたちの故郷？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/0017c",
  "speaker": 16,
  "jp": [
   "リリス、ツタがからまった",
   "石のお城とか想像してたけど",
   "ちょっと違うね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/00210",
  "speaker": 0,
  "jp": [
   "もっとおどろおどろしいものを",
   "想像してたけど、外から見た",
   "感じは案外普通っぽいわね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/002a8",
  "speaker": 16,
  "jp": [
   "ええ、少しほっとしました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/00304",
  "speaker": 0,
  "jp": [
   "見た目で判断しちゃダメだよ",
   "中に入ったらスゴイものを見る",
   "かもしれないんだから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/00376",
  "speaker": 0,
  "jp": [
   "下手に安心していたら",
   "心臓が飛び出るほど怖いものを",
   "見てしまうかもしれないよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/00408",
  "speaker": 16,
  "jp": [
   "こ、怖いものって・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/00460",
  "speaker": 0,
  "jp": [
   "変な想像ふくらませなくても",
   "見たまんまの何にもない場所だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/004c6",
  "speaker": 16,
  "jp": [
   "そ、そうなんだ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/0051c",
  "speaker": 0,
  "jp": [
   "馬鹿なマネさえしなければ",
   "流血沙汰も回避出来るだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/00594",
  "speaker": 16,
  "jp": [
   "りゅ、流血沙汰って・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/005de",
  "speaker": 0,
  "jp": [
   "まぁ、せいぜい",
   "背中に気をつけることだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/00632",
  "speaker": 16,
  "jp": [
   "・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/00684",
  "speaker": 0,
  "jp": [
   "心配しなくてもアタシ達の一族は",
   "ウンダ様の言葉に従い、むやみな",
   "争いはしないから大丈夫だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/00724",
  "speaker": 16,
  "jp": [
   "ウンダ様とは？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/0075a",
  "speaker": 0,
  "jp": [
   "アタシ達一族の長老で",
   "パスカのペインリングの守人",
   "だった人だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/007b8",
  "speaker": 16,
  "jp": [
   "守人ということはペインリングに",
   "関してかなり詳しい人物という",
   "ことか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/0082a",
  "speaker": 0,
  "jp": [
   "そうね、ウンダ様なら",
   "アンタが聞きたがってるような",
   "小難しい話も答えられるはずよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/00890",
  "speaker": 0,
  "jp": [
   "詳しい話が聞きたけりゃ、",
   "謁見出来るように話をしておくよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/008e4",
  "speaker": 16,
  "jp": [
   "すまない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/0091e",
  "speaker": 0,
  "jp": [
   "それじゃあアタシ達は、",
   "一足先にウンダ様に",
   "アラギの件を報告しに行くよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/0097c",
  "speaker": 0,
  "jp": [
   "アンタ達はその間、",
   "村の見物でもしてるといいよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/009e8",
  "speaker": 16,
  "jp": [
   "ボク達だけで村の中を歩いたり",
   "しても大丈夫なの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/00a5c",
  "speaker": 0,
  "jp": [
   "心配するな",
   "村の奴らに話はつけておいてやる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/00aaa",
  "speaker": 0,
  "jp": [
   "だが、この村に黒羽根以外の者が",
   "足を踏み入れるのは初めてだ",
   "おかしなマネはするなよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/256/00b2a",
  "speaker": 16,
  "jp": [
   "・・・はい"
  ],
  "en": ""
 },
