  "en": ""
 },
 {
  "id": "SCENARIO/161/004f4",
  "speaker": null,
  "jp": [
   "子供は目を離すと急に具合が",
   "悪くなったりして、大変なの",
   "リリスにも気をつけてあげてね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/161/0058c",
  "jp": "構成員・若者",
  "en": ""
 },
 {
  "id": "SCENARIO/161/005a2",
  "speaker": null,
  "jp": [
   "エクサルは、一見",
