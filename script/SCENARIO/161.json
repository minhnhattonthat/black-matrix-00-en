 },
 {
  "id": "SCENARIO/161/0038c",
  "jp": "構成員・男",
  "en": ""
 },
 {
  "id": "SCENARIO/161/003a0",
  "speaker": null,
  "jp": [
   "エクサルと会えたか？"
