  "en": ""
 },
 {
  "id": "SCENARIO/161/00318",
  "jp": "構成員・男",
  "en": ""
 },
 {
  "id": "SCENARIO/161/0032c",
  "speaker": null,
  "jp": [
   "そう言えば、",
   "エクサルが捜してたぞ",
   "雑記帳に何か書いてないか？"
