  "en": ""
 },
 {
  "id": "SCENARIO/189/001d8",
  "speaker": 16,
  "jp": [
   "そんなことより、"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/001fc",
  "speaker": 16,
  "jp": [
   "キロタが死ぬかもしれないって",
   "どういうことなのよ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/0025a",
  "speaker": 0,
  "jp": [
   "これから教団で",
   "大きな実験があるそうなの",
   "その実験にあの子が・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/002ca",
  "speaker": 16,
  "jp": [
   "それで、キロタはどこ？",
   "連れ出して来たんでしょ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00326",
  "speaker": 0,
  "jp": [
   "いいえ、",
   "キロタはここには・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00364",
  "speaker": 16,
  "jp": [
   "それじゃあどうして",
   "こんなところに",
   "呼び出したりしたの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/003c2",
  "speaker": 16,
  "jp": [
   "・・・まさか、",
   "あたしを捕まえようと？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00412",
  "speaker": 0,
  "jp": [
   "違うわステイ！！",
   "私はそんなこと・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00462",
  "speaker": 21,
  "jp": [
   "アナタを呼び出すのに、",
   "他に何の用があるのかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/004be",
  "speaker": 0,
  "jp": [
   "グリシナ！？",
   "どうしてここに？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00518",
  "speaker": 16,
  "jp": [
   "カルディアさん",
   "ご苦労様・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/0055a",
  "speaker": 16,
  "jp": [
   "もうつまらない演技など",
   "必要ありませんよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/005c0",
  "speaker": 16,
  "jp": [
   "・・・やっぱり",
   "あたしをだましたのね！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00618",
  "speaker": 16,
  "jp": [
   "三人きりの姉弟だから",
   "きっとキロタを救いだして",
   "くれるだろうって、"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00686",
  "speaker": 17,
  "jp": [
   "ずっとずっと",
   "信じていたのに！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/006e6",
  "speaker": 17,
  "jp": [
   "姉さんの裏切り者！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00726",
  "speaker": 0,
  "jp": [
   "違うのステイエン！！",
   "私はあなたをだまそうとなんか",
   "していないわ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/007ac",
  "speaker": 0,
  "jp": [
   "この小娘を連れて行きなさい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/007ee",
  "speaker": 21,
  "jp": [
   "はっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/008ac",
  "speaker": 16,
  "jp": [
   "大人しく来るんだ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00934",
  "speaker": 22,
  "jp": [
   "姉さんのバカッ！！",
   "嫌い・・・嫌いよ・・・",
   "大っキライ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/0099a",
  "speaker": 0,
  "jp": [
   "ステイエン！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00a1e",
  "speaker": 16,
  "jp": [
   "貴方にはまだ、話があるんだ・・",
   "カルディア"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00a64",
  "speaker": 0,
  "jp": [
   "グリシナ！！",
   "どうしてこんなことを！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00ab6",
  "speaker": 16,
  "jp": [
   "・・・どうして？",
   "それを聞きたいのは私の方です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00af8",
  "speaker": 16,
  "jp": [
   "身内だからとはいえ",
   "十審将の補佐官ともあろう者が",
   "異端者を見逃しておくなど・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00b5c",
  "speaker": 16,
  "jp": [
   "貴方は自分の上官である",
   "ベイル様の立場を、これ以上",
   "危ういものにさせたいのですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00bdc",
  "speaker": 0,
  "jp": [
   "！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00bfc",
  "speaker": 16,
  "jp": [
   "肉親を見捨てることになろうと",
   "ベイル様を守る覚悟があるのなら",
   "貴方の存在を許しましょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00c68",
  "speaker": 16,
  "jp": [
   "しかし、貴方がベイル様より",
   "肉親を選ぶというのなら・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00cc2",
  "speaker": 16,
  "jp": [
   "ベイル様のためにも",
   "貴方にはここで死んでもらいます"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00d20",
  "speaker": 0,
  "jp": [
   "そんな・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00d60",
  "speaker": 16,
  "jp": [
   "選べないのですか？",
   "そう、貴方にとってベイル様は",
   "その程度の価値なのですね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00dec",
  "speaker": 1,
  "jp": [
   "そんなことはありません！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00e30",
  "speaker": 16,
  "jp": [
   "フフフ、",
   "無理をしなくてもいいんですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00ea6",
  "speaker": 0,
  "jp": [
   "待って・・・",
   "グリシナさん聞いて下さい！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00f72",
  "speaker": 17,
  "jp": [
   "クッ、私に触るなッ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00fa6",
  "speaker": 0,
  "jp": [
   "あ、貴方は・・！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/00fe4",
  "speaker": 16,
  "jp": [
   "くっ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/0100e",
  "speaker": 16,
  "jp": [
   "めずらしいでしょうね",
   "こういう身体は"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/01052",
  "speaker": 0,
  "jp": [
   "貴方は、女性じゃ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/01094",
  "speaker": 16,
  "jp": [
   "ええ、そうですね",
   "書類では男と偽ってますけれど"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/010d8",
  "speaker": 16,
  "jp": [
   "正確には、どちらでもない",
   "どちらにもなれなかった",
   "不完全な天使ですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/0113e",
  "speaker": 0,
  "jp": [
   "まさか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/01164",
  "speaker": 1,
  "jp": [
   "中性体！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/01188",
  "speaker": 0,
  "jp": [
   "中性体の天使達は確か・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/011cc",
  "speaker": 16,
  "jp": [
   "研究所で処分されたはず、",
   "そう言いたいのでしょう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/01214",
  "speaker": 16,
  "jp": [
   "そこまで知っているのなら",
   "これ以上の説明は不要ですね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/01274",
  "speaker": 0,
  "jp": [
   "グリシナさん・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/012b4",
  "speaker": 16,
  "jp": [
   "不愉快ですから",
   "そういう、哀れむような目で",
   "私を見ないで下さい・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/01328",
  "speaker": 0,
  "jp": [
   "・・すみません、でも"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/0135a",
  "speaker": 16,
  "jp": [
   "醜いでしょう？",
   "全ての女に嫉妬して",
   "見た目ばかりを美しく磨いて・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/013b4",
  "speaker": 16,
  "jp": [
   "自分でもわかっていますよ",
   "どんなに自分を磨いても",
   "無意味な努力です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/0141a",
  "speaker": 16,
  "jp": [
   "あの方の目に",
   "私が映ることなどない・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/0145e",
  "speaker": 0,
  "jp": [
   "まさか、グリシナさん",
   "貴方もベイル様のこと・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/014ae",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/014de",
  "speaker": 0,
  "jp": [
   "ベイル様も貴方の身体のこと",
   "ご存じなのですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/01538",
  "speaker": 16,
  "jp": [
   "いいえ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/0155a",
  "speaker": 0,
  "jp": [
   "ベイル様も六翼・・",
   "天使の中では規格外と呼ばれる身"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/015a0",
  "speaker": 0,
  "jp": [
   "打ち明ければきっと",
   "貴方の苦しみも理解して",
   "くださるはずです！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/01610",
  "speaker": 16,
  "jp": [
   "ふははははっ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/0163e",
  "speaker": 16,
  "jp": [
   "心優しい方は、私の身体を知れば",
   "必ず痛ましいものを見るような",
   "目で見ます・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/016a0",
  "speaker": 16,
  "jp": [
   "私は、同情なんて・・",
   "そんなもの欲しくない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/016f8",
  "speaker": 0,
  "jp": [
   "同情・・・かもしれません",
   "それでも、一人で苦しむよりは",
   "ずっと楽になれるはずです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/0176a",
  "speaker": 16,
  "jp": [
   "永遠に得られぬ愛・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/017a8",
  "speaker": 0,
  "jp": [
   "え？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/017ca",
  "speaker": 16,
  "jp": [
   "愛されたいと願う人から",
   "ただ同情をそそがれるだけなんて",
   "この上なく残酷な仕打ちですよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/018f6",
  "speaker": 1,
  "jp": [
   "うっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/0194a",
  "speaker": 16,
  "jp": [
   "貴方に時間をあげましょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/01974",
  "speaker": 16,
  "jp": [
   "少しの間だけ待ってあげます",
   "ベイル様よりも家族を選ぶのなら",
   "＜レニアム坂広場＞まで来なさい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/019f2",
  "speaker": 16,
  "jp": [
   "もし、家族を選ぶのなら",
   "貴方の命と引き替えに",
   "家族は解放してあげましょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/01a50",
  "speaker": 16,
  "jp": [
   "ですが、貴方がベイル様を選び",
   "姿を現さなかった場合は",
   "二人の命はありません"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/01ab0",
  "speaker": 16,
  "jp": [
   "肉親よりもベイル様を選ぶ・・",
   "貴方にその覚悟があるのなら",
   "貴方にベイル様を任せましょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/01b9a",
  "speaker": 0,
  "jp": [
   "グリシ・・ナ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/189/01ce0",
  "speaker": 16,
  "jp": [
   "フッ・・・",
   "私にはこんな方法でしか",
   "あの方を守れませんから"
  ],
  "en": ""
 },
