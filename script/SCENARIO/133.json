  "jp": [
   "・・・ビックリしたよな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00198",
  "speaker": 0,
  "jp": [
   "ああ、色々あった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/001e6",
  "speaker": 16,
  "jp": [
   "マティアをさらった",
   "六翼の天使が",
   "シリアの兄さんだったなんて・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00266",
  "speaker": 16,
  "jp": [
   "あーあ、結局アラギも",
   "倒せなかったしなぁ",
   "ルカ達もさぞかし・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00434",
  "speaker": 16,
  "jp": [
   "完全に黙りこんでて怖ぇよ",
   "空気だけが異様にピリピリしてて",
   "ケンカしてくれた方がまだいいよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/004ac",
  "speaker": 0,
  "jp": [
   "・・・そうだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/004d4",
  "speaker": 16,
  "jp": [
   "カインは大丈夫なのか？",
   "まだ翼が痛むんだろ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/0051c",
  "speaker": 0,
  "jp": [
   "そこにいる本人に直接聞けば",
   "いいだろう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/0056e",
  "speaker": 16,
  "jp": [
   "・・・なんつーか",
   "今回はさすがに話かけづらくてさ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/005b4",
  "speaker": 16,
  "jp": [
   "カインとシリア",
   "被害者の身内と加害者の身内",
   "微妙な関係だろ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00610",
  "speaker": 0,
  "jp": [
   "・・・そうだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/0063e",
  "speaker": 0,
  "jp": [
   "それぞれに戦う理由があり",
   "それぞれに守りたいものがある"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00688",
  "speaker": 0,
  "jp": [
   "今まで倒してきた僧兵にも",
   "家族なり肉親なり、",
   "大切な者があったはずだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/006ec",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00718",
  "speaker": 0,
  "jp": [
   "理想を掲げるのはいい",
   "だが、理想のために多くを",
   "踏みにじるのは教団だけではない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/0077c",
  "speaker": 0,
  "jp": [
   "サイファーパンクも、我々も",
   "そういう意味では同種なのだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/007de",
  "speaker": 17,
  "jp": [
   "なんだよそれ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00808",
  "speaker": 16,
  "jp": [
   "サイファーパンクのどこが",
   "教団と同じなんだよ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00854",
  "speaker": 0,
  "jp": [
   "これは、因果だ",
   "生きる者すべてに付きまとう業",
   "巡り巡る人の運命そのものだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/008ca",
  "speaker": 16,
  "jp": [
   "・・・ヨハネさん",
   "オレにもわかるような言葉で",
   "話してくれよ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00928",
  "speaker": 0,
  "jp": [
   "何も失わずに",
   "何かを得ることは難しい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00960",
  "speaker": 0,
  "jp": [
   "だからこそ",
   "人は己が信じられるものに",
   "その魂を委ねようとする"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/009b4",
  "speaker": 0,
  "jp": [
   "何を信じ、何に従うのか",
   "選ぶのは自分自身だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/009f4",
  "speaker": 0,
  "jp": [
   "組織に従属するのもいい",
   "自分だけを信じて戦うのもいい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00a3c",
  "speaker": 0,
  "jp": [
   "操り、操られているようで",
   "人は自分の運命を自分でたぐり",
   "よせていることを知らない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00aa4",
  "speaker": 0,
  "jp": [
   "人はいつでも",
   "運命を切り開く力を持っている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00afa",
  "speaker": 16,
  "jp": [
   "うー、よくわかんないけど",
   "自分が正しいと思う気持ちに",
   "従えってことでいいんだよな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00b6c",
  "speaker": 0,
  "jp": [
   "噛み砕けば、そんな感じだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00b9c",
  "speaker": 0,
  "jp": [
   "カインもカインなりに",
   "答えを導き出すはずだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00be0",
  "speaker": 0,
  "jp": [
   "それを見守るのが、私の役目だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/133/00cf0",
