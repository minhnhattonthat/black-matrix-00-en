[
 {
  "id": "SCENARIO/273/000d0",
  "speaker": 0,
  "jp": [
   "ウンダ様！！",
   "アラギが古の大悪魔の末えいって",
   "どういうことなんですか！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/00138",
  "speaker": 16,
  "jp": [
   "あやつらが言っていたとおり",
   "アラギはこの村の一族の者では",
   "ない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/0018c",
  "speaker": 16,
  "jp": [
   "村の前で息絶えていた女悪魔が",
   "抱きかかえていた赤子・・・",
   "それがアラギじゃ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/00202",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/0023a",
  "speaker": 16,
  "jp": [
   "今でも、あの子がいたずらに",
   "禁忌の地へ踏み込んでしまった",
   "ことが悔やまれるよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/0029c",
  "speaker": 16,
  "jp": [
   "あの子はそこで自らの血と力に",
   "目覚めてしまった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/002f6",
  "speaker": 0,
  "jp": [
   "禁忌の地だって！？",
   "だってあそこは、絶対に行っては",
   "ならない場所だって・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/00380",
  "speaker": 16,
  "jp": [
   "ソリュウはあの時もそう言って",
   "一緒についてこなかった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/003de",
  "speaker": 1,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/00414",
  "speaker": 16,
  "jp": [
   "アタシがアラギとザイオンを",
   "誘って三人で禁忌の地へと",
   "向かったの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/0046c",
  "speaker": 16,
  "jp": [
   "でもアタシとザイオンは",
   "あの嫌な空気に耐えられなくて",
   "すぐに引き返した"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/004c8",
  "speaker": 16,
  "jp": [
   "でも、アラギは・・・",
   "何かにとりつかれたように",
   "奥へと消えてしまった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/00554",
  "speaker": 0,
  "jp": [
   "あの時、力ずくでもアラギを",
   "引き止めれば良かったんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/005cc",
  "speaker": 16,
  "jp": [
   "そうじゃったのか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/0061c",
  "speaker": 0,
  "jp": [
   "ごめんなさいウンダ様",
   "アタシ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/00674",
  "speaker": 16,
  "jp": [
   "パスカのペインリングに呼ばれた",
   "のじゃろう、アラギには封印を",
   "解くだけの力があった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/006dc",
  "speaker": 16,
  "jp": [
   "今思えば、あの時からもう",
   "あの子はパスカのペインリングに",
   "魅入られていたのかもしれない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/00750",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/0077c",
  "speaker": 16,
  "jp": [
   "パスカの力は同胞を食い破る",
   "恐ろしい力ゆえに、決して封印を",
   "解いてはならない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/007e0",
  "speaker": 16,
  "jp": [
   "各部族の族長達は皆、",
   "アラギを殺すことを提案したが、",
   "わしは希望にかけることにした"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/00870",
  "speaker": 0,
  "jp": [
   "希望？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/00890",
  "speaker": 16,
  "jp": [
   "あの子は絶えて久しい誇り高き",
   "戦士の魂を持つ子供"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/008d4",
  "speaker": 16,
  "jp": [
   "わしはアラギに、統率力を失った",
   "悪魔達を束ねるにふさわしい血と",
   "器があると感じた"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/0093c",
  "speaker": 16,
  "jp": [
   "血がうずくのか、あの子自身の",
   "中にもそういう野心があった"
