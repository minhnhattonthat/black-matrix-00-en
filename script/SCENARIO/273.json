  "jp": "向かったの",
  "en": ""
 },
 {
  "id": "SCENARIO/273/0046c",
  "jp": "でもアタシとザイオンは",
  "en": ""
 },
 {
  "id": "SCENARIO/273/00486",
  "jp": "あの嫌な空気に耐えられなくて",
  "en": ""
 },
 {
  "id": "SCENARIO/273/004a6",
  "jp": "すぐに引き返した",
  "en": ""
 },
 {
  "id": "SCENARIO/273/004c8",
