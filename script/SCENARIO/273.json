  "en": ""
 },
 {
  "id": "SCENARIO/273/00380",
  "jp": "ソリュウはあの時もそう言って",
  "en": ""
 },
 {
  "id": "SCENARIO/273/003a0",
  "jp": "一緒についてこなかった",
  "en": ""
 },
 {
  "id": "SCENARIO/273/003de",
