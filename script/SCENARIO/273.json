  "id": "SCENARIO/273/00202",
  "jp": "・・・・・・・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/273/0023a",
  "jp": "今でも、あの子がいたずらに",
  "en": ""
 },
 {
  "id": "SCENARIO/273/00258",
  "jp": "禁忌の地へ踏み込んでしまった",
  "en": ""
 },
 {
  "id": "SCENARIO/273/00278",
  "jp": "ことが悔やまれるよ",
  "en": ""
 },
 {
  "id": "SCENARIO/273/0029c",
