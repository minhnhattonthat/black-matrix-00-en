  "en": ""
 },
 {
  "id": "SCENARIO/273/00f7c",
  "speaker": 16,
  "jp": [
   "それは悲しい事じゃ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/273/00fb6",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
