  "en": ""
 },
 {
  "id": "SCENARIO/273/002bc",
  "jp": "目覚めてしまった",
  "en": ""
 },
 {
  "id": "SCENARIO/273/002f6",
  "jp": "禁忌の地だって！？",
  "en": ""
 },
 {
  "id": "SCENARIO/273/0030c",
  "jp": "だってあそこは、絶対に行っては",
  "en": ""
 },
 {
  "id": "SCENARIO/273/0032e",
