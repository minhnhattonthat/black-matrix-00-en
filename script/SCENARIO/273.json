  "en": ""
 },
 {
  "id": "SCENARIO/273/00414",
  "jp": "アタシがアラギとザイオンを",
  "en": ""
 },
 {
  "id": "SCENARIO/273/00432",
  "jp": "誘って三人で禁忌の地へと",
  "en": ""
 },
