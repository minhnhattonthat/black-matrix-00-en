[
 {
  "id": "SCENARIO/298/00270",
  "jp": "構成員・若者",
  "en": ""
 },
 {
  "id": "SCENARIO/298/00286",
  "speaker": null,
  "jp": [
   "お前達、生きていたのかッ！？",
   "てっきり、サンバルテルミの",
   "崩壊に巻き込まれたものだと・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/002ec",
  "speaker": null,
  "jp": [
   "ああ、みんななら",
   "裏切り者ヴァルトスを殺すため",
   "教団の悪魔討伐隊に同行してる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00348",
  "speaker": null,
  "jp": [
   "俺か・・？",
   "俺は、ただの留守番さ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/003c4",
  "speaker": null,
  "jp": [
   "・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/003e0",
  "speaker": null,
  "jp": [
   "気付いたか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/003f8",
  "speaker": null,
  "jp": [
   "俺も、いつまでもチマチマ",
   "やってられねぇからな",
   "どーんと新調したわけよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/0044c",
  "speaker": null,
  "jp": [
   "お古で、良いなら",
   "持ってって、いいぜ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/004f0",
  "jp": "ダリア",
  "en": ""
 },
 {
  "id": "SCENARIO/298/00500",
  "speaker": null,
  "jp": [
   "あ、あんた達・・・！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00540",
  "jp": "ダリア",
  "en": ""
 },
 {
  "id": "SCENARIO/298/00550",
  "speaker": null,
  "jp": [
   "そうかい、ヨハネさんが・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/0059c",
  "jp": "ウェイター",
  "en": ""
 },
 {
  "id": "SCENARIO/298/005b0",
  "speaker": null,
  "jp": [
   "シクシク・・・",
   "いらっしゃいませ～～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/005e0",
  "speaker": null,
  "jp": [
   "料理好きだった彼女に、",
   "ふられてしまいました・・・",
   "おかげで体重も元に戻りましたよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00674",
  "jp": "剣士の恋人",
  "en": ""
 },
 {
  "id": "SCENARIO/298/00688",
  "speaker": null,
  "jp": [
   "この剣は、彼の形見の品です",
   "私の恋人は、サンバルテルミで",
   "異端者に殺されてしまいました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/006ec",
  "speaker": null,
  "jp": [
   "式をあげる直前に、こんな・・・",
   "私は彼を殺した異端者達を",
   "許しはしません"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00744",
  "speaker": null,
  "jp": [
   "絶対に、許さない・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00798",
  "jp": "中年",
  "en": ""
 },
 {
  "id": "SCENARIO/298/007a6",
  "speaker": null,
  "jp": [
   "女房のヤツが酒をやめろとな・・",
   "やめるまで家に入れねぇとまで",
   "言いやがってよぉ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00808",
  "speaker": null,
  "jp": [
   "はぁ・・・酒は飲めねえが、",
   "飲む気分だけでも味わいたくて",
   "ここに通う毎日だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00894",
  "jp": "片翼の天使",
  "en": ""
 },
 {
  "id": "SCENARIO/298/008a8",
  "speaker": null,
  "jp": [
   "僕は自由気ままに旅する天使",
   "規則に縛られるよりも",
   "風と草と共に歌うのが好き♪"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00904",
  "speaker": null,
  "jp": [
   "天使なのに空を飛べない",
   "片翼の天使とは僕のこと"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00940",
  "speaker": null,
  "jp": [
   "僕を惨めで哀れと思うなら",
   "少しくらいチップをはずんでね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/009cc",
  "jp": "キロタ",
  "en": ""
 },
 {
  "id": "SCENARIO/298/009dc",
  "speaker": null,
  "jp": [
   "ヨハネさん、時々",
   "僕にも面白い本を",
   "持ってきてくれたんです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00a24",
  "speaker": null,
  "jp": [
   "『弱虫ピリポの冒険』とか、",
   "僕、好きだったなぁ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00a78",
  "jp": "キロタ",
  "en": ""
 },
 {
  "id": "SCENARIO/298/00a88",
  "speaker": null,
  "jp": [
   "きっとあの本、ヨハネさんが",
   "カインさんのために探してきた",
   "本の一冊だったんだと思います"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00aec",
  "speaker": null,
  "jp": [
   "なんとなくだけど、",
   "そんな気がするんです・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00b60",
  "jp": "老人",
  "en": ""
 },
 {
  "id": "SCENARIO/298/00b6e",
  "speaker": null,
  "jp": [
   "いつもこの広場にいた",
   "ばあさんとは友人でな",
   "長いつきあいじゃったわ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00bc4",
  "speaker": null,
  "jp": [
   "あのばあさんは、ずっと",
   "この広場でケンカ別れした",
   "息子の帰りを待っていたんじゃ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00c20",
  "speaker": null,
  "jp": [
   "結局、間に合わなかった",
   "ようじゃがの・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00c6c",
  "jp": "老人",
  "en": ""
 },
 {
  "id": "SCENARIO/298/00c7a",
  "speaker": null,
  "jp": [
   "わしも老い先長くない・・・",
   "じゃから思い立ったんじゃ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00cbc",
  "speaker": null,
  "jp": [
   "この髪型・・・イケてるじゃろ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00d20",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/298/00d2e",
  "speaker": null,
  "jp": [
   "兄貴に相談したら",
   "こき使われるのが嫌なら",
   "経営側の苦労を味わえだってさ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00d84",
  "speaker": null,
  "jp": [
   "ま、なんとかなりそうだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00de4",
  "jp": "老婆の息子",
  "en": ""
 },
 {
  "id": "SCENARIO/298/00df8",
  "speaker": null,
  "jp": [
   "今から母の墓参りなんです・・・",
   "母の死に目に会えないなんて",
   "親不孝な息子ですよね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00e58",
  "speaker": null,
  "jp": [
   "こんなことになるのなら、",
   "お互い意地をはらず、素直に",
   "仲直りすれば良かった・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00eec",
  "jp": "カップル・男",
  "en": ""
 },
 {
  "id": "SCENARIO/298/00f02",
  "speaker": null,
  "jp": [
   "はははははっ！",
   "いや・・・もうなんて言うか！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00f3c",
  "speaker": null,
  "jp": [
   "実感、わかないなぁ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00f8c",
  "jp": "カップル・女",
  "en": ""
 },
 {
  "id": "SCENARIO/298/00fa2",
  "speaker": null,
  "jp": [
   "計算がきわどいのよね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/00fc0",
  "speaker": null,
  "jp": [
   "どっちなのかしら・・・？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/01018",
  "jp": "神父",
  "en": ""
 },
 {
  "id": "SCENARIO/298/01026",
  "speaker": null,
  "jp": [
   "＜書＞を読まない子供のために",
   "私が語って聞かせてあげましょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/01070",
  "speaker": null,
  "jp": [
   "今日は、＜翼ある者の年齢＞に",
   "ついて話をしましょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/010b0",
  "speaker": null,
  "jp": [
   "貴方も聞きますか？"
  ],
  "en": "",
  "spill": false
 },
 {
  "id": "SCENARIO/298/010ca",
  "jp": "　はい",
  "en": ""
 },
 {
  "id": "SCENARIO/298/010d8",
  "jp": "　いいえ",
  "en": ""
 },
 {
  "id": "SCENARIO/298/010ec",
  "speaker": null,
  "jp": [
   "翼ある者は、翼なき者より",
   "生命力が強く寿命もはるかに",
   "長いです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/01138",
  "speaker": null,
  "jp": [
   "翼ある者は、その潜在能力に",
   "よって加齢のスピードが",
   "違います"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/01184",
  "speaker": null,
  "jp": [
   "潜在能力が強ければ強いほど",
   "ゆっくりと年をとっていきます"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/011c8",
  "speaker": null,
  "jp": [
   "翼ある者から見れば、我々は、",
   "またたくほどのはやさで老い衰え",
   "死んでゆくのでしょうね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/01236",
  "speaker": null,
  "jp": [
   "あなたも毎日＜書＞を読んで、",
   "立派な大人になるんですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/012ac",
  "jp": "男の子",
  "en": ""
 },
 {
  "id": "SCENARIO/298/012bc",
  "speaker": null,
  "jp": [
   "悪魔ヴァルトスなんて",
   "怖くねーよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/012e8",
  "speaker": null,
  "jp": [
   "自分一人じゃ教団を倒せないから",
   "翼なき者を利用しようなんて・・",
   "一人じゃ何もできないんだろ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/01388",
  "jp": "女の子",
  "en": ""
 },
 {
  "id": "SCENARIO/298/01398",
  "speaker": null,
  "jp": [
   "悪魔ヴァルトスも捕まったら",
   "公開処刑になるのかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/013d8",
  "speaker": null,
  "jp": [
   "やっぱり、次の公開処刑は、",
   "ママにナイショでこっそり",
   "行っちゃおうかな～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/01464",
  "jp": "ピエロ",
  "en": ""
 },
 {
  "id": "SCENARIO/298/01474",
  "speaker": null,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/01490",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/298/014a0",
  "speaker": null,
  "jp": [
   "・・・あの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/014b4",
  "jp": "ピエロ",
  "en": ""
 },
 {
  "id": "SCENARIO/298/014c4",
  "speaker": null,
  "jp": [
   "は、話しかけないでくれ・・・",
   "今ちょっと持病の腰痛が・・・",
   "ウッ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/0154c",
  "jp": "兵士",
  "en": ""
 },
 {
  "id": "SCENARIO/298/0155a",
  "speaker": null,
  "jp": [
   "た、確かに手伝いはしたが、",
   "困っているようだったから",
   "少し手を貸してやっただけだッ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/015bc",
  "speaker": null,
  "jp": [
   "深い意味など無い・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/01610",
  "jp": "プラン",
  "en": ""
 },
 {
  "id": "SCENARIO/298/01620",
  "speaker": null,
  "jp": [
   "今日も元気に",
   "いらっしゃいませ～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/01668",
  "jp": "フライ",
  "en": ""
 },
 {
  "id": "SCENARIO/298/01678",
  "speaker": null,
  "jp": [
   "最近ね、見張りに来てる",
   "僧兵さんがいろいろお手伝い",
   "してくれるんだよ～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/016cc",
  "speaker": null,
  "jp": [
   "僕達としては、ありがたいけれど",
   "いいのかな～？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/298/01724",
  "speaker": null,
  "jp": [
   "きっと心配している・・・",
   "ダリアさんに、会いに行こう"
  ],
  "en": ""
 },
