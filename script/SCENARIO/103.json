[
 {
  "id": "SCENARIO/103/000e4",
  "speaker": 0,
  "jp": [
   "十審将レッド・ムフロン様",
   "並びにリプサリス様",
   "ご到着です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/0016c",
  "speaker": 16,
  "jp": [
   "お待ちしておりました",
   "レッド・ムフロン様"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/001d8",
  "speaker": 0,
  "jp": [
   "・・・・フン、クレイスか",
   "テリオスから話は聞いたぞ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00220",
  "speaker": 0,
  "jp": [
   "我が配下グリシナを傷つけた",
   "二人組を見つけながら",
   "捕り逃したそうではないか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/002ac",
  "speaker": 17,
  "jp": [
   "も、申し訳ありません！",
   "それは、あたしが・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00318",
  "speaker": 16,
  "jp": [
   "確かに自分の不手際でした"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/003c0",
  "speaker": 1,
  "jp": [
   "ク、クレイス様！？",
   "・・・でも！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00444",
  "speaker": 0,
  "jp": [
   "十審将様の御前ですよ",
   "勝手な発言は慎みなさい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/004da",
  "speaker": 16,
  "jp": [
   "し、失礼しました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00544",
  "speaker": 16,
  "jp": [
   "レッド・ムフロン様",
   "死体でかまわぬのなら",
   "すぐにでも連れてきましょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/005a0",
  "speaker": 16,
  "jp": [
   "恥ずかしながら",
   "加減ができぬゆえ",
   "生け捕りは無理です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00604",
  "speaker": 0,
  "jp": [
   "・・・・・・フン",
   "使えん奴め"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/0065c",
  "speaker": 16,
  "jp": [
   "首を持ってゆくおつもりなら",
   "レッド・ムフロン様ご自身で",
   "討つべきではありませんか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/006cc",
  "speaker": 0,
  "jp": [
   "この俺に意見するつもりか",
   "リプサリス"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/0071a",
  "speaker": 16,
  "jp": [
   "ふふふ、同じ贈り物でも",
   "殿方が自分のために駆け回って",
   "用意して下さったものは別格です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/0079a",
  "speaker": 0,
  "jp": [
   "・・・なに？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/007ce",
  "speaker": 16,
  "jp": [
   "愛しい者の心を",
   "永遠に繋ぎ止めていたいのなら",
   "努力を惜しんではいけませんわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00846",
  "speaker": 0,
  "jp": [
   "うぅ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00864",
  "speaker": 16,
  "jp": [
   "グリシナも、殿方からの",
   "誠意のこもった贈り物なら",
   "喜ばないはずありませんわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/008da",
  "speaker": 0,
  "jp": [
   "アレは蝶のように美しい",
   "だが、同時にわがままで",
   "欲しがりで気むずかしい性格"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/0094a",
  "speaker": 0,
  "jp": [
   "・・・しかし",
   "それがいいのだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00984",
  "speaker": 16,
  "jp": [
   "その心をつかみ取るチャンス"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/009be",
  "speaker": 16,
  "jp": [
   "逃す手はないと思われますが？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00a02",
  "speaker": 1,
  "jp": [
   "そうだとも！",
   "この機を逃してなるものか！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00a4e",
  "speaker": 1,
  "jp": [
   "クレイス！",
   "今度みつけた時は俺を呼べ！",
   "やつらはこの俺が始末する！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00ad0",
  "speaker": 16,
  "jp": [
   "承知しました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00b06",
  "speaker": 0,
  "jp": [
   "待っていろよグリシナ",
   "お前のために最高のプレゼントを",
   "用意してやろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00b76",
  "speaker": 1,
  "jp": [
   "ふははははははっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00bbc",
  "speaker": 16,
  "jp": [
   "・・・相変わらず",
   "乗せられやすいお方だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00c20",
  "speaker": 0,
  "jp": [
   "ええ、本当に",
   "でも、可愛らしい方ですわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00c84",
  "speaker": 19,
  "jp": [
   "・・・か、可愛い！！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00cba",
  "speaker": 19,
  "jp": [
   "わからないわ・・・",
   "あれのどこが可愛いっていうの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00d24",
  "speaker": 0,
  "jp": [
   "あの方の恋する心は",
   "少年のように愚直で一途です",
   "可愛らしいと思いませんか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00d9a",
  "speaker": 16,
  "jp": [
   "え・・は、はいっ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00de8",
  "speaker": 16,
  "jp": [
   "・・・そういうものなのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00e2a",
  "speaker": 0,
  "jp": [
   "ええ、いつかあの愚直さを",
   "悪意を持つ者に利用されなければ",
   "いいのですが・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00ea2",
  "speaker": 16,
  "jp": [
   "今、手玉にとってみせた者が",
   "言う言葉とは思えんな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00efe",
  "speaker": 0,
  "jp": [
   "虚言を吐いた覚えはありませんわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00f30",
  "speaker": 0,
  "jp": [
   "でも、偽りの言葉よりも",
   "一片の真実を告げる方が",
   "人を揺り動かすもの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/103/00f88",
  "speaker": 0,
  "jp": [
   "それが、甘美な誘惑でも",
   "淡くはかない希望でも"
  ],
  "en": ""
 },
