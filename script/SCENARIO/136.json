[
 {
  "id": "SCENARIO/136/0011c",
  "speaker": 16,
  "jp": [
   "おはようカイン",
   "よく眠れたかい？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00158",
  "speaker": 0,
  "jp": [
   "・・・うん、少しは"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00192",
  "speaker": 16,
  "jp": [
   "無理もないねぇ",
   "ここのところ色々ごたついて",
   "いたからねぇ・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/001f2",
  "speaker": 16,
  "jp": [
   "少し振り返って",
   "情報を整理してみるかい？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00240",
  "speaker": 3,
  "jp": [
   "どうする？"
  ],
  "en": "",
  "spill": false
 },
 {
  "id": "SCENARIO/136/00252",
  "jp": "　思い出してみる",
  "en": ""
 },
 {
  "id": "SCENARIO/136/0026c",
  "jp": "　思い出さない",
  "en": ""
 },
 {
  "id": "SCENARIO/136/002a6",
  "speaker": 16,
  "jp": [
   "ええと、なんて言ったかい",
   "あの気持ち悪い化け物"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/002ea",
  "jp": "　パスカのこと？",
  "en": ""
 },
 {
  "id": "SCENARIO/136/00304",
  "jp": "　白い化け物のこと？",
  "en": ""
 },
 {
  "id": "SCENARIO/136/00334",
  "speaker": 0,
  "jp": [
   "パスカのこと？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/0036a",
  "speaker": 16,
  "jp": [
   "そうそう、パスカ",
   "死骸を食べる悪魔だってねぇ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/003ac",
  "speaker": 16,
  "jp": [
   "そいつを操ってる悪魔が",
   "確か・・・アラギ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/003fe",
  "speaker": 0,
  "jp": [
   "うん、ルカとザイオンが",
   "捜している相手だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/0043c",
  "speaker": 0,
  "jp": [
   "ボクがキボートスに居た頃、",
   "マティアが＜インセスト＞だから",
   "さらおうとしたんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/004b6",
  "speaker": 16,
  "jp": [
   "結果的には、それを救ってくれた",
   "教団の天使ベイルに",
   "さらわれてしまった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00514",
  "speaker": 16,
  "jp": [
   "・・・そうだったよね？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00552",
  "speaker": 0,
  "jp": [
   "・・・うん"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00582",
  "speaker": 0,
  "jp": [
   "白い化け物のこと？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/005be",
  "speaker": 16,
  "jp": [
   "そうそう",
   "サイファーパンクが掴んだ情報",
   "によれば、"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00608",
  "speaker": 16,
  "jp": [
   "教団の連中もやっきになって",
   "探っているらしいけど",
   "その正体は謎に包まれたまま"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/0066c",
  "speaker": 16,
  "jp": [
   "なんでも＜エンブリオン＞",
   "って名前で呼ばれているらしいよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/006ce",
  "speaker": 0,
  "jp": [
   "＜エンブリオン＞・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/006f4",
  "speaker": 0,
  "jp": [
   "教会を襲って＜インセスト＞の",
   "リリスを連れ去ってしまったんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/0075a",
  "speaker": 16,
  "jp": [
   "シリアには気の毒だったね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/0079a",
  "speaker": 0,
  "jp": [
   "マティアやリリス・・・",
   "みんな助けてあげたい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/007fa",
  "speaker": 16,
  "jp": [
   "それにしても＜インセスト＞って",
   "なんなんだろうねぇ？",
   "いろんなものに狙われて・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00864",
  "speaker": 16,
  "jp": [
   "何かすごい力でもあるのかねぇ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/008aa",
  "speaker": 0,
  "jp": [
   "マティアは、",
   "風や木々の声を聞けたけど",
   "それだけだよ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00904",
  "speaker": 16,
  "jp": [
   "風や木々の声を聞く？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00934",
  "speaker": 0,
  "jp": [
   "うん、風や木々の声を聞いて、",
   "天気が変わるのが分かったり",
   "そういう力だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/009aa",
  "speaker": 16,
  "jp": [
   "ふーん、変わった力だけど",
   "天使や悪魔が奪い合ってまで",
   "欲しがる力ではなさそうだねぇ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00a1c",
  "speaker": 0,
  "jp": [
   "そうだね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00a4e",
  "speaker": 16,
  "jp": [
   "ああ、それはそうと",
   "翼の具合はどうなんだい？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00aa6",
  "speaker": 0,
  "jp": [
   "大丈夫、もう痛くないよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00ae6",
  "speaker": 16,
  "jp": [
   "そうかい、それならいいけどね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00b22",
  "speaker": 16,
  "jp": [
   "坊や、アベルって子に会うたびに",
   "翼が痛いって言うからねぇ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00b86",
  "speaker": 0,
  "jp": [
   "え？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00ba4",
  "speaker": 16,
  "jp": [
   "翼が痛いって言ったのは、",
   "二回とも、そのアベルって子に",
   "会った後のことだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00c1a",
  "speaker": 0,
  "jp": [
   "翼が痛くなった時・・・",
   "そっか、気付かなかった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00c64",
  "speaker": 16,
  "jp": [
   "偶然かも知れないけれどねぇ",
   "こう色々あると、何にでも関連が",
   "ありそうな気がしてくるからねぇ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00cdc",
  "speaker": 0,
  "jp": [
   "どうして、そう思うの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00d1a",
  "speaker": 16,
  "jp": [
   "女の勘ってやつだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00d48",
  "speaker": 0,
  "jp": [
   "女の勘？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00d7a",
  "speaker": 16,
  "jp": [
   "そうさ、女の勘の鋭さは",
   "世の男たちが証人だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00dc4",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00e08",
  "speaker": 16,
  "jp": [
   "まぁ、色々あって頭の中も",
   "こんがらがってるだろうからねぇ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00e62",
  "speaker": 16,
  "jp": [
   "気分転換に",
   "散歩にでも行っておいで"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/136/00eae",
  "speaker": 0,
  "jp": [
   "うん、ありがと"
  ],
  "en": ""
 },
