[
 {
  "id": "SCENARIO/325/00104",
  "speaker": 16,
  "jp": [
   "皆様、おそろいのようですね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00158",
  "speaker": 0,
  "jp": [
   "ベイルに渡す物があるって",
   "言ってたけど・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/001a0",
  "speaker": 16,
  "jp": [
   "ええ、ちょうどいいですわ",
   "皆様にも、ぜひ見て頂きたい",
   "ものでしたから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00212",
  "speaker": 0,
  "jp": [
   "これは・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/0024c",
  "speaker": 3,
  "jp": [
   "なんだろう・・・",
   "この本、どこかで見たことが",
   "あるような気がする・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/002b0",
  "speaker": 16,
  "jp": [
   "テリオス様から",
   "ベイル様へ渡すよう承った",
   "貴重な資料ですわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00328",
  "speaker": 0,
  "jp": [
   "テリオスから・・・私に？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/0035c",
  "speaker": 16,
  "jp": [
   "これを読めば",
   "＜慟哭の５５５日戦争＞が",
   "起きた経緯もわかるはずです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/003ca",
  "speaker": 1,
  "jp": [
   "・・・これはっ？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00406",
  "speaker": 16,
  "jp": [
   "ええ、これは",
   "歴史の表舞台には語られない",
   "もう一つの真実を語る書"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/0046a",
  "speaker": 16,
  "jp": [
   "＜ヨハネの書＞と呼ばれる本です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/004d6",
  "speaker": 0,
  "jp": [
   "ヨハネの書・・・？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00512",
  "speaker": 16,
  "jp": [
   "正確には＜ヨハネの書＞の",
   "写本です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00570",
  "speaker": 0,
  "jp": [
   "これは・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/005b8",
  "speaker": 16,
  "jp": [
   "お兄様、そこには",
   "何が書かれているのですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00600",
  "speaker": 0,
  "jp": [
   "世界樹と第一次倒立樹計画に",
   "ついてだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00638",
  "speaker": 0,
  "jp": [
   "世界樹が大地を支え、",
   "高次元から膨大なエネルギーを",
   "この世界に供給していること"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/0069c",
  "speaker": 0,
  "jp": [
   "インセストと世界樹を使って",
   "膨大なエネルギーを自在に操る",
   "＜倒立樹＞の儀式のこと"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00712",
  "speaker": 0,
  "jp": [
   "だがしかし、これは・・・",
   "何かがおかしい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00778",
  "speaker": 16,
  "jp": [
   "ベイル様も",
   "お気づきになられましたか？",
   "そこにある違和感に"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/007de",
  "speaker": 0,
  "jp": [
   "ああ、何もかも唐突すぎる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00824",
  "speaker": 0,
  "jp": [
   "天使や悪魔がそれを知るに至った",
   "それまでの経緯が一切ない・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/0087c",
  "speaker": 16,
  "jp": [
   "ええ、テリオス様も",
   "それを不信に思われていました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/008ce",
  "speaker": 16,
  "jp": [
   "これは、天使や悪魔が",
   "知り得るような知識ではない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00914",
  "speaker": 16,
  "jp": [
   "この知識を天使や悪魔に",
   "教えられる者がいたとしたら",
   "それは神しかいないだろうと"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/0098e",
  "speaker": 0,
  "jp": [
   "神が・・",
   "天使と悪魔にこの知識を？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/009da",
  "speaker": 16,
  "jp": [
   "言葉のあやですわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/009fc",
  "speaker": 16,
  "jp": [
   "それくらいに超常的な",
   "何かがない限り知り得ない",
   "知識だということです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00a82",
  "speaker": 0,
  "jp": [
   "・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00bb8",
  "speaker": 16,
  "jp": [
   "激動の歴史に現れる奇妙な空白",
   "＜ブランク＞だな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00c04",
  "speaker": 0,
  "jp": [
   "＜ブランク＞・・ですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00c38",
  "speaker": 16,
  "jp": [
   "長く生きると",
   "歴史の節目に奇妙な空白を",
   "感じる時がある"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00c84",
  "speaker": 16,
  "jp": [
   "歴史を一つの本にたとえた時",
   "大きな流れの節目には必ず現れる",
   "奇妙なページの欠落だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00cfa",
  "speaker": 16,
  "jp": [
   "歴史の失われたページ・・",
   "私はそれを＜ブランク＞と呼ぶが",
   "呼び方など自由だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00d6a",
  "speaker": 16,
  "jp": [
   "＜空白の行＞",
   "アンノウンが瞬く時・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00db2",
  "speaker": 16,
  "jp": [
   "ホワイトフェイスは",
   "歴史のブランクを知ったのでは",
   "ないのだろうか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00e22",
  "speaker": 0,
  "jp": [
   "ヴァルトス様・・・",
   "もっとわかりやすく・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00e7c",
  "speaker": 16,
  "jp": [
   "歴史の空白を引き起こす",
   "超常的な＜何か＞との接触に",
   "成功したのだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00ed8",
  "speaker": 16,
  "jp": [
   "その超常的な何かが",
   "人なのか、物なのかはわからない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00f2e",
  "speaker": 16,
  "jp": [
   "だが彼は現に",
   "過ぎたる知識を使い",
   "倒立樹を完成させようとしている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/00fae",
  "speaker": 16,
  "jp": [
   "過ぎたる知識を得ることは",
   "過ぎたる力を手にするのと",
   "同意義だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01028",
  "speaker": 0,
  "jp": [
   "知識と力が同意義だと？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01068",
  "speaker": 16,
  "jp": [
   "野心のある者ならば",
   "おそらくその両方を求めるだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/010b0",
  "speaker": 16,
  "jp": [
   "過ぎたる知識と過ぎたる力・・",
   "片方だけでも野心をくすぐるには",
   "十分な魅力がある"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01114",
  "speaker": 16,
  "jp": [
   "パスカのペインリングを手にした",
   "アラギも・・また、過ぎたる力に",
   "野心をくすぐられたのだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01192",
  "speaker": 16,
  "jp": [
   "パスカのペインリングがなければ",
   "アラギも野心を持たずにすんだ",
   "かもしれないな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/011fc",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/0122a",
  "speaker": 16,
  "jp": [
   "過ぎたる力、それが何であるか",
   "今の我々に知る術は無い"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01282",
  "speaker": 16,
  "jp": [
   "せめてホワイトフェイスが",
   "何を知っているのかさえわかれば",
   "マティアの居場所も・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01314",
  "speaker": 0,
  "jp": [
   "マティアの居場所がわかる",
   "ようになるんですか！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01380",
  "speaker": 16,
  "jp": [
   "教団を裏切る強硬手段に出たと",
   "言うことは、彼の計画は",
   "最終段階を迎えているはずです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/013e8",
  "speaker": 16,
  "jp": [
   "倒立樹を完成させるためには",
   "触媒となるインセストが必要で",
   "ある以上、"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01444",
  "speaker": 16,
  "jp": [
   "その確保もままならないまま",
   "彼が強硬手段に出るとは",
   "とうてい考えられません"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/014ce",
  "speaker": 0,
  "jp": [
   "ホワイトフェイスが",
   "マティアの居場所を・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/0153c",
  "speaker": 16,
  "jp": [
   "写本ではなく、オリジナルの",
   "＜ヨハネの書＞が見つかれば",
   "何かわかるかもしれない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/015b6",
  "speaker": 0,
  "jp": [
   "！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/015d6",
  "speaker": 16,
  "jp": [
   "この写本は完全ではなく",
   "いくつかページが抜け落ちて",
   "いるらしい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/0162c",
  "speaker": 16,
  "jp": [
   "テリオス様が手を尽くして",
   "探してみたが、教団が所蔵する",
   "本の中にはないそうだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/0169e",
  "speaker": 16,
  "jp": [
   "ホワイトフェイスの手に落ちるか",
   "＜慟哭の５５５日戦争＞の",
   "戦火の中で消失していなければ、"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/0170c",
  "speaker": 16,
  "jp": [
   "オリジナルは",
   "どこかに必ず存在するはずだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01750",
  "speaker": 0,
  "jp": [
   "ボク、これと同じ本",
   "見たことがあるんだ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/017a8",
  "speaker": 16,
  "jp": [
   "！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/017d2",
  "speaker": 0,
  "jp": [
   "これと同じ本が",
   "ヨハネの書斎にあったんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/0181a",
  "speaker": 16,
  "jp": [
   "ヨハネ・・・？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01844",
  "speaker": 0,
  "jp": [
   "ボクの側にいてくれた",
   "灰色の翼を持つ天使の名前も",
   "ヨハネなんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/018c0",
  "speaker": 16,
  "jp": [
   "＜ヨハネの書＞と",
   "灰色の翼の天使ヨハネ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/0192a",
  "speaker": 16,
  "jp": [
   "確かに、因果めいたものは",
   "感じなくもありませんが・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/0198a",
  "speaker": 0,
  "jp": [
   "でも、ヨハネがそんなスゴイ本",
   "持ってるはずないよね・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/019d8",
  "speaker": 0,
  "jp": [
   "翼の色が少し違うだけで",
   "ヨハネは普通の天使なんだから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01a48",
  "speaker": 16,
  "jp": [
   "でも、確かめてみるだけの価値は",
   "あるんじゃない？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01aa2",
  "speaker": 0,
  "jp": [
   "きっとボクの勘違いだよ！",
   "ほら、ヨハネの書斎って",
   "本がいっぱいあるから・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01b20",
  "speaker": 16,
  "jp": [
   "ヨハネのこと知るのが怖いの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01b66",
  "speaker": 0,
  "jp": [
   "！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01b7c",
  "speaker": 0,
  "jp": [
   "・・ち、違うよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01baa",
  "speaker": 0,
  "jp": [
   "ボクはただ、",
   "キボートス島には帰りづらいんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01c02",
  "speaker": 16,
  "jp": [
   "アタシ達は、アベルが奪った",
   "パスカのペインリングを",
   "奪い返さなきゃいけない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01c64",
  "speaker": 16,
  "jp": [
   "あんたは、アベルにさらわれた",
   "マティアを取り返したい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01cac",
  "speaker": 16,
  "jp": [
   "みんな、時間がないのよ・・",
   "それなのに、何を今さら",
   "弱腰になってためらうわけ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01d18",
  "speaker": 0,
  "jp": [
   "だって、",
   "ここからキボートスは遠いよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01d50",
  "speaker": 0,
  "jp": [
   "それに、無駄足を踏まされるのが",
   "一番嫌いだったのはルカ達じゃ",
   "ないか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01dc2",
  "speaker": 16,
  "jp": [
   "ふぅん・・・",
   "がっつかなくなったじゃない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01e08",
  "speaker": 0,
  "jp": [
   "ボクだって、いつまでも",
   "闇雲に走るだけの子供なんかじゃ",
   "ないよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01e64",
  "speaker": 16,
  "jp": [
   "そう・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01e8e",
  "speaker": 16,
  "jp": [
   "それじゃあ、のんびりしてて",
   "マティアの救出が間に合わなく",
   "なってもいいのね？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01f06",
  "speaker": 1,
  "jp": [
   "そ、そんなのダメだよっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01f4a",
  "speaker": 16,
  "jp": [
   "カイン",
   "利口になろうとすることだけが",
   "正しいことじゃないのよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01fa4",
  "speaker": 0,
  "jp": [
   "え？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/01fc4",
  "speaker": 16,
  "jp": [
   "あんたは子供なんだから",
   "背伸びなんかしなくていいのよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/0200c",
  "speaker": 16,
  "jp": [
   "自分の気持ちをしっかり",
   "掴まえておきなさい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/0204c",
  "speaker": 16,
  "jp": [
   "でないと、そこの六翼みたいに",
   "大切なことに気づくまでに",
   "遠回りすることになるわよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/02188",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/02280",
  "speaker": 0,
  "jp": [
   "ボクは背伸びなんかしてないよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/022c6",
  "speaker": 16,
  "jp": [
   "そうかしら？",
   "少なくとも、アタシは",
   "カインらしくないと感じたわよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/02324",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/325/02356",
  "speaker": 16,
  "jp": [
   "ヨハネもひどい男よね",
   "言葉では何も伝えないまま",
   "逝ってしまったんだもの・・"
  ],
