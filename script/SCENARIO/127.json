[
 {
  "id": "SCENARIO/127/0012c",
  "speaker": 17,
  "jp": [
   "アラギに会っただって！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00190",
  "speaker": 0,
  "jp": [
   "まーまー",
   "落ち着けって"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/001c4",
  "speaker": 17,
  "jp": [
   "うるさい！！",
   "どうしてアタシを呼ばなかった！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/0021a",
  "speaker": 0,
  "jp": [
   "無理言うなよ",
   "俺とザイオンの二人じゃ",
   "どうしようもなかったんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/0028c",
  "speaker": 16,
  "jp": [
   "ザイオン！",
   "あんたがいたのに、どうして！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/002cc",
  "speaker": 16,
  "jp": [
   "せっかくのチャンスだったのに"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00324",
  "speaker": 0,
  "jp": [
   "焦るなルカ、俺達の目的は",
   "パスカのペインリングの回収だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00370",
  "speaker": 0,
  "jp": [
   "使命を果たさず",
   "犬死にするわけにはいかない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/003b0",
  "speaker": 0,
  "jp": [
   "第一、今の俺とお前の二人で",
   "本気でアラギに勝てると思って",
   "いるのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00422",
  "speaker": 16,
  "jp": [
   "へぇ・・・",
   "＜百人斬りのザイオン＞が",
   "聞いて呆れるわよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00470",
  "speaker": 16,
  "jp": [
   "いつから臆病風に吹かれる",
   "ようになったんだい？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/004b4",
  "speaker": 16,
  "jp": [
   "勝てるかどうかなんて",
   "やってみなきゃわからないわよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00514",
  "speaker": 0,
  "jp": [
   "本気で言ってるのなら",
   "＜冷血のルカ＞も名前負けだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00574",
  "speaker": 16,
  "jp": [
   "ザイオン・・・",
   "アタシにケンカを売るつもり？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/005cc",
  "speaker": 0,
  "jp": [
   "別に収穫が",
   "何もなかったわけじゃない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/0061c",
  "speaker": 16,
  "jp": [
   "！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/006e0",
  "speaker": 16,
  "jp": [
   "・・・それとも",
   "アイツのために汚れるつもりなら",
   "俺も一緒に地下を歩いてやるぜ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00874",
  "speaker": 0,
  "jp": [
   "地下を歩くと言ったら",
   "＜幽葬の地下通路＞しかない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/008b8",
  "speaker": 0,
  "jp": [
   "アラギはそこにいる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00904",
  "speaker": 16,
  "jp": [
   "＜幽葬の地下通路＞って言ったら",
   "前にパスカやアラギと会った",
   "ところだよね？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00980",
  "speaker": 16,
  "jp": [
   "でも、アラギ達はもう",
   "あそこには・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/009e4",
  "speaker": 0,
  "jp": [
   "＜幽葬の地下通路＞は",
   "さらに奥深くまで続いている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00a28",
  "speaker": 0,
  "jp": [
   "おそらく、アラギ達は",
   "さらに奥へと移動したのだろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00a7a",
  "speaker": 16,
  "jp": [
   "でも、あんな迷路みたいな場所",
   "あれ以上奥に行ったら、",
   "帰り道がわからなくなるよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00ae8",
  "speaker": 0,
  "jp": [
   "大丈夫だ",
   "元よりカインの記憶力は",
   "あてにしていない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00b5a",
  "speaker": 16,
  "jp": [
   "ううう・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00b80",
  "speaker": 0,
  "jp": [
   "それでどうする？",
   "行くのか、行かないのか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00bec",
  "speaker": 16,
  "jp": [
   "聞かなくても",
   "行くに決まってるでしょ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00c50",
  "speaker": 0,
  "jp": [
   "よっしゃあ！",
   "そうと決まったら"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00cac",
  "speaker": 16,
  "jp": [
   "わたしも同行させて下さい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00d00",
  "speaker": 0,
  "jp": [
   "シリア！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00d32",
  "speaker": 16,
  "jp": [
   "すみません",
   "お話は聞かせて頂きました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00d7a",
  "speaker": 16,
  "jp": [
   "わたしも、皆様にお力添え",
   "出来るのなら、同行させて下さい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00dde",
  "speaker": 0,
  "jp": [
   "怪我の方はもう大丈夫なの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00e22",
  "speaker": 16,
  "jp": [
   "はい、わたしも天使ですから",
   "それに四翼は、普通の天使より",
   "傷の治りが早いんです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00eb0",
  "speaker": 0,
  "jp": [
   "いいじゃん、連れて行こうぜ",
   "こっそり後をつけられるよりは",
   "目の届くとこに置いた方が安全だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00f44",
  "speaker": 16,
  "jp": [
   "いえ、あの・・・",
   "そんなつもりは・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00fa8",
  "speaker": 0,
  "jp": [
   "図星だって、顔に出てるぜ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/00fea",
  "speaker": 16,
  "jp": [
   "あの、その・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/01038",
  "speaker": 16,
  "jp": [
   "和んでる暇があったら行くぞ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/127/01094",
  "speaker": 16,
  "jp": [
   "アラギ・・・",
   "今日こそケリをつけてやる！"
  ],
  "en": ""
 },
