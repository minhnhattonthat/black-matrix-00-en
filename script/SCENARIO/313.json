[
 {
  "id": "SCENARIO/313/00270",
  "jp": "構成員・男",
  "en": ""
 },
 {
  "id": "SCENARIO/313/00284",
  "speaker": null,
  "jp": [
   "各地の教団施設が、",
   "エンブリオンに襲われている",
   "らしい・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00304",
  "jp": "構成員・女",
  "en": ""
 },
 {
  "id": "SCENARIO/313/00318",
  "speaker": null,
  "jp": [
   "情報収集に急いでいるけれど",
   "襲われた教団施設の数が",
   "多すぎるわ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/003a0",
  "jp": "構成員・若者",
  "en": ""
 },
 {
  "id": "SCENARIO/313/003b6",
  "speaker": null,
  "jp": [
   "あわただしいことに",
   "なってきたな・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/0041c",
  "jp": "ダリア",
  "en": ""
 },
 {
  "id": "SCENARIO/313/0042c",
  "speaker": null,
  "jp": [
   "急ぐんだろう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00444",
  "speaker": null,
  "jp": [
   "ちゃんと弔ってあげるから",
   "行っておいで"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/004e4",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/313/004f4",
  "speaker": null,
  "jp": [
   "・・・あの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00508",
  "jp": "ウェイター",
  "en": ""
 },
 {
  "id": "SCENARIO/313/0051c",
  "speaker": null,
  "jp": [
   "えっ",
   "ダリアさんの現役時代？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00544",
  "speaker": null,
  "jp": [
   "ええ、",
   "それは、もう・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00570",
  "speaker": null,
  "jp": [
   "とても、",
   "言葉では言い表せませんが"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/005a0",
  "speaker": null,
  "jp": [
   "あ、こう見えても、",
   "私の現役時代も・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/005d4",
  "speaker": null,
  "jp": [
   "・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/005ec",
  "speaker": null,
  "jp": [
   "その目は、信用してませんね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00610",
  "speaker": null,
  "jp": [
   "まあ、良いですよ",
   "昔のことは・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00640",
  "speaker": null,
  "jp": [
   "・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00658",
  "speaker": null,
  "jp": [
   "これ、持っていって下さい",
   "私が現役時代に",
   "使っていたモノですが"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/006a4",
  "speaker": null,
  "jp": [
   "さび付かせておくのは",
   "もったいない業物ですから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00708",
  "jp": "ウェイター",
  "en": ""
 },
 {
  "id": "SCENARIO/313/0071c",
  "speaker": null,
  "jp": [
   "シクシク・・・",
   "いらっしゃいませ～～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/0074c",
  "speaker": null,
  "jp": [
   "姉弟感動の再会が・・うぅッ",
   "こんなのなしですよ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/007c4",
  "jp": "剣士の恋人",
  "en": ""
 },
 {
  "id": "SCENARIO/313/007d8",
  "speaker": null,
  "jp": [
   "彼はよく、この酒場の",
   "この場所にいたそうです・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00818",
  "speaker": null,
  "jp": [
   "どうしたら、この悲しみは",
   "癒えるというのでしょう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00858",
  "speaker": null,
  "jp": [
   "この剣で彼を殺した異端者を",
   "殺しても、殺しても・・・",
   "殺し足りないほど憎い・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/008ec",
  "jp": "中年",
  "en": ""
 },
 {
  "id": "SCENARIO/313/008fa",
  "speaker": null,
  "jp": [
   "女房のヤツが酒をやめろとな・・",
   "やめるまで家に入れねぇとまで",
   "言いやがってよぉ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/0095c",
  "speaker": null,
  "jp": [
   "はぁ・・・酒は飲めねえが、",
   "飲む気分だけでも味わいたくて",
   "ここに通う毎日だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/009e8",
  "jp": "片翼の天使",
  "en": ""
 },
 {
  "id": "SCENARIO/313/009fc",
  "speaker": null,
  "jp": [
   "僕は自由気ままに旅する天使",
   "規則に縛られるよりも",
   "風と草と共に歌うのが好き♪"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00a58",
  "speaker": null,
  "jp": [
   "悲しくても立ち上がって",
   "今日は泣いても、",
   "明日は笑って・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00aa4",
  "speaker": null,
  "jp": [
   "胸の痛みが消えることはない",
   "なんとなく忘れていられる",
   "だけでしかないんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00b30",
  "jp": "老人",
  "en": ""
 },
 {
  "id": "SCENARIO/313/00b3e",
  "speaker": null,
  "jp": [
   "今日はいい天気だのう・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00b98",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/313/00ba6",
  "speaker": null,
  "jp": [
   "兄貴に相談したら",
   "こき使われるのが嫌なら",
   "経営側の苦労を味わえだってさ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00bfc",
  "speaker": null,
  "jp": [
   "ま、なんとかなりそうだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00c5c",
  "jp": "老婆の息子",
  "en": ""
 },
 {
  "id": "SCENARIO/313/00c70",
  "speaker": null,
  "jp": [
   "今日も母の墓参りですよ・・・",
   "いなくなってからじゃ、",
   "何もしてあげられないんですよね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00cd4",
  "speaker": null,
  "jp": [
   "こんなことになるのなら、",
   "お互い意地をはらず、素直に",
   "仲直りすれば良かった・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/313/00d68",
  "jp": "カップル・男",
  "en": ""
 },
 {
  "id": "SCENARIO/313/00d7e",
  "speaker": null,
  "jp": [
