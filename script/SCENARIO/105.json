 },
 {
  "id": "SCENARIO/105/002dc",
  "speaker": 0,
  "jp": [
   "そうですが・・？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/105/00312",
  "speaker": 16,
  "jp": [
   "そうか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/105/00330",
  "speaker": 16,
  "jp": [
