[
 {
  "id": "SCENARIO/105/00104",
  "speaker": 1,
  "jp": [
   "大変です！二人組の悪魔が、",
   "我が教会を襲撃してきました！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/105/0017c",
  "speaker": 16,
  "jp": [
   "くそ！かぎつけてきたか！！",
