[
 {
  "id": "SCENARIO/299/0016e",
  "speaker": 16,
  "jp": [
   "ヴァルトス様・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/0019c",
  "speaker": 19,
  "jp": [
   "サイファーパンクの正式な一員に",
   "認められた時に、ヴァルトス様は",
   "この小刀を俺に預けてくれた"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/0020c",
  "speaker": 19,
  "jp": [
   "まじないが込められた",
   "大切な物だから",
   "お前に預かっていてほしいと・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00276",
  "speaker": 19,
  "jp": [
   "大切な物を人に預けたまま",
   "勝手にどこかに消えるなんて・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/002c4",
  "speaker": 19,
  "jp": [
   "それとも、本当に全部",
   "嘘だったっていうのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/0031a",
  "speaker": 16,
  "jp": [
   "この小刀も、ヴァルトス様に",
   "とってはただのガラクタ",
   "なのかよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/0037e",
  "speaker": 16,
  "jp": [
   "・・・そうだよな",
   "俺みたいな下っ端に、普通",
   "自分の大切な物なんて預けるかよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00414",
  "speaker": 0,
  "jp": [
   "あああっ！",
   "リリス、エクサル発見！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00480",
  "speaker": 16,
  "jp": [
   "リ、リリスっ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/004ba",
  "speaker": 0,
  "jp": [
   "もう、エクサルったらダメなの！",
   "一人で飛び出しちゃうから",
   "リリスとキロタで捜したんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/0053e",
  "speaker": 16,
  "jp": [
   "・・・あぁ、ごめん"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00598",
  "speaker": 0,
  "jp": [
   "ごめん、じゃないですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/005ce",
  "speaker": 0,
  "jp": [
   "エクサルさんも",
   "考えなしに飛び出さないで下さい",
   "捜す方も大変なんですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00642",
  "speaker": 16,
  "jp": [
   "あはははは・・・",
   "すみません"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/006a8",
  "speaker": 0,
  "jp": [
   "あれ？",
   "エクサル、その小刀は・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/006f2",
  "speaker": 16,
  "jp": [
   "ああ、これ？",
   "カインにも見せてなかったっけ？",
   "これは・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00778",
  "speaker": 0,
  "jp": [
   "ふわーっ",
   "エクサル、それどうしたの？",
   "すごい綺麗なナイフなの！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/0080a",
  "speaker": 16,
  "jp": [
   "あわわっ！",
   "危ないだろう！",
   "こいつは触っちゃダメだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/0086a",
  "speaker": 0,
  "jp": [
   "うーーー",
   "エクサルのケチ～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/0094c",
  "speaker": 0,
  "jp": [
   "ダメですよ、リリス",
   "小さくても刃物は刃物です",
   "扱いを間違えると大変なんですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/009e4",
  "speaker": 16,
  "jp": [
   "うーー",
   "ちょっと見たかっただけだもん"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00afc",
  "speaker": 0,
  "jp": [
   "ねぇ、エクサル",
   "ダメ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00b3e",
  "speaker": 16,
  "jp": [
   "これは俺のじゃなくて",
   "ヴァルトス様の小刀なの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00b8e",
  "speaker": 16,
  "jp": [
   "預かり物を貸し出しは出来ません"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00cda",
  "speaker": 0,
  "jp": [
   "ちょっとだけ！",
   "ちょっとだけっ！",
   "リリスも持ってみたいーっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00d46",
  "speaker": 16,
  "jp": [
   "ああもう、わかったから！",
   "ちょっと触るだけだぞ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00da2",
  "speaker": 0,
  "jp": [
   "やったー！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00dd6",
  "speaker": 16,
  "jp": [
   "・・・ったく",
   "こんなの珍しくもない",
   "ただの小刀だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00e84",
  "speaker": 0,
  "jp": [
   "そんなことないよ",
   "リリスにもわかるの",
   "これは特別なものだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00eea",
  "speaker": 16,
  "jp": [
   "そんなんじゃない",
   "これは・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00f32",
  "speaker": 0,
  "jp": [
   "内側からキラキラしてる・・・",
   "これ、エクサルの無事を願う",
   "気持ちが込められているの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00fb2",
  "speaker": 16,
  "jp": [
   "俺の無事を願う気持ち？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/00ff2",
  "speaker": 0,
  "jp": [
   "うん、とても優しい気持ちだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/0102e",
  "speaker": 0,
  "jp": [
   "でも、だんだん光が",
   "弱くなっているの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/0107e",
  "speaker": 16,
  "jp": [
   "光が弱くなるって・・",
   "何か良くないことなのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/010c8",
  "speaker": 0,
  "jp": [
   "祈りが絶えようとしているの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/0110a",
  "speaker": 16,
  "jp": [
   "祈りが絶えるって・・・",
   "もう、俺のことなんか",
   "どうでもいいってことか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/0117e",
  "speaker": 0,
  "jp": [
   "違うの！",
   "そんなんじゃないの！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/011be",
  "speaker": 0,
  "jp": [
   "この小刀にエクサルの無事を",
   "願う気持ちを込めた誰かが",
   "消えそうになっているの・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/0123e",
  "speaker": 16,
  "jp": [
   "消える・・・それってまさか？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/01286",
  "speaker": 0,
  "jp": [
   "エクサルを想ってくれている",
   "誰かが、死んでしまいそうなの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/012ea",
  "speaker": 17,
  "jp": [
   "ヴァルトス様っ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/0141a",
  "speaker": 16,
  "jp": [
   "ちょっと",
   "どこに行くの！！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/01474",
  "speaker": 0,
  "jp": [
   "大丈夫です",
   "エクサルさんには声が聞こえて",
   "いるはずです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/014e8",
  "speaker": 16,
  "jp": [
   "声？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/01516",
  "speaker": 0,
  "jp": [
   "サンバルテルミで、",
   "マティアさんの声がカインさんに",
   "聞こえたのと同じことです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/01586",
  "speaker": 0,
  "jp": [
   "インセストではなくても",
   "心の繋がった人達の間では",
   "不思議と何かがつながるんです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/015fa",
  "speaker": 0,
  "jp": [
   "こういうのを、虫の知らせとも",
   "言いますけれどね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/0164a",
  "speaker": 0,
  "jp": [
   "エクサルさんを追いましょう",
   "きっと、ヴァルトスさんの身に",
   "何か危険が迫っているはずです！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/05214",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/299/05222",
  "speaker": 0,
  "jp": [
   "ボンジュール"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/299/0523a",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/299/0524a",
  "speaker": 0,
  "jp": [
   "？？？"
  ],
  "en": ""
 }
