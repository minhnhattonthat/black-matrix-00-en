  "en": ""
 },
 {
  "id": "SCENARIO/049/01a6e",
  "speaker": 16,
  "jp": [
   "そんなの平気です！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01a94",
  "speaker": 16,
  "jp": [
   "あんな悪魔に抱えられて",
   "空を飛ぶ方がずーっと気分が",
   "悪くなりますから！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01b38",
  "speaker": 0,
  "jp": [
   "ああ、そうだな・・・",
   "俺もお前を抱えて飛ぶくらいなら",
   "ガキ二人抱えて飛ぶ方がマシだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01ba0",
  "speaker": 0,
  "jp": [
   "丁度良いから運んでもらってこい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01be6",
  "speaker": 17,
  "jp": [
   "な、なんですってー！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01c38",
  "speaker": 0,
  "jp": [
   "見た目こそ変わらぬが・・・",
   "そんなに変わっていたのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01c9a",
  "speaker": 17,
  "jp": [
   "ク、クレイス様！",
   "こんな悪魔の言葉を",
   "真に受けないで下さい！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01cf0",
  "speaker": 17,
  "jp": [
   "あたし、そんなに",
   "太ってなんかいないです！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01d30",
  "speaker": 17,
  "jp": [
   "太ったのはちょっとだけです！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01d88",
  "speaker": 0,
  "jp": [
   "・・・墓穴を掘ってるぞ、お前"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01dce",
  "speaker": 17,
  "jp": [
   "はっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01df6",
  "speaker": 17,
  "jp": [
   "どーしてくれるのよ！！",
   "またも余計な自己申告",
   "しちゃったじゃない！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01e66",
  "speaker": 0,
  "jp": [
   "・・知るか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01e9a",
  "speaker": 16,
  "jp": [
   "うぅぅぅぅ・・・"
  ],
  "en": ""
 },
