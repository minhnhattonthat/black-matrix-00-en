  "en": ""
 },
 {
  "id": "SCENARIO/049/016ce",
  "speaker": 0,
  "jp": [
   "自分でわかっているなら",
   "少し黙っていろ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01708",
  "speaker": 0,
  "jp": [
   "また墓穴を掘るだけだぞ"
