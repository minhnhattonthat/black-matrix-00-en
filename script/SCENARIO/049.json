  "en": ""
 },
 {
  "id": "SCENARIO/049/0175a",
  "speaker": 16,
  "jp": [
   "・・・うぅぅぅ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/0178a",
  "speaker": 16,
  "jp": [
   "言っておくけど・・・",
   "変なところ触ったら、殺すわよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/017e6",
  "speaker": 0,
  "jp": [
   "誰がお前なんか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01822",
  "speaker": 17,
  "jp": [
   "なんですってぇーー！！！",
   "それ、どういう意味よ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01890",
  "speaker": 0,
  "jp": [
   "ステイエン",
   "落ち着いて・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/018d6",
  "speaker": 17,
  "jp": [
   "十分落ち着いてます！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01912",
  "speaker": 0,
  "jp": [
   "・・そうですわね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01950",
  "speaker": 0,
  "jp": [
   "ステイエン、よろしければ",
   "私と一緒にキボートスまで",
   "移動しますか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/019be",
  "speaker": 16,
  "jp": [
   "いいんですか！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/019f6",
  "speaker": 0,
  "jp": [
   "ただ、慣れていない方は",
   "移動の際にかかる負荷で",
   "気分を悪くされないかと・・・"
