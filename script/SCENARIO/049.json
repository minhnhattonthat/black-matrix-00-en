  "en": ""
 },
 {
  "id": "SCENARIO/049/002be",
  "speaker": 1,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/002dc",
  "speaker": 16,
  "jp": [
   "定期船とかは出てるのかい？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/0031e",
  "speaker": 0,
  "jp": [
   "ええと、小さな島だから",
   "そんなのは・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00372",
  "speaker": 16,
  "jp": [
   "ふぅ、やれやれ・・",
   "どうするつもりなんだい？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/003bc",
  "speaker": 0,
  "jp": [
   "・・・お、泳ぐとか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/003fa",
  "speaker": 16,
  "jp": [
   "もっとマシな考えはないのかい？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00442",
  "speaker": 0,
  "jp": [
   "うぅぅぅぅ・・",
   "やっぱり船がないと海は・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/0049a",
  "speaker": 16,
  "jp": [
   "船に限らなくても",
   "たとえば、飛べない子達は誰かに",
   "抱えて飛んでもらうとか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00516",
  "speaker": 1,
  "jp": [
   "はっ！",
   "それだっ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00556",
  "speaker": 0,
  "jp": [
   "ありがとう、ダリアさん！！",
   "きっとそれでなんとかなるよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/005ba",
  "speaker": 16,
  "jp": [
   "・・いいけれど、くれぐれも",
   "抱えている人を海に落となさい",
   "ように気をつけるんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00636",
  "speaker": 0,
  "jp": [
   "うん、気をつけるようにするよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/0067e",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/006b2",
  "speaker": 16,
  "jp": [
   "・・・カイン",
   "あんたは張り切らないで",
   "他の人に任せておきなさい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/0071e",
  "speaker": 0,
  "jp": [
   "え？",
   "どうして・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/0075e",
  "speaker": 16,
  "jp": [
   "そりゃ、あんたが一番",
   "抱えてる人を落としそうだからね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/007d2",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00820",
  "speaker": 0,
  "jp": [
   "おばちゃん",
   "あんまりカインいじめるなよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00872",
  "speaker": 16,
  "jp": [
   "なんだい、いたのかいエクサル"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/008ae",
  "speaker": 16,
  "jp": [
   "だーれも",
   "坊やをいじめてなんかいないよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/008fe",
  "speaker": 0,
  "jp": [
   "どうだか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00942",
  "speaker": 0,
  "jp": [
   "しっかし、海を渡るっていうのは",
   "盲点だったな～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/009ac",
  "speaker": 16,
  "jp": [
   "うん",
   "ボクもすっかり忘れてたよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/009f6",
  "speaker": 0,
  "jp": [
   "ま、とりあえずカインは",
   "抱えて飛ぶ人から除外な"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00a4e",
  "speaker": 17,
  "jp": [
   "えええっ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00a74",
  "speaker": 0,
  "jp": [
   "だってお前が一番",
   "危なさそうじゃん"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00ac2",
  "speaker": 17,
  "jp": [
   "エクサルまで、ひどい！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00aec",
  "speaker": 17,
  "jp": [
   "ボクにだって、人を抱えて",
   "飛ぶことぐらい出来るよ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00b62",
  "speaker": 0,
  "jp": [
   "そこまで言うなら",
   "軽そうなところで",
   "キロタかリリスが打倒だな・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00be0",
  "speaker": 17,
  "jp": [
   "ダメダメ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00c04",
  "speaker": 16,
  "jp": [
   "リリス、一緒に空を飛ぶなら",
   "シリアお姉ちゃんがいいの！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00c66",
  "speaker": 0,
  "jp": [
   "じゃ、リリスはシリアに任せて",
   "カインにはキロタを・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00cd8",
  "speaker": 17,
  "jp": [
   "ちょっと待って下さい！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00d0c",
  "speaker": 16,
  "jp": [
   "僕にだって自分の命を預けるなら",
   "信頼できる人を選ぶ権利がある",
   "はずです！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00d96",
  "speaker": 0,
  "jp": [
   "・・いや、気持ちはわかるけど"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00dda",
  "speaker": 16,
  "jp": [
   "僕は一番安全そうな",
   "ベイルさんと一緒がいいです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00e44",
  "speaker": 0,
  "jp": [
   "私か・・？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00e76",
  "speaker": 16,
  "jp": [
   "ええ、お願いしても",
   "よろしいですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00ec6",
  "speaker": 0,
  "jp": [
   "ああ、かまわん"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00f18",
  "speaker": 16,
  "jp": [
   "・・・ボクって",
   "そんなに信用ないのかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00f8e",
  "speaker": 0,
  "jp": [
   "・・まぁ、",
   "飛ぶことに限っての話なんだから",
   "そんなに気を落とすなよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00fe8",
  "speaker": 0,
  "jp": [
   "残りは俺とステイエンだけど・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/0102e",
  "speaker": 16,
  "jp": [
   "わかったよ",
   "エクサルはボクが抱えて飛ぶから",
   "任せておいて！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01096",
  "speaker": 1,
  "jp": [
   "えぇぇ？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/010ca",
  "speaker": 16,
  "jp": [
   "エクサルもやっぱり・・",
   "ボクに命を預けるのは嫌なの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/0112a",
  "speaker": 0,
  "jp": [
   "あはははははは・・・",
   "いや、その・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01164",
  "speaker": 0,
  "jp": [
   "ほら！",
   "俺とステイエンって同じくらいの",
   "身長だろ？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/011b0",
  "speaker": 0,
  "jp": [
   "男より女の方が軽いはずだから",
   "カインに任せるのは順番的に",
   "ステイエンだって！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/0124e",
  "speaker": 17,
  "jp": [
   "そ、そんなの絶対にダメよ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01292",
  "speaker": 0,
  "jp": [
   "おいおい、ステイエン",
   "そんな大声で嫌がるなよ・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/012d8",
  "speaker": 0,
  "jp": [
   "カインのヤツ、今にも",
   "泣きそうな顔してるんだぞ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01332",
  "speaker": 16,
  "jp": [
   "わかってるわよ！",
   "でも、あたしじゃ絶対に",
   "ダメなのよ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01396",
  "speaker": 0,
  "jp": [
   "なんで？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/013c6",
  "speaker": 16,
  "jp": [
   "だ、だって、",
   "あたしの方があんたより・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/0140c",
  "speaker": 0,
  "jp": [
   "俺より？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/0143e",
  "speaker": 17,
  "jp": [
   "悪かったわね！",
   "身長は同じでも、あんたより",
   "あたしの方が重いのよっ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/014de",
  "speaker": 0,
  "jp": [
   "あんた、体力には自信あるのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01538",
  "speaker": 16,
  "jp": [
   "人並みにはあるつもりだが・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/0157e",
  "speaker": 0,
  "jp": [
   "重い方は俺が運ぶ",
   "お前はエクサルを運んでやれ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/015e8",
  "speaker": 17,
  "jp": [
   "ちょっと！",
   "重たい方ってレディに失礼よ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/0163a",
  "speaker": 0,
  "jp": [
   "お前を名指しした覚えはない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/01670",
  "speaker": 17,
  "jp": [
   "消去法でいったら残るのは",
   "あたししかいないでしょ！"
