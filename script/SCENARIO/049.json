[
 {
  "id": "SCENARIO/049/0010a",
  "speaker": 16,
  "jp": [
   "聞いたよ",
   "久々に故郷に帰るんだってね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/0016c",
  "speaker": 0,
  "jp": [
   "うん"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/0019a",
  "speaker": 16,
  "jp": [
   "でも、キボートス島って",
   "言うくらいなんだから",
   "海を渡るんだろう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/001f0",
  "speaker": 16,
  "jp": [
   "大丈夫なのかい？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/0022a",
  "speaker": 0,
  "jp": [
   "大丈夫だよ",
   "翼があれば・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/049/00264",
  "speaker": 16,
  "jp": [
   "坊やはいいけれど",
   "翼のない子達はどうするんだい？"
