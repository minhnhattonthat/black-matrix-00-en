  "en": ""
 },
 {
  "id": "SCENARIO/270/00460",
  "speaker": 16,
  "jp": [
   "そっちが力ずくって言うなら",
   "こっちも力ずくで止めさせて",
   "もらうよ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/270/004e4",
  "speaker": 16,
  "jp": [
   "俺達の村に手を出したこと",
   "後悔させてやる"
