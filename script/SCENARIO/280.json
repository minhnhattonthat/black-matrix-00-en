[
 {
  "id": "SCENARIO/280/00270",
  "jp": "ウンダ",
  "en": ""
 },
 {
  "id": "SCENARIO/280/00280",
  "speaker": null,
  "jp": [
   "マスターいつになるんだ～"
  ],
  "en": "",
  "spill": false
 },
 {
  "id": "SCENARIO/280/002b8",
  "jp": "自警団長",
  "en": ""
 },
 {
  "id": "SCENARIO/280/002ca",
  "speaker": null,
  "jp": [
   "ウンダ様は現存する最古の悪魔"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/002f0",
  "speaker": null,
  "jp": [
   "現存する悪魔の多くは、",
   "皆、どこかでウンダ様の血を",
   "ひいてると言っても過言ではない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00350",
  "speaker": null,
  "jp": [
   "ウンダ様にとって悪魔達は皆、",
   "可愛い我が子や孫達のような",
   "ものなのだろう・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/003e0",
  "jp": "族長補佐",
  "en": ""
 },
 {
  "id": "SCENARIO/280/003f2",
  "speaker": null,
  "jp": [
   "ウンダ様なら、",
   "ルカの看病をしている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00458",
  "jp": "悪魔・少女",
  "en": ""
 },
 {
  "id": "SCENARIO/280/0046c",
  "speaker": null,
  "jp": [
   "ルカが倒れたって聞いたけど",
   "大丈夫なの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/004a0",
  "speaker": null,
  "jp": [
   "あの子・・・",
   "強がりで無理ばかりするから、",
   "ちゃんと見ててあげてね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00524",
  "jp": "女主人",
  "en": ""
 },
 {
  "id": "SCENARIO/280/00534",
  "speaker": null,
  "jp": [
   "あら、いらっしゃい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00550",
  "speaker": null,
  "jp": [
   "ソリュウが、雑記帳に",
   "書き込んでいたけれど・・・",
   "アレ、あんた達あてだろ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/005c4",
  "jp": "ウェイトレス",
  "en": ""
 },
 {
  "id": "SCENARIO/280/005da",
  "speaker": null,
  "jp": [
   "ルカが倒れたんですってね・・・",
   "気を落とさないで、",
   "ルカならきっと大丈夫よ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00634",
  "speaker": null,
  "jp": [
   "辛い気持ちでいっぱいになって、",
   "どうしても寂しくなったら、",
   "お姉さんを呼んでね？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00694",
  "speaker": null,
  "jp": [
   "うふふ、",
   "優しくなぐさめてあげるわ・・・",
   "何もかも忘れるほどにね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00718",
  "jp": "悪魔・剣士",
  "en": ""
 },
 {
  "id": "SCENARIO/280/0072c",
  "speaker": null,
  "jp": [
   "地上は、白羽根や羽根なし・・",
   "教団に忠実な家畜たちにとって",
   "この上なく住みやすい場所だろ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00794",
  "speaker": null,
  "jp": [
   "そんな場所に住んでいながら、",
   "死線をかいくぐって来たなんて、",
   "お前ら・・バカってやつだな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/007fc",
  "speaker": null,
  "jp": [
   "俺はそういうバカなヤツら・・・",
   "嫌いじゃないぜ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/0086c",
  "jp": "悪魔・中年",
  "en": ""
 },
 {
  "id": "SCENARIO/280/00880",
  "speaker": null,
  "jp": [
   "げぇ～っぷ、",
   "飲みたいだけ飲んで、",
   "食いたいだけ食って何が悪い？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00904",
  "jp": "片翼の天使",
  "en": ""
 },
 {
  "id": "SCENARIO/280/00918",
  "speaker": null,
  "jp": [
   "神々の妙なる調べ",
   "それが＜グレイヘンの哀歌＞",
   "全ての詩人が求める最高の詩"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00970",
  "speaker": null,
  "jp": [
   "グレイヘンと言うのは",
   "神の歌声を持つ伝説の美しき咎人",
   "だったと口伝で伝わっている・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/009d4",
  "speaker": null,
  "jp": [
   "その歌声は病める者の",
   "傷をいやしたと言われてるけど",
   "本当のところは何一つわからない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00a34",
  "speaker": null,
  "jp": [
   "美しき咎人・・・グレイヘン",
   "どんな人だったんだろうね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00aa8",
  "jp": "自警団員・男",
  "en": ""
 },
 {
  "id": "SCENARIO/280/00abe",
  "speaker": null,
  "jp": [
   "どんな原石も、",
   "みがかなければ、ただの石ころだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00af8",
  "speaker": null,
  "jp": [
   "天才？才能？",
   "確かに個人の興味と適性と資質が",
   "合致した時は、そう見えるかもな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00b54",
  "speaker": null,
  "jp": [
   "・・・だがな、どんな天才も、",
   "今の自分に甘んじていれば、",
   "すぐに地べたに落とされるものさ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00bf0",
  "jp": "悪魔・男",
  "en": ""
 },
 {
  "id": "SCENARIO/280/00c02",
  "speaker": null,
  "jp": [
   "ソリュウは、",
   "直接言えばいいことまで",
   "雑記帳に書き込むクセがあってな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00c54",
  "speaker": null,
  "jp": [
   "そのせいでずいぶん、",
   "ザイオン、アラギ、ルカを",
   "怒らせていたな・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00cdc",
  "jp": "悪魔・女",
  "en": ""
 },
 {
  "id": "SCENARIO/280/00cee",
  "speaker": null,
  "jp": [
   "地下世界には他にも名前さえ",
   "知られていない小さな勢力が",
   "いくつか存在しているわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00d4c",
  "speaker": null,
  "jp": [
   "でも、古参のフィリオ、ゲルダに",
   "並ぶ勢力を持っているのは、",
   "ここカルヒンくらいでしょうね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00de8",
  "jp": "自警団員・女",
  "en": ""
 },
 {
  "id": "SCENARIO/280/00dfe",
  "speaker": null,
  "jp": [
   "お前達が村に来てから、",
   "あのソリュウが、少しだけ",
   "たくましくなったように見える"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00e5c",
  "speaker": null,
  "jp": [
   "お前達、何かしたのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00ea8",
  "speaker": null,
  "jp": [
   "フン、まあいい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00ec0",
  "speaker": null,
  "jp": [
   "感謝の気持ちだ",
   "持っていきな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00f44",
  "jp": "悪魔・男の子",
  "en": ""
 },
 {
  "id": "SCENARIO/280/00f5a",
  "speaker": null,
  "jp": [
   "恋だの愛だのってさ～",
   "翼ある者には必要ない感情だよな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00f9c",
  "speaker": null,
  "jp": [
   "恋愛って発情のことだろ？",
   "結合しなくても勝手にガキは",
   "出来るってのに・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/00ff4",
  "speaker": null,
  "jp": [
   "まぁ、彼女持ちってのは",
   "男のステータスとして、",
   "マイナスにはならないけどな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/01080",
  "jp": "悪魔・女の子",
  "en": ""
 },
 {
  "id": "SCENARIO/280/01096",
  "speaker": null,
  "jp": [
   "恋は女を美しくするのよ！",
   "バカで言ってるんじゃないわ、",
   "ホントのことなんだから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/010f4",
  "speaker": null,
  "jp": [
   "恋を忘れた女なんて、",
   "あっという間におばさんに",
   "なっちゃうのよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/01144",
  "speaker": null,
  "jp": [
   "だから私は恋をするの、",
   "愛と違って恋は単純だから、",
   "相手が格好良ければそれでいいの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/011d8",
  "jp": "ピエロ",
  "en": ""
 },
 {
  "id": "SCENARIO/280/011e8",
  "speaker": null,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/01204",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/280/01214",
  "speaker": null,
  "jp": [
   "・・・あの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/01228",
  "jp": "ピエロ",
  "en": ""
 },
 {
  "id": "SCENARIO/280/01238",
  "speaker": null,
  "jp": [
   "なんで地下世界にいるのかって？",
   "理由は簡単さ・・・",
   "そこにお客さんがいるからだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/012cc",
  "jp": "プラン",
  "en": ""
 },
 {
  "id": "SCENARIO/280/012dc",
  "speaker": null,
  "jp": [
   "今日も元気に",
   "いらっしゃいませ～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/01324",
  "jp": "フライ",
  "en": ""
 },
 {
  "id": "SCENARIO/280/01334",
  "speaker": null,
  "jp": [
   "いらっしゃいませ～",
   "今日も頑張るの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/280/01380",
  "speaker": null,
  "jp": [
   "一人歩きは危ないのに・・・",
   "リリスはどこだろう？",
   "早く捜さなきゃ"
