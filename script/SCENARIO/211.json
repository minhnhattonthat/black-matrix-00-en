  "en": ""
 },
 {
  "id": "SCENARIO/211/00fea",
  "speaker": 16,
  "jp": [
   "ご期待に添えると思いますよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/211/01076",
  "speaker": 16,
  "jp": [
   "・・・フン、",
   "歳がらもなくよく回る舌だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/211/01114",
  "speaker": 0,
  "jp": [
   "すみません",
