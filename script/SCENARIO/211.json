  "en": ""
 },
 {
  "id": "SCENARIO/211/0070a",
  "speaker": 17,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/211/00728",
  "speaker": 0,
  "jp": [
   "そのためには＜力＞と",
   "優秀な＜駒＞が必要なんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/211/00774",
  "speaker": 16,
  "jp": [
   "本気で言ってるの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/211/007a0",
  "speaker": 0,
  "jp": [
   "なぁルカ、お前も来い",
   "俺たちならうまくやれる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/211/007f6",
  "speaker": 0,
  "jp": [
   "なんならザイオンも誘って",
   "やったっていいんだぜ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/211/00852",
  "speaker": 17,
  "jp": [
   "人をからかうのも",
   "いい加減にしな！！"
