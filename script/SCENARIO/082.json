[
 {
  "id": "SCENARIO/082/0011c",
  "speaker": 0,
  "jp": [
   "今日は＜グーテンベルグ＞の",
   "配布があるのか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/082/00160",
  "speaker": 0,
  "jp": [
   "どうりで街が",
   "閑散としているはずだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/082/001a0",
  "speaker": 16,
  "jp": [
   "ねぇ、ヨハネ",
   "＜グーテンベルグ＞って何？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/082/001e4",
  "speaker": 0,
  "jp": [
   "プロデヴォン教団の教えと",
   "人々が守るべき規律が記された",
   "書物のことだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/082/00240",
  "speaker": 0,
  "jp": [
   "正式名称は",
   "＜グーテンベルグの戒律書＞"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/082/0027c",
  "speaker": 0,
  "jp": [
   "一般には＜書＞などと",
   "呼ばれているが、カインも島に",
   "居た時にはもらっていたはずだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/082/002fa",
  "speaker": 16,
  "jp": [
   "そういえば、そんな名前の本が",
   "ウチにもあったかもしれない・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/082/00354",
  "speaker": 0,
  "jp": [
   "住民ならば誰もが",
   "これを持つよう",
   "義務づけられている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/082/003a0",
  "speaker": 0,
  "jp": [
   "・・・そうだな、",
   "この機を逃すべきではない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/082/003f6",
  "speaker": 16,
  "jp": [
   "どういうこと？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/082/00420",
  "speaker": 0,
  "jp": [
   "＜グーテンベルグ＞を受け取りに",
   "教会には多くの住民達が集まる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/082/00470",
  "speaker": 0,
  "jp": [
   "教団の者たちも",
   "その対応に追われているはずだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/082/004b0",
  "speaker": 0,
  "jp": [
   "これは教団の人間に接触して",
   "情報を聞き出す",
   "絶好の機会だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/082/00516",
  "speaker": 16,
  "jp": [
   "ええと、ヨハネが言いたいのは",
   "とにかくボクたちも",
   "教会に行こうってことだよね？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/082/00592",
  "speaker": 0,
  "jp": [
   "ああ、そういうことだ"
  ],
  "en": ""
 },
