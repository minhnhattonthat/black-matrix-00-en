  "jp": [
   "マティアー！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/236/00160",
  "speaker": 0,
  "jp": [
   "ちょっと落ち着けってカイン！！",
   "いったい、どうしたんだよ？"
