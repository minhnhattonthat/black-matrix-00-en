  "en": ""
 },
 {
  "id": "SCENARIO/236/0081e",
  "speaker": 16,
  "jp": [
   "う・・・うぅ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/236/00864",
  "speaker": 16,
  "jp": [
   "リリス、気持ち悪い",
