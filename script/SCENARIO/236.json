  "en": ""
 },
 {
  "id": "SCENARIO/236/00794",
  "speaker": 0,
  "jp": [
   "みんな大丈夫か？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/236/007b8",
  "speaker": 0,
  "jp": [
   "む・・・キロタ？",
   "どうした、大丈夫か！？"
