[
 {
  "id": "SCENARIO/254/00140",
  "jp": "・・・以上で",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00150",
  "jp": "サンバルテルミ崩壊についての",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00170",
  "jp": "報告を終了します",
  "en": ""
 },
 {
  "id": "SCENARIO/254/001aa",
  "jp": "ごくろう",
  "en": ""
 },
 {
  "id": "SCENARIO/254/001b6",
  "jp": "お前はもう下がりなさい",
  "en": ""
 },
 {
  "id": "SCENARIO/254/001e8",
  "jp": "はい",
  "en": ""
 },
 {
  "id": "SCENARIO/254/001f0",
  "jp": "それでは失礼します",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00252",
  "jp": "サンバルテルミの崩壊に",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0026c",
  "jp": "計画の要となるはずだった",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00288",
  "jp": "インセストの喪失",
  "en": ""
 },
 {
  "id": "SCENARIO/254/002ba",
  "jp": "ここにきて計画が頓挫してしまう",
  "en": ""
 },
 {
  "id": "SCENARIO/254/002dc",
  "jp": "とは、いきどおりを通り越して",
  "en": ""
 },
 {
  "id": "SCENARIO/254/002fc",
  "jp": "笑いすらこみ上げてくるね",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00358",
  "jp": "そうだとも",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00382",
  "jp": "あの娘は＜グレイヘン＞の再来だ",
  "en": ""
 },
 {
  "id": "SCENARIO/254/003a4",
  "jp": "あれほどの＜器＞の持ち主は",
  "en": ""
 },
 {
  "id": "SCENARIO/254/003c2",
  "jp": "捜して見つけられるものではない",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0040a",
  "jp": "あの娘の存在こそが奇跡だったと",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0042c",
  "jp": "いうのに、お前は何をしていた",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0044c",
  "jp": "ベイル・ペレンデール！！",
  "en": ""
 },
 {
  "id": "SCENARIO/254/004a8",
  "jp": "・・・・・・・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/254/004fc",
  "jp": "異端者を追って、崩壊する",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00518",
  "jp": "サンバルテルミに乗り込んだ",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00536",
  "jp": "レッド・ムフロンは戻っていない",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00568",
  "jp": "あの男が簡単に死ぬとは思えんが",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0058a",
  "jp": "生きていても無事ではあるまいな",
  "en": ""
 },
 {
  "id": "SCENARIO/254/005ec",
  "jp": "フン・・・サンバルテルミで",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0060a",
  "jp": "幽閉の身であったはずのお前は",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0062a",
  "jp": "生きて帰って来たというのにな",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00660",
  "jp": "生きて戻るぐらいなら",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00678",
  "jp": "命に代えてでもあの娘を救出する",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0069a",
  "jp": "ことぐらい出来たであろう！！",
  "en": ""
 },
 {
  "id": "SCENARIO/254/006de",
  "jp": "・・・・・・・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0071a",
  "jp": "自分の命が惜しくなったのか？",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0073a",
  "jp": "そうだろう卑しい規格外め！",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00758",
  "jp": "しょせん貴様らは異形の天使だ！",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0079e",
  "jp": "・・・くっ！！",
  "en": ""
 },
 {
  "id": "SCENARIO/254/007d6",
  "jp": "私はベイル・ペレンデールの",
  "en": ""
 },
 {
  "id": "SCENARIO/254/007f4",
  "jp": "更迭を求める！！！",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0082e",
  "jp": "なんだと！？",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00854",
  "jp": "自分の命惜しさに牢を抜け",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00870",
  "jp": "さらにインセストをも失った者に",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00892",
  "jp": "十審将を名乗る資格はない！！",
  "en": ""
 },
 {
  "id": "SCENARIO/254/008d6",
  "jp": "違う！！",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00906",
  "jp": "助け出せなかったのは事実だ",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00934",
  "jp": "しかし私は、自分の命惜しさに",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00954",
  "jp": "己の責務を投げ出した",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0096c",
  "jp": "覚えはない！！",
  "en": ""
 },
 {
  "id": "SCENARIO/254/009a2",
  "jp": "フン、言い訳なら何とでも言える",
  "en": ""
 },
 {
  "id": "SCENARIO/254/009ea",
  "jp": "誰がなんと言おうと、私は自分の",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00a0c",
  "jp": "名誉と誇りを裏切るつもりはない",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00a44",
  "jp": "フン、規格外が名誉や誇りを",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00a62",
  "jp": "口にするなど片腹痛い",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00a96",
  "jp": "あくまで己の罪を",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00aaa",
  "jp": "認めようとしないのか",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00ae6",
  "jp": "私は潔白だ",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00b1a",
  "jp": "そうか・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00b46",
  "jp": "そこまで言うのなら",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00b5c",
  "jp": "私はこの男を＜永久凍結＞刑に",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00b7c",
  "jp": "かけることを提案する",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00bba",
  "jp": "＜永久凍結＞刑だと！？",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00bfa",
  "jp": "あらゆる肉体的自由を奪い",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00c16",
  "jp": "唯一思考することのみを許し",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00c34",
  "jp": "堕天使に自らを悔い改めさせる刑",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00c64",
  "jp": "その精神力が試される",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00c7c",
  "jp": "最も過酷な幽閉刑だ・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00cd8",
  "jp": "異議あり",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00ce4",
  "jp": "あれは拷問にも等しい刑だ",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00d00",
  "jp": "キミはベイルを壊すつもりか？",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00d46",
  "jp": "拷問とはおかしなことを言う",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00d82",
  "jp": "本当に強き心を持つ者ならば",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00da0",
  "jp": "無事懺悔を終えて、正気を保った",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00dc2",
  "jp": "ままで戻ってこれるはずだ",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00e02",
  "jp": "ベイルはまだ若い",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00e16",
  "jp": "そして他とない優秀な人材だ",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00e34",
  "jp": "廃人に変えられては困る",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00e72",
  "jp": "優秀な人材ならば、",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00e88",
  "jp": "廃人になることもなかろう",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00eca",
  "jp": "しかし・・・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00f1c",
  "jp": "ベイルに選択をさせよう",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00f74",
  "jp": "ベイル",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00f7e",
  "jp": "お前はインセストの喪失に対し",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00f9e",
  "jp": "自分の過失を認めていた",
  "en": ""
 },
 {
  "id": "SCENARIO/254/00fd0",
  "jp": "・・・・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/254/01006",
  "jp": "その重大な過失に対し",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0101e",
  "jp": "お前はどのような罰を受けるのか",
  "en": ""
 },
 {
  "id": "SCENARIO/254/01040",
  "jp": "自分で選択しろ",
  "en": ""
 },
 {
  "id": "SCENARIO/254/01060",
  "jp": "＜永久凍結＞刑か",
  "en": ""
 },
 {
  "id": "SCENARIO/254/01074",
  "jp": "それとも、ただの規格外として",
  "en": ""
 },
 {
  "id": "SCENARIO/254/01094",
  "jp": "最下級の天使に戻るか",
  "en": ""
 },
 {
  "id": "SCENARIO/254/010d2",
  "jp": "私は・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/254/01110",
  "jp": "＜永久凍結＞刑を選ぶ",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0114e",
  "jp": "あまたの天使が心を壊し",
  "en": ""
 },
 {
  "id": "SCENARIO/254/01168",
  "jp": "廃人と化した恐ろしい刑だぞ？",
  "en": ""
 },
 {
  "id": "SCENARIO/254/011ae",
  "jp": "私は簡単に壊れるほど",
  "en": ""
 },
 {
  "id": "SCENARIO/254/011c6",
  "jp": "脆弱な精神をもった覚えはない",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0120a",
  "jp": "ふふっ、面白い・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/254/01222",
  "jp": "ならばその言葉が強がりで",
  "en": ""
 },
 {
  "id": "SCENARIO/254/0123e",
  "jp": "終わらぬことを期待しよう",
  "en": ""
 },
 {
  "id": "SCENARIO/254/01276",
  "jp": "法天使ルビエル・ビッグホーンの",
  "en": ""
 },
 {
  "id": "SCENARIO/254/01298",
  "jp": "名の元に審判を下す",
  "en": ""
 },
 {
  "id": "SCENARIO/254/012bc",
  "jp": "ベイル・ペレンデールを",
  "en": ""
 },
 {
  "id": "SCENARIO/254/012d6",
  "jp": "＜永久凍結＞刑に処する",
  "en": ""
 },
 {
  "id": "SCENARIO/254/01300",
  "jp": "異議ある者はいないな",
  "en": ""
 },
 {
  "id": "SCENARIO/254/01358",
  "jp": "・・・・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/254/013a8",
  "jp": "これにて十審将裁判を閉廷する",
  "en": ""
 },
 {
  "id": "SCENARIO/254/013e0",
  "jp": "・・・・・・・・・",
