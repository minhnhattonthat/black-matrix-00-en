[
 {
  "id": "SCENARIO/254/00140",
  "speaker": 0,
  "jp": [
   "・・・以上で",
   "サンバルテルミ崩壊についての",
   "報告を終了します"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/001aa",
  "speaker": 16,
  "jp": [
   "ごくろう",
   "お前はもう下がりなさい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/001e8",
  "speaker": 0,
  "jp": [
   "はい",
   "それでは失礼します"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00252",
  "speaker": 0,
  "jp": [
   "サンバルテルミの崩壊に",
   "計画の要となるはずだった",
   "インセストの喪失"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/002ba",
  "speaker": 0,
  "jp": [
   "ここにきて計画が頓挫してしまう",
   "とは、いきどおりを通り越して",
   "笑いすらこみ上げてくるね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00358",
  "speaker": 16,
  "jp": [
   "そうだとも"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00382",
  "speaker": 16,
  "jp": [
   "あの娘は＜グレイヘン＞の再来だ",
   "あれほどの＜器＞の持ち主は",
   "捜して見つけられるものではない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/0040a",
  "speaker": 17,
  "jp": [
   "あの娘の存在こそが奇跡だったと",
   "いうのに、お前は何をしていた",
   "ベイル・ペレンデール！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/004a8",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/004fc",
  "speaker": 16,
  "jp": [
   "異端者を追って、崩壊する",
   "サンバルテルミに乗り込んだ",
   "レッド・ムフロンは戻っていない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00568",
  "speaker": 16,
  "jp": [
   "あの男が簡単に死ぬとは思えんが",
   "生きていても無事ではあるまいな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/005ec",
  "speaker": 16,
  "jp": [
   "フン・・・サンバルテルミで",
   "幽閉の身であったはずのお前は",
   "生きて帰って来たというのにな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00660",
  "speaker": 17,
  "jp": [
   "生きて戻るぐらいなら",
   "命に代えてでもあの娘を救出する",
   "ことぐらい出来たであろう！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/006de",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/0071a",
  "speaker": 16,
  "jp": [
   "自分の命が惜しくなったのか？",
   "そうだろう卑しい規格外め！",
   "しょせん貴様らは異形の天使だ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/0079e",
  "speaker": 0,
  "jp": [
   "・・・くっ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/007d6",
  "speaker": 16,
  "jp": [
   "私はベイル・ペレンデールの",
   "更迭を求める！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/0082e",
  "speaker": 1,
  "jp": [
   "なんだと！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00854",
  "speaker": 16,
  "jp": [
   "自分の命惜しさに牢を抜け",
   "さらにインセストをも失った者に",
   "十審将を名乗る資格はない！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/008d6",
  "speaker": 1,
  "jp": [
   "違う！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00906",
  "speaker": 0,
  "jp": [
   "助け出せなかったのは事実だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00934",
  "speaker": 0,
  "jp": [
   "しかし私は、自分の命惜しさに",
   "己の責務を投げ出した",
   "覚えはない！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/009a2",
  "speaker": 16,
  "jp": [
   "フン、言い訳なら何とでも言える"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/009ea",
  "speaker": 0,
  "jp": [
   "誰がなんと言おうと、私は自分の",
   "名誉と誇りを裏切るつもりはない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00a44",
  "speaker": 16,
  "jp": [
   "フン、規格外が名誉や誇りを",
   "口にするなど片腹痛い"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00a96",
  "speaker": 16,
  "jp": [
   "あくまで己の罪を",
   "認めようとしないのか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00ae6",
  "speaker": 0,
  "jp": [
   "私は潔白だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00b1a",
  "speaker": 16,
  "jp": [
   "そうか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00b46",
  "speaker": 16,
  "jp": [
   "そこまで言うのなら",
   "私はこの男を＜永久凍結＞刑に",
   "かけることを提案する"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00bba",
  "speaker": 1,
  "jp": [
   "＜永久凍結＞刑だと！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00bfa",
  "speaker": 16,
  "jp": [
   "あらゆる肉体的自由を奪い",
   "唯一思考することのみを許し",
   "堕天使に自らを悔い改めさせる刑"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00c64",
  "speaker": 16,
  "jp": [
   "その精神力が試される",
   "最も過酷な幽閉刑だ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00cd8",
  "speaker": 0,
  "jp": [
   "異議あり",
   "あれは拷問にも等しい刑だ",
   "キミはベイルを壊すつもりか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00d46",
  "speaker": 16,
  "jp": [
   "拷問とはおかしなことを言う"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00d82",
  "speaker": 16,
  "jp": [
   "本当に強き心を持つ者ならば",
   "無事懺悔を終えて、正気を保った",
   "ままで戻ってこれるはずだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00e02",
  "speaker": 0,
  "jp": [
   "ベイルはまだ若い",
   "そして他とない優秀な人材だ",
   "廃人に変えられては困る"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00e72",
  "speaker": 16,
  "jp": [
   "優秀な人材ならば、",
   "廃人になることもなかろう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00eca",
  "speaker": 0,
  "jp": [
   "しかし・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00f1c",
  "speaker": 16,
  "jp": [
   "ベイルに選択をさせよう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00f74",
  "speaker": 16,
  "jp": [
   "ベイル",
   "お前はインセストの喪失に対し",
   "自分の過失を認めていた"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/00fd0",
  "speaker": 0,
  "jp": [
   "・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/01006",
  "speaker": 16,
  "jp": [
   "その重大な過失に対し",
   "お前はどのような罰を受けるのか",
   "自分で選択しろ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/01060",
  "speaker": 16,
  "jp": [
   "＜永久凍結＞刑か",
   "それとも、ただの規格外として",
   "最下級の天使に戻るか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/010d2",
  "speaker": 0,
  "jp": [
   "私は・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/01110",
  "speaker": 0,
  "jp": [
   "＜永久凍結＞刑を選ぶ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/0114e",
  "speaker": 16,
  "jp": [
   "あまたの天使が心を壊し",
   "廃人と化した恐ろしい刑だぞ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/011ae",
  "speaker": 0,
  "jp": [
   "私は簡単に壊れるほど",
   "脆弱な精神をもった覚えはない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/0120a",
  "speaker": 16,
  "jp": [
   "ふふっ、面白い・・・",
   "ならばその言葉が強がりで",
   "終わらぬことを期待しよう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/01276",
  "speaker": 16,
  "jp": [
   "法天使ルビエル・ビッグホーンの",
   "名の元に審判を下す"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/012bc",
  "speaker": 16,
  "jp": [
   "ベイル・ペレンデールを",
   "＜永久凍結＞刑に処する"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/01300",
  "speaker": 16,
  "jp": [
   "異議ある者はいないな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/254/01358",
  "speaker": 0,
  "jp": [
   "・・・・・・"
  ],
  "en": ""
 },
