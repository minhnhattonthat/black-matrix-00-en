  "jp": [
   "ザイオン！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00156",
  "speaker": 0,
  "jp": [
   "何しにきた？",
   "もう俺に構うなと言ったのが",
   "聞こえていなかったのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/001b8",
  "speaker": 16,
  "jp": [
   "ルカが教団に捕まっちゃって",
   "もうすぐサンバルテルミで",
   "公開処刑が始まるんだ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00236",
  "speaker": 1,
  "jp": [
   "！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00262",
  "speaker": 0,
  "jp": [
   "・・・・・・クソッ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00372",
  "speaker": 0,
  "jp": [
   "待てよザイオン！！",
   "サンバルテルミがどんな場所か",
   "お前だって知ってるだろ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/003d4",
  "speaker": 0,
  "jp": [
   "いくらお前でも一人じゃ無理だ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/0041a",
  "speaker": 16,
  "jp": [
   "腰抜けのお前らと一緒にするな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/0045e",
  "speaker": 0,
  "jp": [
   "ヘッ、",
   "お前ってルカのことになると",
   "すぐに熱くなるよな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00508",
  "speaker": 16,
  "jp": [
   "・・・そこをどけ",
   "俺の邪魔をするなら殺すぞ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00590",
  "speaker": 1,
  "jp": [
   "このバカ野郎！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/005b4",
  "speaker": 1,
  "jp": [
   "ルカが心配なら、冷静になって",
   "状況を見ろって言ってんだよ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00604",
  "speaker": 1,
  "jp": [
   "なんで俺らがここに来たと思う？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00634",
  "speaker": 1,
  "jp": [
   "一緒にルカを助けに行くからに",
   "決まってるだろ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/006a2",
  "speaker": 16,
  "jp": [
   "・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/006e6",
  "speaker": 16,
  "jp": [
   "正気とは思えないな",
   "そんなことをして",
   "お前らになんの得がある？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/007bc",
  "speaker": 16,
  "jp": [
   "損得の問題ではありませんわ",
   "わたしたちはルカさんに",
   "死んで欲しくないんです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00844",
  "speaker": 16,
  "jp": [
   "リリス、",
   "ルカがいなくなるのは嫌なの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/008a6",
  "speaker": 0,
  "jp": [
   "・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/008e8",
  "speaker": 16,
  "jp": [
   "ルカさん、ザイオンさんの協力が",
   "あったからこそ、今僕はこうして",
   "自由の身でいられます"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/0097e",
  "speaker": 16,
  "jp": [
   "ザイオンさん、",
   "僕に恩返しをさせて下さい！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/009e4",
  "speaker": 16,
  "jp": [
   "ルカに、公開処刑なんて死に方",
   "似合わないわ、",
   "そうでしょ？ザイオン"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00a52",
  "speaker": 0,
  "jp": [
   "・・・バカかお前ら？",
   "俺は渇きに狂った悪魔だぞ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00aa2",
  "speaker": 0,
  "jp": [
   "いつまたお前達を襲うか",
   "分からないんだぞ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00af6",
  "speaker": 16,
  "jp": [
   "どういうつもりでアンタがそんな",
   "嘘をつくか知らないけど",
   "そんな脅し、通用しないわよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00b76",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00bc4",
  "speaker": 16,
  "jp": [
   "一緒に行こうザイオン",
   "みんなで力を合わせれば",
   "ルカを絶対に助けられるよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00c8a",
  "speaker": 0,
  "jp": [
   "俺はまた・・・",
   "アイツを殺そうとするかも",
   "しれないんだぞ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00d68",
  "speaker": 0,
  "jp": [
   "その時は、",
   "俺がお前を止めてやるさ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00da8",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00de2",
  "speaker": 0,
  "jp": [
   "さぁ、行こうぜ",
   "ザイオン！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00e2a",
  "speaker": 16,
  "jp": [
   "俺はルカを助けに向かう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00e54",
  "speaker": 16,
  "jp": [
   "付いてくるなら勝手にしろ",
   "俺の邪魔だけはするな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/224/00ea0",
  "speaker": 0,
  "jp": [
   "ああ、一緒に頑張ろうぜ"
  ],
  "en": ""
