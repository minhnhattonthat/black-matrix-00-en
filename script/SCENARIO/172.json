[
 {
  "id": "SCENARIO/172/000f0",
  "speaker": 16,
  "jp": [
   "何かしら・・・",
   "外の方がすごく騒がしいわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/00166",
  "speaker": 16,
  "jp": [
   "うん、",
   "一体何があったんだろう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/001c4",
  "speaker": 0,
  "jp": [
   "侵入者が騒いでるんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/00214",
  "speaker": 16,
  "jp": [
   "あなたは・・・もしかして、",
   "ベイルさんに殺されかけた",
   "僧兵さん・・・？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/00278",
  "speaker": 0,
  "jp": [
   "覚えていてくれたんだね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/002b6",
  "speaker": 16,
  "jp": [
   "傷の具合は、もういいんですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/002f0",
  "speaker": 0,
  "jp": [
   "君があの時、ベイル様を",
   "止めてくれたおかげで、",
   "こうして今も生きていられるよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/0036a",
  "speaker": 16,
  "jp": [
   "・・・そう、よかった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/00398",
  "speaker": 0,
  "jp": [
   "・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/003e0",
  "speaker": 16,
  "jp": [
   "あの、侵入者って",
   "どんな人たちなんですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/00428",
  "speaker": 0,
  "jp": [
   "悪魔が二匹",
   "それに仮面をつけた灰色の羽根の",
   "天使も混じっているそうだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/004ac",
  "speaker": 16,
  "jp": [
   "・・・まさか、ヨハネさん！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/004e4",
  "speaker": 0,
  "jp": [
   "やつらは前に、教団から",
   "インセストをさらった一味らしい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/00558",
  "speaker": 16,
  "jp": [
   "さらったって・・・",
   "教団からインセストを連れ出した",
   "人がいるの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/005b8",
  "speaker": 0,
  "jp": [
   "ああ、そしてきっと今回も・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/0063c",
  "speaker": 16,
  "jp": [
   "・・・えっ？！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/0068c",
  "speaker": 0,
  "jp": [
   "・・・逃げろ、",
   "彼らと合流するなら、",
   "チャンスは今しかない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/00704",
  "speaker": 16,
  "jp": [
   "どういうつもり？",
   "僕たちを逃がしたりしたら",
   "殺されちゃうよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/00760",
  "speaker": 0,
  "jp": [
   "わかってる"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/007a4",
  "speaker": 16,
  "jp": [
   "なら、どうして・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/007d4",
  "speaker": 0,
  "jp": [
   "僧兵にはいくらでも代わりがいる",
   "そう言った天使に逆らい",
   "あんたは俺を助けてくれた"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/0083c",
  "speaker": 0,
  "jp": [
   "誰にも代わりなんていない",
   "あんたの言った言葉が",
   "嬉しかった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/0088c",
  "speaker": 0,
  "jp": [
   "・・・ただ、それだけだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/008bc",
  "speaker": 16,
  "jp": [
   "でも、わたしたちを逃がしたら",
   "あなたは・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/0090c",
  "speaker": 0,
  "jp": [
   "あの時死ぬはずだった命だ",
   "いまさら惜しくはない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/00958",
  "speaker": 16,
  "jp": [
   "でもッ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/0099c",
  "speaker": 16,
  "jp": [
   "逃がしたんじゃなくて、",
   "逃げられたって事にすれば",
   "どうかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/009f8",
  "speaker": 0,
  "jp": [
   "え？",
   "しかし、どうやって・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/00a42",
  "speaker": 16,
  "jp": [
   "誰かに殴られて気を失い、",
   "その間に逃げられたって",
   "言えばいいんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/00aa4",
  "speaker": 0,
  "jp": [
   "な、なるほど・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/00af0",
  "speaker": 16,
  "jp": [
   "・・・あの、すみません",
   "警棒お借りします"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/00b66",
  "speaker": 0,
  "jp": [
   "ええーっ？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/00b9a",
  "speaker": 16,
  "jp": [
   "それじゃあ",
   "思いっきり殴りますから",
   "覚悟してくださいね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/00c22",
  "speaker": 0,
  "jp": [
   "あ、あの、ちょっと待って",
   "まだ心の準備がっ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/172/00c7a",
