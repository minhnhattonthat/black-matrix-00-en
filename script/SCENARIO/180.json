  "id": "SCENARIO/180/00628",
  "jp": "むしろ幸いです",
  "en": ""
 },
 {
  "id": "SCENARIO/180/00648",
  "jp": "妹君のこともありますし",
  "en": ""
 },
 {
  "id": "SCENARIO/180/00662",
  "jp": "彼の立場は今とても危うい状態に",
