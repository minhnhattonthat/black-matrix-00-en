  "en": ""
 },
 {
  "id": "SCENARIO/180/002ec",
  "jp": "失礼ですが",
  "en": ""
 },
 {
  "id": "SCENARIO/180/002fa",
  "jp": "貴方がベイル様の副官？",
  "en": ""
 },
 {
