  "en": ""
 },
 {
  "id": "SCENARIO/180/0051c",
  "jp": "侵入者の逃亡を許した上、",
  "en": ""
 },
 {
  "id": "SCENARIO/180/00538",
  "jp": "仲間である十審将に牙をむけた",
  "en": ""
 },
 {
  "id": "SCENARIO/180/00558",
  "jp": "のです、当然でしょう",
