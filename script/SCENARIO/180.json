 },
 {
  "id": "SCENARIO/180/001d0",
  "jp": "力天使レッド・ムフロン様の副官",
  "en": ""
 },
 {
  "id": "SCENARIO/180/001f2",
  "jp": "グリシナと申します",
  "en": ""
 },
 {
  "id": "SCENARIO/180/00218",
  "jp": "熾天使ベイル・ペレンデール様の",
  "en": ""
 },
 {
  "id": "SCENARIO/180/0023a",
  "jp": "処遇に関してお伝えに参りました",
  "en": ""
 },
 {
  "id": "SCENARIO/180/00282",
  "jp": "グリシナ、確かベイル様と共に",
  "en": ""
 },
 {
  "id": "SCENARIO/180/002a2",
  "jp": "キボートス島に向かい、",
