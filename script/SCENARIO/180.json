[
 {
  "id": "SCENARIO/180/0012c",
  "speaker": 0,
  "jp": [
   "ベイル様・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/00180",
  "speaker": 16,
  "jp": [
   "失礼しますよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/001a8",
  "speaker": 0,
  "jp": [
   "・・・あなたは"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/001d0",
  "speaker": 16,
  "jp": [
   "力天使レッド・ムフロン様の副官",
   "グリシナと申します"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/00218",
  "speaker": 16,
  "jp": [
   "熾天使ベイル・ペレンデール様の",
   "処遇に関してお伝えに参りました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/00282",
  "speaker": 3,
  "jp": [
   "グリシナ、確かベイル様と共に",
   "キボートス島に向かい、",
   "負傷された天使・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/002ec",
  "speaker": 16,
  "jp": [
   "失礼ですが",
   "貴方がベイル様の副官？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/0032c",
  "speaker": 0,
  "jp": [
   "はい、カルディアと申します"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/0036e",
  "speaker": 16,
  "jp": [
   "・・・ふうん"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/00394",
  "speaker": 19,
  "jp": [
   "あの人は、",
   "こういう地味なのが",
   "好みだったのか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/003e8",
  "speaker": 0,
  "jp": [
   "・・・あの",
   "私の顔に何かついてます？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/00436",
  "speaker": 16,
  "jp": [
   "いえ、何も"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/0046a",
  "speaker": 0,
  "jp": [
   "それで、ベイル様の処遇は？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/004ae",
  "speaker": 16,
  "jp": [
   "しばらくの間",
   "幽閉の身となります"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/004fa",
  "speaker": 1,
  "jp": [
   "幽閉！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/0051c",
  "speaker": 16,
  "jp": [
   "侵入者の逃亡を許した上、",
   "仲間である十審将に牙をむけた",
   "のです、当然でしょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/00588",
  "speaker": 0,
  "jp": [
   "それは！",
   "ベイル様ではなく、",
   "ホワイトフェイス様が！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/005ea",
  "speaker": 16,
  "jp": [
   "十審将とはいえ＜規格外＞の身",
   "それぐらいの罰ですんだのが",
   "むしろ幸いです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/00648",
  "speaker": 16,
  "jp": [
   "妹君のこともありますし",
   "彼の立場は今とても危うい状態に",
   "立たされているのは明白"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/006ac",
  "speaker": 16,
  "jp": [
   "ことと次第によっては",
   "十審将の地位剥奪もありえます"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/0070a",
  "speaker": 0,
  "jp": [
   "・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/00734",
  "speaker": 16,
  "jp": [
   "カルディアさん",
   "大変でしょうが貴方が彼を",
   "しっかり支えてあげて下さいね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/00798",
  "speaker": 0,
  "jp": [
   "はい・・・",
   "お気遣いありがとうございます"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/007dc",
  "speaker": 16,
  "jp": [
   "私も何かお力添えが出来れば",
   "いいのですが"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/00826",
  "speaker": 16,
  "jp": [
   "私に出来るのは悲しいお知らせを",
   "貴方に伝えることだけ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/00878",
  "speaker": 0,
  "jp": [
   "悲しいお知らせ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/008b2",
  "speaker": 16,
  "jp": [
   "・・・貴方の弟さん",
   "インセストなんですってね？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/0090a",
  "speaker": 0,
  "jp": [
   "！！！！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/00962",
  "speaker": 16,
  "jp": [
   "今度大きな実験があって",
   "インセストたちがたくさん",
   "死ぬかもしれないのです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/009c0",
  "speaker": 16,
  "jp": [
   "だから可哀想な子供たちに",
   "せめて死ぬ前に家族の顔を見せて",
   "あげたいと思ってるんだ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/00a34",
  "speaker": 3,
  "jp": [
   "キロタが・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/00a5c",
  "speaker": 16,
  "jp": [
   "あなたの弟さんも",
   "お姉さんたちにとても",
   "会いたがってましたよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/180/00ab0",
  "speaker": 16,
  "jp": [
   "・・・だから"
  ],
  "en": ""
 },
