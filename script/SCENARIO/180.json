  "jp": "・・・ふうん",
  "en": ""
 },
 {
  "id": "SCENARIO/180/00394",
  "jp": "あの人は、",
  "en": ""
 },
 {
  "id": "SCENARIO/180/003a2",
  "jp": "こういう地味なのが",
  "en": ""
 },
 {
  "id": "SCENARIO/180/003b8",
  "jp": "好みだったのか・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/180/003e8",
  "jp": "・・・あの",
  "en": ""
 },
 {
  "id": "SCENARIO/180/003f6",
  "jp": "私の顔に何かついてます？",
  "en": ""
 },
 {
  "id": "SCENARIO/180/00436",
  "jp": "いえ、何も",
  "en": ""
 },
 {
  "id": "SCENARIO/180/0046a",
  "jp": "それで、ベイル様の処遇は？",
  "en": ""
 },
 {
  "id": "SCENARIO/180/004ae",
  "jp": "しばらくの間",
  "en": ""
