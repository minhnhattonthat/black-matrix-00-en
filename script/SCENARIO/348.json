[
 {
  "id": "SCENARIO/348/0018c",
  "speaker": 0,
  "jp": [
   "キボートスの世界樹に",
   "マティアが・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/001c8",
  "speaker": 0,
  "jp": [
   "マティアが、近くに・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/001fc",
  "speaker": 16,
  "jp": [
   "ってことは、",
   "アベルもいるってことだよな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00252",
  "speaker": 0,
  "jp": [
   "たぶん・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00286",
  "speaker": 16,
  "jp": [
   "しかし、",
   "カインが元アベルなんだろ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/002c0",
  "speaker": 16,
  "jp": [
   "だったらアベルを名乗る",
   "黒羽根のあいつは何者なんだ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00324",
  "speaker": 0,
  "jp": [
   "わからない・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00356",
  "speaker": 0,
  "jp": [
   "でも、兄弟なんかじゃない",
   "もっとすごくボクに近い",
   "何かなんだと思う・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/003ce",
  "speaker": 16,
  "jp": [
   "うーん",
   "カインにすごく近い何かかぁ・・",
   "考えてもぜんぜん思いつかないぜ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00454",
  "speaker": 16,
  "jp": [
   "今は奪われたカインの女と",
   "パスカのペインリングを取り戻す",
   "ことだけ考えればいい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/004e2",
  "speaker": 16,
  "jp": [
   "他のことは後でも考えられる",
   "行くならとっとと行くぞ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00550",
  "speaker": 16,
  "jp": [
   "悪いけど",
   "アタシは行けないわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00596",
  "speaker": 0,
  "jp": [
   "ルカッ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/005ca",
  "speaker": 16,
  "jp": [
   "何か文句あるの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/005f4",
  "speaker": 0,
  "jp": [
   "で、でも、ルカが一番",
   "パスカのペインリングを",
   "取り戻したいんじゃ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00658",
  "speaker": 16,
  "jp": [
   "魔力の源である翼をなくした",
   "アタシじゃ、ついて行っても",
   "足手まといになるだけよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/006d2",
  "speaker": 0,
  "jp": [
   "そんなことない！",
   "ルカも一緒に行こうよ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/0073a",
  "speaker": 16,
  "jp": [
   "ありがとう、カイン"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00760",
  "speaker": 16,
  "jp": [
   "あんたは振り返らないで",
   "まっすぐに前だけを見つめて",
   "いればいいのよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/007b8",
  "speaker": 16,
  "jp": [
   "ここで待っててあげるから",
   "あんたの女、アタシにも",
   "紹介しなさいよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00826",
  "speaker": 1,
  "jp": [
   "ち、ちがッ！！",
   "マティアとボクは、そんなッ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/0087a",
  "speaker": 16,
  "jp": [
   "あら、もしかして",
   "カインの片思いだったの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/008c0",
  "speaker": 0,
  "jp": [
   "マ、マティアは大切な人だけど",
   "恋とか、片思いとか、そ、",
   "そんなんじゃないんだッ！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00966",
  "speaker": 16,
  "jp": [
   "大丈夫ですよカインさん",
   "誰が見ても、お二人は確かに",
   "愛し合っていますわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/009da",
  "speaker": 1,
  "jp": [
   "あ、愛ッ！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00a20",
  "speaker": 16,
  "jp": [
   "カインとマティアお姉ちゃんは",
   "心の深いところで好きって",
   "気持ちがつながっているの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00ab2",
  "speaker": 16,
  "jp": [
   "これって",
   "愛し合ってるっていうんでしょ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00af8",
  "speaker": 0,
  "jp": [
   "そ、そんなのわからないよ！",
   "だってボクの片思いかも・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00b6c",
  "speaker": 16,
  "jp": [
   "ほーらみなさい",
   "やっぱり、好きなんでしょ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00bb4",
  "speaker": 0,
  "jp": [
   "ち、ちがッ！！",
   "そ、そんな意味じゃないよー！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00c0e",
  "speaker": 16,
  "jp": [
   "あらあら、カインったら",
   "真っ赤になっちゃって可愛い～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00c60",
  "speaker": 0,
  "jp": [
   "ち・・・違うよー！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00cb8",
  "speaker": 16,
  "jp": [
   "フフフ・・・",
   "本当に緊張感ないんだから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00d2e",
  "speaker": 0,
  "jp": [
   "ルカ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00d62",
  "speaker": 16,
  "jp": [
   "ザイオン",
   "アタシの分まで頼んだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00dae",
  "speaker": 0,
  "jp": [
   "ルカ、約束してくれ",
   "必ず帰ってくるまで",
   "ここで待っていると・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00e1a",
  "speaker": 16,
  "jp": [
   "何よ",
   "約束を持ちかけてくるなんて",
   "らしくないじゃない？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00e7e",
  "speaker": 0,
  "jp": [
   "らしくなくてもいい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00ea4",
  "speaker": 0,
  "jp": [
   "それでも、",
   "お前の口から聞いておきたいんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00efa",
  "speaker": 16,
  "jp": [
   "・・・わかったわ",
   "約束すればいいのね？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00f34",
  "speaker": 16,
  "jp": [
   "約束するわ",
   "それまでは、死なないから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00f74",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/00fb2",
  "speaker": 16,
  "jp": [
   "あんたこそ",
   "ちゃんと生きて帰ってきなさいよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/01006",
  "speaker": 0,
  "jp": [
   "ああ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/0105e",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/011a8",
  "speaker": 0,
  "jp": [
   "・・来たか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/011ec",
  "speaker": 16,
  "jp": [
   "どうやら間に合ったようですね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/01232",
  "speaker": 0,
  "jp": [
   "ホワイトフェイスの容態は？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/01276",
  "speaker": 16,
  "jp": [
   "未だ危険な状態です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/0129c",
  "speaker": 16,
  "jp": [
   "ペインリングを使い続けてきた",
   "反動もあるのでしょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/012e4",
  "speaker": 16,
  "jp": [
   "身体そのものが衰弱していては",
   "ふさがるはずの傷もふさがり",
   "ませんから・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/0136e",
  "speaker": 0,
  "jp": [
   "そうか・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/013b8",
  "speaker": 16,
  "jp": [
   "そろそろ出発するのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/013f6",
  "speaker": 0,
  "jp": [
   "ああ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/01422",
  "speaker": 16,
  "jp": [
   "そうか・・・",
   "準備の方は万全なのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/01484",
  "speaker": 0,
  "jp": [
   "たぶん、大丈夫だよ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/014c2",
  "speaker": 16,
  "jp": [
   "たぶんという状態を",
   "万全とは呼ばないはずだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/01516",
  "speaker": 0,
  "jp": [
   "ええと・・・",
   "きっと大丈夫です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/01550",
  "speaker": 16,
  "jp": [
   "・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/01582",
  "speaker": 16,
  "jp": [
   "リプサリス",
   "お前の力でこれを街まで",
   "連れて行ってやれ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/015ea",
  "speaker": 0,
  "jp": [
   "ええぇっ？！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/01630",
  "speaker": 16,
  "jp": [
   "私ならかまいませんわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/01660",
  "speaker": 0,
  "jp": [
   "で、でも・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/01696",
  "speaker": 16,
  "jp": [
   "それに",
   "クレイスを納得させるなら",
   "準備は万全になさらないと"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/016e8",
  "speaker": 16,
  "jp": [
   "出発前にクレイスと",
   "無駄な一戦を交えることに",
   "なりかねませんよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/01748",
  "speaker": 0,
  "jp": [
   "・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/01776",
  "speaker": 0,
  "jp": [
   "すみません",
   "よろしくお願いします"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/017c2",
  "speaker": 16,
  "jp": [
   "ええ、おまかせ下さい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/017f6",
  "speaker": 16,
  "jp": [
   "街に行けるのは",
   "これが最後になると思います"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/348/01834",
  "speaker": 16,
  "jp": [
   "くれぐれも忘れ物がないように",
   "気をつけて下さいね"
  ],
  "en": ""
 },
