[
 {
  "id": "SCENARIO/259/00144",
  "jp": "そこをどきな！！",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00158",
  "jp": "ソリュウ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0017c",
  "jp": "気持ちは俺もよくわかるよ、でも",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0019e",
  "jp": "冷静に考えてみようよ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/001f4",
  "jp": "邪魔をするなら力ずくで",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0020e",
  "jp": "通らせてもらうぞ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00246",
  "jp": "うぅぅ・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00272",
  "jp": "ウンダ様だって言ってたんだぞ！",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00294",
  "jp": "なんでも力にまかせて進むのは",
  "en": ""
 },
 {
  "id": "SCENARIO/259/002b4",
  "jp": "よくないって！",
  "en": ""
 },
 {
  "id": "SCENARIO/259/002e2",
  "jp": "もっと、友好的に・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00322",
  "jp": "腰抜けの処世術など",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00338",
  "jp": "覚えるつもりはない",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00372",
  "jp": "うぅ、どーせ俺は腰抜けだよ・・",
  "en": ""
 },
 {
  "id": "SCENARIO/259/003ac",
  "jp": "行くよザイオン！",
  "en": ""
 },
 {
  "id": "SCENARIO/259/003fc",
  "jp": "・・・まったく",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0040e",
  "jp": "二人とも相変わらずなんだから",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00490",
  "jp": "あれ？",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0049a",
  "jp": "ルカとザイオンは？",
  "en": ""
 },
 {
  "id": "SCENARIO/259/004d6",
  "jp": "一足遅かったな",
  "en": ""
 },
 {
  "id": "SCENARIO/259/004e8",
  "jp": "ルカ達ならウンダ様を捜しに",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00506",
  "jp": "飛び出して行ったとこだよ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00546",
  "jp": "キミは？",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00576",
  "jp": "俺？",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0057e",
  "jp": "俺はソリュウ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0058e",
  "jp": "ルカ達の幼なじみだ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/005b4",
  "jp": "アンタ達のことは",
  "en": ""
 },
 {
  "id": "SCENARIO/259/005c8",
  "jp": "ルカから聞いてるよ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0061c",
  "jp": "何かあったのか？",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00648",
  "jp": "悪魔も今、いろいろあってね",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00682",
  "jp": "今も、ウチの長老のウンダ様が",
  "en": ""
 },
 {
  "id": "SCENARIO/259/006a2",
  "jp": "各部族の代表達の集いに行ってる",
  "en": ""
 },
 {
  "id": "SCENARIO/259/006c4",
  "jp": "ハズなんだけど、",
  "en": ""
 },
 {
  "id": "SCENARIO/259/006e8",
  "jp": "ちょっと帰りが遅くてね・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00720",
  "jp": "集いとは、パスカに関する",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0073c",
  "jp": "話し合いか？",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00772",
  "jp": "へぇ、灰色のお兄さん",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0078a",
  "jp": "察しがいいんだな",
  "en": ""
 },
 {
  "id": "SCENARIO/259/007ba",
  "jp": "うちの一族で守っていたパスカの",
  "en": ""
 },
 {
  "id": "SCENARIO/259/007dc",
  "jp": "ペインリングをアラギが",
  "en": ""
 },
 {
  "id": "SCENARIO/259/007f6",
  "jp": "奪ったってのは聞いてるよな",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00824",
  "jp": "アラギの奴、ペインリングの力で",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00846",
  "jp": "殺した他の部族のヤツらをパスカ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00868",
  "jp": "にしちまったらしいんだ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00898",
  "jp": "それでペインリングの守人だった",
  "en": ""
 },
 {
  "id": "SCENARIO/259/008ba",
  "jp": "ウンダ殿がその責任を問われて",
  "en": ""
 },
 {
  "id": "SCENARIO/259/008da",
  "jp": "いるというわけか・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0091a",
  "jp": "ま、そんな感じかな？",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0094e",
  "jp": "悪魔って基本的に気が短いからさ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00970",
  "jp": "帰りが遅いのが、ちょっと心配",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00990",
  "jp": "なんだよな",
  "en": ""
 },
 {
  "id": "SCENARIO/259/009dc",
  "jp": "・・・ちょ、ちょっと",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00a04",
  "jp": "村の一番偉い人が危ないかも",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00a22",
  "jp": "しれないのに、そんなのんびり",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00a42",
  "jp": "かまえていて大丈夫なの？",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00a82",
  "jp": "全部パスカのせいだよ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00aa8",
  "jp": "村を守るために戦士が必要",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00ac4",
  "jp": "だから、みんな動きたくても",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00ae2",
  "jp": "自由に動けないんだよ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00b38",
  "jp": "ソリュウも村を守る戦士なの？",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00b7e",
  "jp": "あはは、違う違う",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00b92",
  "jp": "俺はそんなに強くないよ・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00bc0",
  "jp": "俺は腰抜けの臆病者だからね",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00bfa",
  "jp": "俺だってウンダ様は心配だけど",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00c1a",
  "jp": "俺はザイオンやルカみたいに",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00c38",
  "jp": "強くもなければ度胸もない",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00c64",
  "jp": "もう少し勇気と強さがあったら",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00c84",
  "jp": "俺も二人と一緒にウンダ様を",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00ca2",
  "jp": "迎えに行こうとしたんだけどな",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00ce6",
  "jp": "キミも、一緒に行こうよ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00d26",
  "jp": "え？",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00d44",
  "jp": "ボク達はウンダ様から",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00d5c",
  "jp": "ペインリングの話を聞きたいんだ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00d8c",
  "jp": "もし本当に何かが起きていたら",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00dac",
  "jp": "ウンダ様も、様子を見に行った",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00dcc",
  "jp": "ルカやザイオンたちも危ない",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00e0e",
  "jp": "いやいや、俺なんて居たら",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00e2a",
  "jp": "アンタ達の足手まといになっち",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00e4a",
  "jp": "まうよ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00e64",
  "jp": "だから、ダメなんだ・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00ec0",
  "jp": "大丈夫です",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00eea",
  "jp": "きっと、ソリュウさんは",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00f04",
  "jp": "自分で思っているほど臆病でも",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00f24",
  "jp": "ないし、弱くもないはずです",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00f66",
  "jp": "・・・え？",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00f8c",
  "jp": "貴方がルカさんやザイオンさんと",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00fae",
  "jp": "違うのは当たり前のことです",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00fdc",
  "jp": "ルカさんやザイオンさんが強い",
  "en": ""
 },
 {
  "id": "SCENARIO/259/00ffc",
  "jp": "からって、ソリュウさんが自分を",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0101e",
  "jp": "弱いと決めつけるなんて変ですよ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/01066",
  "jp": "あははは・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/259/01078",
  "jp": "天使と話をするのは初めてだけど",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0109a",
  "jp": "かわった考え方をするんだな",
  "en": ""
 },
 {
  "id": "SCENARIO/259/010d6",
  "jp": "そんな風に言われたの",
  "en": ""
 },
 {
  "id": "SCENARIO/259/010ee",
  "jp": "初めてだよ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0113c",
  "jp": "ま、ルカ達を追いかけるなら",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0115a",
  "jp": "俺達には道案内が必要なんだ",
  "en": ""
 },
 {
  "id": "SCENARIO/259/01178",
  "jp": "アンタは行き先がわかるんだろ？",
