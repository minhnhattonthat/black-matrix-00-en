[
 {
  "id": "SCENARIO/259/00144",
  "speaker": 1,
  "jp": [
   "そこをどきな！！",
   "ソリュウ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/0017c",
  "speaker": 16,
  "jp": [
   "気持ちは俺もよくわかるよ、でも",
   "冷静に考えてみようよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/001f4",
  "speaker": 0,
  "jp": [
   "邪魔をするなら力ずくで",
   "通らせてもらうぞ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00246",
  "speaker": 16,
  "jp": [
   "うぅぅ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00272",
  "speaker": 16,
  "jp": [
   "ウンダ様だって言ってたんだぞ！",
   "なんでも力にまかせて進むのは",
   "よくないって！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/002e2",
  "speaker": 16,
  "jp": [
   "もっと、友好的に・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00322",
  "speaker": 0,
  "jp": [
   "腰抜けの処世術など",
   "覚えるつもりはない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00372",
  "speaker": 16,
  "jp": [
   "うぅ、どーせ俺は腰抜けだよ・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/003ac",
  "speaker": 6,
  "jp": [
   "行くよザイオン！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/003fc",
  "speaker": 16,
  "jp": [
   "・・・まったく",
   "二人とも相変わらずなんだから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00490",
  "speaker": 0,
  "jp": [
   "あれ？",
   "ルカとザイオンは？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/004d6",
  "speaker": 16,
  "jp": [
   "一足遅かったな",
   "ルカ達ならウンダ様を捜しに",
   "飛び出して行ったとこだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00546",
  "speaker": 0,
  "jp": [
   "キミは？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00576",
  "speaker": 16,
  "jp": [
   "俺？",
   "俺はソリュウ",
   "ルカ達の幼なじみだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/005b4",
  "speaker": 16,
  "jp": [
   "アンタ達のことは",
   "ルカから聞いてるよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/0061c",
  "speaker": 0,
  "jp": [
   "何かあったのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00648",
  "speaker": 16,
  "jp": [
   "悪魔も今、いろいろあってね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00682",
  "speaker": 16,
  "jp": [
   "今も、ウチの長老のウンダ様が",
   "各部族の代表達の集いに行ってる",
   "ハズなんだけど、"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/006e8",
  "speaker": 16,
  "jp": [
   "ちょっと帰りが遅くてね・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00720",
  "speaker": 0,
  "jp": [
   "集いとは、パスカに関する",
   "話し合いか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00772",
  "speaker": 16,
  "jp": [
   "へぇ、灰色のお兄さん",
   "察しがいいんだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/007ba",
  "speaker": 16,
  "jp": [
   "うちの一族で守っていたパスカの",
   "ペインリングをアラギが",
   "奪ったってのは聞いてるよな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00824",
  "speaker": 16,
  "jp": [
   "アラギの奴、ペインリングの力で",
   "殺した他の部族のヤツらをパスカ",
   "にしちまったらしいんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00898",
  "speaker": 0,
  "jp": [
   "それでペインリングの守人だった",
   "ウンダ殿がその責任を問われて",
   "いるというわけか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/0091a",
  "speaker": 16,
  "jp": [
   "ま、そんな感じかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/0094e",
  "speaker": 16,
  "jp": [
   "悪魔って基本的に気が短いからさ",
   "帰りが遅いのが、ちょっと心配",
   "なんだよな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/009dc",
  "speaker": 0,
  "jp": [
   "・・・ちょ、ちょっと"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00a04",
  "speaker": 0,
  "jp": [
   "村の一番偉い人が危ないかも",
   "しれないのに、そんなのんびり",
   "かまえていて大丈夫なの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00a82",
  "speaker": 16,
  "jp": [
   "全部パスカのせいだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00aa8",
  "speaker": 16,
  "jp": [
   "村を守るために戦士が必要",
   "だから、みんな動きたくても",
   "自由に動けないんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00b38",
  "speaker": 0,
  "jp": [
   "ソリュウも村を守る戦士なの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00b7e",
  "speaker": 16,
  "jp": [
   "あはは、違う違う",
   "俺はそんなに強くないよ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00bc0",
  "speaker": 16,
  "jp": [
   "俺は腰抜けの臆病者だからね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00bfa",
  "speaker": 16,
  "jp": [
   "俺だってウンダ様は心配だけど",
   "俺はザイオンやルカみたいに",
   "強くもなければ度胸もない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00c64",
  "speaker": 16,
  "jp": [
   "もう少し勇気と強さがあったら",
   "俺も二人と一緒にウンダ様を",
   "迎えに行こうとしたんだけどな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00ce6",
  "speaker": 0,
  "jp": [
   "キミも、一緒に行こうよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00d26",
  "speaker": 16,
  "jp": [
   "え？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00d44",
  "speaker": 0,
  "jp": [
   "ボク達はウンダ様から",
   "ペインリングの話を聞きたいんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00d8c",
  "speaker": 0,
  "jp": [
   "もし本当に何かが起きていたら",
   "ウンダ様も、様子を見に行った",
   "ルカやザイオンたちも危ない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00e0e",
  "speaker": 16,
  "jp": [
   "いやいや、俺なんて居たら",
   "アンタ達の足手まといになっち",
   "まうよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00e64",
  "speaker": 16,
  "jp": [
   "だから、ダメなんだ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00ec0",
  "speaker": 0,
  "jp": [
   "大丈夫です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00eea",
  "speaker": 0,
  "jp": [
   "きっと、ソリュウさんは",
   "自分で思っているほど臆病でも",
   "ないし、弱くもないはずです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00f66",
  "speaker": 16,
  "jp": [
   "・・・え？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00f8c",
  "speaker": 0,
  "jp": [
   "貴方がルカさんやザイオンさんと",
   "違うのは当たり前のことです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/00fdc",
  "speaker": 0,
  "jp": [
   "ルカさんやザイオンさんが強い",
   "からって、ソリュウさんが自分を",
   "弱いと決めつけるなんて変ですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/01066",
  "speaker": 16,
  "jp": [
   "あははは・・・",
   "天使と話をするのは初めてだけど",
   "かわった考え方をするんだな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/010d6",
  "speaker": 16,
  "jp": [
   "そんな風に言われたの",
   "初めてだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/0113c",
  "speaker": 0,
  "jp": [
   "ま、ルカ達を追いかけるなら",
   "俺達には道案内が必要なんだ",
   "アンタは行き先がわかるんだろ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/011be",
  "speaker": 16,
  "jp": [
   "ああ、そりゃあ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/01214",
  "speaker": 0,
  "jp": [
   "一緒に来てくれる？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/0124e",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/01282",
  "speaker": 16,
  "jp": [
   "キミ達は、やっぱり",
   "ルカ達の仲間なんだなぁ・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/259/012c8",
  "speaker": 16,
  "jp": [
   "わかった",
   "俺が案内してやるよ"
  ],
  "en": ""
 },
