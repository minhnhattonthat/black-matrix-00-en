 },
 {
  "id": "SCENARIO/259/011be",
  "jp": "ああ、そりゃあ・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/259/01214",
  "jp": "一緒に来てくれる？",
  "en": ""
 },
 {
  "id": "SCENARIO/259/0124e",
  "jp": "・・・・・・・・・",
