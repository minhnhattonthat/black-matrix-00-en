[
 {
  "id": "SCENARIO/166/0016c",
  "speaker": 16,
  "jp": [
   "らしくなくヘコんでるわね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/001be",
  "speaker": 0,
  "jp": [
   "これでも反省してるんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/001fe",
  "speaker": 16,
  "jp": [
   "そうね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00218",
  "speaker": 16,
  "jp": [
   "自分の気持ちだけ言いたい放題、",
   "人の話もロクに聞かない、",
   "あげくに飛び出すなんて最低よ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/0029a",
  "speaker": 0,
  "jp": [
   "ステイエンはきっついな～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/002d2",
  "speaker": 0,
  "jp": [
   "でもさ、あの場にいたら",
   "うやむやのまま周りの気持ちに",
   "押し流されそうで嫌だったんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/0033c",
  "speaker": 0,
  "jp": [
   "だって、自分で選んだ答えじゃ",
   "ないと、後悔しちまうだろ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/003a4",
  "speaker": 16,
  "jp": [
   "それはそうだけど・・・",
   "あんた、ちゃんと周りの人達の",
   "気持ちもわかってるの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00410",
  "speaker": 0,
  "jp": [
   "わかってるよ",
   "みんなは組織の存続だけを",
   "問題にしてるんじゃない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00464",
  "speaker": 0,
  "jp": [
   "肉親のように、本気で俺のことを",
   "心配してくれているんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/004d8",
  "speaker": 16,
  "jp": [
   "だったらやっぱり",
   "エクサルは残った方が・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00520",
  "speaker": 0,
  "jp": [
   "カイン・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00552",
  "speaker": 0,
  "jp": [
   "俺さ、こんな風に思うんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/0058a",
  "speaker": 0,
  "jp": [
   "人の命ってのは、助けたいって",
   "両手を突き出しても、砂のように",
   "指と指の間からすり抜けちまう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/005fc",
  "speaker": 0,
  "jp": [
   "わかってる、手を伸ばしても",
   "助けることが出来るのは",
   "ほんの一握りの人達だけ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/0065c",
  "speaker": 0,
  "jp": [
   "でも、ほんの少し、",
   "後もう少し手を伸ばしたら！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/006ae",
  "speaker": 0,
  "jp": [
   "こんな俺にも、もう少しだけ",
   "出来ることがあるんじゃないか",
   "誰かを助けられるんじゃないか"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/0071c",
  "speaker": 0,
  "jp": [
   "そう思うから、俺は・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00752",
  "speaker": 16,
  "jp": [
   "エクサル・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/0078a",
  "speaker": 0,
  "jp": [
   "それとも",
   "俺がついて行ったんじゃ",
   "足手まといになっちまうかな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/007e2",
  "jp": "　そんなことないよ",
  "en": ""
 },
 {
  "id": "SCENARIO/166/007fc",
  "jp": "　足手まといだよ",
  "en": ""
 },
 {
  "id": "SCENARIO/166/00826",
  "speaker": 16,
  "jp": [
   "そんなことないよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00866",
  "speaker": 16,
  "jp": [
   "足手まといだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/0089e",
  "speaker": 0,
  "jp": [
   "うわぁ、厳しいな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/008d6",
  "speaker": 16,
  "jp": [
   "でも、エクサルが本気だって",
   "ことはボクにも伝わったよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/0093e",
  "speaker": 0,
  "jp": [
   "・・・そうか、サンキュ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00990",
  "speaker": 16,
  "jp": [
   "・・・理解できないわ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/009c6",
  "speaker": 16,
  "jp": [
   "だって、あたし達と違って",
   "アンタには行かなきゃいけない",
   "理由なんてないじゃない！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00a46",
  "speaker": 0,
  "jp": [
   "・・・そりゃそうなんだけど",
   "何かをするのに、いちいち理由",
   "なんて必要なのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00ab0",
  "speaker": 16,
  "jp": [
   "それは・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00ae6",
  "speaker": 0,
  "jp": [
   "だったら、それでいいだろ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00b2a",
  "speaker": 16,
  "jp": [
   "アンタ達って、",
   "本っ当～にお人好しなのね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00b84",
  "speaker": 16,
  "jp": [
   "そんな人間は",
   "長生き出来ないんだから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00bf6",
  "speaker": 0,
  "jp": [
   "そういうアンタも",
   "長生き出来なそうね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00c46",
  "speaker": 16,
  "jp": [
   "な、何よ！？",
   "あたしはお人好しなんかじゃ",
   "ないわよ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00d6e",
  "speaker": 16,
  "jp": [
   "・・・フン",
   "誰が死のうと構わない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00da4",
  "speaker": 16,
  "jp": [
   "危険な場所に向かうなら、",
   "戦力は少ないより多い方がいい",
   "ただ、弱い奴は勝手に死ぬだけだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00e44",
  "speaker": 0,
  "jp": [
   "最初から死ぬことなんて",
   "考えてちゃダメだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00e84",
  "speaker": 0,
  "jp": [
   "みんな、生きて戻るんだから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00ee4",
  "speaker": 16,
  "jp": [
   "だよな",
   "最初っから気持ちで負けてたら",
   "勝てるケンカも勝てないぜ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00f62",
  "speaker": 0,
  "jp": [
   "みんなで、ここに戻ってこよう",
   "奪われた大切な人達と一緒に！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/00fb8",
  "speaker": 6,
  "jp": [
   "リリスも一緒に戦うの！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/010d2",
  "speaker": 16,
  "jp": [
   "リ、リリス？！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/0111c",
  "speaker": 0,
  "jp": [
   "お願いしますカインさん",
   "わたし達も連れて行って下さい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/0117a",
  "speaker": 16,
  "jp": [
   "そんな・・・",
   "危険な戦いになるんだよ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/011bc",
  "speaker": 0,
  "jp": [
   "足手まといかもしれないけど",
   "わたし達も、何かしたいんです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/01208",
  "speaker": 0,
  "jp": [
   "みなさんの傷を癒すくらいなら",
   "わたし達にも出来ると思います",
   "だから・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/0127a",
  "speaker": 16,
  "jp": [
   "分かった、",
   "でも、危険が迫ったら、",
   "真っ先に逃げるんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/012de",
  "speaker": 0,
  "jp": [
   "えぇ、リリスと自分の身くらいは",
   "守ってみせます",
   "だから、一緒に戦いましょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/166/01356",
