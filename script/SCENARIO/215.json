  "speaker": 0,
  "jp": [
   "・・・あの、エクサルさん",
   "もしかして、まだ悪魔のことを",
   "恨んでいらっしゃるのですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/02ddc",
  "speaker": 16,
  "jp": [
   "俺が、悪魔を恨む？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/02e50",
  "speaker": 0,
  "jp": [
   "もしかしたらエクサルさんは",
   "リリスに妹さんのことを重ねた",
   "のではないかと思って・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/02ed4",
  "speaker": 17,
  "jp": [
   "！！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/02ef6",
  "speaker": 0,
  "jp": [
   "エクサルさんは",
   "小さい頃に家族を悪魔に殺された",
   "と聞きました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/02f48",
  "speaker": 0,
  "jp": [
   "その時、妹さんを",
   "守ってやれなかったことを",
   "ずっと悔やんでいるって・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/02fe2",
  "speaker": 17,
  "jp": [
   "うるさい！！！",
   "今はそんな話関係ないだろ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/03052",
  "speaker": 0,
  "jp": [
   "ご、ごめんなさい・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/0307c",
  "speaker": 0,
  "jp": [
   "でも、もしその時の悪魔と",
   "ザイオンさんを重ねてしまって",
   "いたら良くないって思ったんです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/030e8",
  "speaker": 0,
  "jp": [
   "うまく言えませんが、それでは",
   "ザイオンさんを一生許せなく",
   "なってしまいそうで・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/031c8",
  "speaker": 0,
  "jp": [
   "そういうお前はどうなんだよ！！",
   "リリスを殺そうとしたザイオンを",
   "許せるのか！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/03242",
  "speaker": 5,
  "jp": [
   "それは・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/032a4",
  "speaker": 16,
  "jp": [
   "しかし、シリアの言葉が",
   "エクサルの深層心理を言い当てて",
   "いたとしたら"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/03300",
  "speaker": 16,
  "jp": [
   "これから先、黒羽根に対する",
   "不信感がぬぐえず",
   "苦しむことになるぞ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/0338c",
  "speaker": 0,
  "jp": [
   "・・・な、なんだよそれ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/03404",
  "speaker": 16,
  "jp": [
   "あんたの憧れのヴァルトス様は",
   "黒羽根なんだから、その矛盾に",
   "押しつぶされるってことよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/034b8",
  "speaker": 0,
  "jp": [
   "な、なんだよ！！！",
   "勝手に人のことを黒羽根嫌い",
   "なんて決めつけるなよ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/03518",
  "speaker": 0,
  "jp": [
   "俺は黒羽根嫌いなんかじゃない！",
   "ヴァルトス様のことだって",
   "心から尊敬しているんだ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/0358c",
  "speaker": 16,
  "jp": [
   "本当にそう・・・？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/035b8",
  "speaker": 0,
  "jp": [
   "・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/035ea",
  "speaker": 16,
  "jp": [
   "アンタはアタシに、",
   "嫌いなものとちゃんと",
   "向き合えって言った"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/0363c",
  "speaker": 16,
  "jp": [
   "あたしは両親を悪魔に殺され",
   "住んでいた村まで焼き払われて",
   "悪魔のことは今でも大っ嫌いよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/036a8",
  "speaker": 16,
  "jp": [
   "でも、ヴァルトスさんから",
   "悪魔の渇きについて教えられて",
   "少しずつ考えるようになった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/03710",
  "speaker": 16,
  "jp": [
   "アンタはどう？",
   "自分をうやむやにしてるんじゃ",
   "ないの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/03772",
  "speaker": 1,
  "jp": [
   "違う！！",
   "俺は悪魔嫌いなんかじゃない！！",
   "お前なんかと一緒にするな！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/037e6",
  "speaker": 16,
  "jp": [
   "・・・ちょっと",
   "あたしと一緒にするなって",
   "どういう意味よ！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/0384e",
  "speaker": 0,
  "jp": [
   "うるさいんだよ",
   "お前の説教なんか聞きたくない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/038d0",
  "speaker": 17,
  "jp": [
   "なんですってぇ～！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/03948",
  "speaker": 21,
  "jp": [
   "ステイエン",
   "少し落ち着いて・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/039a2",
  "speaker": 17,
  "jp": [
   "もー怒った！",
   "アンタなんか知らない！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/03a10",
  "speaker": 0,
  "jp": [
   "・・・フン",
   "お前に世話してもらうほど",
   "俺もガキじゃないぜ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/03a68",
  "speaker": 17,
  "jp": [
   "・・・ななな、",
   "なんですってー！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/215/03b6e",
