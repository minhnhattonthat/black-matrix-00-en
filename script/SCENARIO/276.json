 {
  "id": "SCENARIO/276/0026e",
  "speaker": 0,
  "jp": [
   "キミは、どうしてアベルと",
   "一緒に居たの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/276/002c2",
  "speaker": 16,
  "jp": [
   "アベル様と共に居る者はみな、",
   "教団施設からアベル様によって",
   "連れ出されたインセスト達です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/276/00346",
  "speaker": 0,
  "jp": [
   "それって、さらわれたって",
   "いうこと？"
