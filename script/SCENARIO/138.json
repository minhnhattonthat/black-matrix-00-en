[
 {
  "id": "SCENARIO/138/001d2",
  "speaker": 16,
  "jp": [
   "カインさん・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/001f4",
  "speaker": 16,
  "jp": [
   "マティアさんをさらった天使",
   "あの六翼の天使は",
   "わたしの兄です"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/0025e",
  "speaker": 0,
  "jp": [
   "・・・うん、聞いたよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/0029a",
  "speaker": 16,
  "jp": [
   "カインさんの大切な人を",
   "兄が・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/002e6",
  "speaker": 0,
  "jp": [
   "ボクも、ごめん"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00308",
  "speaker": 0,
  "jp": [
   "あの時、翼の痛みがなかったら",
   "たぶん、ボクはベイルに斬り",
   "かかっていたと思う"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00374",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/003a0",
  "speaker": 0,
  "jp": [
   "シリアの目の前で",
   "シリアのお兄さんを殺していた",
   "かもしれないんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/0040e",
  "speaker": 16,
  "jp": [
   "それは・・",
   "仕方がないことです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/0044e",
  "speaker": 16,
  "jp": [
   "わたしなら大丈夫です",
   "覚悟は、決めていますから・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/004ae",
  "speaker": 0,
  "jp": [
   "でも、ベイルが死んだら",
   "シリアは悲しくないの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00506",
  "speaker": 16,
  "jp": [
   "それは・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00542",
  "speaker": 0,
  "jp": [
   "本当にそれでいいの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/0057e",
  "speaker": 16,
  "jp": [
   "・・・もう決めたんです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/005b0",
  "speaker": 0,
  "jp": [
   "決めたから、それでいいの？",
   "ボクにはシリアが辛そうに見える",
   "本当は・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00634",
  "speaker": 17,
  "jp": [
   "でももう、決めたんです！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00684",
  "speaker": 16,
  "jp": [
   "やっぱりわたしには",
   "誰かの犠牲の上に立つ幸せを",
   "選ぶことなんてできないから"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/006fa",
  "speaker": 0,
  "jp": [
   "犠牲の上に立つ幸せ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00728",
  "speaker": 16,
  "jp": [
   "プロデヴォン教団も兄も",
   "完全なる悪ではありません"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/0077a",
  "speaker": 16,
  "jp": [
   "でも教団は・・・",
   "少しの犠牲でみんなが幸せに",
   "なれる道を選びました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/007e2",
  "speaker": 16,
  "jp": [
   "インセストという生けにえで",
   "貧困も病も一切の苦しみのない",
   "理想の世界が築けるのです"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00862",
  "speaker": 0,
  "jp": [
   "一切の苦しみのない世界？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/008a2",
  "speaker": 16,
  "jp": [
   "カインさんも、わたし達が",
   "犠牲なくして生きられない存在で",
   "あることは分かっていますよね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00910",
  "speaker": 16,
  "jp": [
   "犠牲が嫌だというのなら",
   "獣や植物の命を食べて生きている",
   "わたし達は何なのでしょう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00986",
  "speaker": 16,
  "jp": [
   "でもわたしは、これ以上の",
   "罪と犠牲を重ねたくない",
   "だから・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/009e4",
  "speaker": 0,
  "jp": [
   "生きることは",
   "罪なんかじゃないよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00a20",
  "speaker": 16,
  "jp": [
   "！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00a4a",
  "speaker": 0,
  "jp": [
   "シリアはお肉を食べるよね？",
   "でも、自分が食べるための獣を",
   "捕まえたことってある？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00ac6",
  "speaker": 16,
  "jp": [
   "いいえ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00ae8",
  "speaker": 0,
  "jp": [
   "ボクも最初はね、"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00b0c",
  "speaker": 0,
  "jp": [
   "捕まえることは出来ても",
   "食べるために殺すことは",
   "なかなか出来なかったんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00b7a",
  "speaker": 0,
  "jp": [
   "殺すのは可哀想だって思ってた"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00bb6",
  "speaker": 0,
  "jp": [
   "でも、ヨハネが言ったんだ",
   "そこで可哀想だと思うのは",
   "不自然だって"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00c22",
  "speaker": 16,
  "jp": [
   "不自然？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00c52",
  "speaker": 0,
  "jp": [
   "どんな生き物だって生きるために",
   "何かの命をもらっている",
   "ボクらもその末端なんだって"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00cbc",
  "speaker": 0,
  "jp": [
   "獣は必要以上の獲物を捕らない",
   "それは命の連鎖を壊さないための",
   "大切なこと"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00d1c",
  "speaker": 0,
  "jp": [
   "そしてボクらも必要以上の命は",
   "狩ってはいけない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00d60",
  "speaker": 0,
  "jp": [
   "譲り受ける命に",
   "感謝の気持ちを忘れてはいけない",
   "ヨハネはそう教えてくれた"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00dd6",
  "speaker": 16,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00e04",
  "speaker": 0,
  "jp": [
   "だから、生きることは",
   "罪深いことなんかじゃない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00e56",
  "speaker": 0,
  "jp": [
   "自分が多くの人や多くの命に",
   "支えられて生きていることを",
   "忘れてはいけない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00ede",
  "speaker": 0,
  "jp": [
   "ただ、それだけのことなんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/00f16",
  "speaker": 5,
  "jp": [
   "おごり高きは",
   "自然の恵みへの感謝と敬意を",
   "忘れた白き翼を持つ者達だな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01088",
  "speaker": 0,
  "jp": [
   "カイン、お前はどう思っている？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/010ce",
  "speaker": 16,
  "jp": [
   "え？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/010ec",
  "speaker": 0,
  "jp": [
   "シリアの言う通り、",
   "教団の計画が多くの人々を幸福に",
   "導くためのものだとしたら"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01150",
  "speaker": 0,
  "jp": [
   "お前はそれを＜悪＞だと断言",
   "出来るのか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/0118c",
  "speaker": 19,
  "jp": [
   "・・・・・・"
  ],
  "en": "",
  "spill": false
 },
 {
  "id": "SCENARIO/138/011a0",
  "jp": "　ボクは＜悪＞だと思う",
  "en": ""
 },
 {
  "id": "SCENARIO/138/011c0",
  "jp": "　ボクにはわからない",
  "en": ""
 },
 {
  "id": "SCENARIO/138/01200",
  "speaker": 16,
  "jp": [
   "ボクは＜悪＞だと思うよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01228",
  "speaker": 16,
  "jp": [
   "誰かが幸せになっても",
   "その裏で他の誰かが泣くのなら",
   "そんなの無意味だ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/0128c",
  "speaker": 0,
  "jp": [
   "果たしてそれだけで＜悪＞だと",
   "言い切れるものなのだろうか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/012fe",
  "speaker": 16,
  "jp": [
   "ボクにはわからない・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01328",
  "speaker": 16,
  "jp": [
   "もし、その計画のおかげで",
   "不幸な誰かが幸せになれるのなら",
   "悪いことだとは言い切れないもの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/013a0",
  "speaker": 0,
  "jp": [
   "善と悪は紙一重、",
   "コインの裏と表のような関係だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/013e4",
  "speaker": 0,
  "jp": [
   "与えられた偽りの幸福でさえ",
   "それを偽りと知らなければ",
   "当人には本物の幸福だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/0144e",
  "speaker": 16,
  "jp": [
   "・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01474",
  "speaker": 0,
  "jp": [
   "それを知った上で",
   "何を求めるか・・・",
   "すべてはそれ次第だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/014c4",
  "speaker": 0,
  "jp": [
   "自分自身にとって一番大切なもの",
   "それが自分を突き動かすすべて",
   "なのかもしれない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01540",
  "speaker": 16,
  "jp": [
   "ボクの大切な人はマティアだよ",
   "それに、ヨハネや他のみんなも",
   "大切だと思う"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/015d4",
  "speaker": 16,
  "jp": [
   "わたしの大切な人はリリス",
   "そして兄・・",
   "他にもたくさんの人たち"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01630",
  "speaker": 0,
  "jp": [
   "それが心からの願いなら",
   "どんな矛盾やきれい事を含んでも",
   "突き進めばいい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/0168c",
  "speaker": 0,
  "jp": [
   "理想がきれい事だと笑うのは",
   "立ちはだかる現実と戦うことを",
   "諦めてしまった者達の言い草だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01706",
  "speaker": 0,
  "jp": [
   "夢で終わらせてしまうのか",
   "それを現実に変えてしまうかは",
   "本人の心のありかた次第だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01796",
  "speaker": 16,
  "jp": [
   "・・・そうですね",
   "そうなのかもしれません"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/017ea",
  "speaker": 0,
  "jp": [
   "後悔をしないですむ人生はない",
   "だが、何もしないで後悔するのと",
   "何かしてから後悔するのでは違う"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/0185c",
  "speaker": 0,
  "jp": [
   "どちらを選ぶのかは本人の自由だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/018a2",
  "speaker": 16,
  "jp": [
   "ウフフ、ヨハネさんって",
   "なんだか面白い話をされる方",
   "なんですね"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/018f8",
  "speaker": 16,
  "jp": [
   "ありがとうございますヨハネさん",
   "少しだけ、すっきりしました"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/0195e",
  "speaker": 0,
  "jp": [
   "感謝されるゆえんなどない",
   "私は真に羽ばたこうとする者の",
   "行く末を見たいだけにすぎない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/019d6",
  "speaker": 0,
  "jp": [
   "・・・そうだな",
   "人は後悔の仕方を選びながら",
   "生きているのかもしれない"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01a64",
  "speaker": 0,
  "jp": [
   "でもそれって簡単じゃないぜ？",
   "後悔ってのは",
   "後から悔やむものなんだからさ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01af8",
  "speaker": 16,
  "jp": [
   "エクサル！？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01b2e",
  "speaker": 0,
  "jp": [
   "ま、続きは酒場に戻ってからに",
   "しようぜ？",
   "お前ら、目立ってるしな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01bc6",
  "speaker": 16,
  "jp": [
   "え？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01bf2",
  "speaker": 0,
  "jp": [
   "あんだけ大声で叫んだり",
   "わめいたりしてれば",
   "嫌でも目立つよな？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01c6c",
  "speaker": 16,
  "jp": [
   "わ、わ、わたしとしたことが",
   "・・・す、すみません！！！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01ddc",
  "speaker": 16,
  "jp": [
   "もう、ヨハネが悪いんだよ！",
   "そんな仮面をつけてるから",
   "目立っちゃうんだ！"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01e54",
  "speaker": 0,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01eb0",
  "speaker": 16,
  "jp": [
   "これじゃ、子守も報われないな"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/01ef8",
  "speaker": 0,
  "jp": [
   "・・・ああ、まったくだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/05a68",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/138/05a76",
  "speaker": 0,
  "jp": [
   "ボンジュール"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/138/05a8e",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/138/05a9e",
  "speaker": 0,
  "jp": [
   "？？？"
  ],
  "en": ""
 }
]