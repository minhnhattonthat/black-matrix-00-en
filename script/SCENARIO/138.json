  "en": ""
 },
 {
  "id": "SCENARIO/138/00634",
  "jp": "でももう、決めたんです！！",
  "en": ""
 },
 {
  "id": "SCENARIO/138/00684",
  "jp": "やっぱりわたしには",
  "en": ""
 },
