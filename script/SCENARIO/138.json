 },
 {
  "id": "SCENARIO/138/0118c",
  "jp": "・・・・・・",
  "en": ""
 },
 {
  "id": "SCENARIO/138/011a0",
  "jp": "　ボクは＜悪＞だと思う",
  "en": ""
 },
 {
  "id": "SCENARIO/138/011c0",
  "jp": "　ボクにはわからない",
  "en": ""
 },
 {
  "id": "SCENARIO/138/01200",
  "jp": "ボクは＜悪＞だと思うよ",
  "en": ""
 },
 {
  "id": "SCENARIO/138/01228",
