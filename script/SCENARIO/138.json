 },
 {
  "id": "SCENARIO/138/007ac",
  "jp": "なれる道を選びました",
  "en": ""
 },
 {
  "id": "SCENARIO/138/007e2",
  "jp": "インセストという生けにえで",
  "en": ""
 },
 {
  "id": "SCENARIO/138/00800",
  "jp": "貧困も病も一切の苦しみのない",
