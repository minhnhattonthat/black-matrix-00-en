  "id": "SCENARIO/138/01c6c",
  "jp": "わ、わ、わたしとしたことが",
  "en": ""
 },
 {
  "id": "SCENARIO/138/01c8a",
  "jp": "・・・す、すみません！！！",
  "en": ""
 },
