  "en": ""
 },
 {
  "id": "SCENARIO/138/00e04",
  "jp": "だから、生きることは",
  "en": ""
 },
 {
  "id": "SCENARIO/138/00e1c",
  "jp": "罪深いことなんかじゃない",
  "en": ""
 },
 {
  "id": "SCENARIO/138/00e56",
  "jp": "自分が多くの人や多くの命に",
