[
 {
  "id": "SCENARIO/165/00270",
  "jp": "構成員・男",
  "en": ""
 },
 {
  "id": "SCENARIO/165/00284",
  "speaker": null,
  "jp": [
   "エクサルはまだまだ子供だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/002a8",
  "speaker": null,
  "jp": [
   "だから私は、",
   "エクサルを正式なメンバーに",
   "迎え入れるのには反対したんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00330",
  "jp": "構成員・女",
  "en": ""
 },
 {
  "id": "SCENARIO/165/00344",
  "speaker": null,
  "jp": [
   "エクサルはね、",
   "天使と悪魔の戦いに巻き込まれ",
   "家族や住んでいた村を失ったの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/0039c",
  "speaker": null,
  "jp": [
   "天使と悪魔がいがみあうから、",
   "エクサルのような不幸な子供が",
   "生まれてしまう・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/003fc",
  "speaker": null,
  "jp": [
   "不幸な子供が生まれない世界、",
   "わたし達がめざす世界は",
   "そういう世界よ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/0047c",
  "speaker": null,
  "jp": [
   "・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00498",
  "speaker": null,
  "jp": [
   "コホンッ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/004ac",
  "speaker": null,
  "jp": [
   "本部からの支給品よ",
   "上手く使いなさい"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00538",
  "jp": "構成員・若者",
  "en": ""
 },
 {
  "id": "SCENARIO/165/0054e",
  "speaker": null,
  "jp": [
   "エクサルはバカだからな・・・",
   "バカだからこそ、みんな",
   "あいつが可愛くて仕方がないんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/005b0",
  "speaker": null,
  "jp": [
   "俺も、ここの仲間達のことを、",
   "＜家族＞のようにさえ想っている"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/005f8",
  "speaker": null,
  "jp": [
   "＜家族＞を・・・",
   "大切な弟分を死なせたくない・・",
   "ただ、それだけのことさ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00684",
  "jp": "ダリア",
  "en": ""
 },
 {
  "id": "SCENARIO/165/00694",
  "speaker": null,
  "jp": [
   "エクサルのこと",
   "よろしく頼んだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/006dc",
  "jp": "ウェイター",
  "en": ""
 },
 {
  "id": "SCENARIO/165/006f0",
  "speaker": null,
  "jp": [
   "いらっしゃいませ～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/0070c",
  "speaker": null,
  "jp": [
   "エクサルさんなら、サーカスの",
   "方に走って行きましたけど・・・",
   "何かあったんですか？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/007a0",
  "jp": "剣士",
  "en": ""
 },
 {
  "id": "SCENARIO/165/007ae",
  "speaker": null,
  "jp": [
   "死線をくぐりぬけてきた俺も",
   "ラムシュタイン大聖堂の護衛に",
   "つくことが出来きて一安心だ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00810",
  "speaker": null,
  "jp": [
   "別名ラムシュタイン要塞",
   "さすがにあそこに襲撃かける",
   "バカはいないだろうからな～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/008a0",
  "jp": "中年",
  "en": ""
 },
 {
  "id": "SCENARIO/165/008ae",
  "speaker": null,
  "jp": [
   "ウィ～ック"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/008c4",
  "speaker": null,
  "jp": [
   "子供の声を聞くと、辛いな・・・",
   "教団に連れてかれた子供から",
   "連絡がこねぇんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00920",
  "speaker": null,
  "jp": [
   "そうだな・・・",
   "自分を捨てた親からの手紙に、",
   "返事なんてかかねぇか・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/009ac",
  "jp": "片翼の天使",
  "en": ""
 },
 {
  "id": "SCENARIO/165/009c0",
  "speaker": null,
  "jp": [
   "僕は自由気ままに旅する天使",
   "規則に縛られるよりも",
   "風と草と共に歌うのが好き♪"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00a1c",
  "speaker": null,
  "jp": [
   "歌うことにつかれたら",
   "ふかふかのベッドに転がって",
   "何もしないのが一番だよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00aa8",
  "jp": "老人",
  "en": ""
 },
 {
  "id": "SCENARIO/165/00ab6",
  "speaker": null,
  "jp": [
   "今日はいい天気だのう・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00b10",
  "jp": "青年",
  "en": ""
 },
 {
  "id": "SCENARIO/165/00b1e",
  "speaker": null,
  "jp": [
   "自分の店を持つんだったら、",
   "やっぱりめずらしいものを",
   "売る店にしたいよな～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00b78",
  "speaker": null,
  "jp": [
   "格好いいじゃん、そういうの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00bd8",
  "jp": "老婆",
  "en": ""
 },
 {
  "id": "SCENARIO/165/00be6",
  "speaker": null,
  "jp": [
   "ケケケケケッ",
   "酒場で毎日飲んでる男は",
   "子供を手放したんじゃ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00c30",
  "speaker": null,
  "jp": [
   "そして、後悔しておる",
   "わたしも似たようなもんじゃ・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00c70",
  "speaker": null,
  "jp": [
   "ケンカ別れした息子に",
   "いつまでも意地をはって",
   "会わずにいるんじゃからのう・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00d00",
  "jp": "カップル・男",
  "en": ""
 },
 {
  "id": "SCENARIO/165/00d16",
  "speaker": null,
  "jp": [
   "僕は彼女を愛しているんだ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00d38",
  "speaker": null,
  "jp": [
   "結婚するのかって？",
   "そうだね、いつかは・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00da4",
  "jp": "カップル・女",
  "en": ""
 },
 {
  "id": "SCENARIO/165/00dba",
  "speaker": null,
  "jp": [
   "わたしは彼を愛しているの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00ddc",
  "speaker": null,
  "jp": [
   "結婚するのかって？",
   "それとコレとは別の話よ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00e48",
  "jp": "神父",
  "en": ""
 },
 {
  "id": "SCENARIO/165/00e56",
  "speaker": null,
  "jp": [
   "＜書＞を読まない子供のために",
   "私が語って聞かせてあげましょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00ea0",
  "speaker": null,
  "jp": [
   "今日は、＜規格外＞の天使に",
   "ついての話をしましょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00ee0",
  "speaker": null,
  "jp": [
   "貴方も聞きますか？"
  ],
  "en": "",
  "spill": false
 },
 {
  "id": "SCENARIO/165/00efa",
  "jp": "　はい",
  "en": ""
 },
 {
  "id": "SCENARIO/165/00f08",
  "jp": "　いいえ",
  "en": ""
 },
 {
  "id": "SCENARIO/165/00f1c",
  "speaker": null,
  "jp": [
   "神の代理人である以上、",
   "天使はヒトよりも強い者で",
   "あることを求められます"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00f74",
  "speaker": null,
  "jp": [
   "ですから、魔力の源である翼を",
   "一枚しか持たない片翼の天使も",
   "また規格外と呼ばれています"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/00fd8",
  "speaker": null,
  "jp": [
   "やはり片翼では、",
   "弱者たる翼なき者を導くには",
   "力不足ということなのでしょう"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/01030",
  "speaker": null,
  "jp": [
   "超越的な力を持たない分、",
   "我々には親しみやすい方が",
   "多いのですがね・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/01092",
  "speaker": null,
  "jp": [
   "あなたも毎日＜書＞を読んで、",
   "立派な大人になるんですよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/01108",
  "jp": "男の子",
  "en": ""
 },
 {
  "id": "SCENARIO/165/01118",
  "speaker": null,
  "jp": [
   "サーカスなんてつまんねーよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/0113c",
  "speaker": null,
  "jp": [
   "何度も見に来てるのに",
   "やってることはほとんど毎回",
   "同じなんだぜ？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/011c0",
  "jp": "女の子",
  "en": ""
 },
 {
  "id": "SCENARIO/165/011d0",
  "speaker": null,
  "jp": [
   "文句ばっかり言ってるけど",
   "何度も熱心に通い詰めているのよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/01214",
  "speaker": null,
  "jp": [
   "好きなら好きと言えばいいのに",
   "男の子ってどうしてこう",
   "素直になれないのかしら？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/012a4",
  "jp": "ピエロ",
  "en": ""
 },
 {
  "id": "SCENARIO/165/012b4",
  "speaker": null,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/012d0",
  "jp": "カイン",
  "en": ""
 },
 {
  "id": "SCENARIO/165/012e0",
  "speaker": null,
  "jp": [
   "・・・あの"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/012f4",
  "jp": "ピエロ",
  "en": ""
 },
 {
  "id": "SCENARIO/165/01304",
  "speaker": null,
  "jp": [
   "見つめないでくれ",
   "見つめられると緊張して",
   "手元が狂っちゃうんだよ"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/01388",
  "jp": "兵士",
  "en": ""
 },
 {
  "id": "SCENARIO/165/01396",
  "speaker": null,
  "jp": [
   "何のために強くなりたいのか",
   "なんて、考えたこともなかった"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/013dc",
  "speaker": null,
  "jp": [
   "恋愛は自分を弱くする・・・",
   "だから、いけないことだと・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/01424",
  "speaker": null,
  "jp": [
   "でも俺は、強くなって",
   "何をしたかったんだろう？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/01494",
  "jp": "プラン",
  "en": ""
 },
 {
  "id": "SCENARIO/165/014a4",
  "speaker": null,
  "jp": [
   "今日も元気に",
   "いらっしゃいませ～"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/014ec",
  "jp": "フライ",
  "en": ""
 },
 {
  "id": "SCENARIO/165/014fc",
  "speaker": null,
  "jp": [
   "いらっしゃいませ～",
   "今日も頑張るの？"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/0155c",
  "jp": "エクサル",
  "en": ""
 },
 {
  "id": "SCENARIO/165/0156e",
  "speaker": null,
  "jp": [
   "・・・・・・・・・"
  ],
  "en": ""
 },
 {
  "id": "SCENARIO/165/015ac",
  "jp": "エクサル",
  "en": ""
 },
 {
  "id": "SCENARIO/165/015be",
  "speaker": null,
  "jp": [
   "サイファーパンクのみんなには",
   "悪いけど、俺はカインと一緒に",
   "行くって決めたからな！"
