{
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "permissions": {
    "deny": [
      "WebFetch(domain:tcrf.net)"
    ]
  },
  "extraKnownMarketplaces": {
    "retro-translation": {
      "source": {
        "source": "github",
        "repo": "minhnhattonthat/translate-retro-game"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "translate-retro-game@retro-translation": true
  }
}
